<?xml version="1.0" encoding="UTF-8"?>
<!--
  DAR-BE-159. The embedded agent's records: the conversation and its turns and messages (the transcript), the changes it
  proposes to an audit (AuditChangeProposal) and the brain-change tickets it files. Every entity is tenant-owned and under
  DARPAN_ACTIVE_COMPANY_SCOPE (data/SecuritySeedData.xml, DARPAN_SCOPE_AGENT_* and friends).
  MySQL row size: at most four text-long fields per entity.
-->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- DAR-CLI-003. Tenant-owned: under DARPAN_ACTIVE_COMPANY_SCOPE (DARPAN_SCOPE_AGENT_QUERY_LOG). -->

    <entity entity-name="AgentQueryLog" package="darpan.agent" use="transactional" cache="never">
        <description>One row per fresh read-only query an agent sent (or tried to send) to a tenant's system through
            Darpan's stored connection: who, which system and connection, what was asked, and how it ended.
            Written in its own transaction, so a failed query still leaves its row.</description>
        <field name="agentQueryLogId" type="id" is-pk="true"/>
        <field name="companyUserGroupId" type="id">
            <description>The tenant the query ran for.</description></field>
        <field name="userId" type="id">
            <description>The person whose agent sent it.</description></field>
        <field name="systemEnumId" type="id">
            <description>The system queried (NetSuite, HotWax OMS or Shopify).</description></field>
        <field name="connectionId" type="id-long">
            <description>The stored connection used.</description></field>
        <field name="queryHash" type="id-long">
            <description>SHA-256 (hex) of the full query text.</description></field>
        <field name="queryText" type="text-medium">
            <description>The first 2,000 characters of the query.</description></field>
        <field name="rowCount" type="number-integer"/>
        <field name="durationMs" type="number-integer"/>
        <field name="outcome" type="id">
            <description>OK, REFUSED, THROTTLED, ERROR or TIMEOUT.</description></field>
        <field name="createdDate" type="date-time"/>
        <index name="AGQLOG_TENANT_DATE"><index-field name="companyUserGroupId"/><index-field name="createdDate"/></index>
    </entity>


    <entity entity-name="AgentConversation" package="darpan.agent" cache="never">
        <description>One chat between a user and the agent, optionally about one audit finding.</description>
        <field name="conversationId" type="id" is-pk="true"/>
        <field name="companyUserGroupId" type="id" not-null="true"><description>The tenant.</description></field>
        <field name="userId" type="id"/>
        <field name="auditId" type="id"/>
        <field name="findingId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <index name="AGENT_CONV_TENANT"><index-field name="companyUserGroupId"/></index>
    </entity>

    <entity entity-name="AgentTurn" package="darpan.agent" cache="never">
        <description>One model run inside a conversation, with what it cost.</description>
        <field name="turnId" type="id" is-pk="true"/>
        <field name="conversationId" type="id" not-null="true"/>
        <field name="companyUserGroupId" type="id" not-null="true"><description>The tenant.</description></field>
        <field name="role" type="text-short"><description>ROUTER, INVESTIGATOR or AUTHOR.</description></field>
        <field name="model" type="text-short"/>
        <field name="requestCount" type="number-integer"/>
        <field name="inputTokens" type="number-integer"/>
        <field name="outputTokens" type="number-integer"/>
        <field name="cacheReadTokens" type="number-integer"/>
        <field name="costMicros" type="number-integer"/>
        <field name="stopReason" type="text-short"/>
        <field name="outcome" type="text-short"/>
        <field name="startedDate" type="date-time"/>
        <field name="endedDate" type="date-time"/>
        <relationship type="one" related="darpan.agent.AgentConversation" fk-name="AGENT_TURN_CONV">
            <key-map field-name="conversationId"/>
        </relationship>
        <index name="AGENT_TURN_CONV_IDX"><index-field name="conversationId"/></index>
        <index name="AGENT_TURN_TENANT"><index-field name="companyUserGroupId"/></index>
    </entity>

    <entity entity-name="AgentMessage" package="darpan.agent" cache="never">
        <description>One transcript entry of a conversation, in order.</description>
        <field name="messageId" type="id" is-pk="true"/>
        <field name="conversationId" type="id" not-null="true"/>
        <field name="companyUserGroupId" type="id" not-null="true"><description>The tenant.</description></field>
        <field name="turnId" type="id"/>
        <field name="sequenceNum" type="number-integer"/>
        <field name="kind" type="text-short"><description>USER, ASSISTANT, TOOL_RESULT or OPERATOR.</description></field>
        <field name="contentJson" type="text-long"/>
        <relationship type="one" related="darpan.agent.AgentConversation" fk-name="AGENT_MSG_CONV">
            <key-map field-name="conversationId"/>
        </relationship>
        <relationship type="one-nofk" related="darpan.agent.AgentTurn">
            <key-map field-name="turnId"/>
        </relationship>
        <index name="AGENT_MSG_CONV_IDX"><index-field name="conversationId"/></index>
        <index name="AGENT_MSG_TENANT"><index-field name="companyUserGroupId"/></index>
    </entity>

    <entity entity-name="AuditChangeProposal" package="darpan.agent" cache="never">
        <description>A change to an audit the agent proposes. Nothing applies until a person approves it.</description>
        <field name="proposalId" type="id" is-pk="true"/>
        <field name="companyUserGroupId" type="id" not-null="true"><description>The tenant.</description></field>
        <field name="conversationId" type="id"/>
        <field name="kind" type="text-short"><description>EXCLUSION_FILTER, STATEMENT_NARROWING, FIX_TEXT or CONCLUSION_ROWS.</description></field>
        <field name="targetJson" type="text-medium"/>
        <field name="beforeJson" type="text-long"/>
        <field name="afterJson" type="text-long"/>
        <field name="evidenceJson" type="text-long"/>
        <field name="backtestJson" type="text-long"/>
        <field name="reasonText" type="text-medium"/>
        <field name="provenanceStatus" type="text-short"><description>PASS or BLOCKED.</description></field>
        <field name="blockedIds" type="text-medium"/>
        <field name="planHash" type="text-short"/>
        <field name="status" type="text-short"><description>DRAFT, PLANNED, APPLIED, REJECTED, REVERTED, STALE or INVALID.</description></field>
        <field name="statusMessage" type="text-medium"/>
        <field name="proposedForUserId" type="id"/>
        <field name="approvedByUserId" type="id"/>
        <field name="approvedDate" type="date-time"/>
        <field name="beforeVersionId" type="id"/>
        <field name="appliedVersionId" type="id"/>
        <field name="revertOfProposalId" type="id"/>
        <index name="AUD_CHG_PROP_TENANT"><index-field name="companyUserGroupId"/></index>
        <index name="AUD_CHG_PROP_CONV"><index-field name="conversationId"/></index>
    </entity>

    <entity entity-name="BrainChangeTicket" package="darpan.agent" cache="never">
        <description>A request to change the product's brain (rules, checks, knowledge) that the agent cannot make itself.</description>
        <field name="ticketId" type="id" is-pk="true"/>
        <field name="companyUserGroupId" type="id" not-null="true"><description>The tenant.</description></field>
        <field name="conversationId" type="id"/>
        <field name="category" type="text-short"><description>The lever (spec section 9.2).</description></field>
        <field name="verbatimText" type="text-long"><description>What the user said, word for word.</description></field>
        <field name="refsJson" type="text-medium"/>
        <field name="evidenceJson" type="text-medium"/>
        <field name="placementJson" type="text-long"/>
        <field name="status" type="text-short"><description>RECEIVED, ACCEPTED, DECLINED or SHIPPED.</description></field>
        <field name="statusReason" type="text-medium"/>
        <field name="shippedVersion" type="text-short"/>
        <field name="createdByUserId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <index name="BRAIN_TICKET_TENANT"><index-field name="companyUserGroupId"/></index>
        <index name="BRAIN_TICKET_CONV"><index-field name="conversationId"/></index>
    </entity>
    <entity entity-name="AgentReadCatalog" package="darpan.agent" use="configuration" cache="never">
        <description>One read the agent may make of a system record, by key (inspect#AgentRecord): which data definition runs, the
            field the key is a value of, and the only fields that come back. Product-level, so no tenant column and no scope
            filter; a tenant's own config supplies the connection. A system repo that supplies a read ships its row.</description>
        <field name="readId" type="id" is-pk="true"/>
        <field name="definitionId" type="id" not-null="true"><description>The DataSourceDefinition that runs.</description></field>
        <field name="system" type="text-short" not-null="true"><description>OMS, SHOPIFY or NETSUITE.</description></field>
        <field name="recordKind" type="text-short"/>
        <field name="lookupKeyField" type="text-short" not-null="true"><description>The field the key is a value of.</description></field>
        <field name="allowedFields" type="text-medium" not-null="true"><description>Comma-separated; status, type, date, amount, id
            and SKU fields only: no name, email, address, phone or note.</description></field>
        <field name="description" type="text-medium"/>
    </entity>

</entities>
