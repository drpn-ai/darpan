<?xml version="1.0" encoding="UTF-8"?>
<!-- DAR-BE-264 recovery code used.
     DAR-BE-298: wears EmailFrame (the app's light theme, like the audit email) and the VOICE_GUIDE.md voice (Aditi
     2026-11-18: "there still is no personality here" / "keep it short still... but making the user smile"); the darpan-email skill holds the rules. No bold. The only
     links are the user guide's (EmailFrame.guides: docs.drpn.ai pages, address shown; never a sign-in or action page). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false">
    <macro-template type="text" location="component://darpan/template/email/EmailText.ftl"/>
    <actions>
        <!-- DAR-OPS-029 S99-076: frameOpen, frameClose, guideLinks, guidesHtml, guidesText (EmailFrame.preamble). -->
        <script>context.putAll(darpan.email.EmailFrame.preamble(ec, 'DARPAN · SECURITY', 'DARPAN_2FA_RECOVERY_USED'))</script>
        <set field="copyVars" from="[firstName: firstName, at: at, recoveryCodesLeft: recoveryCodesLeft]"/>
        <set field="smile" from="darpan.email.EmailSmile.line(ec, &quot;DARPAN_2FA_RECOVERY_USED&quot;, darpan.email.EmailCopy.text(ec, &quot;DARPAN_2FA_RECOVERY_USED&quot;, &quot;smile&quot;, copyVars))"/>
        <set field="copyVars" from="copyVars + [smile: smile]"/>
        <set field="copyGreeting" from="darpan.email.EmailCopy.text(ec, &quot;DARPAN_2FA_RECOVERY_USED&quot;, &quot;greeting&quot;, copyVars)"/>
        <set field="copyBody" from="darpan.email.EmailCopy.text(ec, &quot;DARPAN_2FA_RECOVERY_USED&quot;, &quot;body&quot;, copyVars)"/>
        <set field="copyNext" from="darpan.email.EmailCopy.text(ec, &quot;DARPAN_2FA_RECOVERY_USED&quot;, &quot;next&quot;, copyVars)"/>
        <set field="copyNote" from="darpan.email.EmailCopy.text(ec, &quot;DARPAN_2FA_RECOVERY_USED&quot;, &quot;note&quot;, copyVars)"/>
        <!-- DAR-BE-315: the plain-text part is these same copy blocks, one per paragraph, never cut or dropped; template/email/EmailText.ftl keeps the labels above out of it (stock text macros cut each at 132 columns and drop fail-widgets branches). -->
        <set field="emailText" from="darpan.email.EmailFrame.textOf([copyGreeting, copyBody, copyNext, copyNote, '— Darpan'])"/>
    </actions>
    <widgets>
        <render-mode><text type="html" no-boundary-comment="true"><![CDATA[${frameOpen}]]></text></render-mode>
        <container style="dp-p"><label text="${copyGreeting}"/></container>
        <container style="dp-p"><label text="${copyBody}"/></container>
        <container style="dp-p"><label text="${copyNext}"/></container>
        <container style="dp-note"><label text="${copyNote}"/></container>
        <container style="dp-sign"><label text="— Darpan"/></container>
        <render-mode>
            <text type="html" no-boundary-comment="true"><![CDATA[${guidesHtml}${frameClose}]]></text>
            <text type="text" no-boundary-comment="true"><![CDATA[${emailText}${guidesText}]]></text>
        </render-mode>
    </widgets>
</screen>
