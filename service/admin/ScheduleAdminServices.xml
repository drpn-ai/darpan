<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="get" noun="ScheduleBoard" allow-remote="true" authz-action="view">
        <description>Every tenant's scheduled automations on one instance-wide timeline, ordered by the
            moment the scheduler will actually submit them, for deployment and load management.

            Only the first fire per automation is authoritative — it is the stored nextScheduledFireTime
            the scanner owns. Later entries are projected from scheduleExpr and assume the automation is
            not paused, edited, or deferred by the concurrency cap before it gets there.

            Fire times are absolute instants; submitsAt snaps each one up to the next run of the live cron of
            scan_ReconciliationAutomations_5m (scanCron, default "0 0/5 * * * ?", editable with update#ServiceJob), because
            nothing is submitted between runs. While that job is paused (scanPaused) nothing is submitted: submitsAt and
            concurrentAtTick are empty. concurrentAtTick counts the fires sharing a run, to be read against
            inFlightCap (darpan.reconciliation.automation.maxConcurrentExecutions).</description>
        <in-parameters>
            <parameter name="horizonHours" type="Integer" default-value="24">
                <description>How far forward to project. Defaults to 24 hours.</description>
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="scheduleBoard" type="Map">
                <parameter name="generatedAt" type="Timestamp"/>
                <parameter name="horizonHours" type="Integer"/>
                <parameter name="scanCron" type="String">
                    <description>Live cron of the scan job; empty while it is paused.</description>
                </parameter>
                <parameter name="scanPaused" type="Boolean"/>
                <parameter name="inFlightCap" type="Integer">
                    <description>Global cap on executions in flight at once, not a per-tenant cap.</description>
                </parameter>
                <parameter name="inFlight" type="List">
                    <description>Executions started but not finished, oldest first.</description>
                </parameter>
                <parameter name="fires" type="List">
                    <description>Projected submissions across the horizon, earliest first.</description>
                </parameter>
                <parameter name="paused" type="List">
                    <description>Inactive automations — listed for inventory, never projected.</description>
                </parameter>
            </parameter>
        </out-parameters>
        <actions>
            <set field="scheduleBoard" from="darpan.admin.AdminScheduleSupport.getScheduleBoard(ec, horizonHours, ec.user.nowTimestamp)"/>
        </actions>
    </service>
    <!-- DAR-BE-305. Scheduled jobs as data: list, check, edit, pause, resume and reset a job's cron, pause state and parameters
         without a deploy. Super admin only (the DARPAN_ADMIN_API fence plus the check below); no fresh two-factor code,
         super-admin sign-in is enough, and every write is audit-logged (AdminAuditLog: `what: before -> after`). Only Darpan's
         own jobs (a shipped defaultCronExpression) are editable; the framework's are listed read-only. Every edit stamps
         editedDate/editedByUserId, which is what keeps it across a deploy (schedule.ScheduleServices.apply#JobDefaults skips
         edited rows); a reset clears them. The work is darpan.admin.ScheduleJobAdminSupport and darpan.schedule.JobScheduleRules. -->

    <service verb="get" noun="ServiceJobs" allow-remote="true" authenticate="true" authz-action="view" transaction="ignore">
        <description>Every scheduled job: jobName, description, serviceName, cronExpression, paused (Y/N), defaultCronExpression,
            defaultPaused, minIntervalMinutes (the smallest gap an edited cron may leave), editable (Darpan's own jobs),
            edited, editedByUserId, editedDate, nextRuns (the next 3), lastRun {startTime, endTime, hasError} from the newest
            run, resumeNeedsPreview (resuming it deletes data: update#ServiceJob then needs previewedRows) and parameters
            [{parameterName, value, defaultValue, edited, type}]. Crons run in the server's time zone (what the job runner uses).</description>
        <out-parameters>
            <parameter name="jobs" type="List"><parameter name="job" type="Map"/></parameter>
        </out-parameters>
        <actions>
            <set field="jobs" from="[]"/>
            <if condition="!darpan.admin.AdminAccessSupport.requireSuperAdmin(ec)"><return/></if>
            <entity-find entity-name="moqui.service.job.ServiceJob" list="jobRows" cache="false">
                <order-by field-name="jobName"/>
            </entity-find>
            <iterate list="jobRows" entry="jobRow">
                <service-call name="schedule.ScheduleServices.describe#ServiceJob" in-map="[jobName: jobRow.jobName]" out-map="described"/>
                <script>jobs.add(described.job)</script>
            </iterate>
        </actions>
    </service>

    <service verb="preview" noun="JobSchedule" allow-remote="true" authenticate="true" authz-action="view" transaction="ignore">
        <description>Checks a cron for a job without saving anything: problem (empty when fine; names the job's floor when the cron
            runs more often than it allows, or says it never runs), the next 5 runs and the smallest gap in minutes
            between runs. Quartz cron: six fields (seconds first), at most 120 characters, must run within 400 days.</description>
        <in-parameters>
            <parameter name="jobName" required="true"/>
            <parameter name="cronExpression" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="problem" type="String"/>
            <parameter name="nextRuns" type="List"/>
            <parameter name="smallestGapMinutes" type="Integer"/>
        </out-parameters>
        <actions>
            <if condition="!darpan.admin.AdminAccessSupport.requireSuperAdmin(ec)"><return/></if>
            <entity-find-one entity-name="moqui.service.job.ServiceJob" value-field="job" cache="false"/>
            <if condition="!job"><return error="true" message="No job ${jobName}."/></if>
            <set field="text" from="cronExpression?.trim()"/>
            <set field="nowInstant" from="ec.user.nowTimestamp.toInstant()"/>
            <set field="problem" from="darpan.schedule.JobScheduleRules.cronProblem(text, job.minIntervalMinutes, nowInstant)"/>
            <set field="nextRuns" from="text ? darpan.schedule.JobScheduleRules.nextRuns(text, nowInstant, 5).collect { java.sql.Timestamp.from(it) } : []"/>
            <set field="smallestGapMinutes" from="text ? darpan.schedule.JobScheduleRules.smallestGapMinutes(text, nowInstant) : null"/>
        </actions>
    </service>

    <service verb="update" noun="ServiceJob" allow-remote="true" authenticate="true">
        <description>Edits a Darpan job: its cron, its pause state, its parameters, in one call; refused as a whole, with the reason and
            nothing saved, when any part is wrong. Refused: a job that is not Darpan's, a cron that does not parse, is blank,
            over 120 characters, never runs within 400 days or leaves a gap under the job's minIntervalMinutes, paused other than Y or N,
            a parameter the job's service does not take, a blank value or one that does not convert to the parameter's type (a
            Boolean takes true, false, Y or N).
            Resuming (Y to N) a job with resumePreviewService (retention) needs previewedRows, the total the preview showed: the
            preview is run again and the resume is refused when today's count is more than 100 rows or 5% above it. Pausing needs
            no preview. A resumed job runs within about a minute (the runner catches up a run that was due while it was paused),
            unless the same call changes its cron. A cron change counts as a run made now (ServiceJobRunLock.lastRunTime), so moving
            the time to one already past today does not fire the job at once and break its floor; the next run is the cron's next
            time. A value equal to the live one is not a change; no change writes no audit row. Writes one AdminAuditLog row
            (`cron: a -> b; paused: Y -> N (preview showed N rows, today's dry run counts M); name: a -> b`).</description>
        <in-parameters>
            <parameter name="jobName" required="true"/>
            <parameter name="cronExpression"><description>Quartz cron; never blank (pause the job instead).</description></parameter>
            <parameter name="paused"><description>Y or N.</description></parameter>
            <parameter name="parameters" type="Map"><description>Parameter name to its new value; each must be an in-parameter of the job's service.</description></parameter>
            <parameter name="previewedRows" type="Long"><description>Rows the preview showed; needed to resume a job that deletes.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="job" type="Map"><description>The job as get#ServiceJobs lists it, after the edit.</description></parameter>
        </out-parameters>
        <actions>
            <if condition="!darpan.admin.AdminAccessSupport.requireSuperAdmin(ec)"><return/></if>
            <entity-find-one entity-name="moqui.service.job.ServiceJob" value-field="job" cache="false" for-update="true"/>
            <if condition="!job"><return error="true" message="No job ${jobName}."/></if>
            <if condition="job.defaultCronExpression == null"><return error="true" message="${jobName} is not one of Darpan's jobs and cannot be edited here."/></if>
            <if condition="cronExpression != null &amp;&amp; !cronExpression.trim()"><return error="true" message="The cron is blank; pause the job instead of clearing its cron."/></if>
            <set field="newCron" from="cronExpression?.trim() ?: null"/>
            <set field="newPaused" from="paused?.trim()?.toUpperCase() ?: null"/>
            <if condition="newCron == null &amp;&amp; newPaused == null &amp;&amp; !parameters"><return error="true" message="Nothing to change: send cronExpression, paused or parameters."/></if>

            <!-- plan: every check first, so a refusal has saved nothing -->
            <set field="changes" from="[]"/>
            <set field="cronChanged" from="false"/>
            <set field="pausedChanged" from="false"/>
            <if condition="newCron != null">
                <set field="cronProblem" from="darpan.schedule.JobScheduleRules.cronProblem(newCron, job.minIntervalMinutes, ec.user.nowTimestamp.toInstant())"/>
                <if condition="cronProblem"><return error="true" message="${cronProblem}"/></if>
                <if condition="newCron != job.cronExpression">
                    <set field="cronChanged" from="true"/>
                    <script>changes.add('cron: ' + job.cronExpression + ' -> ' + newCron)</script>
                </if>
            </if>
            <if condition="newPaused != null">
                <if condition="!(newPaused in ['Y', 'N'])"><return error="true" message="paused is Y or N, not '${paused}'."/></if>
                <set field="livePaused" from="job.paused ?: 'N'"/>
                <if condition="newPaused != livePaused">
                    <set field="pausedChanged" from="true"/>
                    <set field="pausedNote" from="''"/>
                    <if condition="newPaused == 'N' &amp;&amp; job.resumePreviewService != null">
                        <service-call name="schedule.ScheduleServices.check#ResumePreview" out-map="pv"
                                in-map="[previewService: job.resumePreviewService, previewedRows: previewedRows]"/>
                        <if condition="pv.problem"><return error="true" message="${pv.problem}"/></if>
                        <set field="pausedNote" from="' (' + pv.note + ')'"/>
                    </if>
                    <script>changes.add('paused: ' + livePaused + ' -> ' + newPaused + pausedNote)</script>
                </if>
            </if>
            <set field="paramWrites" from="[]"/>
            <iterate list="(parameters ?: [:]).entrySet()" entry="pe">
                <set field="pName" from="pe.key.toString()"/>
                <service-call name="schedule.ScheduleServices.check#JobParameter" out-map="chk"
                        in-map="[serviceName: job.serviceName, parameterName: pName, value: pe.value]"/>
                <if condition="chk.problem"><return error="true" message="${chk.problem}"/></if>
                <set field="pValue" from="pe.value.toString().trim()"/>
                <entity-find-one entity-name="moqui.service.job.ServiceJobParameter" value-field="existing" cache="false">
                    <field-map field-name="jobName"/>
                    <field-map field-name="parameterName" from="pName"/>
                </entity-find-one>
                <if condition="existing?.parameterValue != pValue">
                    <script>paramWrites.add([parameterName: pName, value: pValue])
                        changes.add(pName + ': ' + (existing?.parameterValue ?: '(none)') + ' -> ' + pValue)</script>
                </if>
            </iterate>

            <!-- write -->
            <if condition="changes">
                <if condition="cronChanged || pausedChanged">
                    <if condition="cronChanged"><set field="job.cronExpression" from="newCron"/></if>
                    <if condition="pausedChanged"><set field="job.paused" from="newPaused"/></if>
                    <set field="job.editedByUserId" from="ec.user.userId"/>
                    <set field="job.editedDate" from="ec.user.nowTimestamp"/>
                    <entity-update value-field="job"/>
                </if>
                <if condition="cronChanged">
                    <!-- the runner runs a job at once when its last scheduled time is after lastRunTime: count this edit as a run made now -->
                    <entity-find-one entity-name="moqui.service.job.ServiceJobRunLock" value-field="runLock" cache="false" for-update="true">
                        <field-map field-name="jobName"/>
                    </entity-find-one>
                    <if condition="runLock">
                        <set field="runLock.lastRunTime" from="ec.user.nowTimestamp"/>
                        <entity-update value-field="runLock"/>
                    <else>
                        <entity-make-value entity-name="moqui.service.job.ServiceJobRunLock" value-field="newLock"/>
                        <set field="newLock.jobName" from="jobName"/>
                        <set field="newLock.lastRunTime" from="ec.user.nowTimestamp"/>
                        <entity-create value-field="newLock"/>
                    </else></if>
                </if>
                <iterate list="paramWrites" entry="pw">
                    <entity-find-one entity-name="moqui.service.job.ServiceJobParameter" value-field="paramRow" cache="false">
                        <field-map field-name="jobName"/>
                        <field-map field-name="parameterName" from="pw.parameterName"/>
                    </entity-find-one>
                    <if condition="paramRow">
                        <set field="paramRow.parameterValue" from="pw.value"/>
                        <set field="paramRow.editedByUserId" from="ec.user.userId"/>
                        <set field="paramRow.editedDate" from="ec.user.nowTimestamp"/>
                        <entity-update value-field="paramRow"/>
                    <else>
                        <entity-make-value entity-name="moqui.service.job.ServiceJobParameter" value-field="newParam"/>
                        <set field="newParam.jobName" from="jobName"/>
                        <set field="newParam.parameterName" from="pw.parameterName"/>
                        <set field="newParam.parameterValue" from="pw.value"/>
                        <set field="newParam.editedByUserId" from="ec.user.userId"/>
                        <set field="newParam.editedDate" from="ec.user.nowTimestamp"/>
                        <entity-create value-field="newParam"/>
                    </else></if>
                </iterate>
                <script>darpan.admin.AdminAuditSupport.record(ec, "admin.ScheduleAdminServices.update#ServiceJob", "ServiceJob", jobName, changes.join('; '))</script>
            </if>
            <service-call name="schedule.ScheduleServices.describe#ServiceJob" in-map="[jobName: jobName]" out-map="described"/>
            <set field="job" from="described.job"/>
        </actions>
    </service>

    <service verb="reset" noun="ServiceJob" allow-remote="true" authenticate="true">
        <description>Puts a Darpan job back on its shipped defaults. With no parameterNames: the cron and pause state go back to the
            shipped ones, every parameter edited here goes back to its default (a parameter with no default is deleted), and the
            job follows the defaults on every later deploy again. With parameterNames: only those parameters (the cron and pause
            state stay edited). A reset that resumes a job with resumePreviewService needs previewedRows, as update#ServiceJob does,
            and a reset that changes the cron counts as a run made now, as there. A job already on its defaults changes nothing and
            writes no audit row. Writes one AdminAuditLog row naming each change.</description>
        <in-parameters>
            <parameter name="jobName" required="true"/>
            <parameter name="parameterNames" type="List"><description>Parameters to reset; omit to reset everything.</description></parameter>
            <parameter name="previewedRows" type="Long"><description>Rows the preview showed; needed when the reset resumes a job that deletes.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="job" type="Map"><description>The job as get#ServiceJobs lists it, after the reset.</description></parameter>
        </out-parameters>
        <actions>
            <if condition="!darpan.admin.AdminAccessSupport.requireSuperAdmin(ec)"><return/></if>
            <entity-find-one entity-name="moqui.service.job.ServiceJob" value-field="job" cache="false" for-update="true"/>
            <if condition="!job"><return error="true" message="No job ${jobName}."/></if>
            <if condition="job.defaultCronExpression == null"><return error="true" message="${jobName} is not one of Darpan's jobs and cannot be reset here."/></if>

            <!-- plan -->
            <set field="all" from="parameterNames == null"/>
            <set field="names" from="parameterNames?.collect { it.toString() }"/>
            <set field="changes" from="[]"/>
            <set field="cronChanged" from="false"/>
            <set field="markerSet" from="false"/>
            <entity-find entity-name="moqui.service.job.ServiceJobParameter" list="paramRows" cache="false">
                <econdition field-name="jobName"/>
                <order-by field-name="parameterName"/>
            </entity-find>
            <if condition="all">
                <set field="wantPaused" from="job.defaultPaused ?: 'N'"/>
                <set field="livePaused" from="job.paused ?: 'N'"/>
                <set field="markerSet" from="job.editedDate != null"/>
                <if condition="job.cronExpression != job.defaultCronExpression">
                    <set field="cronChanged" from="true"/>
                    <script>changes.add('cron: ' + job.cronExpression + ' -> ' + job.defaultCronExpression)</script>
                </if>
                <if condition="livePaused != wantPaused">
                    <set field="pausedNote" from="''"/>
                    <if condition="wantPaused == 'N' &amp;&amp; job.resumePreviewService != null">
                        <service-call name="schedule.ScheduleServices.check#ResumePreview" out-map="pv"
                                in-map="[previewService: job.resumePreviewService, previewedRows: previewedRows]"/>
                        <if condition="pv.problem"><return error="true" message="${pv.problem}"/></if>
                        <set field="pausedNote" from="' (' + pv.note + ')'"/>
                    </if>
                    <script>changes.add('paused: ' + livePaused + ' -> ' + wantPaused + pausedNote)</script>
                </if>
            <else>
                <set field="missing" from="names.find { !(it in paramRows*.parameterName) }"/>
                <if condition="missing"><return error="true" message="${jobName} has no parameter ${missing} to reset."/></if>
            </else></if>
            <set field="restores" from="[]"/>
            <set field="deletes" from="[]"/>
            <iterate list="paramRows" entry="r">
                <if condition="all || names.contains(r.parameterName)">
                    <if condition="r.defaultValue != null">
                        <if condition="r.parameterValue != r.defaultValue || r.editedDate != null">
                            <script>restores.add([parameterName: r.parameterName, defaultValue: r.defaultValue])</script>
                            <if condition="r.parameterValue != r.defaultValue">
                                <script>changes.add(r.parameterName + ': ' + r.parameterValue + ' -> ' + r.defaultValue)</script>
                            </if>
                        </if>
                    <else-if condition="!all || r.editedDate != null">
                        <script>deletes.add(r.parameterName)
                            changes.add(r.parameterName + ': ' + r.parameterValue + ' -> (removed)')</script>
                    </else-if></if>
                </if>
            </iterate>

            <!-- write -->
            <if condition="changes || markerSet || restores || deletes">
                <iterate list="restores" entry="pr">
                    <entity-find-one entity-name="moqui.service.job.ServiceJobParameter" value-field="paramRow" cache="false">
                        <field-map field-name="jobName"/>
                        <field-map field-name="parameterName" from="pr.parameterName"/>
                    </entity-find-one>
                    <set field="paramRow.parameterValue" from="pr.defaultValue"/>
                    <set field="paramRow.editedByUserId" from="null"/>
                    <set field="paramRow.editedDate" from="null"/>
                    <entity-update value-field="paramRow"/>
                </iterate>
                <iterate list="deletes" entry="pn">
                    <entity-delete-by-condition entity-name="moqui.service.job.ServiceJobParameter">
                        <econdition field-name="jobName"/>
                        <econdition field-name="parameterName" from="pn"/>
                    </entity-delete-by-condition>
                </iterate>
                <if condition="all">
                    <set field="job.editedByUserId" from="null"/>
                    <set field="job.editedDate" from="null"/>
                    <entity-update value-field="job"/>
                    <!-- the load's own step, for this job only: copies the shipped cron and pause state onto this now-unedited job -->
                    <service-call name="schedule.ScheduleServices.apply#JobDefaults" in-map="[jobName: jobName]"/>
                </if>
                <if condition="cronChanged">
                    <entity-find-one entity-name="moqui.service.job.ServiceJobRunLock" value-field="runLock" cache="false" for-update="true">
                        <field-map field-name="jobName"/>
                    </entity-find-one>
                    <if condition="runLock">
                        <set field="runLock.lastRunTime" from="ec.user.nowTimestamp"/>
                        <entity-update value-field="runLock"/>
                    <else>
                        <entity-make-value entity-name="moqui.service.job.ServiceJobRunLock" value-field="newLock"/>
                        <set field="newLock.jobName" from="jobName"/>
                        <set field="newLock.lastRunTime" from="ec.user.nowTimestamp"/>
                        <entity-create value-field="newLock"/>
                    </else></if>
                </if>
                <script>darpan.admin.AdminAuditSupport.record(ec, "admin.ScheduleAdminServices.reset#ServiceJob", "ServiceJob", jobName,
                        changes ? changes.join('; ') : 'follows the shipped defaults again')</script>
            </if>
            <service-call name="schedule.ScheduleServices.describe#ServiceJob" in-map="[jobName: jobName]" out-map="described"/>
            <set field="job" from="described.job"/>
        </actions>
    </service>
</services>
