<?xml version="1.0" encoding="UTF-8"?>
<!--
Release-scoped upgrade data for Darpan 1.4.0.
Generated from backend compare range: v1.3.0..HEAD, then reviewed.
Records must also live in generic source data files under runtime/component/darpan/data/.
Load with: ./gradlew loadDarpanUpgradeData

PREREQUISITE: this file is release-scoped and carries ONLY the records new in 1.4.0. It does not
re-carry the 1.3.0 record (the OMS connector's filterParameterName). An environment that never
loaded data/releases/1.3.0/upgrade-data.xml must load that file first, or source exclusion filters
stay inert there even after 1.4.0 is deployed.

ORDERING NOTE: the generator sorts records by source file, which this release happens to agree with
— DarpanSystemSourceSeedData.xml sorts before SourceSystemConnectorSeedData.xml, so the
OMS_TRANSFER_ORDERS Enumeration lands before the SourceSystemConnector row whose systemEnumId
references it. That alignment is coincidence, not a guarantee. Re-check parent-before-child by hand
after every regeneration.

OPERATOR IMPACT: three additive records. Two Enumerations and one new SourceSystemConnector row
register HotWax transfer orders as a selectable source system. Nothing existing is modified, so
loading this file changes no current reconciliation behaviour. Until it loads, transfer orders do
not appear as a source-system option and any saved configuration naming them cannot resolve a
connector.

The AUT_WIN_STATE row backs a window mode that is deliberately NOT offered in the UI in this
release — list#AutomationSourceOptions filters it out, because the per-source status list it needs
has no write path yet. The row is loaded now so the enum is in place when that surface ships;
loading it exposes nothing to operators.
-->
<entity-facade-xml type="darpan-seed">
    <!-- Added records from data/AutomationSeedData.xml -->
    <moqui.basic.Enumeration enumId="AUT_WIN_STATE" enumTypeId="AutomationRelWindow" enumCode="STATE_BASED" description="State based (no date window)" sequenceNum="8"/>
    <!-- Added records from data/DarpanSystemSourceSeedData.xml.
         Precedes the SourceSystemConnector row below: that row's systemEnumId references this enum. -->
    <moqui.basic.Enumeration enumId="OMS_TRANSFER_ORDERS" enumTypeId="DarpanSystemSource" enumCode="HOTWAX_TRANSFER_ORDERS" description="HotWax Transfer Orders" sequenceNum="6"/>
    <!-- Added records from data/SecuritySeedData.xml.
         Parent ArtifactGroup DARPAN_AUTH_API already exists in every deployed environment (it has carried
         login#Session since before 1.3.0), so this row has no forward FK reference and needs no reordering.
         Registers the anonymous forced-password-change entry point alongside the other pre-session auth
         services. Until it loads, a fresh install and an upgraded install disagree on the contents of the
         anonymous auth fence. -->
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_AUTH_API" artifactName="facade.AuthFacadeServices.change#ExpiredPassword" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"/>
    <!-- Added records from data/SourceSystemConnectorSeedData.xml -->
    <darpan.reconciliation.SourceSystemConnector systemEnumId="OMS_TRANSFER_ORDERS" extractServiceName="reconciliation.HotWaxOmsExtractionServices.extract#HotWaxOmsTransferOrders" dateFromParameterName="windowStart" dateToParameterName="windowEnd" expectedSourceConfigType="HOTWAX_OMS_REST_TRANSFER" configParameterName="omsRestSourceConfigId" configEntityName="darpan.hotwax.HotWaxOmsRestSourceConfig" remoteId="HOTWAX_ORDERS_API" endpointLabel="Orders API (Transfer Orders)" sendUrlTemplate="{baseUrl}/rest/s1/oms/orders" remoteSendServiceName="reconciliation.HotWaxOmsExtractionServices.extract#HotWaxOmsTransferOrders" systemAliases="OMS_TRANSFER_ORDERS,HOTWAX_TRANSFER_ORDERS,DAR_SYS_OMS_TO" preserveWindowInstants="N" keepFieldsParameterName="keepRecordFields" keepFieldsBase="orderId,orderName,orderDate,statusId,originFacilityId,grandTotal,currencyUom" filterParameterName="sourceFilters" windowFieldName="orderDate" supportsStateExtract="Y" statusParameterName="orderStatusIds" healthCheckServiceName="facade.HotWaxOmsFacadeServices.probe#HotWaxOmsConnection" enabled="Y"/>
</entity-facade-xml>
