<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- DAR-UI-058. The app's audit run, in the active tenant. The report and the finding are the assembler's JSON
         unchanged (darpan.audit.report/v1, darpan.audit.finding/v1): the same documents GraphQL and the CLI read, so
         the screen has no fields of its own. Another tenant's audit or finding reads as not found. -->

    <service verb="get" noun="Audits" authz-action="view" allow-remote="true" authenticate="true">
        <description>The active tenant's audits: id (the audit's code), name and the period it reports by.</description>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="audits" type="List"><parameter name="audit" type="Map">
                <parameter name="id"/><parameter name="name"/><parameter name="period"/></parameter></parameter>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <set field="audits" from="[]"/>
            <if condition="tenantId">
                <entity-find entity-name="darpan.audit.Audit" list="auditList">
                    <econdition field-name="companyUserGroupId" from="tenantId"/>
                    <order-by field-name="auditName"/>
                </entity-find>
                <iterate list="auditList" entry="auditRow">
                    <entity-find-one entity-name="moqui.basic.Enumeration" value-field="periodEnum" cache="true">
                        <field-map field-name="enumId" from="auditRow.periodEnumId"/></entity-find-one>
                    <script>audits.add([id: auditRow.auditCode, name: auditRow.auditName, period: periodEnum?.enumCode])</script>
                </iterate>
            </if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="get" noun="AuditReport" authz-action="view" allow-remote="true" authenticate="true">
        <description>An audit's report for one morning (darpan.audit.report/v1), as the assembler writes it.</description>
        <in-parameters>
            <parameter name="audit" required="true"><description>The audit's code, e.g. month-close.</description></parameter>
            <parameter name="date"><description>The morning, YYYY-MM-DD; blank is today in the tenant's zone.</description></parameter>
            <parameter name="period"><description>Which period's run, e.g. 2026-09 while September is extended.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="report" type="Map"/>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <set field="auditId" from="tenantId ? darpan.audit.AuditReportGraph.auditIdFor(ec, tenantId, audit) : null"/>
            <if condition="!auditId"><return error="true" message="Audit ${audit} was not found"/></if>
            <script>
                try {
                    reportDate = darpan.audit.AuditReportGraph.reportDateFor(ec, tenantId, date)
                } catch (IllegalArgumentException e) {
                    ec.message.addError(e.message)
                }
            </script>
            <if condition="!ec.message.hasError()">
                <service-call name="audit.AuditReportServices.assemble#AuditReport" out-map="assembled"
                        in-map="[companyUserGroupId:tenantId, auditId:auditId, reportDate:reportDate, period:period]"/>
                <set field="report" from="assembled?.document"/>
            </if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="get" noun="AuditFinding" authz-action="view" allow-remote="true" authenticate="true">
        <description>One finding (darpan.audit.finding/v1): records, evidence, fix and history, as the assembler writes it.</description>
        <in-parameters>
            <parameter name="findingId" required="true"><description>The finding's id, e.g. F-20761.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="finding" type="Map"/>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <if condition="!tenantId || !darpan.audit.AuditReportGraph.ownsFinding(ec, tenantId, findingId)">
                <return error="true" message="Finding ${findingId} was not found"/></if>
            <service-call name="audit.AuditReportServices.assemble#AuditFinding" out-map="assembled"
                    in-map="[companyUserGroupId:tenantId, findingId:findingId]"/>
            <set field="finding" from="assembled?.document"/>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>
    <!-- DAR-UI-063. The audit page's settings gear and play button. Writes need the active tenant's edit access. -->
    <service verb="get" noun="AuditSettings" authz-action="view" allow-remote="true" authenticate="true">
        <description>An audit's settings: its name, the daily schedule its checks run on, and each statement with its
            checks and the run each check reads.</description>
        <in-parameters><parameter name="audit" required="true"><description>The audit's code.</description></parameter></in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="settings" type="Map"><description>{audit: {id, name, period}, playableFrom: YYYY-MM-DD (the earliest
                day play can record today), schedule: {active, time HH:mm,
                timeZone, mixed, automations, checksWithoutRun}, statements: [{id, code, text, active, checks: [{id, label,
                savedRunId, runName}]}]}</description></parameter>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <set field="auditRow" from="darpan.audit.AuditSettingsSupport.auditOf(ec, tenantId, audit)"/>
            <if condition="!auditRow"><return error="true" message="Audit ${audit} was not found"/></if>
            <set field="settings" from="darpan.audit.AuditSettingsSupport.settings(ec, tenantId, auditRow)"/>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="save" noun="AuditSettings" allow-remote="true" authenticate="true">
        <description>Changes an audit's name, statements (text, on/off) and the daily schedule of every check it runs. A check
            whose run has no automation gets one (paused) when the schedule is saved. Answers the settings as saved.</description>
        <in-parameters>
            <parameter name="audit" required="true"><description>The audit's code.</description></parameter>
            <parameter name="name"><description>New name; blank keeps it.</description></parameter>
            <parameter name="statements" type="List"><description>[{id, text, active}], only those that changed.</description>
                <parameter name="statement" type="Map"/></parameter>
            <parameter name="schedule" type="Map"><description>{active, time HH:mm, timeZone}; absent keeps it.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="settings" type="Map"><description>{audit: {id, name, period}, playableFrom: YYYY-MM-DD (the earliest
                day play can record today), schedule: {active, time HH:mm,
                timeZone, mixed, automations, checksWithoutRun}, statements: [{id, code, text, active, checks: [{id, label,
                savedRunId, runName}]}]}</description></parameter>
        </out-parameters>
        <actions>
            <set field="ignoreWriteAccess" from="darpan.facade.common.TenantAccessSupport.requireActiveTenantWriteAccess(ec, 'Your active tenant only has view access for audit changes.')"/>
            <if condition="!ec.message.hasError()">
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <set field="auditRow" from="darpan.audit.AuditSettingsSupport.auditOf(ec, tenantId, audit)"/>
            <if condition="!auditRow"><return error="true" message="Audit ${audit} was not found"/></if>
                <script>darpan.audit.AuditSettingsSupport.save(ec, tenantId, auditRow, name, statements as List, schedule as Map)</script>
                <if condition="!ec.message.hasError()">
                    <set field="settings" from="darpan.audit.AuditSettingsSupport.settings(ec, tenantId, darpan.audit.AuditSettingsSupport.auditOf(ec, tenantId, audit))"/>
                </if>
            </if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="run" noun="Audit" allow-remote="true" authenticate="true">
        <description>Play: runs every check of the audit now over the days picked, first to last inclusive (the tenant's zone),
            recording findings as the morning run does. Submitted to the background, one automation per run; the audit page
            shows the results as each finishes. Refused up front for days in the future or in a period that ended and was
            not extended.</description>
        <in-parameters>
            <parameter name="audit" required="true"><description>The audit's code.</description></parameter>
            <parameter name="fromDate" required="true"><description>First day, YYYY-MM-DD.</description></parameter>
            <parameter name="thruDate" required="true"><description>Last day, YYYY-MM-DD, inclusive.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="runs" type="List"><description>[{automationId, savedRunId, submitted, error}]</description>
                <parameter name="run" type="Map"/></parameter>
        </out-parameters>
        <actions>
            <set field="ignoreWriteAccess" from="darpan.facade.common.TenantAccessSupport.requireActiveTenantWriteAccess(ec, 'Your active tenant only has view access for running audits.')"/>
            <if condition="!ec.message.hasError()">
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <set field="auditRow" from="darpan.audit.AuditSettingsSupport.auditOf(ec, tenantId, audit)"/>
            <if condition="!auditRow"><return error="true" message="Audit ${audit} was not found"/></if>
                <script>
                    try {
                        runs = darpan.audit.AuditSettingsSupport.run(ec, tenantId, auditRow, java.time.LocalDate.parse(fromDate.trim()),
                                java.time.LocalDate.parse(thruDate.trim()))
                    } catch (java.time.format.DateTimeParseException e) {
                        ec.message.addError("The days must be YYYY-MM-DD.")
                    }
                </script>
            </if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <!-- DAR-UI-064: adding a check to an audit from the app (AuditCheckAuthoringSupport). Appended, not woven in: the
         audit settings services above are DAR-UI-063's. -->
    <service verb="get" noun="AuditCheckOptions" authz-action="view" allow-remote="true" authenticate="true">
        <description>What the add-a-check editor offers for one audit: its statements, the tenant's runs with their rules
            and conclusions, the row types and fix systems a check may name, and the audit's checks.</description>
        <in-parameters><parameter name="audit" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="options" type="Map"/>
        </out-parameters>
        <actions>
            <set field="options" from="darpan.audit.AuditCheckAuthoringSupport.options(ec, audit)"/>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="get" noun="AuditCheck" authz-action="view" allow-remote="true" authenticate="true">
        <description>One check of an audit as the editor shows it, with its links to that audit's statements.</description>
        <in-parameters><parameter name="audit" required="true"/><parameter name="check" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="check" type="Map"/>
        </out-parameters>
        <actions>
            <set field="check" from="darpan.audit.AuditCheckAuthoringSupport.getCheck(ec, audit, check)"/>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="save" noun="AuditCheck" allow-remote="true" authenticate="true">
        <description>Creates or updates a check (check.id is its code) and replaces its links to this audit's statements.
            All or nothing; refused in words for a statement outside the audit, a run the tenant does not own, a rule not
            in that run, or a row type the ledger does not write. A new check, or one whose run changed, has no automation
            until the audit's play or settings makes one.</description>
        <in-parameters>
            <parameter name="audit" required="true"/>
            <parameter name="check" type="Map" required="true"/>
            <parameter name="statements" type="List"><description>[{id: statement code, diffTypes, conclusionCodes,
                ruleIds}], at least one (refused in words when empty).</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="savedCheck" type="Map"/>
        </out-parameters>
        <actions>
            <set field="savedCheck" from="darpan.audit.AuditCheckAuthoringSupport.saveCheck(ec, audit, check, statements)"/>
            <if condition="ec.message.hasError()"><return error="true"/></if>
            <set field="ok" from="true"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="[]"/>
        </actions>
    </service>

    <service verb="delete" noun="AuditCheck" allow-remote="true" authenticate="true">
        <description>Unlinks a check from this audit's statements; the check itself goes too when no other audit links it
            and no finding names it (the ledger keeps its history).</description>
        <in-parameters><parameter name="audit" required="true"/><parameter name="check" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="result" type="Map"/>
        </out-parameters>
        <actions>
            <set field="result" from="darpan.audit.AuditCheckAuthoringSupport.deleteCheck(ec, audit, check)"/>
            <if condition="ec.message.hasError()"><return error="true"/></if>
            <set field="ok" from="true"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="[]"/>
        </actions>
    </service>
</services>
