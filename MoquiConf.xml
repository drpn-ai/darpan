<?xml version="1.0" encoding="UTF-8" ?>
<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd">
    <webapp-list>
        <webapp name="webroot">
            <before-request>
                <actions>
                    <script><![CDATA[
                        // DAR-BE-078: /rpc/json dispatches only facade.*, admin.* and gql.* (403 otherwise).
                        // DAR-CLI-003: on every path, a CLI session reaches only CliMethodAllowlist (403 otherwise).
                        darpan.facade.common.RpcMethodFence.enforce(ec)
                        // DAR-CLI-003: a web session a CLI key opened is re-checked each request (revoke, expiry,
                        // disable), so revoking or disabling ends it on the next call, not when the session times out.
                        String cliSessionRefusal = darpan.facade.auth.CliAuthSupport.revalidateCliWebSession(ec)
                        if (cliSessionRefusal) throw new org.moqui.context.ArtifactAuthorizationException(cliSessionRefusal)
                        darpan.facade.common.TenantAccessSupport.syncUserContext(ec)
                    ]]></script>
                </actions>
            </before-request>
            <!-- Clear MDC correlation keys after every request so values never leak across
                 pooled threads. syncUserContext (before-request) stamps the keys; this block
                 guarantees cleanup regardless of whether the request succeeded or errored. -->
            <after-request>
                <actions>
                    <script><![CDATA[
                        darpan.facade.common.DarpanMdcSupport.clear()
                    ]]></script>
                </actions>
            </after-request>
            <after-login>
                <actions>
                    <script><![CDATA[
                        darpan.facade.common.TenantAccessSupport.syncUserContext(ec)
                    ]]></script>
                </actions>
            </after-login>
        </webapp>
    </webapp-list>
    <screen-facade>
        <screen location="component://webroot/screen/webroot/apps.xml">
            <subscreens-item name="darpan" menu-title="Darpan" menu-index="50" location="component://darpan/screen/darpan.xml"/>
        </screen>
    </screen-facade>
</moqui-conf>
