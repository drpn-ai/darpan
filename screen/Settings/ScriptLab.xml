<?xml version="1.0" encoding="UTF-8"?>
<!-- DAR-BE-175 POC. Script Lab: run a tenant script INSIDE the main server, on the ScriptLane, in JEXL or in guarded
     Groovy, and watch the lane (threads, queue, stuck, refusals, heap gate, off switch). Super-admin only (URL authz on
     component://darpan/screen/.* plus the exception in always-actions: Moqui skips pre-actions for transitions and runs a
     transition's actions even after an always-actions error message). Writes nothing. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Script Lab" require-authentication="true">

    <parameter name="example"/>

    <always-actions>
        <if condition="!darpan.facade.common.TenantAccessSupport.isSuperAdmin(ec)">
            <script>throw new org.moqui.context.ArtifactAuthorizationException('The script lab is limited to super-admin users.')</script>
        </if>
    </always-actions>

    <transition name="chooseTenant">
        <actions>
            <service-call name="facade.AuthFacadeServices.save#ActiveTenant" in-map="[activeTenantUserGroupId: activeTenantUserGroupId]"/>
        </actions>
        <default-response url="."/>
    </transition>

    <!-- The off switch an operator would flip without a deploy. -->
    <transition name="setLane">
        <actions><script>darpan.script.ScriptLane.setEnabled(laneOn == 'Y')</script></actions>
        <default-response url="."/>
    </transition>

    <!-- No transaction: a script must never hold row locks or a pooled connection while it runs. -->
    <transition name="runScript" begin-transaction="false">
        <actions>
            <set field="out" from="darpan.script.ScriptLab.run(ec, engine, scriptProfile, scriptBody, inputJson)"/>
            <set field="lastRun" from="[engine: engine, scriptProfile: scriptProfile, scriptBody: scriptBody, inputJson: inputJson,
                    out: out, ranAt: ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd HH:mm:ss')]"/>
            <!-- As JSON text: Moqui drops a non-serializable session attribute. -->
            <script>ec.web.sessionAttributes.put('darpanScriptLabLastRun', groovy.json.JsonOutput.toJson(lastRun))</script>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <set field="lane" from="darpan.script.ScriptLane.status()"/>
        <set field="laneText" from="(lane.enabled ? 'On' : 'SWITCHED OFF') + ' · ' + lane.running + ' of ' + lane.threads + ' threads busy · ' + lane.queued + ' of ' + lane.queueCapacity + ' queued · stuck ' + lane.stuck + ' · runs ' + lane.runs"/>
        <set field="heapText" from="'Heap ' + lane.heapPercent + '% (' + lane.heapUsedMb + ' of ' + lane.heapMaxMb + ' MB) · scripts refused above ' + lane.heapGatePercent + '%'"/>
        <set field="refusedText" from="lane.refused ? lane.refused.collect { k, v -> k + ' ' + v }.join(' · ') : 'none'"/>
        <set field="busyText" from="lane.busyTenants ? lane.busyTenants.join(', ') : 'none'"/>
        <set field="groovyCacheText" from="'Compiled Groovy scripts held: ' + darpan.script.GroovyGuard.cachedScripts() + ' of ' + darpan.script.GroovyGuard.CACHE_SIZE"/>

        <service-call name="facade.AuthFacadeServices.get#SessionInfo" out-map="sessionOut"/>
        <set field="activeTenantUserGroupId" from="sessionOut?.sessionInfo?.activeTenantUserGroupId"/>
        <set field="availableTenants" from="sessionOut?.sessionInfo?.availableTenants ?: []"/>
        <set field="tenantText" from="activeTenantUserGroupId ? (sessionOut.sessionInfo.activeTenantLabel + ' (' + activeTenantUserGroupId + ')') : 'None chosen. Scripts need an active tenant.'"/>

        <set field="examples" from="darpan.script.ScriptLab.examples()"/>
        <set field="picked" from="example ? examples.find { it.key == example } : null"/>

        <set field="lastRunJson" from="ec.web.sessionAttributes.remove('darpanScriptLabLastRun')"/>
        <set field="lastRun" from="lastRunJson instanceof String ? new groovy.json.JsonSlurper().parseText(lastRunJson) : null"/>
        <set field="formValues" from="lastRun ? [engine: lastRun.engine, scriptProfile: lastRun.scriptProfile, scriptBody: lastRun.scriptBody, inputJson: lastRun.inputJson]
                : (picked ? [engine: picked.engine, scriptProfile: picked.profile ?: 'SCRIPT', scriptBody: picked.body, inputJson: picked.input]
                : [engine: 'JEXL', scriptProfile: 'SCRIPT', scriptBody: examples[0].body, inputJson: examples[0].input])"/>
        <set field="pickedText" from="picked ? ('Loaded: ' + picked.label + ' · expected: ' + picked.expect) : ''"/>
        <if condition="lastRun">
            <set field="run" from="lastRun.out ?: [:]"/>
            <set field="runVerdict" from="run.ok ? 'ok' : ('stopped: ' + (run.error?.kind ?: 'unknown'))"/>
            <set field="runResultJson" from="groovy.json.JsonOutput.prettyPrint(groovy.json.JsonOutput.toJson(run.result))"/>
            <set field="runErrorText" from="run.error ? run.error.kind + ': ' + run.error.message : 'none'"/>
            <set field="runLogs" from="run.logs ?: []"/>
            <set field="runNumbers" from="'Engine ' + (run.engine ?: lastRun.engine) + ' · units ' + (run.units ?: 0) + ' · in the engine ' + (run.elapsedMs ?: 0) + ' ms · on the lane ' + (run.laneMs ?: 0) + ' ms'"/>
        </if>
    </actions>

    <widgets>
        <container style="container">
            <container style="page-header">
                <label text="Script Lab" type="h2"/>
                <label text="Runs a tenant script inside the main server, on the script lane, in JEXL or in guarded Groovy." type="p" style="text-muted"/>
            </container>

            <section name="Lane">
                <widgets>
                    <label text="Script lane" type="h4"/>
                    <container-box>
                        <box-header><label text="${laneText}"/></box-header>
                        <box-body>
                            <label text="${heapText}" type="p"/>
                            <label text="Refused so far: ${refusedText}" type="p"/>
                            <label text="Tenants with a script running: ${busyText}" type="p"/>
                            <label text="${groovyCacheText}" type="p" style="text-muted"/>
                            <container>
                                <link url="setLane" text="Switch scripts off" parameter-map="[laneOn: 'N']" link-type="hidden-form" condition="lane.enabled"/>
                                <link url="setLane" text="Switch scripts on" parameter-map="[laneOn: 'Y']" link-type="hidden-form" condition="!lane.enabled"/>
                                <link url="." text="Refresh" link-type="anchor"/>
                            </container>
                        </box-body>
                    </container-box>
                </widgets>
            </section>

            <section name="Tenant">
                <widgets>
                    <label text="Tenant: ${tenantText}" type="p"/>
                    <form-single name="ChooseTenantForm" transition="chooseTenant">
                        <field name="activeTenantUserGroupId"><default-field title="Switch to">
                            <drop-down allow-empty="false"><list-options list="availableTenants" key="${userGroupId}" text="${label} (${userGroupId})"/></drop-down>
                        </default-field></field>
                        <field name="chooseButton"><default-field title=""><submit text="Use this tenant"/></default-field></field>
                    </form-single>
                </widgets>
            </section>

            <section name="Examples">
                <widgets>
                    <label text="Examples" type="h4"/>
                    <section-iterate name="ExampleRows" list="examples" entry="ex">
                        <widgets>
                            <container>
                                <link url="." text="Load" parameter-map="[example: ex.key]" link-type="anchor"/>
                                <label text="  ${ex.label} · expected: ${ex.expect}" type="span"/>
                            </container>
                        </widgets>
                    </section-iterate>
                </widgets>
            </section>

            <section name="RunScript">
                <widgets>
                    <label text="Run" type="h4"/>
                    <label text="${pickedText}" type="p" style="text-info" condition="pickedText"/>
                    <form-single name="RunScriptForm" transition="runScript" map="formValues">
                        <field name="engine"><default-field title="Engine">
                            <drop-down allow-empty="false"><option key="JEXL" text="JEXL (metered every step)"/><option key="GROOVY" text="Groovy (guarded)"/></drop-down>
                        </default-field></field>
                        <field name="scriptProfile"><default-field title="JEXL profile">
                            <drop-down allow-empty="false"><option key="SCRIPT" text="SCRIPT (2 s, 2,000,000 units)"/><option key="EXPRESSION" text="EXPRESSION (250 ms, 100,000 units)"/></drop-down>
                        </default-field></field>
                        <field name="scriptBody"><default-field title="Script"><text-area rows="8" cols="90"/></default-field></field>
                        <field name="inputJson"><default-field title="Input (JSON)"><text-area rows="4" cols="90"/></default-field></field>
                        <field name="runButton"><default-field title=""><submit text="Run on the lane" btn-type="primary"/></default-field></field>
                    </form-single>
                </widgets>
            </section>

            <section name="LastResult" condition="lastRun">
                <widgets>
                    <label text="Result" type="h4"/>
                    <container-box>
                        <box-header><label text="${runVerdict} · ${lastRun.ranAt}"/></box-header>
                        <box-body>
                            <label text="${runNumbers}" type="p"/>
                            <label text="Result:" type="p" style="text-muted"/>
                            <label text="${runResultJson}" type="pre"/>
                            <label text="Error: ${runErrorText}" type="p"/>
                            <label text="Script log:" type="p" style="text-muted"/>
                            <section-iterate name="RunLogs" list="runLogs" entry="logLine"><widgets><label text="${logLine}" type="pre"/></widgets></section-iterate>
                            <label text="(no log lines)" type="p" style="text-muted" condition="!runLogs"/>
                        </box-body>
                    </container-box>
                </widgets>
            </section>
        </container>
    </widgets>
</screen>
