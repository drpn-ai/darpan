    <darpan.rule.Rule ruleId="GORJANA_R16_STATUS" ruleSetId="GORJANA_CANCELLED_RETURN_RS" sequenceNum="10"
            ruleText="statusId = status" enabled="Y" ruleType="FIELD_COMPARISON" severity="WARN"
            companyUserGroupId="GORJANA">
        <expression>{"type":"FIELD_COMPARISON","file1FieldPath":"statusId","file2FieldPath":"status","operator":"="}</expression>
        <ruleLogic><![CDATA[rule "GORJANA_R16_STATUS"
when
    $m : Map(this["file1"] != null, this["file2"] != null)
    eval(!java.util.Objects.equals(((Map) $m.get("file1")).get("statusId"), ((Map) $m.get("file2")).get("status")))
then
    Object _file1Value = ((Map) $m.get("file1")).get("statusId");
    Object _file2Value = ((Map) $m.get("file2")).get("status");
    reconciliation.rule.RuleDiffSupport.addFieldMismatch(
        $m,
        kcontext.getRule().getName(),
        "statusId = status",
        _file1Value,
        _file2Value,
        "WARN",
        "Field comparison failed: statusId = status"
    );
end]]></ruleLogic>
    </darpan.rule.Rule>

