<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="build" noun="RunCompletedPayload" authenticate="false">
        <description>Build the Google Chat text payload for a completed reconciliation run.</description>
        <in-parameters>
            <parameter name="companyUserGroupId"/>
            <parameter name="companyLabel"/>
            <parameter name="runName"/>
            <parameter name="savedRunId"/>
            <parameter name="reconciliationRunId"/>
            <parameter name="reconciliationRunResultId"/>
            <parameter name="reconciliationMappingId"/>
            <parameter name="ruleSetId"/>
            <parameter name="resultDataManagerPath"/>
            <parameter name="file1SystemLabel"/>
            <parameter name="file1Label"/>
            <parameter name="file1SystemEnumId"/>
            <parameter name="file2SystemLabel"/>
            <parameter name="file2Label"/>
            <parameter name="file2SystemEnumId"/>
            <parameter name="differenceCount"/>
            <parameter name="onlyInFile1Count"/>
            <parameter name="onlyInFile2Count"/>
            <!-- Audit 2026-06-11 #5: surface rule failures / processing warnings so a silently broken
                 ruleset does not produce a normal "completed" alert. -->
            <parameter name="statusEnumId"/>
            <parameter name="processingWarnings" type="List"/>
            <parameter name="terminationReason"/>
            <!-- UAT 2026-07-31: a run that died before producing any result has no counts to report.
                 The standard body ("run completed" + "Differences: 0") reads as a clean sync for those,
                 which is worse than silence — this switches to a did-not-complete body instead. -->
            <parameter name="noOutputProduced" type="Boolean" default-value="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="payload" type="Map"/>
        </out-parameters>
        <actions>
            <set field="notificationContext" from="[companyUserGroupId: companyUserGroupId, companyLabel: companyLabel, runName: runName, savedRunId: savedRunId, reconciliationRunId: reconciliationRunId, reconciliationRunResultId: reconciliationRunResultId, reconciliationMappingId: reconciliationMappingId, ruleSetId: ruleSetId, resultDataManagerPath: resultDataManagerPath, file1SystemLabel: file1SystemLabel, file1Label: file1Label, file1SystemEnumId: file1SystemEnumId, file2SystemLabel: file2SystemLabel, file2Label: file2Label, file2SystemEnumId: file2SystemEnumId]"/>
            <set field="tenantLabelValue" from="((companyLabel)?.toString()?.trim()) ?: darpan.facade.common.TenantAccessSupport.resolveTenantLabelForUserGroupId(ec, companyUserGroupId)"/>
            <set field="runNameValue" from="((runName)?.toString()?.trim()) ?: ((savedRunId)?.toString()?.trim()) ?: ((reconciliationRunId)?.toString()?.trim()) ?: 'reconciliation run'"/>
            <set field="resultIdValue" from="((reconciliationRunResultId)?.toString()?.trim())"/>
            <set field="resultUrl" from="darpan.reconciliation.notification.TenantNotificationSupport.buildRunResultUrl(ec, notificationContext)"/>
            <set field="file1SystemLabelValue" from="darpan.reconciliation.notification.TenantNotificationSupport.resolveFileSystemLabel(ec, notificationContext, 'file1', null)"/>
            <set field="file2SystemLabelValue" from="darpan.reconciliation.notification.TenantNotificationSupport.resolveFileSystemLabel(ec, notificationContext, 'file2', null)"/>
            <set field="differenceCountValue" from="differenceCount == null ? '0' : (differenceCount instanceof Number ? ((Number) differenceCount).intValue().toString() : (((differenceCount)?.toString()?.trim()) ?: '0'))"/>
            <set field="onlyInFile1CountValue" from="onlyInFile1Count == null ? '0' : (onlyInFile1Count instanceof Number ? ((Number) onlyInFile1Count).intValue().toString() : (((onlyInFile1Count)?.toString()?.trim()) ?: '0'))"/>
            <set field="onlyInFile2CountValue" from="onlyInFile2Count == null ? '0' : (onlyInFile2Count instanceof Number ? ((Number) onlyInFile2Count).intValue().toString() : (((onlyInFile2Count)?.toString()?.trim()) ?: '0'))"/>
            <set field="warningList" from="(processingWarnings instanceof java.util.List ? processingWarnings : []).collect { ((it)?.toString()?.trim()) }.findAll { it }"/>
            <set field="runFailed" from="((statusEnumId)?.toString()?.trim()) == 'AUT_STAT_FAILED'"/>
            <set field="noOutput" from="runFailed &amp;&amp; noOutputProduced == true"/>
            <set field="headerPrefix" from="noOutput ? 'Darpan run FAILED: ' :
                    ((runFailed || warningList) ? 'Darpan run completed WITH ISSUES: ' : 'Darpan run completed: ')"/>
            <set field="lines" from="[headerPrefix + runNameValue]"/>
            <if condition="noOutput">
                <set field="ignoreLine" from="lines.add('⚠ Status: FAILED — the run did not finish and produced no results. Nothing was reconciled.')"/>
            </if>
            <if condition="runFailed &amp;&amp; !noOutput">
                <set field="ignoreLine" from="lines.add('⚠ Status: FAILED — the ruleset did not fully evaluate; results may be incomplete.')"/>
            </if>
            <set field="terminationReasonValue" from="((terminationReason)?.toString()?.trim())"/>
            <if condition="terminationReasonValue">
                <set field="ignoreLine" from="lines.add('⚠ ' + terminationReasonValue)"/>
            </if>
            <if condition="tenantLabelValue">
                <set field="ignoreLine" from="lines.add('Tenant: ' + tenantLabelValue)"/>
            </if>
            <if condition="resultIdValue">
                <set field="ignoreLine" from="lines.add('Result ID: ' + resultIdValue)"/>
            </if>
            <if condition="resultUrl">
                <set field="ignoreLine" from="lines.add('Run result: &lt;' + resultUrl + '|Open run result&gt;')"/>
            </if>
            <!-- Counts are omitted entirely for a no-output failure: zeros there are not "no differences",
                 they are "never computed", and an operator cannot tell those apart from the numbers. -->
            <if condition="!noOutput">
                <set field="ignoreLine" from="lines.add('Differences: ' + differenceCountValue)"/>
                <set field="ignoreLine" from="lines.add('Only in ' + (file1SystemLabelValue ?: 'File 1') + ': ' + onlyInFile1CountValue)"/>
                <set field="ignoreLine" from="lines.add('Only in ' + (file2SystemLabelValue ?: 'File 2') + ': ' + onlyInFile2CountValue)"/>
            </if>
            <if condition="warningList">
                <set field="ignoreLine" from="lines.add('Warnings (' + warningList.size() + '): ' + warningList.take(3).join('; ') + (warningList.size() > 3 ? ' …' : ''))"/>
            </if>
            <set field="payload" from="[text: lines.join('\n')]"/>
        </actions>
    </service>

    <service verb="migrate" noun="TenantNotificationSettings" authenticate="false">
        <description>One-time v1.2.0 upgrade: copy each tenant's TenantNotificationSetting webhook into a
            TenantChatSpace named 'Default space' and link that tenant's automations (without a space) to it.
            Idempotent — tenants that already have any chat space are skipped. Internal only, not remote.</description>
        <out-parameters>
            <parameter name="migratedTenantCount" type="Integer"/>
            <parameter name="linkedAutomationCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="migratedTenantCount" from="0"/>
            <set field="linkedAutomationCount" from="0"/>
            <set field="settingRows" from="ec.entity.find('darpan.reconciliation.TenantNotificationSetting').disableAuthz().useCache(false).list() ?: []"/>
            <iterate list="settingRows" entry="settingRow">
                <set field="tenantIdValue" from="((settingRow.companyUserGroupId)?.toString()?.trim())"/>
                <set field="webhookValue" from="((settingRow.googleChatWebhookUrl)?.toString()?.trim())"/>
                <set field="existingSpaceCount" from="tenantIdValue ? ec.entity.find('darpan.reconciliation.TenantChatSpace').condition('companyUserGroupId', tenantIdValue).disableAuthz().useCache(false).count() : 1"/>
                <if condition="tenantIdValue &amp;&amp; webhookValue &amp;&amp; existingSpaceCount == 0">
                    <service-call name="create#darpan.reconciliation.TenantChatSpace" out-map="createdSpace"
                            in-map="[companyUserGroupId: tenantIdValue, spaceName: 'Default space', googleChatWebhookUrl: webhookValue, isActive: ((settingRow.isActive)?.toString()?.trim()) ?: 'Y', createdByUserId: settingRow.createdByUserId, createdDate: ec.user.nowTimestamp, lastUpdatedDate: ec.user.nowTimestamp]"/>
                    <set field="migratedTenantCount" from="migratedTenantCount + 1"/>
                    <set field="automationRows" from="ec.entity.find('darpan.reconciliation.ReconciliationAutomation').condition('companyUserGroupId', tenantIdValue).disableAuthz().useCache(false).list() ?: []"/>
                    <iterate list="automationRows" entry="automationRow">
                        <if condition="!((automationRow.chatSpaceId)?.toString()?.trim())">
                            <set field="ignoreSet" from="automationRow.set('chatSpaceId', createdSpace.chatSpaceId)"/>
                            <set field="ignoreUpdate" from="automationRow.update()"/>
                            <set field="linkedAutomationCount" from="linkedAutomationCount + 1"/>
                        </if>
                    </iterate>
                </if>
            </iterate>
        </actions>
    </service>

    <!-- Task 13 fix round 1, Critical 2: originally named facade.ReconciliationFacadeServices.migrate#
         AutomationExcludeFilters with allow-remote="true"/authenticate="true". data/SecuritySeedData.xml
         warns that facade.* is an auto-grant trap — the facade.* ArtifactGroupMember grants AUTHZA_ALL
         to every tenant tier, so any authenticated user (including a view-only member of one tenant)
         could invoke a cross-tenant migration and read the global automationsScanned count. Moved out of
         facade.* and matched to this file's own migrate#TenantNotificationSettings posture: authenticate
         ="false", no allow-remote (defaults false, so it is not reachable via /rpc/json at all). -->
    <service verb="migrate" noun="AutomationExcludeFilters" authenticate="false" transaction="ignore">
        <description>One-time backfill: copy each ruleset-backed automation's exclusion filters from its
            rule set into the automation's own snapshot, across every tenant. Idempotent — a side that
            already has filter rows is left untouched. Run once after deploying exclusion filters;
            automations created afterwards are seeded at save time and do not need it. Internal only, not
            remote: this reads and writes across every tenant with no per-request authorization check, so
            it must be invoked from a trusted internal/admin path, never exposed to the SPA or
            /rpc/json.</description>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="automationsScanned" type="Integer"/>
            <parameter name="automationsSkipped" type="Integer"/>
            <parameter name="sidesSeeded" type="Integer"/>
            <parameter name="rowsCreated" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="backfillResult" from="darpan.facade.reconciliation.AutomationFacadeSupport.backfillAutomationExcludeFilters(ec)"/>
            <set field="automationsScanned" from="backfillResult.automationsScanned"/>
            <set field="automationsSkipped" from="backfillResult.automationsSkipped"/>
            <set field="sidesSeeded" from="backfillResult.sidesSeeded"/>
            <set field="rowsCreated" from="backfillResult.rowsCreated"/>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
            <message>Backfilled ${rowsCreated} exclusion filter rows across ${sidesSeeded} source sides (${automationsScanned} automations scanned, ${automationsSkipped} skipped).</message>
        </actions>
    </service>

</services>
