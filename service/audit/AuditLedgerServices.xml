<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- DAR-BE-089. The findings ledger's two writers. Only a scheduled check calls them: the external API has no
         mutations, so nothing an agent does can found, keep or close a finding.

         Tenant. A scheduled run executes as _NA_ with authz disabled and no active tenant in the user context
         (AutomationExecutionSupport.executeAutomation), so the DARPAN_ACTIVE_COMPANY_SCOPE filter does not apply
         here. Every find therefore carries an explicit companyUserGroupId condition, the check must belong to
         the caller's tenant before anything is written, and no find puts the tenant beside a full primary key
         (Moqui drops non-PK conditions on a one() by PK). authenticate="false" and allow-remote="false" as
         sweep#RuleChildTenantStamps: internal only, and no disable-authz site is added.

         Call order for one check on one morning: record#CheckFindings with what the check reported, then
         close#ResolvedFindings with every record key the check looked at. Closing reads "not reported this
         morning" as lastSeenDate before reportDate, so it must run after recording. -->

    <service verb="record" noun="CheckFindings" authenticate="false" allow-remote="false">
        <description>Writes one check's reported findings for one morning. A record seen for the first time becomes
            a new finding (event found). A known open or pending finding seen on a later morning is stillOpen, and a
            fixed one reported again is reopened with its first-found day kept. A second call on the same morning
            refreshes the evidence and writes no event, so a rerun never double-counts. State is pending while the
            finding is younger than the check's graceDays, open after. Records and evidence checks are replaced, so
            they always show the latest read. Each record's systemEnumId is stored as its ROOT system, never the
            endpoint. Every finding is validated before anything is written.</description>
        <in-parameters>
            <parameter name="companyUserGroupId" required="true"/>
            <parameter name="checkId" required="true"/>
            <parameter name="reportDate" type="Date" required="true">
                <description>The morning the check ran, as a tenant calendar day.</description></parameter>
            <parameter name="checkStamp" type="Timestamp" default="ec.user.nowTimestamp"/>
            <parameter name="period">
                <description>DAR-BE-091. The period whose run this is, e.g. 2026-10 on Nov 3 while October is extended. Blank:
                    the report day's own period. A past period must still be running (extended).</description></parameter>
            <parameter name="findings" type="List">
                <description>One Map per (statement, record): statementCode, recordKey, headline (all required);
                    ruleText, expectedAmount, actualAmount, currencyUomId, expectedSource, actualSource,
                    conclusionEnumId, diagnosisText; records [{systemEnumId, recordType, recordId, internalId, recordStatus}];
                    checks [{label, passed (Boolean), value}].</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="findingIds" type="List"/>
            <parameter name="foundCount" type="Integer"/>
            <parameter name="stillOpenCount" type="Integer"/>
            <parameter name="reopenedCount" type="Integer"/>
            <parameter name="refreshedCount" type="Integer"/>
        </out-parameters>
        <actions>
            <service-call name="audit.AuditLedgerServices.get#TenantCheck" in-map="[companyUserGroupId:companyUserGroupId, checkId:checkId]" out-map="tenantCheck"/>
            <if condition="ec.message.hasError()"><return/></if>
            <set field="runWindow" from="darpan.audit.AuditReportAssembler.resolveCheckRun(ec, companyUserGroupId, tenantCheck.auditIds, reportDate.toLocalDate(), period)"/>
            <if condition="runWindow.error">
                <return error="true" message="Audit check ${checkId}: ${runWindow.error}"/></if>
            <set field="period" from="runWindow.period"/>
            <set field="graceDays" from="(tenantCheck.check.graceDays ?: 0) as int"/>
            <set field="statementIdByCode" from="tenantCheck.statementIdByCode"/>
            <set field="findings" from="findings ?: []"/>

            <!-- Validate everything first: a bad row writes nothing. -->
            <iterate list="findings" entry="f">
                <if condition="!f.statementCode || !f.recordKey || !f.headline">
                    <return error="true" message="Every finding needs statementCode, recordKey and headline (check ${checkId})"/></if>
                <if condition="!statementIdByCode[f.statementCode]">
                    <return error="true" message="Check ${checkId} does not test statement ${f.statementCode}"/></if>
                <set field="fRecords" from="f.records ?: []"/>
                <iterate list="fRecords" entry="r">
                    <if condition="!r.systemEnumId || !r.recordType || !r.recordId">
                        <return error="true" message="A record of finding ${f.recordKey} needs systemEnumId, recordType and recordId"/></if>
                    <entity-find-one entity-name="moqui.basic.Enumeration" value-field="systemEnum" cache="true">
                        <field-map field-name="enumId" from="r.systemEnumId"/></entity-find-one>
                    <if condition="systemEnum?.enumTypeId != 'DarpanSystemSource'">
                        <return error="true" message="Unknown system ${r.systemEnumId} on finding ${f.recordKey}"/></if>
                </iterate>
            </iterate>

            <set field="findingIds" from="[]"/>
            <set field="foundCount" from="0" type="Integer"/>
            <set field="stillOpenCount" from="0" type="Integer"/>
            <set field="reopenedCount" from="0" type="Integer"/>
            <set field="refreshedCount" from="0" type="Integer"/>
            <iterate list="findings" entry="f">
                <set field="statementId" from="statementIdByCode[f.statementCode]"/>
                <entity-find entity-name="darpan.audit.AuditFinding" list="existingList" for-update="true">
                    <econdition field-name="companyUserGroupId"/>
                    <econdition field-name="checkId"/>
                    <econdition field-name="statementId"/>
                    <econdition field-name="period"/>
                    <econdition field-name="recordKey" from="f.recordKey"/>
                </entity-find>
                <set field="eventTypeEnumId" from="null"/>
                <if condition="existingList">
                    <set field="finding" from="existingList[0]"/>
                    <if condition="finding.stateEnumId == 'AUDFS_FIXED'">
                        <set field="eventTypeEnumId" value="AUDFE_REOPENED"/>
                        <set field="reopenedCount" from="reopenedCount + 1"/>
                        <set field="finding.timesSeen" from="(finding.timesSeen ?: 0) + 1"/>
                        <set field="finding.lastSeenDate" from="reportDate"/>
                        <set field="finding.closedStamp" from="null"/>
                        <set field="finding.closedByTypeEnumId" from="null"/>
                        <set field="finding.closedById" from="null"/>
                        <else-if condition="finding.lastSeenDate &lt; reportDate">
                            <set field="eventTypeEnumId" value="AUDFE_STILL_OPEN"/>
                            <set field="stillOpenCount" from="stillOpenCount + 1"/>
                            <set field="finding.timesSeen" from="(finding.timesSeen ?: 0) + 1"/>
                            <set field="finding.lastSeenDate" from="reportDate"/>
                        </else-if>
                        <else><set field="refreshedCount" from="refreshedCount + 1"/></else>
                    </if>
                    <else>
                        <entity-make-value value-field="finding" entity-name="darpan.audit.AuditFinding"/>
                        <entity-sequenced-id-primary value-field="finding"/>
                        <set field="finding.companyUserGroupId" from="companyUserGroupId"/>
                        <set field="finding.checkId" from="checkId"/>
                        <set field="finding.statementId" from="statementId"/>
                        <set field="finding.recordKey" from="f.recordKey"/>
                        <set field="finding.period" from="period"/>
                        <set field="finding.firstFoundDate" from="reportDate"/>
                        <set field="finding.lastSeenDate" from="reportDate"/>
                        <set field="finding.timesSeen" from="1"/>
                        <set field="eventTypeEnumId" value="AUDFE_FOUND"/>
                        <set field="foundCount" from="foundCount + 1"/>
                    </else>
                </if>

                <!-- Grace age: days from first found to this morning, against the check's graceDays. -->
                <set field="ageDays" from="reportDate.toLocalDate().toEpochDay() - finding.firstFoundDate.toLocalDate().toEpochDay()"/>
                <set field="finding.stateEnumId" from="ageDays &lt; graceDays ? 'AUDFS_PENDING' : 'AUDFS_OPEN'"/>
                <set field="finding.headline" from="f.headline"/>
                <set field="finding.ruleText" from="f.ruleText"/>
                <set field="finding.expectedAmount" from="f.expectedAmount != null ? new BigDecimal(f.expectedAmount.toString()) : null"/>
                <set field="finding.actualAmount" from="f.actualAmount != null ? new BigDecimal(f.actualAmount.toString()) : null"/>
                <set field="finding.differenceAmount" from="finding.expectedAmount != null &amp;&amp; finding.actualAmount != null ? finding.actualAmount - finding.expectedAmount : null"/>
                <set field="finding.currencyUomId" from="f.currencyUomId"/>
                <set field="finding.expectedSource" from="f.expectedSource"/>
                <set field="finding.actualSource" from="f.actualSource"/>
                <set field="finding.conclusionEnumId" from="f.conclusionEnumId"/>
                <set field="finding.diagnosisText" from="f.diagnosisText"/>
                <set field="finding.lastCheckedStamp" from="checkStamp"/>
                <entity-create value-field="finding" or-update="true"/>

                <!-- The latest read replaces the last one's records and evidence checks. -->
                <entity-delete-by-condition entity-name="darpan.audit.AuditFindingRecord">
                    <econdition field-name="findingId" from="finding.findingId"/>
                    <econdition field-name="companyUserGroupId"/></entity-delete-by-condition>
                <entity-delete-by-condition entity-name="darpan.audit.AuditFindingCondition">
                    <econdition field-name="findingId" from="finding.findingId"/>
                    <econdition field-name="companyUserGroupId"/></entity-delete-by-condition>
                <set field="recordSeq" from="0"/>
                <set field="fRecords" from="f.records ?: []"/>
                <iterate list="fRecords" entry="r">
                    <set field="recordSeq" from="recordSeq + 1"/>
                    <entity-find-one entity-name="moqui.basic.Enumeration" value-field="systemEnum" cache="true">
                        <field-map field-name="enumId" from="r.systemEnumId"/></entity-find-one>
                    <entity-make-value value-field="findingRecord" entity-name="darpan.audit.AuditFindingRecord"
                            map="[findingId:finding.findingId, recordSeqId:String.format('%02d', recordSeq),
                                  companyUserGroupId:companyUserGroupId, systemEnumId:(systemEnum.parentEnumId ?: systemEnum.enumId),
                                  recordType:r.recordType, recordId:r.recordId?.toString(), internalId:r.internalId?.toString(),
                                  recordStatus:r.recordStatus]"/>
                    <entity-create value-field="findingRecord"/>
                </iterate>
                <set field="checkSeq" from="0"/>
                <set field="fChecks" from="f.checks ?: []"/>
                <iterate list="fChecks" entry="c">
                    <set field="checkSeq" from="checkSeq + 1"/>
                    <entity-make-value value-field="findingCheck" entity-name="darpan.audit.AuditFindingCondition"
                            map="[findingId:finding.findingId, sequenceNum:checkSeq, companyUserGroupId:companyUserGroupId,
                                  label:c.label, passed:(c.passed ? 'Y' : 'N'), checkValue:c.value?.toString()]"/>
                    <entity-create value-field="findingCheck"/>
                </iterate>

                <if condition="eventTypeEnumId">
                    <service-call name="audit.AuditLedgerServices.create#FindingEvent"
                            in-map="[companyUserGroupId:companyUserGroupId, findingId:finding.findingId, checkId:checkId,
                                     eventTypeEnumId:eventTypeEnumId, eventStamp:checkStamp, eventDate:reportDate]"/>
                </if>
                <script>findingIds.add(finding.findingId)</script>
            </iterate>
        </actions>
    </service>

    <service verb="close" noun="ResolvedFindings" authenticate="false" allow-remote="false">
        <description>Marks fixed every open or pending finding of one check whose record the check looked at this
            morning (examinedRecordKeys) and did not report (lastSeenDate before reportDate). Runs only when the check
            ran over complete reads: a partial or not-run check closes NOTHING, because a record missing from a
            partial read is not evidence that it was fixed. In v1 only a scheduled check closes a finding.</description>
        <in-parameters>
            <parameter name="companyUserGroupId" required="true"/>
            <parameter name="checkId" required="true"/>
            <parameter name="reportDate" type="Date" required="true"/>
            <parameter name="checkStamp" type="Timestamp" default="ec.user.nowTimestamp"/>
            <parameter name="period">
                <description>DAR-BE-091. The period whose run this is, e.g. 2026-10 on Nov 3 while October is extended. Blank:
                    the report day's own period. A past period must still be running (extended).</description></parameter>
            <parameter name="checkStatusEnumId" required="true">
                <description>AuditCheckStatus of this morning's check; only AUDCS_RAN closes anything.</description></parameter>
            <parameter name="examinedRecordKeys" type="List">
                <description>Every record key the check looked at this morning, reported or not.</description></parameter>
            <parameter name="reportedRecordKeys" type="List">
                <description>DAR-BE-118. The record keys this run reported (record#CheckFindings). Given: a finding closes when
                    this run examined its record and did not report it, so a later run the same morning closes what an
                    earlier one raised. Blank: "not reported" is read as lastSeenDate before reportDate.</description></parameter>
            <parameter name="explanations" type="Map">
                <description>DAR-BE-118. recordKey -> {conclusionEnumId, diagnosisText, headline}: why this run did not report
                    it (a conclusion the statement does not count). The closed finding keeps it.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="closedFindingIds" type="List"/>
            <parameter name="closedCount" type="Integer"/>
            <parameter name="skippedReason"/>
        </out-parameters>
        <actions>
            <service-call name="audit.AuditLedgerServices.get#TenantCheck" in-map="[companyUserGroupId:companyUserGroupId, checkId:checkId]"
                    out-map="tenantCheck"/>
            <if condition="ec.message.hasError()"><return/></if>
            <set field="runWindow" from="darpan.audit.AuditReportAssembler.resolveCheckRun(ec, companyUserGroupId, tenantCheck.auditIds, reportDate.toLocalDate(), period)"/>
            <if condition="runWindow.error">
                <return error="true" message="Audit check ${checkId}: ${runWindow.error}"/></if>
            <set field="period" from="runWindow.period"/>
            <set field="closedFindingIds" from="[]"/>
            <set field="closedCount" from="0" type="Integer"/>
            <if condition="checkStatusEnumId != 'AUDCS_RAN'">
                <set field="skippedReason" value="Check ${checkId} status is ${checkStatusEnumId}; only a check that ran over complete reads closes findings."/>
                <return/>
            </if>
            <set field="examined" from="new HashSet((examinedRecordKeys ?: [])*.toString())"/>
            <set field="reported" from="new HashSet((reportedRecordKeys ?: [])*.toString())"/>
            <entity-find entity-name="darpan.audit.AuditFinding" list="candidates" for-update="true">
                <econdition field-name="companyUserGroupId"/>
                <econdition field-name="checkId"/>
                <econdition field-name="period"/>
                <econdition field-name="stateEnumId" operator="in" from="['AUDFS_OPEN', 'AUDFS_PENDING']"/>
                <econdition field-name="lastSeenDate" operator="less" from="reportDate" ignore="reportedRecordKeys != null"/>
            </entity-find>
            <iterate list="candidates" entry="finding">
                <if condition="examined.contains(finding.recordKey) &amp;&amp; !reported.contains(finding.recordKey)">
                    <set field="why" from="explanations?.get(finding.recordKey)"/>
                    <if condition="why">
                        <set field="finding.conclusionEnumId" from="why.conclusionEnumId"/>
                        <set field="finding.diagnosisText" from="why.diagnosisText"/>
                        <set field="finding.headline" from="why.headline ?: finding.headline"/>
                    </if>
                    <set field="finding.stateEnumId" value="AUDFS_FIXED"/>
                    <set field="finding.closedStamp" from="checkStamp"/>
                    <set field="finding.closedByTypeEnumId" value="AUDAT_CHECK"/>
                    <set field="finding.closedById" from="checkId"/>
                    <set field="finding.lastCheckedStamp" from="checkStamp"/>
                    <entity-update value-field="finding"/>
                    <service-call name="audit.AuditLedgerServices.create#FindingEvent"
                            in-map="[companyUserGroupId:companyUserGroupId, findingId:finding.findingId, checkId:checkId,
                                     eventTypeEnumId:'AUDFE_FIXED', eventStamp:checkStamp, eventDate:reportDate]"/>
                    <script>closedFindingIds.add(finding.findingId)</script>
                    <set field="closedCount" from="closedCount + 1"/>
                </if>
            </iterate>
        </actions>
    </service>

    <service verb="record" noun="CheckRun" authenticate="false" allow-remote="false">
        <description>DAR-BE-090 / DAR-BE-091. Records how one check ran on one morning, over which window, with one source
            read per extract, and the check's
            status derived from them. Every read complete: ran. Any read partial or failed: partial, with each bad read
            named in the reason. notRunReason given, or no reads at all: notRun. The returned checkStatusEnumId is
            what close#ResolvedFindings must be given, so a partial read can never close a finding. A second call the
            same morning replaces the first run's status and reads.</description>
        <in-parameters>
            <parameter name="companyUserGroupId" required="true"/>
            <parameter name="checkId" required="true"/>
            <parameter name="reportDate" type="Date" required="true"/>
            <parameter name="period">
                <description>DAR-BE-091. The period whose run this is, e.g. 2026-10 on Nov 3 while October is extended. Blank:
                    the report day's own period. A past period must still be running (extended).</description></parameter>
            <parameter name="windowFromDate" type="Date">
                <description>First day the window covered. Blank: the period's first day (the 1st for a monthly audit), so
                    the run re-examines every open finding of the period.</description></parameter>
            <parameter name="windowThruDate" type="Date">
                <description>Last day the window covered, inclusive. Blank: reportDate, or a past period's last day.</description></parameter>
            <parameter name="runStamp" type="Timestamp" default="ec.user.nowTimestamp"/>
            <parameter name="notRunReason">
                <description>Set when the check did not run (no saved run configured, the run errored before
                    reading). The check is notRun and any reads are kept for the record.</description></parameter>
            <parameter name="sourceReads" type="List">
                <description>One Map per extract: systemEnumId (an endpoint or a root system), statusEnumId
                    (AUDSR_COMPLETE / AUDSR_PARTIAL / AUDSR_FAILED), recordCount, readStamp, reason.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="checkRunId"/>
            <parameter name="period"/>
            <parameter name="checkStatusEnumId"/>
            <parameter name="reason"/>
        </out-parameters>
        <actions>
            <service-call name="audit.AuditLedgerServices.get#TenantCheck" in-map="[companyUserGroupId:companyUserGroupId, checkId:checkId]"
                    out-map="tenantCheck"/>
            <if condition="ec.message.hasError()"><return/></if>
            <set field="sourceReads" from="sourceReads ?: []"/>
            <set field="runWindow" from="darpan.audit.AuditReportAssembler.resolveCheckRun(ec, companyUserGroupId, tenantCheck.auditIds, reportDate.toLocalDate(), period)"/>
            <if condition="runWindow.error">
                <return error="true" message="Audit check ${checkId}: ${runWindow.error}"/></if>
            <set field="period" from="runWindow.period"/>
            <set field="windowFromDate" from="windowFromDate ?: java.sql.Date.valueOf(runWindow.from)"/>
            <set field="windowThruDate" from="windowThruDate ?: java.sql.Date.valueOf(runWindow.thru)"/>
            <if condition="windowFromDate &gt; windowThruDate">
                <return error="true" message="Audit check ${checkId}: window ${windowFromDate} to ${windowThruDate} runs backwards"/></if>

            <!-- Validate first: a bad read writes nothing. -->
            <set field="badReads" from="[]"/>
            <iterate list="sourceReads" entry="sr">
                <entity-find-one entity-name="moqui.basic.Enumeration" value-field="systemEnum" cache="true">
                    <field-map field-name="enumId" from="sr.systemEnumId"/></entity-find-one>
                <if condition="systemEnum?.enumTypeId != 'DarpanSystemSource'">
                    <return error="true" message="Unknown system ${sr.systemEnumId} on a source read of check ${checkId}"/></if>
                <if condition="!(sr.statusEnumId in ['AUDSR_COMPLETE', 'AUDSR_PARTIAL', 'AUDSR_FAILED'])">
                    <return error="true" message="Source read status ${sr.statusEnumId} is not an AuditSourceRead status"/></if>
                <if condition="sr.statusEnumId != 'AUDSR_COMPLETE'">
                    <set field="rootSystemId" from="systemEnum.parentEnumId ?: systemEnum.enumId"/>
                    <script>badReads.add("The ${darpan.audit.AuditReportAssembler.systemKey(rootSystemId)} read ${sr.statusEnumId == 'AUDSR_FAILED' ? 'failed' : 'was partial'}: ${sr.reason ?: 'no reason was given'}.".toString())</script>
                </if>
            </iterate>

            <if condition="notRunReason">
                <set field="checkStatusEnumId" value="AUDCS_NOT_RUN"/>
                <set field="reason" from="notRunReason"/>
                <else-if condition="!sourceReads">
                    <set field="checkStatusEnumId" value="AUDCS_NOT_RUN"/>
                    <set field="reason" value="The check recorded no source read."/>
                </else-if>
                <else-if condition="badReads">
                    <set field="checkStatusEnumId" value="AUDCS_PARTIAL"/>
                    <set field="reason" from="badReads.join(' ')"/>
                </else-if>
                <else>
                    <set field="checkStatusEnumId" value="AUDCS_RAN"/>
                    <set field="reason" from="null"/>
                </else>
            </if>

            <entity-find entity-name="darpan.audit.AuditCheckRun" list="existingRuns" for-update="true">
                <econdition field-name="companyUserGroupId"/>
                <econdition field-name="checkId"/>
                <econdition field-name="period"/>
                <econdition field-name="reportDate"/>
            </entity-find>
            <if condition="existingRuns">
                <set field="checkRun" from="existingRuns[0]"/>
                <entity-delete-by-condition entity-name="darpan.audit.AuditSourceRead">
                    <econdition field-name="checkRunId" from="checkRun.checkRunId"/>
                    <econdition field-name="companyUserGroupId"/></entity-delete-by-condition>
                <else>
                    <entity-make-value value-field="checkRun" entity-name="darpan.audit.AuditCheckRun"/>
                    <entity-sequenced-id-primary value-field="checkRun"/>
                    <set field="checkRun.companyUserGroupId" from="companyUserGroupId"/>
                    <set field="checkRun.checkId" from="checkId"/>
                    <set field="checkRun.reportDate" from="reportDate"/>
                    <set field="checkRun.period" from="period"/>
                </else>
            </if>
            <set field="checkRun.windowFromDate" from="windowFromDate"/>
            <set field="checkRun.windowThruDate" from="windowThruDate"/>
            <set field="checkRun.statusEnumId" from="checkStatusEnumId"/>
            <set field="checkRun.reason" from="reason"/>
            <set field="checkRun.runStamp" from="runStamp"/>
            <entity-create value-field="checkRun" or-update="true"/>
            <set field="checkRunId" from="checkRun.checkRunId"/>

            <set field="readSeq" from="0"/>
            <iterate list="sourceReads" entry="sr">
                <set field="readSeq" from="readSeq + 1"/>
                <entity-find-one entity-name="moqui.basic.Enumeration" value-field="systemEnum" cache="true">
                    <field-map field-name="enumId" from="sr.systemEnumId"/></entity-find-one>
                <entity-make-value value-field="sourceRead" entity-name="darpan.audit.AuditSourceRead"
                        map="[checkRunId:checkRunId, readSeqId:String.format('%02d', readSeq), companyUserGroupId:companyUserGroupId,
                              systemEnumId:(systemEnum.parentEnumId ?: systemEnum.enumId), endpointEnumId:systemEnum.enumId,
                              statusEnumId:sr.statusEnumId, recordCount:(sr.recordCount != null ? sr.recordCount as Long : null),
                              readStamp:sr.readStamp, reason:sr.reason]"/>
                <entity-create value-field="sourceRead"/>
            </iterate>
        </actions>
    </service>

    <service verb="get" noun="TenantCheck" authenticate="false" allow-remote="false">
        <description>The check, if it belongs to the tenant, and its statements' codes. Fails closed: a check owned by
            another tenant, or one that tests no statement, is an error.</description>
        <in-parameters>
            <parameter name="companyUserGroupId" required="true"/>
            <parameter name="checkId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="check" type="Map"/>
            <parameter name="statementIdByCode" type="Map"/>
            <parameter name="auditIds" type="List"><description>DAR-BE-091. The audits the check's statements belong to.</description></parameter>
        </out-parameters>
        <actions>
            <entity-find entity-name="darpan.audit.AuditCheck" list="checkList">
                <econdition field-name="checkId"/>
                <econdition field-name="companyUserGroupId"/>
            </entity-find>
            <if condition="!checkList">
                <return error="true" message="Audit check ${checkId} does not belong to tenant ${companyUserGroupId}"/></if>
            <set field="check" from="checkList[0].getMap()"/>
            <entity-find entity-name="darpan.audit.AuditStatementCheck" list="links">
                <econdition field-name="checkId"/>
                <econdition field-name="companyUserGroupId"/>
            </entity-find>
            <if condition="!links">
                <return error="true" message="Audit check ${checkId} tests no statement"/></if>
            <entity-find entity-name="darpan.audit.AuditStatement" list="statements">
                <econdition field-name="statementId" operator="in" from="links*.statementId"/>
                <econdition field-name="companyUserGroupId"/>
            </entity-find>
            <!-- DAR-BE-103. Codes are unique within an audit, so one check testing R4 of two audits could not tell them
                 apart from a statementCode: refuse it rather than file a finding under the wrong audit. -->
            <set field="sharedCodes" from="statements*.statementCode.countBy { it }.findAll { it.value &gt; 1 }.keySet()"/>
            <if condition="sharedCodes">
                <return error="true" message="Audit check ${checkId} tests two statements coded ${sharedCodes.join(', ')}; a check's statements need distinct codes"/></if>
            <set field="statementIdByCode" from="statements.collectEntries { [(it.statementCode): it.statementId] }"/>
            <set field="auditIds" from="statements*.auditId.unique()"/>
        </actions>
    </service>

    <service verb="create" noun="FindingEvent" authenticate="false" allow-remote="false">
        <description>Appends one history row, by the scheduled check.</description>
        <in-parameters>
            <parameter name="companyUserGroupId" required="true"/>
