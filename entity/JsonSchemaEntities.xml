<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="JsonSchema" package="darpan.reconciliation" use="configuration">
        <description>Stores JSON Schemas for reconciliation.</description>
        <field name="jsonSchemaId" type="id" is-pk="true"/>
        <field name="schemaName" type="text-medium" enable-audit-log="true"/>
        <field name="description" type="text-long"/>
        <field name="systemEnumId" type="id">
            <description>Reconciliation system enumeration ID for this schema.</description>
        </field>
        <field name="ownerUserId" type="id">
            <description>Owning pilot user for shared-tenant customer scope; blank rows remain super-admin only.</description>
        </field>
        <field name="companyUserGroupId" type="id">
            <description>Company scope for shared-tenant company access. Blank rows are treated as unassigned legacy data.</description>
        </field>
        <field name="createdByUserId" type="id">
            <description>User who created the schema record.</description>
        </field>
        <field name="schemaText" type="text-very-long"/>
        <field name="statusId" type="id"/>
        <field name="createdDate" type="date-time"/>

        
        <!-- Audit H1.6 / H12.7 — was unique on schemaName alone (global), which made schemaName a
             cross-tenant scarce resource: tenant A creating 'orders.json' would block tenant B from
             creating their own 'orders.json'. Now composite-unique on (companyUserGroupId, schemaName)
             so each tenant has its own namespace. See data/releases/2.1.1/MIGRATION.md for the DDL
             that operators must run on existing production databases to convert the index. -->
        <index name="JSON_SCHEMA_TENANT_NAME" unique="true">
            <index-field name="companyUserGroupId"/>
            <index-field name="schemaName"/>
        </index>

        <relationship type="one" title="System" related="moqui.basic.Enumeration" fk-name="JSONSCHEMA_SYS_ENUM">
            <key-map field-name="systemEnumId" related-field-name="enumId"/>
        </relationship>
        <relationship type="one" title="Company" related="moqui.security.UserGroup" fk-name="JSONSCHEMA_COMPANY_GRP">
            <key-map field-name="companyUserGroupId" related-field-name="userGroupId"/>
        </relationship>
    </entity>
</entities>
