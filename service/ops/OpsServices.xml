<?xml version="1.0" encoding="UTF-8"?>
<!-- DAR-BE-015. Store for the Darpan-only error card, the error log and the daily error email. Internal: called by
     darpan.ops.ErrorChatSupport, darpan.ops.ErrorLogCapture and darpan.ops.ErrorDigestSupport. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="record" noun="RunErrorNotice" authenticate="anonymous-all" allow-remote="false" transaction="force-new">
        <description>Claims the (tenantId, subjectKey, runDay, triggerType) card slot. isNew is false when that slot already has a
            card (nothing is written). Otherwise the row is created and priorDays lists the subject's earlier scheduled card days within 60 days, newest
            first, so the caller can count a streak.</description>
        <in-parameters>
            <parameter name="tenantId" required="true"/>
            <parameter name="subjectKey" required="true"/>
            <parameter name="runDay" type="Date" required="true"/>
            <parameter name="triggerType" required="true"/>
            <parameter name="errorKind"/>
            <parameter name="executionId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="isNew" type="Boolean"/>
            <parameter name="priorDays" type="List"><parameter name="priorDay" type="Date"/></parameter>
        </out-parameters>
        <actions>
            <set field="isNew" from="false"/>
            <set field="priorDays" from="[]"/>
            <entity-find-one entity-name="darpan.ops.RunErrorNotice" value-field="existing" cache="false">
                <field-map field-name="tenantId"/><field-map field-name="subjectKey"/><field-map field-name="runDay"/><field-map field-name="triggerType"/>
            </entity-find-one>
            <if condition="existing == null">
                <set field="earliest" from="java.sql.Date.valueOf(runDay.toLocalDate().minusDays(60))"/>
                <entity-find entity-name="darpan.ops.RunErrorNotice" list="earlier">
                    <econdition field-name="tenantId"/><econdition field-name="subjectKey"/>
                    <econdition field-name="triggerType" value="scheduled"/>
                    <econdition field-name="runDay" operator="less" from="runDay"/>
                    <econdition field-name="runDay" operator="greater-equals" from="earliest"/>
                    <order-by field-name="-runDay"/>
                </entity-find>
                <set field="priorDays" from="earlier.collect { it.runDay }"/>
                <entity-make-value entity-name="darpan.ops.RunErrorNotice" value-field="notice"/>
                <set field="notice.tenantId" from="tenantId"/>
                <set field="notice.subjectKey" from="subjectKey"/>
                <set field="notice.runDay" from="runDay"/>
                <set field="notice.triggerType" from="triggerType"/>
                <set field="notice.errorKind" from="errorKind"/>
                <set field="notice.executionId" from="executionId"/>
                <set field="notice.postedDate" from="ec.user.nowTimestamp"/>
                <entity-create value-field="notice"/>
                <set field="isNew" from="true"/>
            </if>
        </actions>
    </service>

    <service verb="add" noun="ErrorLogEntries" authenticate="anonymous-all" allow-remote="false" transaction="force-new">
        <description>Adds flushed ERROR log aggregates into their (fingerprint, logDay) rows: count added, first and last seen
            widened, the row's first sample kept. Internal: called by darpan.ops.ErrorLogCapture.flush, always in its own transaction.</description>
        <in-parameters>
            <parameter name="entries" type="List" required="true"><parameter name="entry" type="Map"/></parameter>
        </in-parameters>
        <actions>
            <iterate list="entries" entry="entry">
                <entity-find-one entity-name="darpan.ops.ErrorLogEntry" value-field="row" cache="false" for-update="true">
                    <field-map field-name="fingerprint" from="entry.fingerprint"/><field-map field-name="logDay" from="entry.logDay"/>
                </entity-find-one>
                <if condition="row == null">
                    <entity-make-value entity-name="darpan.ops.ErrorLogEntry" value-field="row" map="entry"/>
                    <entity-create value-field="row"/>
                    <else>
                        <set field="row.count" from="(row.count ?: 0) + (entry.count ?: 0)"/>
                        <if condition="entry.firstSeen != null &amp;&amp; (row.firstSeen == null || entry.firstSeen &lt; row.firstSeen)">
                            <set field="row.firstSeen" from="entry.firstSeen"/></if>
                        <if condition="entry.lastSeen != null &amp;&amp; (row.lastSeen == null || entry.lastSeen &gt; row.lastSeen)">
                            <set field="row.lastSeen" from="entry.lastSeen"/></if>
                        <if condition="!row.tenantId &amp;&amp; entry.tenantId"><set field="row.tenantId" from="entry.tenantId"/></if>
                        <entity-update value-field="row"/>
                    </else>
                </if>
            </iterate>
        </actions>
    </service>
    <service verb="purge" noun="ErrorLogEntries" authenticate="anonymous-all" allow-remote="false">
        <description>Deletes the ErrorLogEntry rows whose logDay is more than 30 days before today (UTC). Internal: called by
            ops.ErrorDigestServices.flush#ErrorLog.</description>
        <in-parameters>
            <parameter name="nowStamp" type="Timestamp" default="ec.user.nowTimestamp"/>
        </in-parameters>
        <out-parameters><parameter name="purged" type="Integer"/></out-parameters>
        <actions>
            <set field="oldest" from="java.sql.Date.valueOf(nowStamp.toInstant().atZone(java.time.ZoneOffset.UTC).toLocalDate().minusDays(30))"/>
            <set field="purged" from="(ec.entity.find('darpan.ops.ErrorLogEntry').condition('logDay', org.moqui.entity.EntityCondition.LESS_THAN, oldest).deleteAll() ?: 0) as Integer"/>
        </actions>
    </service>

    <service verb="claim" noun="ErrorDigestDay" authenticate="anonymous-all" allow-remote="false" transaction="force-new">
        <description>Claims the daily error email's UTC day before anything is read or sent. isNew is false when the day already
            has a row (nothing is written). Otherwise the row is created with sentDate = nowStamp, and previousSentDate is the
            latest earlier day's sentDate (null when none), where the new email's window starts. Two callers at once: the
            second create fails on the key and that caller sends nothing.</description>
        <in-parameters>
            <parameter name="digestDay" type="Date" required="true"/>
            <parameter name="nowStamp" type="Timestamp" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="isNew" type="Boolean"/>
            <parameter name="previousSentDate" type="Timestamp"/>
        </out-parameters>
        <actions>
            <set field="isNew" from="false"/>
            <entity-find-one entity-name="darpan.ops.ErrorDigestSend" value-field="existing" cache="false">
                <field-map field-name="digestDay"/>
            </entity-find-one>
            <if condition="existing == null">
                <entity-find entity-name="darpan.ops.ErrorDigestSend" list="earlier" limit="1">
                    <econdition field-name="digestDay" operator="less" from="digestDay"/>
                    <econdition field-name="sentDate" operator="is-not-null"/>
                    <order-by field-name="-sentDate"/>
                </entity-find>
                <set field="previousSentDate" from="earlier ? earlier[0].sentDate : null"/>
                <entity-make-value entity-name="darpan.ops.ErrorDigestSend" value-field="send"/>
                <set field="send.digestDay" from="digestDay"/>
                <set field="send.claimedDate" from="ec.user.nowTimestamp"/>
                <set field="send.sentDate" from="nowStamp"/>
                <entity-create value-field="send"/>
                <set field="isNew" from="true"/>
            </if>
        </actions>
    </service>

    <service verb="finish" noun="ErrorDigestDay" authenticate="anonymous-all" allow-remote="false" transaction="force-new">
        <description>Records what the claimed day's email held. delivered false (no address, or the send failed) clears
            sentDate, so the next email covers this day again.</description>
        <in-parameters>
            <parameter name="digestDay" type="Date" required="true"/>
            <parameter name="delivered" type="Boolean" required="true"/>
            <parameter name="checksCount" type="Integer"/>
            <parameter name="logErrorsCount" type="Integer"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="darpan.ops.ErrorDigestSend" value-field="send" cache="false" for-update="true">
                <field-map field-name="digestDay"/>
            </entity-find-one>
            <if condition="send != null">
                <set field="send.checksCount" from="checksCount"/>
                <set field="send.logErrorsCount" from="logErrorsCount"/>
                <if condition="!delivered"><set field="send.sentDate" from="null"/></if>
                <entity-update value-field="send"/>
            </if>
        </actions>
    </service>
</services>
