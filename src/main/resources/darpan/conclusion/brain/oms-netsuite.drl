// DAR-BE-151: the oms-netsuite brain pack. Checked in and reviewed like code; tenants never write it.
// Layers: facts (Groovy, darpan.conclusion.brain.fact) -> each fact read once -> pieces -> causes about ONE subject
// -> one best-cause rule -> statements that only say whose cause a finding takes. Web: claude.ai/artifact/P5r3oxsGXV99mjGaBn5X2V
package darpan.conclusion.brain.omsnetsuite

import darpan.conclusion.brain.fact.Finding
import darpan.conclusion.brain.fact.Item
import darpan.conclusion.brain.fact.Order
import darpan.conclusion.brain.fact.Product
import darpan.conclusion.brain.fact.Payment
import darpan.conclusion.brain.fact.Return
import darpan.conclusion.brain.fact.ReplacementReturn
import darpan.conclusion.brain.fact.Ask
import darpan.conclusion.brain.fact.Answered
import darpan.conclusion.brain.fact.Cause
import darpan.conclusion.brain.fact.BestCause
import darpan.conclusion.brain.fact.Conclusion
import java.math.BigDecimal
import java.util.List

// @label / @value: how a fact reads in a finding's "how Darpan concluded" ({path} is a field path on the fact).
declare OrderNotInNetsuite
    @label("The order is not in NetSuite") @value("{order.orderId}")
    order : Order @key
end

declare TenderGivenBack
    @label("A tender was given back in full") @value("{tender} {amount}")
    order : Order @key
    tender : String @key
    amount : BigDecimal
end

declare PaymentsGivenBack
    @label("Every tender taken was given back") @value("{taken}")
    order : Order @key
    taken : BigDecimal
end

declare PartialPaymentGivenBack
    @label("Part of the order was paid and given back") @value("{taken} of {order.total}")
    order : Order @key
    taken : BigDecimal
end

declare ProductNotInNetsuite
    @label("The item's product has no NetSuite id in HotWax") @value("{product.sku}")
    product : Product @key
end

declare SoldOnRetiredSku
    @label("Sold on a retired -OLD SKU; its live SKU") @value("{product.sku} -> {liveSku}")
    product : Product @key
    liveSku : String
end

// DAR-BE-192: a replacement (an exchange or warranty replacement) HotWax holds until its return has a linked credit memo.
declare ReplacementWaitsOnItsReturn
    @label("Its return is still open in HotWax") @value("{ret.returnId} {ret.statusId} since {ret.entered}")
    order : Order @key
    ret : ReplacementReturn
end

declare ReturnRmaClosedNoMemo
    @label("Its return's RMA is closed in NetSuite, with no credit memo") @value("{ret.returnId}: {ret.rmaTranId} {ret.rmaStatus}")
    order : Order @key
    ret : ReplacementReturn
end

declare ReturnRmaNoMemo
    @label("Its return has an RMA in NetSuite and no credit memo") @value("{ret.returnId}: {ret.rmaTranId}")
    order : Order @key
    ret : ReplacementReturn
end

declare ReturnNotInNetsuite
    @label("Its return has no RMA in NetSuite") @value("{ret.returnId}")
    order : Order @key
    ret : ReplacementReturn
end

declare LostClaimNoMemo
    @label("Its lost-warranty claim has no credit memo in NetSuite") @value("{ret.returnId}")
    order : Order @key
    ret : ReplacementReturn
end

// DAR-BE-151 (Aditi 2026-11-06, R1; 2026-10-28, R2 F-100189): HotWax holds an exchange until its original order ships.
declare ExchangeWaitsOnOriginal
    @label("Its original order is not fulfilled in NetSuite") @value("{original.orderId}: {original.netsuiteTranId} {original.netsuiteStatus}")
    order : Order @key
    original : Order
end

declare PaymentsNotTheTotal
    @label("Its payments do not settle its total") @value("{settled} of {order.total}")
    order : Order @key
    settled : BigDecimal
end

// ---- each fact read once

rule "R1 sees the order not in NetSuite: no sales order line"
    @reads("Finding") @produces("OrderNotInNetsuite")
when
    Finding( kind == "orderLine", bucket == "MISSING_FROM_FILE_2", netsuiteHasOrderLine == false, $o : order, order != null )
then
    insertLogical( new OrderNotInNetsuite( $o ) );
end

rule "R2 sees the order not in NetSuite: no NETSUITE_ORDER_ID"
    @reads("Finding, Return, Order") @produces("OrderNotInNetsuite")
when
    Finding( kind == "return", bucket == "MISSING_FROM_FILE_2", $r : ret, ret != null )
    Return( this == $r, $o : order )
    Order( this == $o, netsuiteOrderId == null )
then
    insertLogical( new OrderNotInNetsuite( $o ) );
end

rule "R7 sees the order not in NetSuite: no sales order"
    @reads("Finding") @produces("OrderNotInNetsuite")
when
    Finding( kind == "order", bucket == "MISSING_FROM_FILE_2", $o : order, order != null )
then
    insertLogical( new OrderNotInNetsuite( $o ) );
end

// Per amount, not per row: two gift cards swiped (100 + 81) are given back only by 181 back to that tender. A row of the
// tender with no amount proves nothing.
rule "A tender taken was given back in full"
    @reads("Order, Payment") @produces("TenderGivenBack")
when
    $o : Order( paymentsComplete == true )
    Payment( order == $o, state == "SETTLED", $t : tender )
    not Payment( order == $o, tender == $t, amount == null )
    $taken : List() from collect( Payment( order == $o, tender == $t, state == "SETTLED" ) )
    $back : List() from collect( Payment( order == $o, tender == $t, state == "REFUNDED" ) )
then
    BigDecimal taken = Payment.sum( $taken );
    if (taken.compareTo( Payment.sum( $back ) ) == 0) { insertLogical( new TenderGivenBack( $o, $t, taken ) ); }
end

// ---- questions: asked only when an answer can still change a cause; the ask planner batches them across findings

rule "Ask for the payments of an order that never reached NetSuite"
    @reads("OrderNotInNetsuite, Answered") @asks("orderPayments") @mayEnable("CONC_PARTIAL_PAYMENT_GIVEN_BACK")
when
    OrderNotInNetsuite( $o : order )
    not Answered( question == "orderPayments", subject == $o )
then
    insertLogical( new Ask( "orderPayments", $o ) );
end

// DAR-BE-186: only for the items of an order NetSuite does not have; one read per 100 products, dropped when the order's
// best cause already outranks what the answer could unlock.
rule "Ask whether an item's product is known to NetSuite, when its order never reached NetSuite"
    @reads("OrderNotInNetsuite, Item, Answered") @asks("productNetsuiteId") @mayEnable("CONC_RETIRED_SKU,CONC_PRODUCT_NOT_IN_NETSUITE")
when
    OrderNotInNetsuite( $o : order )
    Item( order == $o, $p : product )
    not Answered( question == "productNetsuiteId", subject == $p )
then
    insertLogical( new Ask( "productNetsuiteId", $p, $o ) );
end

// DAR-BE-192: a replacement's name says it is one (EXC- an exchange, WTY- a warranty replacement); its return is found from it.
rule "Ask for the return a replacement was made for, when the replacement never reached NetSuite"
    @reads("OrderNotInNetsuite, Order, Answered") @asks("replacementReturn")
    @mayEnable("RET_OPEN,RMA_CLOSED,RMA_NO_MEMO,RET_NO_RMA,LOST_NO_MEMO,ORIG_OPEN")
when
    OrderNotInNetsuite( $o : order )
    Order( this == $o, name != null, name matches "(?i)(EXC|WTY)-.+" )
    not Answered( question == "replacementReturn", subject == $o )
then
    insertLogical( new Ask( "replacementReturn", $o ) );
end

rule "Ask NetSuite for the RMA of a replacement's completed return"
    @reads("OrderNotInNetsuite, ReplacementReturn, Answered") @asks("returnRma")
    @mayEnable("RMA_CLOSED,RMA_NO_MEMO,RET_NO_RMA")
when
    OrderNotInNetsuite( $o : order )
    $r : ReplacementReturn( replacement == $o, statusId == "RETURN_COMPLETED" )
    not Answered( question == "returnRma", subject == $r )
then
    insertLogical( new Ask( "returnRma", $r, $o ) );
end

rule "Ask NetSuite for the credit memo of a replacement's completed return"
    @reads("OrderNotInNetsuite, ReplacementReturn, Answered") @asks("returnMemo")
    @mayEnable("RMA_CLOSED,RMA_NO_MEMO,RET_NO_RMA,LOST_NO_MEMO")
when
    OrderNotInNetsuite( $o : order )
    $r : ReplacementReturn( replacement == $o, statusId == "RETURN_COMPLETED" )
    not Answered( question == "returnMemo", subject == $r )
then
    insertLogical( new Ask( "returnMemo", $r, $o ) );
end

// DAR-BE-151 (Aditi 2026-11-06: "when an exchange order is not in NS... check the parent order in the unfulfilled in NS
// list"): only for an exchange (EXC-) NetSuite does not have, once its return has named the original.
rule "Ask NetSuite for an exchange's original order, when the exchange never reached NetSuite"
    @reads("OrderNotInNetsuite, Order, ReplacementReturn, Answered") @asks("originalInNetsuite") @mayEnable("ORIG_OPEN")
when
    OrderNotInNetsuite( $o : order )
    Order( this == $o, name != null, name matches "(?i)EXC-.+" )
    ReplacementReturn( replacement == $o, $orig : original, original != null )
    not Answered( question == "originalInNetsuite", subject == $orig )
then
    insertLogical( new Ask( "originalInNetsuite", $orig, $o ) );
end

// ---- pieces

// Unfulfilled in NetSuite: Pending Approval, Pending Fulfillment, Partially Fulfilled or Pending Billing/Partially Fulfilled
// (gorjana 2026-11-06: M1191688 SO7352829 Pending Fulfillment, 2 lines backordered). Billed, Pending Billing (all shipped),
// Closed and Cancelled are not; an original NetSuite has no sales order for is not in the unfulfilled list either.
rule "An exchange waits on its original order, which NetSuite has not fulfilled"
    @reads("OrderNotInNetsuite, Order, ReplacementReturn, Answered") @produces("ExchangeWaitsOnOriginal")
when
    OrderNotInNetsuite( $o : order )
    Order( this == $o, name != null, name matches "(?i)EXC-.+" )
    ReplacementReturn( replacement == $o, $orig : original, original != null )
    Answered( question == "originalInNetsuite", subject == $orig )
    Order( this == $orig, netsuiteTranId != null, netsuiteStatus != null,
           netsuiteStatus matches "(?i).*(pending approval|pending fulfillment|partially fulfilled).*" )
then
    insertLogical( new ExchangeWaitsOnOriginal( $o, $orig ) );
end

rule "An item's product has no NetSuite id in HotWax"
    @reads("Product, Answered") @produces("ProductNotInNetsuite")
when
    $p : Product( netsuiteProductId == null )
    Answered( question == "productNetsuiteId", subject == $p )
then
    insertLogical( new ProductNotInNetsuite( $p ) );
end

// gorjana 2026-11-03: HotWax kept the old Shopify variant (238-007-G-OLD) beside the re-created product (238-007-G, same
// UPC), and only the live one carries the NetSuite id. Its live SKU is the same SKU without -OLD.
rule "A product with no NetSuite id is a retired -OLD SKU"
    @reads("ProductNotInNetsuite, Product") @produces("SoldOnRetiredSku")
when
    ProductNotInNetsuite( $p : product )
    Product( this == $p, sku != null, sku matches "(?i).+-OLD" )
then
    insertLogical( new SoldOnRetiredSku( $p, $p.getSku().replaceAll( "(?i)-OLD$", "" ) ) );
end

// DAR-BE-192 pieces: what a held replacement's return lacks. HotWax sends the replacement once its return has a linked memo.
rule "A replacement's own return is still open"
    @reads("OrderNotInNetsuite, ReplacementReturn") @produces("ReplacementWaitsOnItsReturn")
when
    OrderNotInNetsuite( $o : order )
    $r : ReplacementReturn( replacement == $o, statusId != "RETURN_COMPLETED" )
then
    insertLogical( new ReplacementWaitsOnItsReturn( $o, $r ) );
end

// gorjana M197605 / M215547 / M217621 (2026-11-04): NetSuite refuses to make a memo from a closed RMA ("invalid reference").
rule "A replacement's completed return has a closed RMA and no credit memo"
    @reads("OrderNotInNetsuite, ReplacementReturn, Answered") @produces("ReturnRmaClosedNoMemo")
when
    OrderNotInNetsuite( $o : order )
    $r : ReplacementReturn( replacement == $o, statusId == "RETURN_COMPLETED", rmaTranId != null, rmaStatus != null,
                            rmaStatus matches "(?i).*closed.*", memoTranId == null )
    Answered( question == "returnRma", subject == $r )
    Answered( question == "returnMemo", subject == $r )
then
    insertLogical( new ReturnRmaClosedNoMemo( $o, $r ) );
end

rule "A replacement's completed return has an RMA and no credit memo"
    @reads("OrderNotInNetsuite, ReplacementReturn, Answered") @produces("ReturnRmaNoMemo")
when
    OrderNotInNetsuite( $o : order )
    $r : ReplacementReturn( replacement == $o, statusId == "RETURN_COMPLETED", rmaTranId != null, memoTranId == null,
                            rmaStatus == null || rmaStatus not matches "(?i).*closed.*" )
    Answered( question == "returnRma", subject == $r )
    Answered( question == "returnMemo", subject == $r )
then
    insertLogical( new ReturnRmaNoMemo( $o, $r ) );
end

// A lost-warranty claim reaches NetSuite as a credit memo only, never an RMA (Aditi, F-104607).
rule "A replacement's completed return has no RMA and no credit memo"
    @reads("OrderNotInNetsuite, ReplacementReturn, Answered") @produces("ReturnNotInNetsuite")
when
    OrderNotInNetsuite( $o : order )
    $r : ReplacementReturn( replacement == $o, statusId == "RETURN_COMPLETED", rmaTranId == null, memoTranId == null,
                            channel == null || channel != "AFTSHP_HG_LOSS" )
    Answered( question == "returnRma", subject == $r )
    Answered( question == "returnMemo", subject == $r )
then
    insertLogical( new ReturnNotInNetsuite( $o, $r ) );
end

rule "A replacement's lost-warranty claim has no credit memo"
    @reads("OrderNotInNetsuite, ReplacementReturn, Answered") @produces("LostClaimNoMemo")
when
    OrderNotInNetsuite( $o : order )
    $r : ReplacementReturn( replacement == $o, statusId == "RETURN_COMPLETED", channel == "AFTSHP_HG_LOSS", memoTranId == null )
    Answered( question == "returnMemo", subject == $r )
then
    insertLogical( new LostClaimNoMemo( $o, $r ) );
end

// gorjana EXC-#GOR191697343-1 (958.50 against 288.19 of credit), EXC-#GOR192290196-1 (65.00, nothing paying it).
rule "A replacement's payments do not settle its total"
    @reads("OrderNotInNetsuite, Order, Payment") @produces("PaymentsNotTheTotal")
when
    OrderNotInNetsuite( $o : order )
    Order( this == $o, paymentsComplete == true, total != null, name != null, name matches "(?i)(EXC|WTY)-.+" )
    not Payment( order == $o, state == "SETTLED", amount == null )
    $settled : List() from collect( Payment( order == $o, state == "SETTLED" ) )
then
    BigDecimal paid = Payment.sum( $settled );
    if (paid.subtract( $o.getTotal() ).abs().compareTo( new BigDecimal( "0.01" ) ) >= 0) { insertLogical( new PaymentsNotTheTotal( $o, paid ) ); }
end

rule "Every tender taken was given back, and nothing else was"
    @reads("Order, Payment, TenderGivenBack") @produces("PaymentsGivenBack")
when
    $o : Order( paymentsComplete == true )
    exists Payment( order == $o, state == "SETTLED" )
    forall( $p : Payment( order == $o, state == "SETTLED" || state == "REFUNDED" )
            TenderGivenBack( order == $o, tender == $p.tender ) )
    not Payment( order == $o, state != "SETTLED", state != "REFUNDED", state != "CANCELLED" )
    not Payment( order == $o, state == "SETTLED", amount == null )
    $amounts : List() from collect( Payment( order == $o, state == "SETTLED" ) )
then
    insertLogical( new PaymentsGivenBack( $o, Payment.sum( $amounts ) ) );
end

rule "Less than the order total was taken"
    @reads("PaymentsGivenBack, Order") @produces("PartialPaymentGivenBack")
when
    PaymentsGivenBack( $o : order, $taken : taken )
    Order( this == $o, total != null, total > $taken )
then
    insertLogical( new PartialPaymentGivenBack( $o, $taken ) );
end

// ---- causes: each about one subject, written once

rule "Order cause · partial payment given back"
    @reads("OrderNotInNetsuite, PartialPaymentGivenBack") @concludes("CONC_PARTIAL_PAYMENT_GIVEN_BACK") @rank(80)
when
    $n : OrderNotInNetsuite( $o : order )
    $p : PartialPaymentGivenBack( order == $o )
then
    insertLogical( Cause.expected( $o, "CONC_PARTIAL_PAYMENT_GIVEN_BACK", 80, $n, $p ) );
end

rule "Order cause · sold on a retired SKU"
    @reads("OrderNotInNetsuite, Item, SoldOnRetiredSku") @concludes("CONC_RETIRED_SKU") @rank(66)
when
    $n : OrderNotInNetsuite( $o : order )
    Item( order == $o, $p : product )
    $r : SoldOnRetiredSku( product == $p )
then
    insertLogical( Cause.fix( $o, "CONC_RETIRED_SKU", 66, $n, $r ) );
end

rule "Order cause · product not in NetSuite"
    @reads("OrderNotInNetsuite, Item, ProductNotInNetsuite") @concludes("CONC_PRODUCT_NOT_IN_NETSUITE") @rank(65)
when
    $n : OrderNotInNetsuite( $o : order )
    Item( order == $o, $p : product )
    $q : ProductNotInNetsuite( product == $p )
then
    insertLogical( Cause.fix( $o, "CONC_PRODUCT_NOT_IN_NETSUITE", 65, $n, $q ) );
end

// DAR-BE-192 causes, about the replacement order: what its return lacks, most specific first.
// More specific than what the replacement's return lacks: the original has to ship first (rank 58 over 56-51).
rule "Order cause · an exchange waits on its original order"
    @reads("OrderNotInNetsuite, ExchangeWaitsOnOriginal") @concludes("ORIG_OPEN") @rank(58)
when
    $n : OrderNotInNetsuite( $o : order )
    $w : ExchangeWaitsOnOriginal( order == $o )
then
    insertLogical( Cause.fix( $o, "ORIG_OPEN", 58, $n, $w ) );
end

rule "Order cause · a replacement waits on its own return"
    @reads("OrderNotInNetsuite, ReplacementWaitsOnItsReturn") @concludes("RET_OPEN") @rank(56)
when
    $n : OrderNotInNetsuite( $o : order )
    $w : ReplacementWaitsOnItsReturn( order == $o )
then
    insertLogical( Cause.fix( $o, "RET_OPEN", 56, $n, $w ) );
end

rule "Order cause · a replacement's return RMA is closed, no memo"
    @reads("OrderNotInNetsuite, ReturnRmaClosedNoMemo") @concludes("RMA_CLOSED") @rank(55)
when
    $n : OrderNotInNetsuite( $o : order )
    $c : ReturnRmaClosedNoMemo( order == $o )
then
    insertLogical( Cause.fix( $o, "RMA_CLOSED", 55, $n, $c ) );
end

rule "Order cause · a replacement's return has an RMA, no memo"
    @reads("OrderNotInNetsuite, ReturnRmaNoMemo") @concludes("RMA_NO_MEMO") @rank(54)
when
    $n : OrderNotInNetsuite( $o : order )
    $m : ReturnRmaNoMemo( order == $o )
then
    insertLogical( Cause.fix( $o, "RMA_NO_MEMO", 54, $n, $m ) );
end

rule "Order cause · a replacement's return is not in NetSuite"
    @reads("OrderNotInNetsuite, ReturnNotInNetsuite") @concludes("RET_NO_RMA") @rank(53)
when
    $n : OrderNotInNetsuite( $o : order )
    $m : ReturnNotInNetsuite( order == $o )
then
    insertLogical( Cause.fix( $o, "RET_NO_RMA", 53, $n, $m ) );
end

rule "Order cause · a replacement's lost-warranty claim has no memo"
    @reads("OrderNotInNetsuite, LostClaimNoMemo") @concludes("LOST_NO_MEMO") @rank(52)
when
    $n : OrderNotInNetsuite( $o : order )
    $m : LostClaimNoMemo( order == $o )
then
    insertLogical( Cause.fix( $o, "LOST_NO_MEMO", 52, $n, $m ) );
end

rule "Order cause · a replacement is not paid for"
    @reads("OrderNotInNetsuite, PaymentsNotTheTotal") @concludes("REPL_UNPAID") @rank(51)
when
    $n : OrderNotInNetsuite( $o : order )
    $p : PaymentsNotTheTotal( order == $o )
then
    insertLogical( Cause.fix( $o, "REPL_UNPAID", 51, $n, $p ) );
end

// ---- one rule picks every subject's best cause

rule "The best cause about a subject"
    @reads("Cause") @produces("BestCause")
when
    $c : Cause( $s : subject, $r : rank )
    not Cause( subject == $s, rank > $r )
then
    insertLogical( new BestCause( $s, $c ) );
end

// ---- statements: whose cause a finding takes (line and return causes join here as they are ported)

rule "R1 · the order's cause, when NetSuite has no line for it"
    @reads("Finding, OrderNotInNetsuite, BestCause") @states("R1")
when
    $f : Finding( kind == "orderLine", bucket == "MISSING_FROM_FILE_2", $o : order, order != null )
    OrderNotInNetsuite( order == $o )
    BestCause( subject == $o, $c : cause )
then
    insert( Conclusion.of( $f, $c ) );
end

rule "R2 · its order's cause"
    @reads("Finding, Return, BestCause") @states("R2")
when
    $f : Finding( kind == "return", bucket == "MISSING_FROM_FILE_2", $r : ret, ret != null )
    Return( this == $r, $o : order )
    BestCause( subject == $o, $c : cause )
then
    insert( Conclusion.of( $f, $c ) );
end

// DAR-BE-192: R7 (gorjana "Every order HotWax approves reaches NetSuite within a day"): an approved order takes its cause.
rule "R7 · the order's cause, when HotWax approved it and NetSuite has no sales order"
    @reads("Finding, Order, OrderNotInNetsuite, BestCause") @states("R7")
when
    $f : Finding( kind == "order", bucket == "MISSING_FROM_FILE_2", $o : order, order != null )
    Order( this == $o, statusId == "ORDER_APPROVED" )
    OrderNotInNetsuite( order == $o )
    BestCause( subject == $o, $c : cause )
then
    insert( Conclusion.of( $f, $c ) );
end
