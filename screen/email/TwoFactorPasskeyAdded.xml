<?xml version="1.0" encoding="UTF-8"?>
<!-- DAR-BE-270 email body. No bold and no links (a link in a security email is the phishing shape). The not-you line stays plain: it is the security instruction.
     DAR-BE-298: wears EmailFrame (the app's light theme, like the audit email); copy follows the darpan-email skill. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false">
    <actions>
        <set field="frameOpen" from="darpan.email.EmailFrame.open('DARPAN · SECURITY')"/>
        <set field="frameClose" from="darpan.email.EmailFrame.close()"/>
    </actions>
    <widgets>
        <render-mode><text type="html" no-boundary-comment="true"><![CDATA[${frameOpen}]]></text></render-mode>
        <container style="dp-p"><label text="Hi ${firstName}, your Darpan account has a new passkey, &quot;${passkeyName}&quot;, added ${at}."/></container>
        <container style="dp-p"><label text="From now on it signs you in with a touch or a glance. No password, no code, no squinting at your phone."/></container>
        <container style="dp-note"><label text="Not you? Remove it in Darpan under User Settings, change your password, and tell your Darpan administrator."/></container>
        <container style="dp-sign"><label text="— Darpan"/></container>
        <render-mode><text type="html" no-boundary-comment="true"><![CDATA[${frameClose}]]></text></render-mode>
    </widgets>
</screen>
