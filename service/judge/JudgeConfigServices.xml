<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- DAR-BE-318 plan 2. The tenant-owned config the judge reads beside a moqui-rules decision (entity/JudgeEntities.xml).
         Every read finds by an explicit companyUserGroupId condition as well as the DARPAN_ACTIVE_COMPANY_SCOPE filter, and
         never by a bare primary key: another tenant's id reads as "does not exist". Neither service disables authz. -->

    <service verb="store" noun="DecisionOutcome" allow-remote="false">
        <description>Saves what one outcome of the active tenant's decision means. Refuses an outcome the decision does not
            list (rules.RuleSetOutcome of the same tenant).</description>
        <in-parameters>
            <parameter name="ruleSetId" required="true"/>
            <parameter name="outcomeId" required="true"/>
            <parameter name="outcomeKindEnumId" required="true"/>
            <parameter name="label" required="true"/>
            <parameter name="fixText"/>
            <parameter name="fixOwner"/>
            <parameter name="fixWhereEnumId"/>
        </in-parameters>
        <actions>
            <set field="tenantId" from="ec.user.context.activeTenantUserGroupId"/>
            <if condition="!tenantId || tenantId == '__NO_ACTIVE_TENANT__'">
                <return error="true" message="No active tenant"/></if>
            <entity-find entity-name="moqui.basic.Enumeration" list="kindList">
                <econdition field-name="enumId" from="outcomeKindEnumId"/>
                <econdition field-name="enumTypeId" value="JudgeOutcomeKind"/>
            </entity-find>
            <if condition="!kindList">
                <return error="true" message="Outcome kind ${outcomeKindEnumId} is not one of JOK_FINDING, JOK_EXPECTED, JOK_HIDDEN, JOK_SET_ASIDE"/></if>
            <if condition="fixWhereEnumId">
                <entity-find entity-name="moqui.basic.Enumeration" list="whereList">
                    <econdition field-name="enumId" from="fixWhereEnumId"/>
                    <econdition field-name="enumTypeId" value="DarpanSystemSource"/>
                </entity-find>
                <if condition="!whereList">
                    <return error="true" message="Fix system ${fixWhereEnumId} does not exist"/></if>
            </if>
            <entity-find entity-name="rules.RuleSetOutcome" list="listedList">
                <econdition field-name="ruleSetId" from="ruleSetId"/>
                <econdition field-name="outcomeId" from="outcomeId"/>
                <econdition field-name="companyUserGroupId" from="tenantId"/>
            </entity-find>
            <if condition="!listedList">
                <return error="true" message="Decision ${ruleSetId} does not list outcome ${outcomeId}"/></if>

            <entity-find entity-name="darpan.judge.DecisionOutcome" list="existingList">
                <econdition field-name="ruleSetId" from="ruleSetId"/>
                <econdition field-name="outcomeId" from="outcomeId"/>
                <econdition field-name="companyUserGroupId" from="tenantId"/>
            </entity-find>
            <if condition="existingList">
                <then>
                    <set field="existing" from="existingList[0]"/>
                    <set field="existing.outcomeKindEnumId" from="outcomeKindEnumId"/>
                    <set field="existing.label" from="label"/>
                    <set field="existing.fixText" from="fixText"/>
                    <set field="existing.fixOwner" from="fixOwner"/>
                    <set field="existing.fixWhereEnumId" from="fixWhereEnumId"/>
                    <script>existing.update()</script>
                </then>
                <else>
                    <service-call name="create#darpan.judge.DecisionOutcome" in-map="[ruleSetId:ruleSetId, outcomeId:outcomeId,
                            companyUserGroupId:tenantId, outcomeKindEnumId:outcomeKindEnumId, label:label, fixText:fixText,
                            fixOwner:fixOwner, fixWhereEnumId:fixWhereEnumId]"/>
                </else>
            </if>
        </actions>
    </service>

    <service verb="get" noun="CheckJudgeConfig" allow-remote="false">
        <description>Everything the judge reads for one of the active tenant's checks: its two decisions, the meaning of every
            outcome of those decisions that has one, its parameter sets and its asks. A check of another tenant does not exist.
            Read once per judging, never per batch of pairs.</description>
        <in-parameters>
            <parameter name="checkId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="mustHoldRuleSetId"/>
            <parameter name="explainsRuleSetId"/>
            <parameter name="outcomes" type="Map"><description>Keyed "ruleSetId|outcomeId": outcomeKindEnumId, label, fixText,
                fixOwner, fixWhereEnumId.</description></parameter>
            <parameter name="parameterSets" type="List"><description>Each: parameterSetId, label, parameters (name to value).</description></parameter>
            <parameter name="decisions" type="Map"><description>Keyed by ruleSetId, for each of the two decisions that is the
                active tenant's: firstMatchOnly, outcomeIds (the outcomes it lists) and readFields (every fact field its rules'
                lines read, a piece's lines included, sorted). A decision of another tenant, or one that does not exist, has no
                entry.</description></parameter>
            <parameter name="asks" type="List"><description>The check's CheckAsk rows by askName, as maps (AskSupport.fetchAsks
                takes them): askName, subjectSide, idField, systemEnumId, sourceConfigId, keyField, many, keepRecordFields.</description></parameter>
        </out-parameters>
        <actions>
            <set field="tenantId" from="ec.user.context.activeTenantUserGroupId"/>
            <if condition="!tenantId || tenantId == '__NO_ACTIVE_TENANT__'">
                <return error="true" message="No active tenant"/></if>
            <entity-find entity-name="darpan.audit.AuditCheck" list="checkList">
                <econdition field-name="checkId" from="checkId"/>
                <econdition field-name="companyUserGroupId" from="tenantId"/>
            </entity-find>
            <if condition="!checkList">
                <return error="true" message="Check ${checkId} does not exist"/></if>

            <set field="outcomes" from="[:]"/>
            <set field="parameterSets" from="[]"/>
            <set field="decisions" from="[:]"/>
            <entity-find entity-name="darpan.judge.CheckDecision" list="decisionList">
                <econdition field-name="checkId" from="checkId"/>
                <econdition field-name="companyUserGroupId" from="tenantId"/>
            </entity-find>
            <iterate list="decisionList" entry="decision">
                <if condition="decision.stageEnumId == 'CDS_MUST_HOLD'"><set field="mustHoldRuleSetId" from="decision.ruleSetId"/></if>
                <if condition="decision.stageEnumId == 'CDS_EXPLAINS'"><set field="explainsRuleSetId" from="decision.ruleSetId"/></if>
                <entity-find entity-name="darpan.judge.DecisionOutcome" list="outcomeList">
                    <econdition field-name="ruleSetId" from="decision.ruleSetId"/>
                    <econdition field-name="companyUserGroupId" from="tenantId"/>
                </entity-find>
                <iterate list="outcomeList" entry="outcome">
                    <script>outcomes.put(outcome.ruleSetId + '|' + outcome.outcomeId, [outcomeKindEnumId: outcome.outcomeKindEnumId,
                            label: outcome.label, fixText: outcome.fixText, fixOwner: outcome.fixOwner,
                            fixWhereEnumId: outcome.fixWhereEnumId])</script>
                </iterate>
                <!-- DAR-BE-318 Task 7: the judge refuses a decision whose shape is wrong before it runs one (ruling P2-17). -->
                <entity-find entity-name="rules.RuleSet" list="ruleSetList">
                    <econdition field-name="ruleSetId" from="decision.ruleSetId"/>
                    <econdition field-name="companyUserGroupId" from="tenantId"/>
                </entity-find>
                <if condition="ruleSetList">
                    <entity-find entity-name="rules.RuleSetOutcome" list="listedList">
                        <econdition field-name="ruleSetId" from="decision.ruleSetId"/>
                        <econdition field-name="companyUserGroupId" from="tenantId"/>
                        <order-by field-name="outcomeId"/>
                    </entity-find>
                    <!-- The fields its lines read: the judge warns when a Must hold decision reads no presence field (OC30). -->
                    <set field="readFields" from="new java.util.TreeSet()"/>
                    <entity-find entity-name="rules.RuleSetRule" list="ruleList">
                        <econdition field-name="ruleSetId" from="decision.ruleSetId"/>
                        <econdition field-name="companyUserGroupId" from="tenantId"/>
                    </entity-find>
                    <if condition="ruleList">
                        <entity-find entity-name="rules.RuleSetCondition" list="lineList">
                            <econdition field-name="ruleId" operator="in" from="ruleList*.ruleId"/>
                            <econdition field-name="companyUserGroupId" from="tenantId"/>
                        </entity-find>
                        <set field="pieceIds" from="lineList.findAll { it.conditionTypeId == 'RCT_PIECE' &amp;&amp; it.compareValue }*.compareValue"/>
                        <set field="pieceLineList" from="[]"/>
                        <if condition="pieceIds">
                            <entity-find entity-name="rules.RulePieceCondition" list="pieceLineList">
                                <econdition field-name="pieceId" operator="in" from="pieceIds"/>
                                <econdition field-name="companyUserGroupId" from="tenantId"/>
                            </entity-find>
                        </if>
                        <script>(lineList + pieceLineList).each { line -> [line.fieldName, line.compareFieldName].findAll { it }.each { readFields.add(it) } }</script>
                    </if>
                    <script>decisions.put(decision.ruleSetId, [firstMatchOnly: ruleSetList[0].firstMatchOnly,
                            outcomeIds: listedList.collect { it.outcomeId }, readFields: readFields as List])</script>
                </if>
            </iterate>

            <entity-find entity-name="darpan.judge.CheckParameterSet" list="setList">
                <econdition field-name="checkId" from="checkId"/>
                <econdition field-name="companyUserGroupId" from="tenantId"/>
                <order-by field-name="parameterSetId"/>
            </entity-find>
            <iterate list="setList" entry="parameterSet">
                <entity-find entity-name="darpan.judge.CheckParameter" list="parameterList">
                    <econdition field-name="checkId" from="checkId"/>
                    <econdition field-name="parameterSetId" from="parameterSet.parameterSetId"/>
                    <econdition field-name="companyUserGroupId" from="tenantId"/>
                    <order-by field-name="parameterName"/>
                </entity-find>
                <set field="parameters" from="new java.util.LinkedHashMap()"/>
                <iterate list="parameterList" entry="parameter">
                    <script>parameters.put(parameter.parameterName, parameter.parameterValue)</script>
                </iterate>
                <script>parameterSets.add([parameterSetId: parameterSet.parameterSetId, label: parameterSet.label, parameters: parameters])</script>
            </iterate>

            <entity-find entity-name="darpan.judge.CheckAsk" list="askList">
                <econdition field-name="checkId" from="checkId"/>
                <econdition field-name="companyUserGroupId" from="tenantId"/>
                <order-by field-name="askName"/>
            </entity-find>
            <set field="asks" from="askList.collect { it.getMap() }"/>
        </actions>
    </service>

    <service verb="check" noun="KeepRuleLines" allow-remote="false">
        <description>Runs before store#Rule saves a rule (KeepRule.secas.xml). A rule on one of the active tenant's Keep
            decisions (CheckDecision stage CDS_KEEP_FILE_1 or CDS_KEEP_FILE_2) is refused: no run reads a Keep decision (Aditi
            2026-11-28, DAR-OPS-029), so one saved would be checked and then silently ignored. Any other decision passes. The
            stage is read by an explicit companyUserGroupId condition, so another tenant's Keep decision never gates this
            tenant's rule.</description>
        <in-parameters>
            <parameter name="ruleSetId" required="true"/>
        </in-parameters>
        <actions>
            <set field="tenantId" from="ec.user.context.activeTenantUserGroupId"/>
            <if condition="!tenantId || tenantId == '__NO_ACTIVE_TENANT__'"><return/></if>
            <entity-find-count entity-name="darpan.judge.CheckDecision" count-field="keepCount">
                <econdition field-name="ruleSetId" from="ruleSetId"/>
                <econdition field-name="companyUserGroupId" from="tenantId"/>
                <econdition field-name="stageEnumId" operator="in" value="CDS_KEEP_FILE_1,CDS_KEEP_FILE_2"/>
            </entity-find-count>
            <if condition="keepCount &gt; 0">
                <return error="true" message="Keep decisions are not supported yet"/></if>
        </actions>
    </service>
</services>
