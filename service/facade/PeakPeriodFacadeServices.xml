    <service verb="save" noun="PeakPeriodSync" allow-remote="true" authenticate="true">
        <description>Replace one sync pair's override for a peak period. Allowance (15 minutes to 48 hours) and pulse (0, 60, 120, 180, 240 or 360 minutes; 0 is off for the period) are each null for normal; an omitted value clears that field.</description>
        <in-parameters>
            <parameter name="peakPeriodId" required="true"/>
            <parameter name="syncPairId" required="true"/>
            <parameter name="allowanceMinutes" type="Integer"/>
            <parameter name="pulseEveryMinutes" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <if condition="!tenantId"><message error="true">Active tenant is required for peak periods.</message></if>
            <if condition="!ec.message.hasError()">
                <set field="ignoreWriteAccess" from="darpan.facade.common.TenantAccessSupport.requireActiveTenantWriteAccess(ec, 'Your active tenant only has view access for peak periods.')"/>
            </if>
            <set field="peakPeriodIdValue" from="((peakPeriodId)?.toString()?.trim())"/>
            <set field="syncPairIdValue" from="((syncPairId)?.toString()?.trim())"/>
            <set field="periodRow" from="(!ec.message.hasError() &amp;&amp; peakPeriodIdValue) ? darpan.facade.common.TenantScopedFinder.findOneOwnedByTenant(ec, 'darpan.peak.PeakPeriod', 'peakPeriodId', peakPeriodIdValue, tenantId, 'peak period read for a sync override verified against the active tenant after a primary-key read') : null"/>
            <if condition="!ec.message.hasError() &amp;&amp; periodRow == null">
                <message error="true">Peak period '${peakPeriodIdValue}' was not found.</message>
            </if>
            <set field="pairRow" from="(!ec.message.hasError() &amp;&amp; syncPairIdValue) ? darpan.facade.common.TenantScopedFinder.findOneOwnedByTenant(ec, 'darpan.pulse.SyncPair', 'syncPairId', syncPairIdValue, tenantId, 'sync pair read for a peak override verified against the active tenant after a primary-key read') : null"/>
            <if condition="!ec.message.hasError() &amp;&amp; pairRow == null">
                <message error="true">Sync pair '${syncPairIdValue}' was not found.</message>
            </if>
            <if condition="!ec.message.hasError()">
                <set field="validationErrors" from="darpan.peak.PeakPeriodFacadeSupport.validateSync(allowanceMinutes, pulseEveryMinutes)"/>
                <iterate list="validationErrors" entry="validationError"><message error="true">${validationError}</message></iterate>
            </if>
            <if condition="!ec.message.hasError() &amp;&amp; pulseEveryMinutes != null &amp;&amp; pulseEveryMinutes > 0 &amp;&amp; !darpan.peak.PeakPeriodFacadeSupport.upstreamCanPulse(ec, tenantId, pairRow.getMap())">
                <message error="true">${darpan.pulse.SyncPulseFacadeSupport.E_UPSTREAM}</message>
            </if>
            <set field="pulseBlock" from="(!ec.message.hasError() &amp;&amp; pulseEveryMinutes != null &amp;&amp; pulseEveryMinutes > 0) ? darpan.peak.PeakPeriodFacadeSupport.pulseBlockOf(ec, tenantId, pairRow.getMap()) : null"/>
            <if condition="pulseBlock">
                <message error="true">${pulseBlock}</message>
            </if>
            <if condition="!ec.message.hasError()">
                <set field="ignoreReplace" from="darpan.peak.PeakPeriodFacadeSupport.replaceSync(ec, tenantId, peakPeriodIdValue, syncPairIdValue, allowanceMinutes, pulseEveryMinutes)"/>
                <message>Saved sync override.</message>
            </if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="delete" noun="PeakPeriodSync" allow-remote="true" authenticate="true">
        <description>Remove one sync pair's override for a peak period; a missing override is fine.</description>
        <in-parameters>
            <parameter name="peakPeriodId" required="true"/>
            <parameter name="syncPairId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <if condition="!tenantId"><message error="true">Active tenant is required for peak periods.</message></if>
            <if condition="!ec.message.hasError()">
                <set field="ignoreWriteAccess" from="darpan.facade.common.TenantAccessSupport.requireActiveTenantWriteAccess(ec, 'Your active tenant only has view access for peak periods.')"/>
            </if>
            <set field="peakPeriodIdValue" from="((peakPeriodId)?.toString()?.trim())"/>
            <set field="syncPairIdValue" from="((syncPairId)?.toString()?.trim())"/>
            <set field="periodRow" from="(!ec.message.hasError() &amp;&amp; peakPeriodIdValue) ? darpan.facade.common.TenantScopedFinder.findOneOwnedByTenant(ec, 'darpan.peak.PeakPeriod', 'peakPeriodId', peakPeriodIdValue, tenantId, 'peak period read for a sync override delete verified against the active tenant after a primary-key read') : null"/>
            <if condition="!ec.message.hasError() &amp;&amp; periodRow == null">
                <message error="true">Peak period '${peakPeriodIdValue}' was not found.</message>
            </if>
            <if condition="!ec.message.hasError()">
                <set field="ignoreDelete" from="darpan.peak.PeakPeriodFacadeSupport.deleteSync(ec, tenantId, peakPeriodIdValue, syncPairIdValue)"/>
                <message>Removed sync override.</message>
            </if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>
</services>
