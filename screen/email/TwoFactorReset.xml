<?xml version="1.0" encoding="UTF-8"?>
<!-- DAR-BE-264 email body. No bold and no links (a link in a security email is the phishing shape). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false">
    <widgets>
        <render-mode><text type="html"><![CDATA[<html><body>]]></text></render-mode>
        <container><label text="Hi ${firstName}, a Darpan administrator reset your two-factor on ${at}. Your authenticator app and recovery codes no longer work."/></container>
        <container><label text="Set two-factor up again at your next sign-in."/></container>
        <container><label text="Not expecting this? Tell your Darpan administrator now."/></container>
        <container><label text="— Darpan"/></container>
        <render-mode><text type="html"><![CDATA[</body></html>]]></text></render-mode>
    </widgets>
</screen>
