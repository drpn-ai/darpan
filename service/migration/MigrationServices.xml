<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- transaction="force-new" is the whole point of this service existing separately.
         Moqui marks the active transaction rollback-only when a service reports errors, so a ledger
         write sharing that transaction would be rolled back alongside the migration whose failure it
         records. force-new pauses the active transaction and commits this row independently.

         This differs from the getLoginKey forced-new transaction that deadlocked production: that
         one ran once per login against a contended shared row. This runs once per migration against
         a row keyed (migrationId, runId) that nothing else touches. -->
    <service verb="record" noun="MigrationRun" authenticate="false" allow-remote="false"
             transaction="force-new">
        <description>Write one DarpanMigrationRun ledger row. Internal: called by the supervisor,
            never by an operator directly.</description>
        <in-parameters>
            <parameter name="migrationId" required="true"/>
            <parameter name="statusId" required="true"/>
            <parameter name="startedDate" type="Timestamp"/>
            <parameter name="rowsAffected" type="Integer"/>
            <parameter name="messageDetail"/>
        </in-parameters>
        <out-parameters>
            <parameter name="runId"/>
        </out-parameters>
        <actions>
            <!-- required="true" passes a whitespace-only id, so trim and re-check here. -->
            <set field="migrationId" from="migrationId?.toString()?.trim()"/>
            <set field="statusId" from="statusId?.toString()?.trim()"/>
            <if condition="!migrationId || !statusId">
                <message error="true">record#MigrationRun requires migrationId and statusId</message>
                <return/>
            </if>

            <!-- One instant for both stamps, so a caller that passes no start records a zero-length attempt. -->
            <set field="recordedDate" from="ec.user.nowTimestamp"/>
            <!-- The short "DarpanMigrationRun" bank, not the full entity name entity-sequenced-id-primary
                 would use: every runId already in a client's ledger came from this bank, and a fresh one
                 would hand out ids that collide with them. -->
            <set field="runId" from="ec.entity.sequencedIdPrimary('DarpanMigrationRun', null, null)"/>
            <entity-make-value entity-name="darpan.migration.DarpanMigrationRun" value-field="ledgerRow" map="[
                    migrationId    : migrationId,
                    runId          : runId,
                    startedDate    : startedDate instanceof java.sql.Timestamp ? startedDate : recordedDate,
                    completedDate  : recordedDate,
                    appliedByUserId: ec.user.userId,
                    statusId       : statusId,
                    rowsAffected   : rowsAffected,
                    messageDetail  : darpan.migration.MigrationLedgerSupport.truncate(messageDetail)]"/>
            <entity-create value-field="ledgerRow"/>
        </actions>
    </service>

    <!-- transaction="ignore" on purpose: this service must not own a transaction that a failing
         migration can poison. Each migration runs in its own; each ledger row is written by
         record#MigrationRun in a forced-new one. -->
    <service verb="run" noun="PendingMigrations" authenticate="false" allow-remote="false"
             transaction="ignore">
        <description>Run every registered migration that has no SUCCESS ledger row, in sequenceNum
            order. Idempotent: a second run applies nothing. Not remote — an operator runs this from
            the Migrations screen, and it deliberately sweeps every tenant's data.</description>
        <in-parameters>
            <parameter name="dryRun" type="Boolean" default="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="results" type="List"><parameter name="result" type="Map"/></parameter>
            <parameter name="appliedCount" type="Integer"/>
            <parameter name="skippedCount" type="Integer"/>
            <parameter name="blockedCount" type="Integer"/>
            <parameter name="failedCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="results" from="darpan.migration.MigrationSupervisorSupport.runPending(ec, dryRun as boolean)"/>
            <set field="appliedCount" from="results.count { it.outcome == 'APPLIED' }"/>
            <set field="skippedCount" from="results.count { it.outcome == 'ALREADY_APPLIED' || it.outcome == 'NO_PREVIEW' }"/>
            <set field="blockedCount" from="results.count { it.outcome == 'BLOCKED' }"/>
            <set field="failedCount" from="results.count { it.outcome == 'FAILED' }"/>
            <set field="ok" from="failedCount == 0"/>
            <message>Applied ${appliedCount}, skipped ${skippedCount}, blocked ${blockedCount}, failed ${failedCount}.</message>
        </actions>
    </service>

    <service verb="list" noun="MigrationStatus" authenticate="false" allow-remote="false">
        <description>Registry and ledger state for every registered migration, in sequence order.
            Read-only; drives the Migrations screen.</description>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="migrations" type="List"><parameter name="migration" type="Map"/></parameter>
        </out-parameters>
        <actions>
            <set field="migrations" from="darpan.migration.MigrationSupervisorSupport.statusList(ec)"/>
            <set field="ok" from="!ec.message.hasError()"/>
        </actions>
    </service>

    <!-- Targeted remediation on one installation. Split preview from run into two service NAMES
         rather than a dryRun boolean: a dropped boolean defaults to false, and false is the branch
         that rewrites data. Two names on the wire cannot be confused that way. -->
    <service verb="run" noun="Migration" authenticate="false" allow-remote="false"
             transaction="ignore">
        <description>Run one named migration. Honours the same gates as the sweep: parked migrations
            are refused, prerequisites are enforced, and an already-applied migration is skipped
            unless force is set.</description>
        <in-parameters>
            <parameter name="migrationId" required="true"/>
            <parameter name="force" type="Boolean" default="false">
                <description>Re-run even when a SUCCESS row exists. For re-running an idempotent
                    backfill; never overrides prerequisites.</description>
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="outcome"><description>APPLIED | ALREADY_APPLIED | BLOCKED | FAILED | DISABLED | NOT_FOUND | NO_PREVIEW</description></parameter>
            <parameter name="runId"/>
            <parameter name="rowsAffected" type="Integer"/>
            <parameter name="detail"/>
        </out-parameters>
        <actions>
            <set field="result" from="darpan.migration.MigrationSupervisorSupport.runMigration(ec, migrationId, false, force as boolean)"/>
            <set field="outcome" from="result?.outcome"/>
            <set field="runId" from="result?.runId"/>
            <set field="rowsAffected" from="result?.rowsAffected"/>
            <set field="detail" from="result?.detail"/>
            <set field="ok" from="outcome == 'APPLIED' || outcome == 'ALREADY_APPLIED'"/>
        </actions>
    </service>

    <service verb="dryRun" noun="Migration" authenticate="false" allow-remote="false"
             transaction="ignore">
        <description>Preview one named migration. Writes a DRY_RUN ledger row, which never satisfies
            the already-applied check.</description>
        <in-parameters>
            <parameter name="migrationId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="outcome"/>
            <parameter name="runId"/>
            <parameter name="rowsAffected" type="Integer"/>
            <parameter name="detail"/>
        </out-parameters>
        <actions>
            <set field="result" from="darpan.migration.MigrationSupervisorSupport.runMigration(ec, migrationId, true, false)"/>
            <set field="outcome" from="result?.outcome"/>
            <set field="runId" from="result?.runId"/>
            <set field="rowsAffected" from="result?.rowsAffected"/>
            <set field="detail" from="result?.detail"/>
            <set field="ok" from="outcome != 'FAILED' &amp;&amp; outcome != 'NOT_FOUND'"/>
        </actions>
    </service>

    <service verb="set" noun="MigrationEnabled" authenticate="false" allow-remote="false">
        <description>Park or unpark a migration. Parking lets the rest of a sweep through when one
            migration is broken on an installation, instead of stranding the whole upgrade.</description>
        <in-parameters>
            <parameter name="migrationId" required="true"/>
            <parameter name="enabled" type="Boolean" required="true"/>
        </in-parameters>
        <out-parameters><parameter name="ok" type="Boolean"/></out-parameters>
        <actions>
            <!-- Installation-wide registry row (no companyUserGroupId, no EntityFilter): a plain find
                 under the caller's authz. cache="false" because this decides what the next sweep runs. -->
            <entity-find-one entity-name="darpan.migration.DarpanMigration" value-field="migration" cache="false">
                <field-map field-name="migrationId"/>
            </entity-find-one>
            <if condition="migration == null">
                <set field="ok" from="false"/>
                <message error="true">No registered migration with id ${migrationId}</message>
                <return/>
            </if>
            <set field="migration.enabled" from="enabled ? 'Y' : 'N'"/>
            <set field="migration.lastUpdatedDate" from="ec.user.nowTimestamp"/>
            <entity-update value-field="migration"/>
            <set field="ok" from="true"/>
        </actions>
    </service>

    <service verb="get" noun="MigrationHistory" authenticate="false" allow-remote="false">
        <description>Every recorded attempt at one migration, newest first, with its own failure
            detail. Read-only.</description>
        <in-parameters>
            <parameter name="migrationId" required="true"/>
            <parameter name="maxRows" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="attempts" type="List"><parameter name="attempt" type="Map"/></parameter>
        </out-parameters>
        <actions>
            <!-- A ledger row per retry means this list is unbounded; cap it at 50 unless asked. -->
            <set field="historyLimit" from="maxRows != null &amp;&amp; maxRows &gt; 0 ? maxRows : 50"/>
            <!-- Installation-wide ledger (no companyUserGroupId, no EntityFilter): a plain find under
                 the caller's authz. -->
            <entity-find entity-name="darpan.migration.DarpanMigrationRun" list="ledgerRows" limit="historyLimit">
                <econdition field-name="migrationId"/>
                <order-by field-name="-startedDate"/>
            </entity-find>
            <!-- Built key by key, not getValueMapList(): the admin wrapper serialises these maps as-is,
                 so the key set and its order are part of the wire shape. -->
            <set field="attempts" from="[]"/>
            <iterate list="ledgerRows" entry="ledgerRow">
                <script>attempts.add([runId          : ledgerRow.getString("runId"),
                                      statusId       : ledgerRow.getString("statusId"),
                                      startedDate    : ledgerRow.get("startedDate"),
                                      completedDate  : ledgerRow.get("completedDate"),
                                      appliedByUserId: ledgerRow.getString("appliedByUserId"),
                                      rowsAffected   : ledgerRow.get("rowsAffected"),
                                      messageDetail  : ledgerRow.getString("messageDetail")])</script>
            </iterate>
            <set field="ok" from="!ec.message.hasError()"/>
        </actions>
    </service>

</services>
