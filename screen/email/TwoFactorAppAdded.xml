<?xml version="1.0" encoding="UTF-8"?>
<!-- DAR-BE-264 (review M2) email body. No bold and no links (a link in a security email is the phishing shape). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false">
    <widgets>
        <render-mode><text type="html"><![CDATA[<html><body>]]></text></render-mode>
        <container><label text="Hi ${firstName}, an authenticator app was set up for your Darpan account on ${at}. Its codes can now be used to sign in."/></container>
        <container><label text="Not you? Change your password and tell your Darpan administrator, who can reset your two-factor."/></container>
        <container><label text="— Darpan"/></container>
        <render-mode><text type="html"><![CDATA[</body></html>]]></text></render-mode>
    </widgets>
</screen>
