<?xml version="1.0" encoding="UTF-8"?>
<!-- DAR-BE-264 email body. No bold and no links (a link in a security email is the phishing shape). The not-you line stays plain: it is the security instruction.
     DAR-BE-298: wears EmailFrame (the app's light theme, like the audit email); copy follows the darpan-email skill. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false">
    <actions>
        <set field="frameOpen" from="darpan.email.EmailFrame.open('DARPAN · SECURITY')"/>
        <set field="frameClose" from="darpan.email.EmailFrame.close()"/>
    </actions>
    <widgets>
        <render-mode><text type="html" no-boundary-comment="true"><![CDATA[${frameOpen}]]></text></render-mode>
        <container style="dp-p"><label text="Hi ${firstName}, a recovery code got you into Darpan on ${at}. That's what they're for."/></container>
        <container style="dp-p"><label text="You have ${recoveryCodesLeft} left. When you're down to the last few, make a fresh set in User Settings."/></container>
        <container style="dp-note"><label text="Not you? Change your password now and tell your Darpan administrator."/></container>
        <container style="dp-sign"><label text="— Darpan"/></container>
        <render-mode><text type="html" no-boundary-comment="true"><![CDATA[${frameClose}]]></text></render-mode>
    </widgets>
</screen>
