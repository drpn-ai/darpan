<?xml version="1.0" encoding="UTF-8"?>
<!-- DAR-BE-028 email body. Plain on purpose: no bold, and no links, because a link in a reset email is the
     phishing shape users should learn to distrust, and a code needs none. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false">
    <widgets>
        <render-mode><text type="html"><![CDATA[<html><body>]]></text></render-mode>
        <container><label text="The Darpan password for ${username} was changed on ${changedAt}."/></container>
        <container><label text="Not you? Tell your Darpan administrator now."/></container>
        <render-mode><text type="html"><![CDATA[</body></html>]]></text></render-mode>
    </widgets>
</screen>
