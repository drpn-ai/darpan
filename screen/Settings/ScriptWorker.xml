<?xml version="1.0" encoding="UTF-8"?>
<!-- Script Worker: shows where scripts run (worker URL, caller token set or not, live /health) and runs a script
     through run#TenantScript, the same service the app uses; writes nothing. Super-admin only. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Script Worker" require-authentication="true">

    <parameter name="example"/>
    <parameter name="savedId"/>

    <!-- NOTE: throw, not return error, Moqui still runs a transition's actions after an always-actions error message -->
    <always-actions>
        <if condition="!darpan.facade.common.TenantAccessSupport.isSuperAdmin(ec)">
            <script>throw new org.moqui.context.ArtifactAuthorizationException('The script worker screen is limited to super-admin users.')</script>
        </if>
    </always-actions>

    <transition name="chooseTenant">
        <actions>
            <if condition="!darpan.facade.common.TenantAccessSupport.isSuperAdmin(ec)"><return error="true" message="Super-admin only."/></if>
            <service-call name="facade.AuthFacadeServices.save#ActiveTenant" in-map="[activeTenantUserGroupId: activeTenantUserGroupId]"/>
        </actions>
        <default-response url="."/>
    </transition>

    <transition name="runScript">
        <actions>
            <if condition="!darpan.facade.common.TenantAccessSupport.isSuperAdmin(ec)"><return error="true" message="Super-admin only."/></if>
            <!-- a loaded saved script runs by its id -->
            <service-call name="facade.TenantScriptFacadeServices.run#TenantScript" out-map="runOut"
                    in-map="[tenantScriptId: tenantScriptId ?: null, scriptProfile: scriptProfile, scriptBody: scriptBody, inputSource: 'SAMPLE', inputJson: inputJson ?: '{}']"/>
            <set field="lastRun" from="[tenantScriptId: tenantScriptId, scriptProfile: scriptProfile, scriptBody: scriptBody, inputJson: inputJson,
                    run: runOut?.run, ranAt: ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd HH:mm:ss'), workerUrl: darpan.script.ScriptWorker.configuredUrl()]"/>
            <!-- NOTE: stored as JSON text, Moqui drops a non-serializable session attribute -->
            <script>ec.web.sessionAttributes.put('darpanScriptWorkerLastRun', groovy.json.JsonOutput.toJson(lastRun))</script>
        </actions>
        <default-response url="."/>
    </transition>

    <actions>
        <!-- where scripts run; the token is reported as set or not, never shown -->
        <set field="workerUrl" from="darpan.script.ScriptWorker.configuredUrl()"/>
        <set field="tokenConfigured" from="darpan.script.ScriptWorker.configuredToken() != null"/>
        <set field="health" from="darpan.script.ScriptWorker.probeHealth(workerUrl)"/>
        <set field="whereText" from="workerUrl ? 'In the worker at ' + workerUrl + '. Moqui never runs a script itself; an unreachable worker returns a WORKER error.' : 'Inside Moqui (no DARPAN_SCRIPT_WORKER_URL). Local development only.'"/>
        <set field="tokenText" from="tokenConfigured ? 'Configured: every call carries X-Darpan-Worker-Token.' : 'Not configured: only the network walls protect the worker.'"/>
        <set field="healthText" from="health.reachable ? 'Answered in ' + health.ms + ' ms.' : health.message"/>

        <service-call name="facade.AuthFacadeServices.get#SessionInfo" out-map="sessionOut"/>
        <set field="activeTenantUserGroupId" from="sessionOut?.sessionInfo?.activeTenantUserGroupId"/>
        <set field="activeTenantLabel" from="sessionOut?.sessionInfo?.activeTenantLabel"/>
        <set field="availableTenants" from="sessionOut?.sessionInfo?.availableTenants ?: []"/>
        <set field="tenantText" from="activeTenantUserGroupId ? activeTenantLabel + ' (' + activeTenantUserGroupId + ')' : 'None chosen. Scripts need an active tenant.'"/>

        <!-- demo scripts, each label says what it proves -->
        <set field="examples" from="[
                one   : [scriptProfile: 'EXPRESSION', scriptBody: '1 + 1', inputJson: '{}'],
                sum   : [scriptProfile: 'SCRIPT', scriptBody: 'var total = 0;\nfor (var line : input.lines) { total = total + line.qty; }\nd:log(&quot;lines &quot; + size(input.lines));\ntotal', inputJson: '{&quot;lines&quot;: [{&quot;sku&quot;: &quot;A&quot;, &quot;qty&quot;: 3}, {&quot;sku&quot;: &quot;B&quot;, &quot;qty&quot;: 4}, {&quot;sku&quot;: &quot;C&quot;, &quot;qty&quot;: 5}]}'],
                escape: [scriptProfile: 'SCRIPT', scriptBody: '\'\'.class.forName(\'java.lang.Runtime\')', inputJson: '{}'],
                loop  : [scriptProfile: 'SCRIPT', scriptBody: 'while (true) {}', inputJson: '{}']]"/>

        <!-- the active tenant's saved scripts, through the same service the app's Scripts page uses -->
        <set field="savedScripts" from="[]"/>
        <if condition="activeTenantUserGroupId">
            <service-call name="facade.TenantScriptFacadeServices.list#TenantScripts" out-map="listOut"/>
            <set field="savedScripts" from="listOut?.scripts ?: []"/>
        </if>
        <set field="savedPick" from="savedId ? savedScripts.find { it.tenantScriptId == savedId } : null"/>
        <set field="savedValues" from="savedPick ? [tenantScriptId: savedPick.tenantScriptId, scriptProfile: savedPick.scriptProfile,
                scriptBody: savedPick.scriptBody, inputJson: savedPick.sampleInputJson ?: '{}'] : null"/>

        <!-- the last run (shown once), else a loaded saved script, else the chosen example, else 1 + 1 -->
        <set field="lastRunJson" from="ec.web.sessionAttributes.remove('darpanScriptWorkerLastRun')"/>
        <set field="lastRun" from="lastRunJson instanceof String ? new groovy.json.JsonSlurper().parseText(lastRunJson) : null"/>
        <set field="formValues" from="lastRun ?: (savedValues ?: (examples[example] ?: examples.one))"/>
        <if condition="lastRun">
            <set field="run" from="lastRun.run ?: [:]"/>
            <set field="runVerdict" from="run.ok ? 'ok' : ('stopped: ' + (run.error?.kind ?: 'unknown'))"/>
            <set field="runResultJson" from="groovy.json.JsonOutput.prettyPrint(groovy.json.JsonOutput.toJson(run.result))"/>
            <set field="runErrorText" from="run.error ? run.error.kind + ': ' + run.error.message : 'none'"/>
            <set field="runLogs" from="run.logs ?: []"/>
            <set field="runWhere" from="lastRun.workerUrl ? 'worker (' + lastRun.workerUrl + ')' : 'inside Moqui'"/>
        </if>
    </actions>

    <widgets>
        <container style="container">
            <container style="page-header">
                <label text="Script Worker" type="h2"/>
                <label text="Runs a tenant script through run#TenantScript, the same service the app calls, and shows where it ran." type="p" style="text-muted"/>
            </container>

            <section name="WhereScriptsRun">
                <widgets>
                    <label text="Where scripts run" type="h4"/>
                    <container-box>
                        <box-header><label text="Worker"/></box-header>
                        <box-body>
                            <label text="Runs: ${whereText}" type="p"/>
                            <label text="Health from Moqui: ${healthText}" type="p" style="${health.reachable ? 'text-success' : 'text-danger'}"/>
                            <label text="Caller token: ${tokenText}" type="p"/>
                        </box-body>
                    </container-box>
                </widgets>
            </section>

            <section name="ActiveTenant">
                <widgets>
                    <label text="Tenant" type="h4"/>
                    <label text="Active tenant: ${tenantText}" type="p"/>
                    <form-single name="ChooseTenantForm" transition="chooseTenant">
                        <field name="activeTenantUserGroupId">
                            <default-field title="Switch to">
                                <drop-down allow-empty="false"><list-options list="availableTenants" key="${userGroupId}" text="${label} (${userGroupId})"/></drop-down>
                            </default-field>
                        </field>
                        <field name="chooseButton"><default-field title=""><submit text="Use this tenant"/></default-field></field>
                    </form-single>
                </widgets>
            </section>

            <section name="SavedScripts" condition="activeTenantUserGroupId">
                <widgets>
                    <label text="Saved scripts (${savedScripts.size()})" type="h4"/>
                    <label text="None saved for this tenant yet." type="p" style="text-muted" condition="!savedScripts"/>
                    <section-iterate name="SavedScriptRows" list="savedScripts" entry="saved">
                        <widgets>
                            <container>
                                <link url="." text="Load" parameter-map="[savedId: saved.tenantScriptId]" link-type="anchor"/>
                                <label text="  ${saved.scriptName} · ${saved.scriptProfile}${saved.description ? ' · ' + saved.description : ''}" type="span"/>
                            </container>
                        </widgets>
                    </section-iterate>
                </widgets>
            </section>

            <section name="RunScript">
                <widgets>
                    <label text="Run a script" type="h4"/>
                    <label text="Loaded: saved script ${formValues.tenantScriptId}" type="p" style="text-info" condition="formValues?.tenantScriptId"/>
                    <container>
                        <label text="Examples:" type="span" style="text-muted"/>
                        <link url="." text="1 + 1" parameter-map="[example: 'one']" link-type="anchor"/>
                        <link url="." text="Sum of order lines" parameter-map="[example: 'sum']" link-type="anchor"/>
                        <link url="." text="Escape attempt (Java Runtime)" parameter-map="[example: 'escape']" link-type="anchor"/>
                        <link url="." text="Endless loop" parameter-map="[example: 'loop']" link-type="anchor"/>
                    </container>
                    <form-single name="RunScriptForm" transition="runScript" map="formValues">
                        <field name="tenantScriptId"><default-field><hidden/></default-field></field>
                        <field name="scriptProfile">
                            <default-field title="Profile">
                                <drop-down allow-empty="false">
                                    <option key="EXPRESSION" text="EXPRESSION (one line, 250 ms, 100,000 units)"/>
                                    <option key="SCRIPT" text="SCRIPT (2 s, 2,000,000 units)"/>
                                </drop-down>
                            </default-field>
                        </field>
                        <field name="scriptBody"><default-field title="Script"><text-area rows="8" cols="90"/></default-field></field>
                        <field name="inputJson"><default-field title="Input (JSON)"><text-area rows="5" cols="90"/></default-field></field>
                        <field name="runButton"><default-field title=""><submit text="Run" btn-type="primary"/></default-field></field>
                    </form-single>
                </widgets>
            </section>

            <section name="LastResult" condition="lastRun">
                <widgets>
                    <label text="Result" type="h4"/>
                    <container-box>
                        <box-header><label text="${runVerdict} · ran in the ${runWhere} · ${lastRun.ranAt}"/></box-header>
                        <box-body>
                            <label text="Result:" type="p" style="text-muted"/>
                            <label text="${runResultJson}" type="pre"/>
                            <label text="Error: ${runErrorText}" type="p"/>
                            <label text="Units of work: ${run.units ?: 0} · time in the evaluator: ${run.elapsedMs ?: 0} ms" type="p"/>
                            <label text="Script log:" type="p" style="text-muted"/>
                            <section-iterate name="RunLogs" list="runLogs" entry="logLine">
                                <widgets><label text="${logLine}" type="pre"/></widgets>
                            </section-iterate>
                            <label text="(no log lines)" type="p" style="text-muted" condition="!runLogs"/>
                        </box-body>
                    </container-box>
                </widgets>
            </section>
        </container>
    </widgets>
</screen>
