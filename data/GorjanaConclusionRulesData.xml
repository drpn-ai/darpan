<?xml version="1.0" encoding="UTF-8"?>
<!--
  DAR-UI-044 — the gorjana conclusion catalogue for the tri-system runs (A-open, B, C, C-cancel; see
  darpan/data/TriSystemOrderRunsRuleSetData.xml). Each rule names what a finding IS, from conditions
  on both sides' records; the first rule whose conditions all hold wins, and a finding no rule names
  is Unexplained. "How Darpan concluded" on the result page is rendered FROM these conditions, so a
  check label must describe exactly what its condition tests.

  NOT seed data — tenant configuration. Load per install AFTER ConclusionCatalogSeedData.xml (the enum
  type) and TriSystemOrderRunsRuleSetData.xml (the scopes):

      ec.entity.makeDataLoader().location("component://darpan/data/GorjanaConclusionRulesData.xml").load()

  Order is load-bearing. On the order scope the gift-card and POS rules come BEFORE the plain "Never
  reached NetSuite", so a gift-card order is named as such rather than as the general case.

  C and C-cancel name the NetSuite lineState a finding lands on (BILLED > CLOSED > SHIPPED > OPEN): done
  in NetSuite is BILLED, and CLOSED is NetSuite's cancel. A HotWax-completed item on a closed NetSuite line
  is the same conclusion in both runs, so it reads the same wherever it is found.

  Run D (NS_PENDING_BILLING) has no rules here: its scope id is generated when
  tools/netsuite-chain-config/upload-gorjana-checks.py creates the run.
-->
<entity-facade-xml type="darpan-tenant-config">
    <moqui.basic.Enumeration enumId="CONC_NS_NO_LINE_LOCATION" enumTypeId="DarpanConclusion" enumCode="CONC_NS_NO_LINE_LOCATION" description="No location on the NetSuite line"/>
    <moqui.basic.Enumeration enumId="CONC_NS_BACKORDERED" enumTypeId="DarpanConclusion" enumCode="CONC_NS_BACKORDERED" description="Backordered in NetSuite"/>
    <moqui.basic.Enumeration enumId="CONC_NEVER_REACHED_NS" enumTypeId="DarpanConclusion" enumCode="CONC_NEVER_REACHED_NS" description="Never reached NetSuite"/>
    <moqui.basic.Enumeration enumId="CONC_SHIPPED_NOT_COMPLETED" enumTypeId="DarpanConclusion" enumCode="CONC_SHIPPED_NOT_COMPLETED" description="Shipped, not completed in HotWax"/>
    <moqui.basic.Enumeration enumId="CONC_GIFT_CARD_NOT_IN_NS" enumTypeId="DarpanConclusion" enumCode="CONC_GIFT_CARD_NOT_IN_NS" description="Gift card never reached NetSuite"/>
    <moqui.basic.Enumeration enumId="CONC_POS_NOT_IN_NS" enumTypeId="DarpanConclusion" enumCode="CONC_POS_NOT_IN_NS" description="POS order never reached NetSuite"/>
    <moqui.basic.Enumeration enumId="CONC_NS_ID_MISSING" enumTypeId="DarpanConclusion" enumCode="CONC_NS_ID_MISSING" description="NetSuite id missing in HotWax"/>
    <moqui.basic.Enumeration enumId="CONC_PARKED_IN_HOTWAX" enumTypeId="DarpanConclusion" enumCode="CONC_PARKED_IN_HOTWAX" description="Parked in HotWax"/>
    <moqui.basic.Enumeration enumId="CONC_BILLED_NOT_COMPLETED" enumTypeId="DarpanConclusion" enumCode="CONC_BILLED_NOT_COMPLETED" description="Billed, not completed in HotWax"/>
    <moqui.basic.Enumeration enumId="CONC_SHIPPED_NOT_BILLED" enumTypeId="DarpanConclusion" enumCode="CONC_SHIPPED_NOT_BILLED" description="Shipped, not billed in NetSuite"/>
    <moqui.basic.Enumeration enumId="CONC_COMPLETED_CLOSED_IN_NS" enumTypeId="DarpanConclusion" enumCode="CONC_COMPLETED_CLOSED_IN_NS" description="Completed in HotWax, closed in NetSuite"/>
    <moqui.basic.Enumeration enumId="CONC_CANCEL_NOT_IN_NS" enumTypeId="DarpanConclusion" enumCode="CONC_CANCEL_NOT_IN_NS" description="Cancel not synced to NetSuite"/>
    <moqui.basic.Enumeration enumId="CONC_CANCELLED_FULFILLED_IN_NS" enumTypeId="DarpanConclusion" enumCode="CONC_CANCELLED_FULFILLED_IN_NS" description="Cancelled in HotWax, fulfilled in NetSuite"/>
    <moqui.basic.Enumeration enumId="CONC_OPEN_CLOSED_IN_NS" enumTypeId="DarpanConclusion" enumCode="CONC_OPEN_CLOSED_IN_NS" description="Open in HotWax, closed in NetSuite"/>
    <moqui.basic.Enumeration enumId="CONC_CANCEL_NOT_IN_SHOPIFY" enumTypeId="DarpanConclusion" enumCode="CONC_CANCEL_NOT_IN_SHOPIFY" description="Cancel not synced to Shopify"/>
    <!-- DAR-BE-118, Aditi 2026-10-23 on R1 (F-100799, F-100767). -->
    <moqui.basic.Enumeration enumId="CONC_ORDER_BACKORDER_HOLDS_BILLING" enumTypeId="DarpanConclusion" enumCode="CONC_ORDER_BACKORDER_HOLDS_BILLING" description="Shipped, not billed: another line of its order is backordered in NetSuite"/>
    <moqui.basic.Enumeration enumId="CONC_PARTIAL_PAYMENT_NO_NS" enumTypeId="DarpanConclusion" enumCode="CONC_PARTIAL_PAYMENT_NO_NS" description="Partial payment: the order was never sent to NetSuite"/>

    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_OMS_NS_LINE_SCOPE" sequenceNum="5" fixActionTemplate="NetSuite closed the line HotWax completed: reopen and bill it in NetSuite, or cancel item {recordKey} in HotWax if it never shipped." conclusionEnumId="CONC_COMPLETED_CLOSED_IN_NS" appliesToBucket="MISSING_FROM_FILE_2" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_LINE_SCOPE" sequenceNum="5" conditionSeq="1" subject="FILE_2" presence="EXCLUDED" keyScope="FULL" fieldExpression="lineState" operator="IN" conditionValues="CLOSED" checkLabel="NetSuite closed the line" companyUserGroupId="GORJANA"/>

    <!-- DAR-BE-093, gorjana R3. Ahead of the backorder it shows as: NetSuite cannot ship a line with no location. A line
         that shipped had a location that worked, so only OPEN lines. SuiteQL omits a null column, so BLANK reads absent. -->
    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_OMS_NS_LINE_SCOPE" sequenceNum="8" fixActionTemplate="Set the location on the NetSuite line of item {recordKey}; NetSuite can then ship and bill it." conclusionEnumId="CONC_NS_NO_LINE_LOCATION" appliesToBucket="MISSING_FROM_FILE_2" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_LINE_SCOPE" sequenceNum="8" conditionSeq="1" subject="FILE_2" presence="EXCLUDED" keyScope="FULL" fieldExpression="lineState" operator="IN" conditionValues="OPEN" checkLabel="NetSuite has the line, nothing shipped" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_LINE_SCOPE" sequenceNum="8" conditionSeq="2" subject="FILE_2" presence="ANY" keyScope="FULL" fieldExpression="lineLocation" operator="BLANK" checkLabel="The line has no location" companyUserGroupId="GORJANA"/>

    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_OMS_NS_LINE_SCOPE" sequenceNum="10" fixActionTemplate="Fulfil the backordered line in NetSuite ({quantityBackordered} on backorder); it is billed once it ships." conclusionEnumId="CONC_NS_BACKORDERED" appliesToBucket="MISSING_FROM_FILE_2" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_LINE_SCOPE" sequenceNum="10" conditionSeq="1" subject="FILE_2" presence="EXCLUDED" keyScope="FULL" checkLabel="NetSuite has the line" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_LINE_SCOPE" sequenceNum="10" conditionSeq="2" subject="FILE_2" presence="ANY" keyScope="FULL" fieldExpression="quantityBackordered" operator="GT_ZERO" checkLabel="Nothing shipped, on backorder" companyUserGroupId="GORJANA"/>

    <!-- DAR-BE-118 (F-100799): NetSuite bills an order once, so a shipped line waits while another line is backordered. The
         order is looked up in NetSuite (the scope's orderInNetsuite lookup, NS_SO_BACKORDER: only backordered orders come
         back), and only for the shipped lines that reach this rule. -->
    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_OMS_NS_LINE_SCOPE" sequenceNum="12" fixActionTemplate="Fulfil the backordered lines of {orderInNetsuite.tranId} in NetSuite: NetSuite bills the order once it ships complete, this line included." conclusionEnumId="CONC_ORDER_BACKORDER_HOLDS_BILLING" appliesToBucket="MISSING_FROM_FILE_2" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_LINE_SCOPE" sequenceNum="12" conditionSeq="1" subject="FILE_2" presence="EXCLUDED" keyScope="FULL" fieldExpression="lineState" operator="IN" conditionValues="SHIPPED" checkLabel="NetSuite shipped the line" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_LINE_SCOPE" sequenceNum="12" conditionSeq="2" subject="FILE_2" presence="ANY" keyScope="FULL" fieldExpression="orderInNetsuite.tranId" operator="NOT_BLANK" checkLabel="Its order has units backordered" companyUserGroupId="GORJANA"/>

    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_OMS_NS_LINE_SCOPE" sequenceNum="15" fixActionTemplate="Bill the shipped line in NetSuite: invoice its sales order." conclusionEnumId="CONC_SHIPPED_NOT_BILLED" appliesToBucket="MISSING_FROM_FILE_2" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_LINE_SCOPE" sequenceNum="15" conditionSeq="1" subject="FILE_2" presence="EXCLUDED" keyScope="FULL" fieldExpression="lineState" operator="IN" conditionValues="SHIPPED" checkLabel="NetSuite shipped, not billed" companyUserGroupId="GORJANA"/>

    <!-- DAR-BE-118 (F-100767, M1167217): HotWax does not send an order whose payment was taken back; its total is then 0. -->
    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_OMS_NS_LINE_SCOPE" sequenceNum="18" fixActionTemplate="Nothing to fix in NetSuite: HotWax sends an order only once it is paid, and this one&#x27;s payment was taken back (order total {orderGrandTotal}). It syncs once paid; cancel it in HotWax if the sale did not stand." conclusionEnumId="CONC_PARTIAL_PAYMENT_NO_NS" appliesToBucket="MISSING_FROM_FILE_2" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_LINE_SCOPE" sequenceNum="18" conditionSeq="1" subject="FILE_2" presence="ABSENT" keyScope="FIRST_FIELD" checkLabel="NetSuite has no line for the order" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_LINE_SCOPE" sequenceNum="18" conditionSeq="2" subject="FILE_1" presence="ANY" keyScope="FULL" fieldExpression="orderGrandTotal" operator="IN" conditionValues="0" checkLabel="Its payment was taken back: the order total is 0" companyUserGroupId="GORJANA"/>

    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_OMS_NS_LINE_SCOPE" sequenceNum="20" fixActionTemplate="Re-run the order sync in HotWax for item {recordKey}: NetSuite has no sales order for it." conclusionEnumId="CONC_NEVER_REACHED_NS" appliesToBucket="MISSING_FROM_FILE_2" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_LINE_SCOPE" sequenceNum="20" conditionSeq="1" subject="FILE_2" presence="ABSENT" keyScope="FIRST_FIELD" checkLabel="NetSuite has no line for the order" companyUserGroupId="GORJANA"/>

    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_OMS_NS_LINE_SCOPE" sequenceNum="30" fixActionTemplate="Complete item {recordKey} in HotWax: NetSuite already billed it." conclusionEnumId="CONC_BILLED_NOT_COMPLETED" appliesToBucket="MISSING_FROM_FILE_1" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_LINE_SCOPE" sequenceNum="30" conditionSeq="1" subject="FILE_2" presence="KEPT" keyScope="FULL" fieldExpression="lineState" operator="IN" conditionValues="BILLED" checkLabel="NetSuite billed the line" companyUserGroupId="GORJANA"/>

    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_OMS_NS_ORDER_SCOPE" sequenceNum="10" conclusionEnumId="CONC_GIFT_CARD_NOT_IN_NS" appliesToBucket="MISSING_FROM_FILE_2"
            questionText="Should gift-card-only orders reach NetSuite?" suggestedFilterJson="{&quot;fileSide&quot;:&quot;FILE_1&quot;,&quot;fieldExpression&quot;:&quot;facilityId&quot;,&quot;operator&quot;:&quot;EXCLUDE_IN&quot;,&quot;values&quot;:[&quot;_NA_&quot;]}" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_ORDER_SCOPE" sequenceNum="10" conditionSeq="1" subject="FILE_2" presence="ABSENT" keyScope="FIRST_FIELD" checkLabel="NetSuite has no order" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_ORDER_SCOPE" sequenceNum="10" conditionSeq="2" subject="FILE_1" presence="ANY" keyScope="FULL" fieldExpression="facilityId" operator="IN" conditionValues="_NA_" checkLabel="Nothing to ship" companyUserGroupId="GORJANA"/>

    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_OMS_NS_ORDER_SCOPE" sequenceNum="20" conclusionEnumId="CONC_POS_NOT_IN_NS" appliesToBucket="MISSING_FROM_FILE_2"
            questionText="Should POS orders reach NetSuite?" suggestedFilterJson="{&quot;fileSide&quot;:&quot;FILE_1&quot;,&quot;fieldExpression&quot;:&quot;salesChannelEnumId&quot;,&quot;operator&quot;:&quot;EXCLUDE_IN&quot;,&quot;values&quot;:[&quot;POS_SALES_CHANNEL&quot;]}" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_ORDER_SCOPE" sequenceNum="20" conditionSeq="1" subject="FILE_2" presence="ABSENT" keyScope="FIRST_FIELD" checkLabel="NetSuite has no order" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_ORDER_SCOPE" sequenceNum="20" conditionSeq="2" subject="FILE_1" presence="ANY" keyScope="FULL" fieldExpression="salesChannelEnumId" operator="IN" conditionValues="POS_SALES_CHANNEL" checkLabel="POS order" companyUserGroupId="GORJANA"/>

    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_OMS_NS_ORDER_SCOPE" sequenceNum="30" conclusionEnumId="CONC_NS_ID_MISSING" appliesToBucket="MISSING_FROM_FILE_2" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_ORDER_SCOPE" sequenceNum="30" conditionSeq="1" subject="FILE_1" presence="ANY" keyScope="FULL" fieldExpression="netsuiteOrderId" operator="IN" conditionValues="NONE" checkLabel="HotWax holds no NetSuite id" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_ORDER_SCOPE" sequenceNum="30" conditionSeq="2" subject="FILE_2" presence="KEPT" keyScope="FIRST_FIELD" checkLabel="NetSuite has the order" companyUserGroupId="GORJANA"/>

    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_OMS_NS_ORDER_SCOPE" sequenceNum="40" conclusionEnumId="CONC_NEVER_REACHED_NS" appliesToBucket="MISSING_FROM_FILE_2" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_ORDER_SCOPE" sequenceNum="40" conditionSeq="1" subject="FILE_2" presence="ABSENT" keyScope="FIRST_FIELD" checkLabel="NetSuite has no order" companyUserGroupId="GORJANA"/>

    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_OMS_NS_ORDER_SCOPE" sequenceNum="50" conclusionEnumId="CONC_NS_ID_MISSING" appliesToBucket="MISSING_FROM_FILE_1" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_ORDER_SCOPE" sequenceNum="50" conditionSeq="1" subject="FILE_1" presence="KEPT" keyScope="FIRST_FIELD" fieldExpression="netsuiteOrderId" operator="IN" conditionValues="NONE" checkLabel="HotWax holds no NetSuite id" companyUserGroupId="GORJANA"/>

    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_LINE_OPEN_SCOPE" sequenceNum="10" conclusionEnumId="CONC_PARKED_IN_HOTWAX" appliesToBucket="MISSING_FROM_FILE_1" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_LINE_OPEN_SCOPE" sequenceNum="10" conditionSeq="1" subject="FILE_2" presence="KEPT" keyScope="FULL" fieldExpression="facilityId" operator="IN" conditionValues="UNF_HOLD_PARKING" checkLabel="Held in unfillable parking" companyUserGroupId="GORJANA"/>

    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_LINE_OPEN_SCOPE" sequenceNum="20" conclusionEnumId="CONC_CANCEL_NOT_IN_SHOPIFY" appliesToBucket="MISSING_FROM_FILE_2" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_LINE_OPEN_SCOPE" sequenceNum="20" conditionSeq="1" subject="FILE_2" presence="EXCLUDED" keyScope="FULL" fieldExpression="unitState" operator="IN" conditionValues="CANCELLED" checkLabel="Cancelled in HotWax" companyUserGroupId="GORJANA"/>

    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_OMS_NS_CANCEL_SCOPE" sequenceNum="10" conclusionEnumId="CONC_CANCEL_NOT_IN_NS" appliesToBucket="MISSING_FROM_FILE_2" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_CANCEL_SCOPE" sequenceNum="10" conditionSeq="1" subject="FILE_2" presence="EXCLUDED" keyScope="FULL" fieldExpression="lineState" operator="IN" conditionValues="OPEN" checkLabel="NetSuite line still open" companyUserGroupId="GORJANA"/>

    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_OMS_NS_CANCEL_SCOPE" sequenceNum="20" conclusionEnumId="CONC_CANCELLED_FULFILLED_IN_NS" appliesToBucket="MISSING_FROM_FILE_2" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_CANCEL_SCOPE" sequenceNum="20" conditionSeq="1" subject="FILE_2" presence="EXCLUDED" keyScope="FULL" fieldExpression="lineState" operator="IN" conditionValues="SHIPPED,BILLED" checkLabel="NetSuite shipped or billed the line" companyUserGroupId="GORJANA"/>

    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_OMS_NS_CANCEL_SCOPE" sequenceNum="30" conclusionEnumId="CONC_NEVER_REACHED_NS" appliesToBucket="MISSING_FROM_FILE_2" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_CANCEL_SCOPE" sequenceNum="30" conditionSeq="1" subject="FILE_2" presence="ABSENT" keyScope="FIRST_FIELD" checkLabel="NetSuite has no line for the order" companyUserGroupId="GORJANA"/>

    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_OMS_NS_CANCEL_SCOPE" sequenceNum="40" conclusionEnumId="CONC_COMPLETED_CLOSED_IN_NS" appliesToBucket="MISSING_FROM_FILE_1" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_CANCEL_SCOPE" sequenceNum="40" conditionSeq="1" subject="FILE_1" presence="EXCLUDED" keyScope="FULL" fieldExpression="unitState" operator="IN" conditionValues="COMPLETED" checkLabel="Completed in HotWax" companyUserGroupId="GORJANA"/>

    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_OMS_NS_CANCEL_SCOPE" sequenceNum="50" conclusionEnumId="CONC_OPEN_CLOSED_IN_NS" appliesToBucket="MISSING_FROM_FILE_1" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_OMS_NS_CANCEL_SCOPE" sequenceNum="50" conditionSeq="1" subject="FILE_1" presence="EXCLUDED" keyScope="FULL" fieldExpression="unitState" operator="IN" conditionValues="OPEN" checkLabel="Still open in HotWax" companyUserGroupId="GORJANA"/>

</entity-facade-xml>
