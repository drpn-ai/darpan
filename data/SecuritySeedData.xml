<?xml version="1.0" encoding="UTF-8"?>
<!-- No copyright or license for configuration file, details here are not considered a creative work. -->
<entity-facade-xml type="darpan-seed">
    <!-- UserGroups (and the enum they FK) MUST precede every ArtifactAuthz below: a data file loads
         in document order inside one transaction, and on MySQL with FK constraints already in place
         a forward reference to a not-yet-inserted UserGroup fails and rolls back the entire file. -->
    <moqui.security.UserGroup userGroupId="DARPAN_USER"
            description="Darpan application users"/>
    <moqui.basic.Enumeration enumId="UgtDarpanPermission"
            description="Darpan permission groups"
            enumTypeId="UserGroupType"/>
    <moqui.security.UserGroup userGroupId="DARPAN_ADMIN"
            description="Can manage Darpan app-level settings and core configuration"
            groupTypeEnumId="UgtDarpanPermission"/>
    <moqui.security.UserGroup userGroupId="DARPAN_SUPER_ADMIN"
            description="Can view and edit every tenant and manage tenant and user setup"
            groupTypeEnumId="UgtDarpanPermission"/>
    <moqui.security.UserGroup userGroupId="DARPAN_TENANT_ADMIN"
            description="Can view, run, create, update, and delete data for associated tenants"
            groupTypeEnumId="UgtDarpanPermission"/>
    <moqui.security.UserGroup userGroupId="DARPAN_TENANT_USER"
            description="Can view tenant pages, upload files, and run reconciliation for associated tenants"
            groupTypeEnumId="UgtDarpanPermission"/>
    <moqui.security.UserGroup userGroupId="DARPAN_COMPANY_EDITOR"
            description="Can create, update, run, and delete tenant-scoped Darpan data"
            groupTypeEnumId="UgtDarpanPermission"/>
    <moqui.security.UserGroup userGroupId="DARPAN_COMPANY_VIEW_ONLY"
            description="Can view tenant-scoped Darpan data but cannot mutate it"
            groupTypeEnumId="UgtDarpanPermission"/>

    <moqui.security.ArtifactGroup artifactGroupId="DARPAN_AUTH_API" description="Darpan anonymous-accessible auth facade entry points (login, session info, logout). Tightly scoped: do not widen with patterns."/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_AUTH_API"
            artifactName="facade.AuthFacadeServices.login#Session" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_AUTH_API"
            artifactName="facade.AuthFacadeServices.get#SessionInfo" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_AUTH_API"
            artifactName="facade.AuthFacadeServices.logout#Session" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_AUTH_API"
            artifactName="facade.AuthFacadeServices.change#ExpiredPassword" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="DARPAN_AUTH_API_ALL_USERS" userGroupId="ALL_USERS"
            artifactGroupId="DARPAN_AUTH_API" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>

    <moqui.security.ArtifactGroup artifactGroupId="DARPAN_APP" description="Darpan App (via root screen)"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_APP"
            artifactName="component://darpan/screen/.*" artifactTypeEnumId="AT_XML_SCREEN" nameIsPattern="Y" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_APP"
            artifactName="facade\..*" artifactTypeEnumId="AT_SERVICE" nameIsPattern="Y" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_APP"
            artifactName="moqui.basic.Enumeration" artifactTypeEnumId="AT_ENTITY" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_APP"
            artifactName="darpan.mapping.ReconciliationMapping" artifactTypeEnumId="AT_ENTITY" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_APP"
            artifactName="darpan.mapping.ReconciliationMappingMember" artifactTypeEnumId="AT_ENTITY" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_APP"
            artifactName="darpan.rule.RuleSet" artifactTypeEnumId="AT_ENTITY" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_APP"
            artifactName="darpan.rule.RuleSetCompareScope" artifactTypeEnumId="AT_ENTITY" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_APP"
            artifactName="darpan.rule.RuleSetCompareSource" artifactTypeEnumId="AT_ENTITY" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_APP"
            artifactName="darpan.rule.RuleSetCompareSourceKeyField" artifactTypeEnumId="AT_ENTITY" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_APP"
            artifactName="darpan.auth.TenantSetting" artifactTypeEnumId="AT_ENTITY" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_APP"
            artifactName="darpan.reconciliation.ReconciliationRunResult" artifactTypeEnumId="AT_ENTITY" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_APP"
            artifactName="darpan.reconciliation.TenantNotificationSetting" artifactTypeEnumId="AT_ENTITY" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_APP" artifactName="darpan.reconciliation.TenantChatSpace" artifactTypeEnumId="AT_ENTITY" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_APP" artifactName="darpan.reconciliation.ReconciliationRunNotifySubscription" artifactTypeEnumId="AT_ENTITY" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_APP"
            artifactName="darpan.reconciliation.ReconciliationAutomation" artifactTypeEnumId="AT_ENTITY" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_APP"
            artifactName="darpan.reconciliation.ReconciliationAutomationSource" artifactTypeEnumId="AT_ENTITY" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_APP"
            artifactName="darpan.reconciliation.ReconciliationAutomationExecution" artifactTypeEnumId="AT_ENTITY" inheritAuthz="Y"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="DARPAN_APP_ADMIN" userGroupId="ADMIN"
            artifactGroupId="DARPAN_APP" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>

    <!-- MACH P0 #3: the legacy server-rendered screen UI (component://darpan/screen/**) drives transitions
         that call domain services DIRECTLY, bypassing the facade where tenant scoping + input validation
         live, so it must stay super-admin-only. DARPAN_APP (above) already grants the framework ADMIN
         group (which satisfies isSuperAdmin()); this screen-scoped group additionally grants DARPAN_SUPER_ADMIN.
         DARPAN_ADMIN is NOT granted here — it would pass URL-authz but fail the isSuperAdmin() pre-actions
         content gate, which is misleading; align the two layers. Regular tenant permission groups
         (DARPAN_USER / DARPAN_TENANT_USER / DARPAN_COMPANY_EDITOR / DARPAN_COMPANY_VIEW_ONLY) get no grant
         here and remain denied. The /rpc/json facade path (DARPAN_FACADE_APP, below) is unaffected. -->
    <moqui.security.ArtifactGroup artifactGroupId="DARPAN_SCREEN_UI"
            description="Legacy server-rendered Darpan screen UI — super-admin only (facade-bypassing)."/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_SCREEN_UI"
            artifactName="component://darpan/screen/.*" artifactTypeEnumId="AT_XML_SCREEN" nameIsPattern="Y" inheritAuthz="Y"/>
    <!-- DARPAN_SCREEN_UI_ADMIN removed: /apps/darpan screens are super-admin-only.
         DARPAN_ADMIN reaching the URL but being content-denied was misleading; align URL-authz
         to match the isSuperAdmin() pre-actions gate. Framework ADMIN still reaches via DARPAN_APP_ADMIN. -->
    <moqui.security.ArtifactAuthz artifactAuthzId="DARPAN_SCREEN_UI_SUPER_ADMIN" userGroupId="DARPAN_SUPER_ADMIN"
            artifactGroupId="DARPAN_SCREEN_UI" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>

    <moqui.security.ArtifactGroup artifactGroupId="DARPAN_FACADE_APP" description="Darpan facade APIs for the PWA"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_FACADE_APP"
            artifactName="facade\..*" artifactTypeEnumId="AT_SERVICE" nameIsPattern="Y" inheritAuthz="Y"/>
    <!--
        DARPAN_FACADE_APP_USER currently grants AUTHZA_ALL to all DARPAN_USER members. The role-based mutation gates
        live in service-layer Groovy (TenantAccessSupport.canEditActiveTenantData and similar). The editor-tier rules
        below are additive: they give an authz-layer access path to permission groups (DARPAN_COMPANY_EDITOR,
        DARPAN_TENANT_USER, DARPAN_TENANT_ADMIN, DARPAN_SUPER_ADMIN) that previously had no direct ArtifactAuthz.
        Planned Phase B: downgrade DARPAN_FACADE_APP_USER to AUTHZA_VIEW once onboarding is confirmed to assign every
        mutating user to one of the editor-tier groups. List/get/search services are tagged authz-action="view" so
        view-only users keep read access; save/run/etc default to AUTHZA_ALL and require an editor-tier rule.
    -->
    <moqui.security.ArtifactAuthz artifactAuthzId="DARPAN_FACADE_APP_USER" userGroupId="DARPAN_USER"
            artifactGroupId="DARPAN_FACADE_APP" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="DARPAN_FACADE_APP_ADMIN" userGroupId="ADMIN"
            artifactGroupId="DARPAN_FACADE_APP" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="DARPAN_FACADE_APP_EDITOR" userGroupId="DARPAN_COMPANY_EDITOR"
            artifactGroupId="DARPAN_FACADE_APP" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="DARPAN_FACADE_APP_TENANT_USER" userGroupId="DARPAN_TENANT_USER"
            artifactGroupId="DARPAN_FACADE_APP" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="DARPAN_FACADE_APP_TENANT_ADMIN" userGroupId="DARPAN_TENANT_ADMIN"
            artifactGroupId="DARPAN_FACADE_APP" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="DARPAN_FACADE_APP_SUPER_ADMIN" userGroupId="DARPAN_SUPER_ADMIN"
            artifactGroupId="DARPAN_FACADE_APP" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>

    <!-- Curated read-only GraphQL API (moqui-gql fork): authorize the /rest/s1/graphql REST path + gql.*
         services for the same Darpan groups as the PWA facade. ACCESS only — per-query tenant isolation is
         enforced independently by DarpanTenantScopeFilter (companyUserGroupId == active tenant). -->
    <moqui.security.ArtifactGroup artifactGroupId="DARPAN_GQL_API"
            description="Curated read-only GraphQL API (moqui-gql): REST path + gql services."/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_GQL_API"
            artifactName="/graphql.*" artifactTypeEnumId="AT_REST_PATH" nameIsPattern="Y" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_GQL_API"
            artifactName="gql\..*" artifactTypeEnumId="AT_SERVICE" nameIsPattern="Y" inheritAuthz="Y"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="DARPAN_GQL_API_USER" userGroupId="DARPAN_USER"
            artifactGroupId="DARPAN_GQL_API" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="DARPAN_GQL_API_TENANT_USER" userGroupId="DARPAN_TENANT_USER"
            artifactGroupId="DARPAN_GQL_API" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="DARPAN_GQL_API_TENANT_ADMIN" userGroupId="DARPAN_TENANT_ADMIN"
            artifactGroupId="DARPAN_GQL_API" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="DARPAN_GQL_API_SUPER_ADMIN" userGroupId="DARPAN_SUPER_ADMIN"
            artifactGroupId="DARPAN_GQL_API" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="DARPAN_GQL_API_ADMIN" userGroupId="ADMIN"
            artifactGroupId="DARPAN_GQL_API" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>

    <moqui.security.EntityFilterSet entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"
            description="Filter Darpan tenant-owned rows by the active tenant in user context"/>
    <moqui.security.EntityFilter entityFilterId="DARPAN_SCOPE_JSON_SCHEMA"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"
            entityName="darpan.reconciliation.JsonSchema"
            filterMap="[companyUserGroupId: activeTenantUserGroupId]"/>
    <moqui.security.EntityFilter entityFilterId="DARPAN_SCOPE_RECON_MAPPING"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"
            entityName="darpan.mapping.ReconciliationMapping"
            filterMap="[companyUserGroupId: activeTenantUserGroupId]"/>
    <moqui.security.EntityFilter entityFilterId="DARPAN_SCOPE_RULE_SET"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"
            entityName="darpan.rule.RuleSet"
            filterMap="[companyUserGroupId: activeTenantUserGroupId]"/>
    <!-- Rule / compare-scope / compare-source children carry a denormalized tenant stamp
         (MACH P1 defense-in-depth); the parent RuleSet stays the authoritative boundary. -->
    <moqui.security.EntityFilter entityFilterId="DARPAN_SCOPE_RULE"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"
            entityName="darpan.rule.Rule"
            filterMap="[companyUserGroupId: activeTenantUserGroupId]"/>
    <moqui.security.EntityFilter entityFilterId="DARPAN_SCOPE_RULE_SCOPE"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"
            entityName="darpan.rule.RuleSetCompareScope"
            filterMap="[companyUserGroupId: activeTenantUserGroupId]"/>
    <moqui.security.EntityFilter entityFilterId="DARPAN_SCOPE_RULE_SOURCE"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"
            entityName="darpan.rule.RuleSetCompareSource"
            filterMap="[companyUserGroupId: activeTenantUserGroupId]"/>
    <moqui.security.EntityFilter entityFilterId="DARPAN_SCOPE_RULE_SOURCE_KEY_FIELD"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"
            entityName="darpan.rule.RuleSetCompareSourceKeyField"
            filterMap="[companyUserGroupId: activeTenantUserGroupId]"/>
    <moqui.security.EntityFilter entityFilterId="DARPAN_SCOPE_RUN_RESULT"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"
            entityName="darpan.reconciliation.ReconciliationRunResult"
            filterMap="[companyUserGroupId: activeTenantUserGroupId]"/>
    <moqui.security.EntityFilter entityFilterId="DARPAN_SCOPE_TENANT_SETTING"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"
            entityName="darpan.auth.TenantSetting"
            filterMap="[companyUserGroupId: activeTenantUserGroupId]"/>
    <moqui.security.EntityFilter entityFilterId="DARPAN_SCOPE_TENANT_NOTIF"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"
            entityName="darpan.reconciliation.TenantNotificationSetting"
            filterMap="[companyUserGroupId: activeTenantUserGroupId]"/>
    <!-- No EntityFilter for ReconciliationRunNotifySubscription: it has no companyUserGroupId,
         every read is keyed by the caller's own userId or goes through TenantScopedFinder.findGlobalUnscoped. -->
    <moqui.security.EntityFilter entityFilterId="DARPAN_SCOPE_TENANT_CHAT_SPACE" entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE" entityName="darpan.reconciliation.TenantChatSpace" filterMap="[companyUserGroupId: activeTenantUserGroupId]"/>
    <moqui.security.EntityFilter entityFilterId="DARPAN_SCOPE_AUTOMATION"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"
            entityName="darpan.reconciliation.ReconciliationAutomation"
            filterMap="[companyUserGroupId: activeTenantUserGroupId]"/>
    <moqui.security.EntityFilter entityFilterId="DARPAN_SCOPE_AUTOMATION_SOURCE"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"
            entityName="darpan.reconciliation.ReconciliationAutomationSource"
            filterMap="[companyUserGroupId: activeTenantUserGroupId]"/>
    <moqui.security.EntityFilter entityFilterId="DARPAN_SCOPE_AUTOMATION_EXEC"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"
            entityName="darpan.reconciliation.ReconciliationAutomationExecution"
            filterMap="[companyUserGroupId: activeTenantUserGroupId]"/>
    <moqui.security.EntityFilter entityFilterId="DARPAN_SCOPE_SFTP_SERVER"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"
            entityName="darpan.reconciliation.SftpServer"
            filterMap="[companyUserGroupId: activeTenantUserGroupId]"/>
    <!-- DAR-BE-005 — these four config entities can be SHARED across tenants via
         darpan.auth.ConfigTenantAccess, but they stay in this filter set on purpose. Sharing is
         granted by the resolver (SharedConfigAccessSupport), never by removing the framework's
         tenant filter: an authz-enabled read must still see only the active tenant's own rows.
         Every sharing-aware read goes through TenantScopedFinder, which disables authz on each of
         its methods and therefore bypasses this filter by design. A NEW read path that calls
         ec.entity.find directly on one of these entities will silently drop shared rows — the
         symptom is "the shared config vanished" and it points nowhere near this file. -->
    <moqui.security.EntityFilter entityFilterId="DARPAN_SCOPE_NS_AUTH"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"
            entityName="darpan.reconciliation.NsAuthConfig"
            filterMap="[companyUserGroupId: activeTenantUserGroupId]"/>
    <moqui.security.EntityFilter entityFilterId="DARPAN_SCOPE_NS_RESTLET"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"
            entityName="darpan.reconciliation.NsRestletConfig"
            filterMap="[companyUserGroupId: activeTenantUserGroupId]"/>
    <!-- Audit H12.2 — both entities are tenant-owned (companyUserGroupId not-null) but were missing
         from the DARPAN_ACTIVE_COMPANY_SCOPE filter set, so any direct find against the entity layer
         returned rows across all tenants. -->
    <moqui.security.EntityFilter entityFilterId="DARPAN_SCOPE_HW_OMS_REST"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"
            entityName="darpan.hotwax.HotWaxOmsRestSourceConfig"
            filterMap="[companyUserGroupId: activeTenantUserGroupId]"/>
    <moqui.security.EntityFilter entityFilterId="DARPAN_SCOPE_SHOPIFY_AUTH"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"
            entityName="darpan.shopify.ShopifyAuthConfig"
            filterMap="[companyUserGroupId: activeTenantUserGroupId]"/>
    <moqui.security.ArtifactAuthzFilter artifactAuthzId="DARPAN_FACADE_APP_ADMIN"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"/>
    <moqui.security.ArtifactAuthzFilter artifactAuthzId="DARPAN_FACADE_APP_USER"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"/>
    <moqui.security.ArtifactAuthzFilter artifactAuthzId="DARPAN_FACADE_APP_EDITOR"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"/>
    <moqui.security.ArtifactAuthzFilter artifactAuthzId="DARPAN_FACADE_APP_TENANT_USER"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"/>
    <moqui.security.ArtifactAuthzFilter artifactAuthzId="DARPAN_FACADE_APP_TENANT_ADMIN"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"/>
    <moqui.security.ArtifactAuthzFilter artifactAuthzId="DARPAN_FACADE_APP_SUPER_ADMIN"
            entityFilterSetId="DARPAN_ACTIVE_COMPANY_SCOPE"/>

    <moqui.basic.Enumeration enumId="UgtDarpanCompany"
            description="Darpan tenant groups"
            enumTypeId="UserGroupType"/>
    <moqui.basic.Enumeration enumId="darpan.auth.activeTenantUserGroupId"
            description="Preferred active tenant user group id"
            enumTypeId="UserPreferenceKey"/>
    <moqui.basic.Enumeration enumId="darpan.dashboard.pinnedMappingIds"
            description="Pinned dashboard reconciliation mappings"
            enumTypeId="UserPreferenceKey"/>
    <moqui.basic.Enumeration enumId="darpan.notification.defaultChatSpaceId"
            description="Default Google Chat space per tenant (JSON map companyUserGroupId to chatSpaceId)"
            enumTypeId="UserPreferenceKey"/>
    <moqui.basic.EnumerationType enumTypeId="DarpanSftpScope"
            description="Darpan SFTP server scope"/>
    <moqui.basic.Enumeration enumId="DARPAN_SFTP_TENANT"
            description="Tenant-owned SFTP server"
            enumTypeId="DarpanSftpScope"/>
    <moqui.basic.Enumeration enumId="DARPAN_SFTP_TENANT_GROUP"
            description="SFTP server shared across explicitly assigned tenant groups"
            enumTypeId="DarpanSftpScope"/>
    <moqui.basic.Enumeration enumId="DARPAN_SFTP_ADMIN"
            description="Admin/platform-owned SFTP server"
            enumTypeId="DarpanSftpScope"/>

    <!-- Chat destination providers. TenantChatSpace.chatProviderEnumId FKs this, so these two rows
         must exist before any Slack-provider space can be saved; a tenant with no rows loaded can
         still save Google Chat spaces, because a null provider resolves to CHAT_PROV_GOOGLE.
         Adding a provider here also needs a delivery branch and a host pin in
         TenantNotificationSupport — the enum alone buys nothing. -->
    <moqui.basic.EnumerationType enumTypeId="DarpanChatProvider"
            description="Chat products Darpan can post run notifications to"/>
    <moqui.basic.Enumeration enumId="CHAT_PROV_GOOGLE"
            enumTypeId="DarpanChatProvider"
            enumCode="GOOGLE_CHAT"
            description="Google Chat"
            sequenceNum="1"/>
    <moqui.basic.Enumeration enumId="CHAT_PROV_SLACK"
            enumTypeId="DarpanChatProvider"
            enumCode="SLACK"
            description="Slack"
            sequenceNum="2"/>

    <!-- DAR-BE-005 — the catalog of config types that can be shared across tenants. Adding a value
         here plus a CONFIG_TYPE_REGISTRY row in SharedConfigAccessSupport is the whole extension
         path for a new shareable config type. moqui.service.message.SystemMessageRemote is
         deliberately absent: it is a framework-owned endpoint descriptor already visible to every
         tenant, not a per-tenant credential. -->
    <moqui.basic.EnumerationType enumTypeId="DarpanSharedConfigType"
            description="Darpan API source config types that support cross-tenant sharing"/>
    <moqui.basic.Enumeration enumId="SCFG_HOTWAX_OMS"
            description="HotWax OMS REST source config (darpan.hotwax.HotWaxOmsRestSourceConfig)"
            enumTypeId="DarpanSharedConfigType"/>
    <moqui.basic.Enumeration enumId="SCFG_SHOPIFY_AUTH"
            description="Shopify auth config (darpan.shopify.ShopifyAuthConfig)"
            enumTypeId="DarpanSharedConfigType"/>
    <moqui.basic.Enumeration enumId="SCFG_NS_AUTH"
            description="NetSuite auth config (darpan.reconciliation.NsAuthConfig)"
            enumTypeId="DarpanSharedConfigType"/>
    <moqui.basic.Enumeration enumId="SCFG_NS_RESTLET"
            description="NetSuite Restlet config (darpan.reconciliation.NsRestletConfig)"
            enumTypeId="DarpanSharedConfigType"/>

    <!-- Admin API fence: the admin.* service namespace is the platform-operator surface
         (tenant lifecycle, user management, membership). Granted ONLY to DARPAN_SUPER_ADMIN and
         framework ADMIN — the same two groups that satisfy isSuperAdmin(). Deliberately NOT
         granted to DARPAN_USER/editor tiers, and deliberately carrying NO ArtifactAuthzFilter:
         admin services are cross-tenant. Never name an admin service facade.* (auto-grant trap)
         and never widen this group with additional members. -->
    <moqui.security.ArtifactGroup artifactGroupId="DARPAN_ADMIN_API"
            description="Darpan platform-admin APIs (admin.* services) — super-admin only, cross-tenant."/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DARPAN_ADMIN_API"
            artifactName="admin\..*" artifactTypeEnumId="AT_SERVICE" nameIsPattern="Y" inheritAuthz="Y"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="DARPAN_ADMIN_API_SUPER_ADMIN" userGroupId="DARPAN_SUPER_ADMIN"
            artifactGroupId="DARPAN_ADMIN_API" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="DARPAN_ADMIN_API_ADMIN" userGroupId="ADMIN"
            artifactGroupId="DARPAN_ADMIN_API" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>

    <!-- Privileged password ops (admin.user.reset#Password / create) go through framework
         update#PasswordInternal; ADMIN_PASSWORD also lets update#Password skip oldPassword. -->
    <moqui.security.UserGroupPermission userGroupId="DARPAN_SUPER_ADMIN"
            userPermissionId="ADMIN_PASSWORD" fromDate="2026-07-28 00:00:00.000"/>
</entity-facade-xml>
