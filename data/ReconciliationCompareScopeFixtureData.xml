<?xml version="1.0" encoding="UTF-8"?>
<entity-facade-xml type="darpan-fixture">
    <moqui.basic.EnumerationType
            enumTypeId="DarpanSystemSource"
            description="Darpan System Source"/>

    <moqui.basic.Enumeration
            enumId="OMS"
            enumTypeId="DarpanSystemSource"
            enumCode="HOTWAX"
            description="HotWax"
            sequenceNum="1"/>

    <moqui.basic.Enumeration
            enumId="SHOPIFY"
            enumTypeId="DarpanSystemSource"
            enumCode="SHOPIFY"
            description="Shopify"
            sequenceNum="2"/>

    <moqui.basic.EnumerationType
            enumTypeId="DarpanFileType"
            description="File Types for Reconciliation"/>

    <moqui.basic.Enumeration
            enumId="DftJson"
            enumTypeId="DarpanFileType"
            enumCode="JSON"
            description="JSON"
            sequenceNum="2"/>

    <darpan.rule.RuleSet
            ruleSetId="DARPAN_TEST_PRODUCT_COMPARE_RS"
            ruleSetName="Darpan Test Product Compare RuleSet"
            description="Smoke-test RuleSet for matched-pair field diff generation."
            version="1.0"
            explosionPath="data.products"
            primaryKeyPath="productId"/>

    <!-- DAR-OPS-029 S99-205b: what a tenant can author, generated field comparisons (the ruleLogic is
         FieldComparisonRuleLogicGenerator's output for the expression; AutomationEntityContractTests checks it),
         so a stack loading this fixture runs them through the compile gate without darpan.rules.allowRawDrl. -->
    <darpan.rule.Rule
            ruleId="DARPAN_TEST_PRODUCT_SKU_MISMATCH"
            ruleSetId="DARPAN_TEST_PRODUCT_COMPARE_RS"
            sequenceNum="10"
            ruleText="sku = sku"
            ruleType="FIELD_COMPARISON"
            expression='{"type":"FIELD_COMPARISON","file1FieldPath":"sku","file2FieldPath":"sku","operator":"="}'
            enabled="Y"
            severity="WARN">
        <ruleLogic><![CDATA[rule "DARPAN_TEST_PRODUCT_SKU_MISMATCH"
when
    $m : Map(this["file1"] != null, this["file2"] != null)
    eval(!java.util.Objects.equals(((Map) $m.get("file1")).get("sku"), ((Map) $m.get("file2")).get("sku")))
then
    Object _file1Value = ((Map) $m.get("file1")).get("sku");
    Object _file2Value = ((Map) $m.get("file2")).get("sku");
    reconciliation.rule.RuleDiffSupport.addFieldMismatch(
        $m,
        kcontext.getRule().getName(),
        "sku = sku",
        _file1Value,
        _file2Value,
        "WARN",
        "Field comparison failed: sku = sku"
    );
end]]></ruleLogic>
    </darpan.rule.Rule>

    <darpan.rule.Rule
            ruleId="DARPAN_TEST_PRODUCT_PRICE_MISMATCH"
            ruleSetId="DARPAN_TEST_PRODUCT_COMPARE_RS"
            sequenceNum="20"
            ruleText="price = price"
            ruleType="FIELD_COMPARISON"
            expression='{"type":"FIELD_COMPARISON","file1FieldPath":"price","file2FieldPath":"price","operator":"="}'
            enabled="Y"
            severity="WARN">
        <ruleLogic><![CDATA[rule "DARPAN_TEST_PRODUCT_PRICE_MISMATCH"
when
    $m : Map(this["file1"] != null, this["file2"] != null)
    eval(!java.util.Objects.equals(((Map) $m.get("file1")).get("price"), ((Map) $m.get("file2")).get("price")))
then
    Object _file1Value = ((Map) $m.get("file1")).get("price");
    Object _file2Value = ((Map) $m.get("file2")).get("price");
    reconciliation.rule.RuleDiffSupport.addFieldMismatch(
        $m,
        kcontext.getRule().getName(),
        "price = price",
        _file1Value,
        _file2Value,
        "WARN",
        "Field comparison failed: price = price"
    );
end]]></ruleLogic>
    </darpan.rule.Rule>

    <darpan.rule.RuleSetCompareScope
            compareScopeId="DARPAN_TEST_ORDER_JSON_SCOPE"
            ruleSetId="DARPAN_TEST_COMPARE_RS"
            objectType="ORDER"
            description="Smoke-test compare scope for nested JSON order IDs."/>

    <darpan.rule.RuleSetCompareSource
            compareScopeId="DARPAN_TEST_ORDER_JSON_SCOPE"
            fileSide="FILE_1"
            systemEnumId="SHOPIFY"
            fileTypeEnumId="DftJson"
            recordRootExpression="data.orders.edges"
            primaryIdExpression="node.id|SHOPIFY_GID_TAIL"/>

    <darpan.rule.RuleSetCompareSource
            compareScopeId="DARPAN_TEST_ORDER_JSON_SCOPE"
            fileSide="FILE_2"
            systemEnumId="OMS"
            fileTypeEnumId="DftJson"
            recordRootExpression="data.orders.edges"
            primaryIdExpression="node.id"
            idValueNormalizer="SHOPIFY_GID_TAIL"/>

    <darpan.rule.RuleSetCompareScope
            compareScopeId="DARPAN_TEST_PRODUCT_JSON_SCOPE"
            ruleSetId="DARPAN_TEST_PRODUCT_COMPARE_RS"
            objectType="PRODUCT"
            description="Smoke-test compare scope for product field mismatches."/>

    <darpan.rule.RuleSetCompareSource
            compareScopeId="DARPAN_TEST_PRODUCT_JSON_SCOPE"
            fileSide="FILE_1"
            systemEnumId="SHOPIFY"
            fileTypeEnumId="DftJson"
            recordRootExpression="data.products"
            primaryIdExpression="productId"/>

    <darpan.rule.RuleSetCompareSource
            compareScopeId="DARPAN_TEST_PRODUCT_JSON_SCOPE"
            fileSide="FILE_2"
            systemEnumId="OMS"
            fileTypeEnumId="DftJson"
            recordRootExpression="data.products"
            primaryIdExpression="productId"/>
</entity-facade-xml>
