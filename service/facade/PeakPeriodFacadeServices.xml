<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <!-- DAR-BE-328 plan 1: peak periods. Every read carries an explicit companyUserGroupId condition and every
         single-row lookup goes through TenantScopedFinder.findOneOwnedByTenant (a foreign id reads as missing). -->

    <service verb="list" noun="PeakPeriods" authz-action="view" allow-remote="true" authenticate="true">
        <description>List the active tenant's peak periods with their state (upcoming, on, off, ended) in the tenant's local today.</description>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="peakPeriods" type="List">
                <parameter name="peakPeriodId"/><parameter name="periodName"/>
                <parameter name="fromDate"/><parameter name="thruDate"/>
                <parameter name="isActive"/><parameter name="state"/>
            </parameter>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <set field="today" from="java.time.LocalDate.now(darpan.facade.common.TenantAccessSupport.tenantTimeZoneFor(ec, tenantId))"/>
            <set field="periodRows" from="tenantId ? darpan.peak.PeakPeriodFacadeSupport.periodsOf(ec, tenantId) : []"/>
            <set field="peakPeriods" from="darpan.peak.PeakPeriodFacadeSupport.listRows(periodRows, today)"/>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="get" noun="PeakPeriod" authz-action="view" allow-remote="true" authenticate="true">
        <description>One peak period with its run-time moves, the runs its peak hours or a sync lag allowance hold, and the runs a move can name.</description>
        <in-parameters><parameter name="peakPeriodId" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="peakPeriod" type="Map">
                <parameter name="peakPeriodId"/><parameter name="periodName"/>
                <parameter name="fromDate"/><parameter name="thruDate"/>
                <parameter name="peakHoursStart"/><parameter name="peakHoursEnd"/>
                <parameter name="hotwaxReadSharePct" type="Integer"/><parameter name="netsuiteSerial"/>
                <parameter name="isActive"/><parameter name="state"/><parameter name="timeZone"/>
                <parameter name="createdByUserId"/><parameter name="lastUpdatedDate" type="Timestamp"/>
            </parameter>
            <parameter name="runTimes" type="List">
                <parameter name="runTimeId"/><parameter name="automationId"/><parameter name="auditId"/>
                <parameter name="targetLabel"/><parameter name="onDate"/><parameter name="runTime"/><parameter name="normalTime"/>
            </parameter>
            <parameter name="heldRuns" type="List">
                <parameter name="targetLabel"/><parameter name="normalTime"/><parameter name="startsAt"/><parameter name="reason"/>
            </parameter>
            <parameter name="targets" type="List">
                <parameter name="automationId"/><parameter name="auditId"/><parameter name="label"/>
            </parameter>
            <parameter name="syncRows" type="List">
                <parameter name="syncPairId"/><parameter name="label"/>
                <parameter name="normalAllowanceMinutes" type="Integer"/><parameter name="periodAllowanceMinutes" type="Integer"/>
                <parameter name="normalPulseMinutes" type="Integer"/><parameter name="periodPulseMinutes" type="Integer"/>
            </parameter>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <if condition="!tenantId"><message error="true">Active tenant is required for peak periods.</message></if>
            <set field="peakPeriodIdValue" from="((peakPeriodId)?.toString()?.trim())"/>
            <set field="periodRow" from="(!ec.message.hasError() &amp;&amp; peakPeriodIdValue) ? darpan.facade.common.TenantScopedFinder.findOneOwnedByTenant(ec, 'darpan.peak.PeakPeriod', 'peakPeriodId', peakPeriodIdValue, tenantId, 'peak period read verified against the active tenant after a primary-key read') : null"/>
            <if condition="!ec.message.hasError() &amp;&amp; periodRow == null">
                <message error="true">Peak period '${peakPeriodIdValue}' was not found.</message>
            </if>
            <if condition="!ec.message.hasError()">
                <set field="zone" from="darpan.facade.common.TenantAccessSupport.tenantTimeZoneFor(ec, tenantId)"/>
                <set field="today" from="java.time.LocalDate.now(zone)"/>
                <set field="targetInfo" from="darpan.peak.PeakPeriodFacadeSupport.targetsOf(ec, tenantId)"/>
                <set field="labelById" from="targetInfo.targets.collectEntries { [(it.automationId ?: it.auditId): it.label] }"/>
                <set field="fromLocal" from="darpan.peak.PeakPeriodFacadeSupport.toLocalDate(periodRow.fromDate)"/>
                <set field="thruLocal" from="darpan.peak.PeakPeriodFacadeSupport.toLocalDate(periodRow.thruDate)"/>
                <set field="normalTimes" from="darpan.peak.PeakPeriodFacadeSupport.normalTimes(targetInfo.scheduled, fromLocal, zone)"/>
                <set field="runTimeRows" from="darpan.peak.PeakPeriodFacadeSupport.rows(ec, 'darpan.peak.PeakPeriodRunTime', tenantId).condition('peakPeriodId', peakPeriodIdValue).orderBy(['onDate', 'runTime']).list() ?: []"/>
                <set field="runTimes" from="runTimeRows.collect { rt -> [runTimeId: rt.runTimeId, automationId: rt.automationId, auditId: rt.auditId, targetLabel: labelById[rt.automationId ?: rt.auditId] ?: (rt.automationId ?: rt.auditId), onDate: rt.onDate?.toString(), runTime: rt.runTime, normalTime: normalTimes[rt.automationId ?: rt.auditId]] }"/>
                <set field="peakWindow" from="darpan.peak.PeakPeriodFacadeSupport.windowOf(periodRow, runTimeRows, targetInfo.scheduled)"/>
                <set field="heldRuns" from="darpan.peak.PeakPeriodFacadeSupport.heldRuns(targetInfo.scheduled, peakWindow, zone, darpan.peak.PeakPeriodLoader.allowances(ec, tenantId))"/>
                <set field="targets" from="targetInfo.targets"/>
                <set field="syncRows" from="darpan.peak.PeakPeriodFacadeSupport.syncRows(ec, tenantId, peakPeriodIdValue)"/>
                <set field="peakPeriod" from="[peakPeriodId: periodRow.peakPeriodId, periodName: periodRow.periodName, fromDate: fromLocal.toString(), thruDate: thruLocal.toString(), peakHoursStart: periodRow.peakHoursStart, peakHoursEnd: periodRow.peakHoursEnd, hotwaxReadSharePct: periodRow.hotwaxReadSharePct, netsuiteSerial: periodRow.netsuiteSerial ?: 'N', isActive: periodRow.isActive ?: 'Y', state: darpan.peak.PeakPeriodFacadeSupport.stateOf(periodRow.getMap(), today), timeZone: zone.getId(), createdByUserId: periodRow.createdByUserId, lastUpdatedDate: periodRow.lastUpdatedDate]"/>
            </if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="save" noun="PeakPeriod" allow-remote="true" authenticate="true">
        <description>Create or update one peak period for the active tenant. Peak hours are both set or both blank; active periods may not overlap. An omitted hotwaxReadSharePct clears the share, as omitted peak hours clear the hours; an omitted netsuiteSerial keeps the stored value.</description>
        <in-parameters>
            <parameter name="peakPeriodId"/>
            <parameter name="periodName"/>
            <parameter name="fromDate" type="Date"/>
            <parameter name="thruDate" type="Date"/>
            <parameter name="peakHoursStart"/>
            <parameter name="peakHoursEnd"/>
            <parameter name="hotwaxReadSharePct" type="Integer"/>
            <parameter name="netsuiteSerial" type="Boolean"/>
            <parameter name="isActive" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="peakPeriodId"/>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <if condition="!tenantId"><message error="true">Active tenant is required for peak periods.</message></if>
            <if condition="!ec.message.hasError()">
                <set field="ignoreWriteAccess" from="darpan.facade.common.TenantAccessSupport.requireActiveTenantWriteAccess(ec, 'Your active tenant only has view access for peak periods.')"/>
            </if>
            <set field="peakPeriodIdValue" from="((peakPeriodId)?.toString()?.trim())"/>
            <set field="existingPeriod" from="(!ec.message.hasError() &amp;&amp; peakPeriodIdValue) ? darpan.facade.common.TenantScopedFinder.findOneOwnedByTenant(ec, 'darpan.peak.PeakPeriod', 'peakPeriodId', peakPeriodIdValue, tenantId, 'peak period edit target verified against the active tenant after a primary-key read') : null"/>
            <if condition="!ec.message.hasError() &amp;&amp; peakPeriodIdValue &amp;&amp; existingPeriod == null">
                <message error="true">Peak period '${peakPeriodIdValue}' was not found.</message>
            </if>
            <if condition="!ec.message.hasError()">
                <set field="isActiveValue" from="isActive == null ? (existingPeriod?.isActive ?: 'Y') : (isActive ? 'Y' : 'N')"/>
                <set field="periodMap" from="[periodName: ((periodName)?.toString()?.trim()) ?: null, fromDate: fromDate, thruDate: thruDate, peakHoursStart: ((peakHoursStart)?.toString()?.trim()) ?: null, peakHoursEnd: ((peakHoursEnd)?.toString()?.trim()) ?: null, hotwaxReadSharePct: hotwaxReadSharePct, isActive: isActiveValue]"/>
                <set field="otherPeriods" from="darpan.peak.PeakPeriodFacadeSupport.periodsOf(ec, tenantId).findAll { it.peakPeriodId != peakPeriodIdValue }"/>
                <set field="validationErrors" from="darpan.peak.PeakPeriodFacadeSupport.validatePeriod(periodMap, otherPeriods)"/>
                <iterate list="validationErrors" entry="validationError"><message error="true">${validationError}</message></iterate>
            </if>
            <if condition="!ec.message.hasError()">
                <set field="storeMap" from="[peakPeriodId: peakPeriodIdValue ?: null, companyUserGroupId: tenantId, periodName: periodMap.periodName, fromDate: fromDate, thruDate: thruDate, isActive: isActiveValue, createdByUserId: existingPeriod?.createdByUserId ?: darpan.facade.common.TenantAccessSupport.currentUserId(ec), lastUpdatedDate: ec.user.nowTimestamp].findAll { it.value != null }"/>
                <!-- Set explicitly: null is the intended value when peak hours are cleared, and findAll strips nulls. -->
                <set field="ignoreStart" from="storeMap.put('peakHoursStart', periodMap.peakHoursStart)"/>
                <set field="ignoreEnd" from="storeMap.put('peakHoursEnd', periodMap.peakHoursEnd)"/>
                <!-- Blank share = no HotWax limit (null). Serial: absent keeps the stored value on update, 'N' on create. -->
                <set field="ignoreShare" from="storeMap.put('hotwaxReadSharePct', hotwaxReadSharePct)"/>
                <set field="ignoreSerial" from="storeMap.put('netsuiteSerial', netsuiteSerial == null ? (existingPeriod?.netsuiteSerial ?: 'N') : (netsuiteSerial ? 'Y' : 'N'))"/>
                <service-call name="store#darpan.peak.PeakPeriod" in-map="storeMap" out-map="storeResult"/>
                <if condition="!ec.message.hasError()"><set field="peakPeriodId" from="peakPeriodIdValue ?: ((storeResult?.peakPeriodId)?.toString()?.trim())"/></if>
                <if condition="!ec.message.hasError()"><message>Saved peak period.</message></if>
            </if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="delete" noun="PeakPeriod" allow-remote="true" authenticate="true">
        <description>Delete a peak period, its run times and its sync overrides.</description>
        <in-parameters><parameter name="peakPeriodId" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <if condition="!tenantId"><message error="true">Active tenant is required for peak periods.</message></if>
            <if condition="!ec.message.hasError()">
                <set field="ignoreWriteAccess" from="darpan.facade.common.TenantAccessSupport.requireActiveTenantWriteAccess(ec, 'Your active tenant only has view access for peak periods.')"/>
            </if>
            <set field="peakPeriodIdValue" from="((peakPeriodId)?.toString()?.trim())"/>
            <set field="periodRow" from="(!ec.message.hasError() &amp;&amp; peakPeriodIdValue) ? darpan.facade.common.TenantScopedFinder.findOneOwnedByTenant(ec, 'darpan.peak.PeakPeriod', 'peakPeriodId', peakPeriodIdValue, tenantId, 'peak period delete target verified against the active tenant after a primary-key read') : null"/>
            <if condition="!ec.message.hasError() &amp;&amp; periodRow == null">
                <message error="true">Peak period '${peakPeriodIdValue}' was not found.</message>
            </if>
            <if condition="!ec.message.hasError()">
                <set field="ignoreRunTimes" from="darpan.peak.PeakPeriodFacadeSupport.deleteRunTimesOf(ec, tenantId, peakPeriodIdValue)"/>
                <set field="ignoreSyncRows" from="darpan.peak.PeakPeriodFacadeSupport.deleteSyncRowsOf(ec, tenantId, peakPeriodIdValue)"/>
                <set field="ignoreDelete" from="periodRow.delete()"/>
                <message>Deleted peak period.</message>
            </if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="save" noun="PeakPeriodRunTime" allow-remote="true" authenticate="true">
        <description>Create or update one run-time move of a peak period: a run (an automation or an audit) starts at runTime on onDate, or on every day of the period when onDate is blank.</description>
        <in-parameters>
            <parameter name="runTimeId"/>
            <parameter name="peakPeriodId" required="true"/>
            <parameter name="automationId"/>
            <parameter name="auditId"/>
            <parameter name="onDate" type="Date"/>
            <parameter name="runTime"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="runTimeId"/>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <if condition="!tenantId"><message error="true">Active tenant is required for peak periods.</message></if>
            <if condition="!ec.message.hasError()">
                <set field="ignoreWriteAccess" from="darpan.facade.common.TenantAccessSupport.requireActiveTenantWriteAccess(ec, 'Your active tenant only has view access for peak periods.')"/>
            </if>
            <set field="peakPeriodIdValue" from="((peakPeriodId)?.toString()?.trim())"/>
            <set field="runTimeIdValue" from="((runTimeId)?.toString()?.trim())"/>
            <set field="periodRow" from="(!ec.message.hasError() &amp;&amp; peakPeriodIdValue) ? darpan.facade.common.TenantScopedFinder.findOneOwnedByTenant(ec, 'darpan.peak.PeakPeriod', 'peakPeriodId', peakPeriodIdValue, tenantId, 'peak period read for a run time verified against the active tenant after a primary-key read') : null"/>
            <if condition="!ec.message.hasError() &amp;&amp; periodRow == null">
                <message error="true">Peak period '${peakPeriodIdValue}' was not found.</message>
            </if>
            <set field="existingRunTime" from="(!ec.message.hasError() &amp;&amp; runTimeIdValue) ? darpan.facade.common.TenantScopedFinder.findOneOwnedByTenant(ec, 'darpan.peak.PeakPeriodRunTime', 'runTimeId', runTimeIdValue, tenantId, 'peak run time edit target verified against the active tenant after a primary-key read') : null"/>
            <if condition="!ec.message.hasError() &amp;&amp; runTimeIdValue &amp;&amp; (existingRunTime == null || existingRunTime.peakPeriodId != peakPeriodIdValue)">
                <message error="true">Peak run time '${runTimeIdValue}' was not found.</message>
            </if>
            <if condition="!ec.message.hasError()">
                <set field="automationIdValue" from="((automationId)?.toString()?.trim()) ?: null"/>
                <set field="auditIdValue" from="((auditId)?.toString()?.trim()) ?: null"/>
                <set field="runTimeValue" from="((runTime)?.toString()?.trim()) ?: null"/>
                <set field="targetIds" from="darpan.peak.PeakPeriodFacadeSupport.targetsOf(ec, tenantId).ids"/>
                <set field="validationErrors" from="darpan.peak.PeakPeriodFacadeSupport.validateRunTime([automationId: automationIdValue, auditId: auditIdValue, onDate: onDate, runTime: runTimeValue], periodRow.getMap(), targetIds)"/>
                <iterate list="validationErrors" entry="validationError"><message error="true">${validationError}</message></iterate>
            </if>
            <if condition="!ec.message.hasError()">
                <set field="storeMap" from="[runTimeId: runTimeIdValue ?: null, peakPeriodId: peakPeriodIdValue, companyUserGroupId: tenantId, runTime: runTimeValue].findAll { it.value != null }"/>
                <!-- Set explicitly: null is the intended value for the side not chosen and for an every-day move. -->
                <set field="ignoreAutomation" from="storeMap.put('automationId', automationIdValue)"/>
                <set field="ignoreAudit" from="storeMap.put('auditId', auditIdValue)"/>
                <set field="ignoreOnDate" from="storeMap.put('onDate', onDate)"/>
                <service-call name="store#darpan.peak.PeakPeriodRunTime" in-map="storeMap" out-map="storeResult"/>
                <if condition="!ec.message.hasError()"><set field="runTimeId" from="runTimeIdValue ?: ((storeResult?.runTimeId)?.toString()?.trim())"/></if>
                <if condition="!ec.message.hasError()"><message>Saved run time.</message></if>
            </if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="delete" noun="PeakPeriodRunTime" allow-remote="true" authenticate="true">
        <description>Delete one run-time move of a peak period.</description>
        <in-parameters><parameter name="runTimeId" required="true"/></in-parameters>
