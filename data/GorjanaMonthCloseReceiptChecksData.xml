<?xml version="1.0" encoding="UTF-8"?>
<!--
  DAR-BE-097 — gorjana month close, comparison 5 (receipts): R11. R15 (store handovers) waits for the team (their Q6).

  R11 "A warranty piece that arrives is booked, even when the claim is closed."
     OMS warranty returns (OMS_RETURNS_GQL, by entry date) against NetSuite RMAs that HAVE a linked item receipt
     (tools/netsuite-chain-config/gorjana-month-close-queries.xml, NS_RMA_RECEIVED), keyed by the HC return id. A return
     missing on the NetSuite side whose items show a received quantity, on a warranty channel, is a piece that arrived
     and was never booked: CONC_ARRIVED_NOT_BOOKED.

  WHAT THIS CANNOT SEE. The cases behind R11 (gorjana-maarg prod-issues-scenarios.json iarr1-iarr4: M225164, M222926,
  M222992, M247365) are arrivals AfterShip reported whose quantity the OMS never saved; neither the OMS nor NetSuite
  knows the piece came back, and Darpan does not read AfterShip. This check catches the other half: the OMS saved the
  arrival and NetSuite has no receipt (the item receipt failed, e.g. "Status change not allowed from Completed to
  Authorized" after the claim closed).

  The warranty channels are the HotWax return channels HotWax writes to NetSuite's custbody_hc_return_channel
  (AfterShip warranty and Happiness Guarantee); a plain AfterShip, POS or admin return is not R11's.

  automationId is blank on purpose: one automation per environment, two sources (FILE_1 OMS_RETURNS_GQL with
  omsRestSourceConfigId gorjana_prod, FILE_2 NETSUITE_SUITEQL with nsSuiteQlSourceQueryId NS_RMA_RECEIVED).

  NOT seed data - tenant configuration. Load per install, AFTER AuditSeedData.xml, GorjanaMonthCloseCatalogData.xml and
  tools/netsuite-chain-config/gorjana-month-close-queries.xml:

      ec.entity.makeDataLoader().location("component://darpan/data/GorjanaMonthCloseReceiptChecksData.xml").load()
-->
<!--
  DAR-BE-097 R15 "An exchange piece handed over at a store is booked at that store." (Aditi, 2026-10-22: R15 stays in
  month close.) Run C's pair (OMS order items against NetSuite sales order lines, keyed by OMS order id and item seq id;
  TriSystemOrderRunsRuleSetData.xml) narrowed to exchange orders, whose names start with EXC- (EXC-#GOR195591082-2) and
  which differ from an ordinary order in nothing else (filter INCLUDE_PREFIX). Rule GORJANA_R15_LOCATION: the OMS item's
  facility = the NetSuite line's location. Probed 2026-10-22: a NetSuite location's internal id IS the OMS facility id
  (29 Irvine Spectrum, 199 Brea, 42 Americana, 28 Newport Beach, 72 Carlsbad on both sides), so the compare is direct.
  An exchange shipped from the warehouse (OMS facility WH, NetSuite location 31 Ecomm; AfterShip exchanges, 40 of 320
  items on 14 Oct) is not handed over at a store: left out (facilityId EXCLUDE_IN WH).
-->
<entity-facade-xml type="darpan-tenant-config">

    <moqui.basic.Enumeration enumId="CONC_ARRIVED_NOT_BOOKED" enumTypeId="DarpanConclusion" enumCode="CONC_ARRIVED_NOT_BOOKED" description="Arrived in the OMS, no item receipt in NetSuite"/>

    <darpan.rule.RuleSet ruleSetId="GORJANA_WARRANTY_RECEIPT_RS" ruleSetName="Warranty arrivals - NetSuite item receipts"
            description="Every warranty piece the OMS received has an item receipt on its NetSuite RMA."
            version="1.0" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareScope compareScopeId="GORJANA_WARRANTY_RECEIPT_SCOPE" ruleSetId="GORJANA_WARRANTY_RECEIPT_RS"
            objectType="RETURN" scopeMode="COMPARE" description="Every warranty piece the OMS received has an item receipt on its NetSuite RMA."
            companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSource compareScopeId="GORJANA_WARRANTY_RECEIPT_SCOPE" fileSide="FILE_1"
            systemEnumId="OMS_RETURNS_GQL" sourceTypeEnumId="AUT_SRC_API" fileTypeEnumId="DftJson"
            recordRootExpression="records" primaryIdExpression="returnId"
            sourceConfigId="gorjana_prod" sourceConfigType="HOTWAX_OMS_GQL_RETURNS" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSourceKeyField compareScopeId="GORJANA_WARRANTY_RECEIPT_SCOPE" fileSide="FILE_1" sequenceNum="1" fieldExpression="returnId" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSource compareScopeId="GORJANA_WARRANTY_RECEIPT_SCOPE" fileSide="FILE_2"
            systemEnumId="NETSUITE_SUITEQL" sourceTypeEnumId="AUT_SRC_API" fileTypeEnumId="DftJson"
            recordRootExpression="records" primaryIdExpression="returnId"
            sourceConfigId="NS_RMA_RECEIVED" sourceConfigType="NETSUITE_SUITEQL" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSourceKeyField compareScopeId="GORJANA_WARRANTY_RECEIPT_SCOPE" fileSide="FILE_2" sequenceNum="1" fieldExpression="returnId" companyUserGroupId="GORJANA"/>

    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_WARRANTY_RECEIPT_SCOPE" sequenceNum="10" conclusionEnumId="CONC_ARRIVED_NOT_BOOKED" appliesToBucket="MISSING_FROM_FILE_2" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_WARRANTY_RECEIPT_SCOPE" sequenceNum="10" conditionSeq="1" subject="FILE_1" presence="ANY" keyScope="FULL" fieldExpression="returnChannelEnumId" operator="IN" conditionValues="AFTSHP_HG_LOSS,AFTSHP_OL_WTY,AFTSHP_NO_POP,AFTSHP_HG_EMPL,AFTSHP_SCE_WTY,HAPPINESS_GUARANTEE" checkLabel="A warranty claim" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_WARRANTY_RECEIPT_SCOPE" sequenceNum="10" conditionSeq="2" subject="FILE_1" presence="ANY" keyScope="FULL" fieldExpression="items.receivedQuantity" operator="GT_ZERO" quantifier="ANY" checkLabel="The OMS received the piece" companyUserGroupId="GORJANA"/>

    <darpan.audit.AuditCheck checkId="GORJANA_CHK_WARRANTY_RECEIPT" companyUserGroupId="GORJANA" checkCode="warranty-arrivals-without-receipt"
            label="Warranty pieces the OMS received with no NetSuite item receipt" savedRunId="GORJANA_WARRANTY_RECEIPT_RS"
            file1RecordType="return" graceDays="2"
            matchedBy="return id (custbody_hc_return_id on the RMA; the receipt by link)"
            fixOwner="HotWax Support" fixWhereEnumId="NETSUITE"
            headlineTemplate="Warranty return {return} arrived in the OMS and has no NetSuite item receipt"
            fixActionTemplate="Receive return {return}'s piece in NetSuite (an item receipt on its RMA, at the damage location with QC), even if the claim is closed."
            passesWhenTemplate="Return {return}'s RMA carries an item receipt."/>
    <darpan.audit.AuditStatementCheck statementId="GORJANA_R11" checkId="GORJANA_CHK_WARRANTY_RECEIPT" companyUserGroupId="GORJANA"
            sequenceNum="1" diffTypes="MISSING_IN_FILE_2" conclusionCodes="CONC_ARRIVED_NOT_BOOKED"/>


    <!-- ================================================================ R15: exchange pieces booked at their store -->
    <darpan.rule.RuleSet ruleSetId="GORJANA_EXCHANGE_LOCATION_RS" ruleSetName="Exchange orders - HotWax facility vs NetSuite line location"
            description="Every exchange piece HotWax completed is booked in NetSuite at the facility that handed it over. Keyed (OMS order id, OMS order item seq id)."
            version="1.0" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareScope compareScopeId="GORJANA_EXCHANGE_LOCATION_SCOPE" ruleSetId="GORJANA_EXCHANGE_LOCATION_RS"
            objectType="ORDER_LINE_UNIT" scopeMode="COMPARE" description="Every exchange piece HotWax completed is booked in NetSuite at the facility that handed it over. Keyed (OMS order id, OMS order item seq id)."
            companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSource compareScopeId="GORJANA_EXCHANGE_LOCATION_SCOPE" fileSide="FILE_1"
            systemEnumId="OMS_ORDER_ITEMS" sourceTypeEnumId="AUT_SRC_API" fileTypeEnumId="DftJson"
            recordRootExpression="records" primaryIdExpression="omsOrderId"
            sourceConfigId="gorjana_prod" sourceConfigType="HOTWAX_OMS_REST_ORDER_ITEMS" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSourceKeyField compareScopeId="GORJANA_EXCHANGE_LOCATION_SCOPE" fileSide="FILE_1" sequenceNum="1" fieldExpression="omsOrderId" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSourceKeyField compareScopeId="GORJANA_EXCHANGE_LOCATION_SCOPE" fileSide="FILE_1" sequenceNum="2" fieldExpression="orderItemSeqId" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSourceFilter compareScopeId="GORJANA_EXCHANGE_LOCATION_SCOPE" fileSide="FILE_1" sequenceNum="1" fieldExpression="unitState" operator="INCLUDE_IN" filterValues="COMPLETED" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSourceFilter compareScopeId="GORJANA_EXCHANGE_LOCATION_SCOPE" fileSide="FILE_1" sequenceNum="2" fieldExpression="omsOrderName" operator="INCLUDE_PREFIX" filterValues="EXC-" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSourceFilter compareScopeId="GORJANA_EXCHANGE_LOCATION_SCOPE" fileSide="FILE_1" sequenceNum="3" fieldExpression="facilityId" operator="EXCLUDE_IN" filterValues="WH" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSource compareScopeId="GORJANA_EXCHANGE_LOCATION_SCOPE" fileSide="FILE_2"
            systemEnumId="NETSUITE_SUITEQL" sourceTypeEnumId="AUT_SRC_API" fileTypeEnumId="DftJson"
            recordRootExpression="records" primaryIdExpression="orderId"
            sourceConfigId="NS_SO_SHIPPED_LINES" sourceConfigType="NETSUITE_SUITEQL" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSourceKeyField compareScopeId="GORJANA_EXCHANGE_LOCATION_SCOPE" fileSide="FILE_2" sequenceNum="1" fieldExpression="orderId" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSourceKeyField compareScopeId="GORJANA_EXCHANGE_LOCATION_SCOPE" fileSide="FILE_2" sequenceNum="2" fieldExpression="orderLineId" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSourceFilter compareScopeId="GORJANA_EXCHANGE_LOCATION_SCOPE" fileSide="FILE_2" sequenceNum="1" fieldExpression="orderName" operator="INCLUDE_PREFIX" filterValues="EXC-" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSourceFilter compareScopeId="GORJANA_EXCHANGE_LOCATION_SCOPE" fileSide="FILE_2" sequenceNum="2" fieldExpression="itemType" operator="EXCLUDE_IN" filterValues="Discount" companyUserGroupId="GORJANA"/>
    <darpan.rule.Rule ruleId="GORJANA_R15_LOCATION" ruleSetId="GORJANA_EXCHANGE_LOCATION_RS" sequenceNum="10"
            ruleText="facilityId = lineLocation" enabled="Y" ruleType="FIELD_COMPARISON" severity="WARN"
            companyUserGroupId="GORJANA">
        <expression>{"type":"FIELD_COMPARISON","file1FieldPath":"facilityId","file2FieldPath":"lineLocation","operator":"=","preActions":[{"fieldSide":"file1","action":"STRING_TO_INT"},{"fieldSide":"file2","action":"STRING_TO_INT"}]}</expression>
        <ruleLogic><![CDATA[rule "GORJANA_R15_LOCATION"
when
    $m : Map(this["file1"] != null, this["file2"] != null)
    eval(reconciliation.rule.RuleDiffSupport.violatesOperator(reconciliation.rule.RuleDiffSupport.applyPreActions(((Map) $m.get("file1")).get("facilityId"), java.util.Arrays.asList("STRING_TO_INT")), reconciliation.rule.RuleDiffSupport.applyPreActions(((Map) $m.get("file2")).get("lineLocation"), java.util.Arrays.asList("STRING_TO_INT")), "="))
then
    Object _file1Value = reconciliation.rule.RuleDiffSupport.applyPreActions(((Map) $m.get("file1")).get("facilityId"), java.util.Arrays.asList("STRING_TO_INT"));
    Object _file2Value = reconciliation.rule.RuleDiffSupport.applyPreActions(((Map) $m.get("file2")).get("lineLocation"), java.util.Arrays.asList("STRING_TO_INT"));
    reconciliation.rule.RuleDiffSupport.addFieldMismatch(
        $m,
        kcontext.getRule().getName(),
        "facilityId = lineLocation",
        _file1Value,
        _file2Value,
        "WARN",
        "Field comparison failed: facilityId = lineLocation"
    );
end]]></ruleLogic>
    </darpan.rule.Rule>
    <darpan.audit.AuditCheck checkId="GORJANA_CHK_EXCHANGE_LOCATION" companyUserGroupId="GORJANA" checkCode="exchange-pieces-booked-elsewhere"
            label="Exchange pieces booked at another NetSuite location than the facility that handed them over" savedRunId="GORJANA_EXCHANGE_LOCATION_RS"
            file1RecordType="orderItem" graceDays="1"
            matchedBy="OMS order id and item seq id (custbody_hc_order_id, custcol_hc_order_line_id)"
            fixOwner="HotWax Support" fixWhereEnumId="NETSUITE"
            headlineTemplate="Exchange item {recordKey}: handed over at facility {file1Value}, booked at NetSuite location {file2Value}"
            fixActionTemplate="Set the location of exchange item {recordKey}'s NetSuite line to {file1Value}, the facility that handed it over."
            passesWhenTemplate="The NetSuite line of exchange item {recordKey} is at the facility that handed it over."/>
    <darpan.audit.AuditStatementCheck statementId="GORJANA_R15" checkId="GORJANA_CHK_EXCHANGE_LOCATION" companyUserGroupId="GORJANA"
            sequenceNum="1" diffTypes="FIELD_MISMATCH" ruleIds="GORJANA_R15_LOCATION"/>
</entity-facade-xml>
