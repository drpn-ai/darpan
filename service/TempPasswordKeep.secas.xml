<?xml version="1.0" encoding="UTF-8"?>
<!--
  DAR-BE-325. Every password set goes through update#PasswordInternal: the person's own change (update#Password, the
  first-sign-in change), the forgot-password reset, and the admin create/reset. When a password the person chose is
  set (requirePasswordChange not Y), the temporary password kept for their welcome email is deleted in the same
  transaction, so it goes with the change or stays with its rollback. post-service, not tx-commit: Moqui runs tx-commit
  rules later on a pool thread. Not on error (run-on-error defaults false). An admin's temporary password
  (requirePasswordChange Y) is kept by the admin service itself, after this call.
-->
<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <seca id="TempPasswordKeepDrop" service="org.moqui.impl.UserServices.update#PasswordInternal" when="post-service">
        <condition><expression>updateSuccessful &amp;&amp; requirePasswordChange != 'Y'</expression></condition>
        <actions><script>darpan.admin.TempPasswordKeeper.drop(ec, userId)</script></actions>
    </seca>
</secas>
