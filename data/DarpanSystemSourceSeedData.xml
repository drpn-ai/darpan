<?xml version="1.0" encoding="UTF-8"?>
<entity-facade-xml type="darpan-seed">
    <moqui.basic.EnumerationType
            enumTypeId="DarpanSystemSource"
            description="Darpan System Source"/>

    <moqui.basic.Enumeration
            enumId="OMS"
            enumTypeId="DarpanSystemSource"
            enumCode="HOTWAX"
            description="HotWax"
            sequenceNum="1"/>

    <moqui.basic.Enumeration
            enumId="SHOPIFY"
            enumTypeId="DarpanSystemSource"
            enumCode="SHOPIFY"
            description="Shopify"
            sequenceNum="2"/>

    <moqui.basic.Enumeration
            enumId="NETSUITE"
            enumTypeId="DarpanSystemSource"
            enumCode="NETSUITE"
            description="NetSuite"
            sequenceNum="3"/>

    <moqui.basic.Enumeration
            enumId="SAPI"
            enumTypeId="DarpanSystemSource"
            enumCode="SAPI"
            description="SAPI"
            sequenceNum="4"/>

    <moqui.basic.Enumeration
            enumId="DATABASE"
            enumTypeId="DarpanSystemSource"
            enumCode="DATABASE"
            description="Database"
            sequenceNum="5"/>

    <!-- parentEnumId groups this row under OMS for the source picker: step 1 asks for the system
         (OMS/HotWax), step 2 asks for the endpoint (this row is one of OMS's choices, alongside
         OMS itself as the default "Orders" endpoint). See list#AutomationSourceOptions and
         darpan-ui's darpanSystems.ts for the consumers. -->
    <moqui.basic.Enumeration
            enumId="OMS_TRANSFER_ORDERS"
            enumTypeId="DarpanSystemSource"
            enumCode="HOTWAX_TRANSFER_ORDERS"
            description="HotWax Transfer Orders"
            sequenceNum="6"
            parentEnumId="OMS"/>

    <moqui.basic.Enumeration
            enumId="OMS_RECON_ORDERS"
            enumTypeId="DarpanSystemSource"
            enumCode="HOTWAX_RECON_ORDERS"
            description="HotWax Orders (Reconciliation API)"
            sequenceNum="7"
            parentEnumId="OMS"/>

    <moqui.basic.Enumeration
            enumId="OMS_RETURNS"
            enumTypeId="DarpanSystemSource"
            enumCode="HOTWAX_RETURNS"
            description="HotWax Returns (Reconciliation API)"
            sequenceNum="8"
            parentEnumId="OMS"/>

    <!-- DAR-BE-018. Per-order Shopify refund/return id sets, cursor-paginated (task 9). Its own
         SourceSystemConnector row references this enum by systemEnumId, so this row must load
         first (see upgrade-data.xml's ordering note). parentEnumId groups it under SHOPIFY for
         the two-step source picker (see comment above). -->
    <moqui.basic.Enumeration
            enumId="SHOPIFY_RETURN_REFS"
            enumTypeId="DarpanSystemSource"
            enumCode="SHOPIFY_RETURN_REFS"
            description="Shopify Order Return References"
            sequenceNum="9"
            parentEnumId="SHOPIFY"/>

    <!-- DAR-BE-050. The two endpoints of the order-line UNIT presence pair. They are endpoints,
         not systems: both sit under their parent system in the source picker, exactly like
         OMS_TRANSFER_ORDERS does. Both rows are REQUIRED before either extractor can run -
         requireUsableOmsConfig / requireUsableAuthConfig resolve the endpoint through
         SourceEndpointAccessSupport.isEndpointEnabled, which treats a MISSING enablement row as
         enabled but an endpoint absent from this enum list as DISABLED. So no per-config backfill
         is owed, but without these rows every extract fails with "not enabled for ...". -->
    <moqui.basic.Enumeration
            enumId="SHOPIFY_ORDER_LINE_UNITS"
            enumTypeId="DarpanSystemSource"
            enumCode="SHOPIFY_ORDER_LINE_UNITS"
            description="Shopify Order Line Units"
            sequenceNum="10"
            parentEnumId="SHOPIFY"/>

    <moqui.basic.Enumeration
            enumId="OMS_ORDER_LINE_UNITS"
            enumTypeId="DarpanSystemSource"
            enumCode="HOTWAX_ORDER_LINE_UNITS"
            description="HotWax Order Line Units"
            sequenceNum="11"
            parentEnumId="OMS"/>
</entity-facade-xml>
