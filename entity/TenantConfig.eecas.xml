<?xml version="1.0" encoding="UTF-8"?>
<!--
  DAR-BE-160 phase A. Every table a tenant config version holds (TransferSpecs.KINDS, their children and links, and
  TenantConclusion for conclusion codes) notes a write to it, so the tenant gets a version without each save service
  asking. note() only records the tenant on the transaction; it is marked pending after the commit, once per transaction
  (darpan.config.TenantConfigChangeTracker). Runs before the write so a delete still knows its tenant; a write that then
  fails rolls back and marks nothing. TenantConfigAutoVersionSmokeTests holds this list to the transfer specs.
-->
<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">
    <eeca id="TenantConfigChange_NsAuthConfig" entity="darpan.reconciliation.NsAuthConfig" on-create="true" on-update="true" on-delete="true"
            run-before="true" get-entire-entity="true">
        <actions><script>darpan.config.TenantConfigChangeTracker.note(ec, 'darpan.reconciliation.NsAuthConfig', entityValue)</script></actions>
    </eeca>
