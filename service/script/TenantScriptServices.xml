<?xml version="1.0" encoding="UTF-8"?>
<!-- Script work with no user session; each deployment runs as its own tenant (darpan.script.ScriptDeploymentSupport). -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="scan" noun="DueScriptDeployments" transaction="ignore" allow-remote="false" authenticate="anonymous-all">
        <description>Runs the script deployments that are due (job scan_TenantScriptDeployments_5m) and stamps each
            outcome on it; one failing never stops the others. While Darpan is busy a due one waits, then expires.</description>
        <in-parameters>
            <parameter name="nowTimestamp" type="Timestamp"/>
            <parameter name="limit" type="Integer" default-value="50"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ran" type="Integer"/>
            <parameter name="held" type="Integer"><description>Deployments left WAITING or marked EXPIRED because the core was busy.</description></parameter>
            <parameter name="results" type="List"/>
        </out-parameters>
        <actions>
            <set field="scan" from="darpan.script.ScriptDeploymentSupport.scanDue(ec, nowTimestamp, limit)"/>
            <set field="ran" from="scan.ran"/>
            <set field="held" from="scan.held"/>
            <set field="results" from="scan.results"/>
        </actions>
    </service>
</services>
