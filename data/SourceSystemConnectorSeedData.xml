<?xml version="1.0" encoding="UTF-8"?>
<!-- SourceSystemConnector registry seed (DAR-292 / DAR-293, Phase 1).
     OMS + SHOPIFY rows reproduce the current per-system dispatch switch BYTE-IDENTICALLY. Values
     mirror the constants in ReconciliationSavedRunSupport / AutomationExecutionSupport:
       - extractServiceName          <- HOTWAX_OMS_ORDERS_EXTRACT_SERVICE / SHOPIFY_ORDERS_EXTRACT_SERVICE
       - dateFrom/ToParameterName    <- windowStart / windowEnd (defaultDate*ParameterName switch)
       - preserveWindowInstants      <- Y only for Shopify (AutomationExecutionSupport:634)
       - expectedSourceConfigType    <- HOTWAX_OMS_REST / SHOPIFY_AUTH (expectedSourceConfigType switch)
       - remoteId / endpointLabel    <- HOTWAX_ORDERS_API "Orders API" / SHOPIFY_REMOTE "Admin GraphQL Orders"
       - sendUrlTemplate             <- the ensureVirtual*OrdersRemote sendUrl templates
       - systemAliases               <- canonicalSystemEnumId alias table
     configIdResolverServiceName / validationServiceName are intentionally left blank: today these are
     Groovy static methods, not Moqui services; converting + allow-listing them is a later phase.
     NetSuite / SAPI are intentionally deferred to a later phase. -->
<entity-facade-xml type="darpan-seed">
    <darpan.reconciliation.SourceSystemConnector
            systemEnumId="OMS"
            extractServiceName="reconciliation.HotWaxOmsExtractionServices.extract#HotWaxOmsOrders"
            dateFromParameterName="windowStart"
            dateToParameterName="windowEnd"
            expectedSourceConfigType="HOTWAX_OMS_REST"
            configParameterName="omsRestSourceConfigId"
            configEntityName="darpan.hotwax.HotWaxOmsRestSourceConfig"
            remoteId="HOTWAX_ORDERS_API"
            endpointLabel="Orders API"
            sendUrlTemplate="{baseUrl}/rest/s1/oms/orders"
            remoteSendServiceName="reconciliation.HotWaxOmsExtractionServices.extract#HotWaxOmsOrders"
            systemAliases="OMS,HOTWAX,DAR_SYS_OMS"
            preserveWindowInstants="N"
            keepFieldsParameterName="keepRecordFields"
            keepFieldsBase="orderId,orderName,externalId,grandTotal,orderDate,statusId"
            filterParameterName="sourceFilters"
            pairLookupServiceName="reconciliation.HotWaxOmsExtractionServices.lookup#HotWaxOmsOrdersByExternalId"
            healthCheckServiceName="facade.HotWaxOmsFacadeServices.probe#HotWaxOmsConnection"
            enabled="Y"/>

    <darpan.reconciliation.SourceSystemConnector
            systemEnumId="SHOPIFY"
            extractServiceName="reconciliation.ShopifyOrderExtractionServices.extract#ShopifyOrders"
            dateFromParameterName="windowStart"
            dateToParameterName="windowEnd"
            expectedSourceConfigType="SHOPIFY_AUTH"
            configParameterName="shopifyAuthConfigId"
            configEntityName="darpan.shopify.ShopifyAuthConfig"
            remoteId="SHOPIFY_REMOTE"
            endpointLabel="Admin GraphQL Orders"
            sendUrlTemplate="https://{shop}.myshopify.com/admin/api/{apiVersion}/graphql.json"
            remoteSendServiceName="facade.ShopifyFacadeServices.execute#ShopifyGraphql"
            systemAliases="SHOPIFY,DAR_SYS_SHOPIFY"
            preserveWindowInstants="Y"
            lookupServiceName="reconciliation.ShopifyOrderExtractionServices.lookup#ShopifyOrderIds"
            exchangeStateLookupServiceName="reconciliation.ShopifyOrderExtractionServices.lookup#ShopifyOrderExchangeState"
            exchangeSweepServiceName="reconciliation.ShopifyOrderExtractionServices.lookup#ShopifyExchangeSweep"
            healthCheckServiceName="facade.ShopifyFacadeServices.probe#ShopifyAuthConnection"
            enabled="Y"/>

    <!-- NETSUITE has no automation extractor; this row exists so the saved-run path resolves its
         expectedSourceConfigType (NETSUITE_AUTH) + aliases from the registry (config over code).
         No extractServiceName / configParameterName / remote fields on purpose. -->
    <darpan.reconciliation.SourceSystemConnector
            systemEnumId="NETSUITE"
            expectedSourceConfigType="NETSUITE_AUTH"
            systemAliases="NETSUITE,DAR_SYS_NETSUITE"
            preserveWindowInstants="N"
            enabled="Y"/>

    <!-- Transfer orders are served by the SAME /rest/s1/oms/orders endpoint and the SAME credentials as
         sales orders; only the order type differs, and it is a server-side query filter. The row still
         needs its own extractServiceName and expectedSourceConfigType because both connector resolvers
         (resolveByExtractServiceName, resolveByExpectedSourceConfigType) take the first enabled match on
         those attributes — two rows sharing either one would resolve ambiguously and silently.
         No pairLookupServiceName: exchange pair verification is a sales-order concern. -->
    <darpan.reconciliation.SourceSystemConnector
            systemEnumId="OMS_TRANSFER_ORDERS"
            extractServiceName="reconciliation.HotWaxOmsExtractionServices.extract#HotWaxOmsTransferOrders"
            dateFromParameterName="windowStart"
            dateToParameterName="windowEnd"
            expectedSourceConfigType="HOTWAX_OMS_REST_TRANSFER"
            configParameterName="omsRestSourceConfigId"
            configEntityName="darpan.hotwax.HotWaxOmsRestSourceConfig"
            remoteId="HOTWAX_ORDERS_API"
            endpointLabel="Orders API (Transfer Orders)"
            sendUrlTemplate="{baseUrl}/rest/s1/oms/orders"
            remoteSendServiceName="reconciliation.HotWaxOmsExtractionServices.extract#HotWaxOmsTransferOrders"
            systemAliases="OMS_TRANSFER_ORDERS,HOTWAX_TRANSFER_ORDERS,DAR_SYS_OMS_TO"
            preserveWindowInstants="N"
            keepFieldsParameterName="keepRecordFields"
            keepFieldsBase="orderId,orderName,orderDate,statusId,originFacilityId,grandTotal,currencyUom"
            filterParameterName="sourceFilters"
            windowFieldName="orderDate"
            supportsStateExtract="Y"
            statusParameterName="orderStatusIds"
            healthCheckServiceName="facade.HotWaxOmsFacadeServices.probe#HotWaxOmsConnection"
            enabled="Y"/>

    <!-- OMS sales orders again, but served by /rest/s1/oms/reconciliationOrders, which filters to
         comparison-eligible sales orders server-side, projects to the six-field set, honours pageSize
         and reports hasMore/ordersCount (DAR-BE-018). ADDITIVE and opt-in: the OMS row above is
         untouched, and a rule set moves across by pointing its source at HOTWAX_OMS_REST_RECON —
         against the SAME HotWaxOmsRestSourceConfig row, since the credentials and baseUrl are shared.

         Its own systemEnumId AND its own expectedSourceConfigType are both required: the two
         resolvers take the first enabled match on those attributes, so a row cloning either one
         would shadow the shipped OMS row silently (SourceSystemConnectorSupportSmokeTests ratchets
         this). remoteId is deliberately shared with OMS — same API family, same credentials — and
         costs nothing here because the virtual-remote builder only ever fires for canonical OMS.

         sendUrlTemplate documents the endpoint for the registry and the remote label; it does NOT
         route the extractor, which pins DEFAULT_RECON_ORDERS_PATH rather than reading the tenant
         config's (legacy) ordersPath column.

         GATING: the endpoint returns a FIXED field set. Before enabling this connector for a rule
         set, verify its join key and every field-comparison field fall inside keepFieldsBase below;
         anything wider must stay on the OMS row. filterParameterName is retained because configured
         exclusions still run client-side — the endpoint has no knowledge of tenant exclusion rules.
         No pairLookupServiceName: exchange counterparts arrive inline on the record, so the manifest
         is built without point lookups. -->
    <darpan.reconciliation.SourceSystemConnector
            systemEnumId="OMS_RECON_ORDERS"
            extractServiceName="reconciliation.HotWaxOmsExtractionServices.extract#HotWaxOmsReconciliationOrders"
            dateFromParameterName="windowStart"
            dateToParameterName="windowEnd"
            expectedSourceConfigType="HOTWAX_OMS_REST_RECON"
            configParameterName="omsRestSourceConfigId"
            configEntityName="darpan.hotwax.HotWaxOmsRestSourceConfig"
            remoteId="HOTWAX_ORDERS_API"
            endpointLabel="Reconciliation Orders API"
            sendUrlTemplate="{baseUrl}/rest/s1/oms/reconciliationOrders"
            remoteSendServiceName="reconciliation.HotWaxOmsExtractionServices.extract#HotWaxOmsReconciliationOrders"
            systemAliases="OMS_RECON_ORDERS,HOTWAX_RECON_ORDERS,DAR_SYS_OMS_RECON"
            preserveWindowInstants="N"
            keepFieldsParameterName="keepRecordFields"
            keepFieldsBase="orderId,orderName,externalId,grandTotal,orderDate,statusId"
            filterParameterName="sourceFilters"
            healthCheckServiceName="facade.HotWaxOmsFacadeServices.probe#HotWaxOmsConnection"
            enabled="Y"/>

    <!-- OMS returns via /rest/s1/oms/reconciliationReturns (DAR-BE-018). NEW CAPABILITY: Darpan did
         not reconcile returns before this row, so nothing is being migrated and no existing rule set
         changes behaviour.

         Its own systemEnumId AND its own expectedSourceConfigType are both required — the resolvers
         take the first enabled match on either attribute, so a row cloning one would silently shadow
         a shipped row (SourceSystemConnectorSupportSmokeTests ratchets this). remoteId is shared with
         the OMS family because the credentials and baseUrl are the same tenant config row.

         sendUrlTemplate documents the endpoint for the registry and the remote label; it does NOT
         route the extractor, which pins DEFAULT_RETURNS_PATH.

         filterParameterName is REQUIRED here, not optional: the returnChannelEnumId exclusion is part
         of the phase-1 design (§5), and exclusion dispatch keys on this attribute. Without it the
         rules board hides the exclusion control and a configured rule would never run.

         keepFieldsBase mirrors the endpoint's header field set. items[] is nested rather than a
         top-level field and is always retained by the extractor regardless of projection. -->
    <darpan.reconciliation.SourceSystemConnector
            systemEnumId="OMS_RETURNS"
            extractServiceName="reconciliation.HotWaxOmsExtractionServices.extract#HotWaxOmsReturns"
            dateFromParameterName="windowStart"
            dateToParameterName="windowEnd"
            expectedSourceConfigType="HOTWAX_OMS_REST_RETURNS"
            configParameterName="omsRestSourceConfigId"
            configEntityName="darpan.hotwax.HotWaxOmsRestSourceConfig"
            remoteId="HOTWAX_ORDERS_API"
            endpointLabel="Reconciliation Returns API"
            sendUrlTemplate="{baseUrl}/rest/s1/oms/reconciliationReturns"
            remoteSendServiceName="reconciliation.HotWaxOmsExtractionServices.extract#HotWaxOmsReturns"
            systemAliases="OMS_RETURNS,HOTWAX_RETURNS,DAR_SYS_OMS_RETURNS"
            preserveWindowInstants="N"
            keepFieldsParameterName="keepRecordFields"
            keepFieldsBase="returnId,shopifyReturnId,externalId,orderExternalId,statusId,entryDate,returnTotal,currencyUomId,returnChannelEnumId"
            filterParameterName="sourceFilters"
            healthCheckServiceName="facade.HotWaxOmsFacadeServices.probe#HotWaxOmsConnection"
            orderStateLookupServiceName="reconciliation.HotWaxOmsExtractionServices.lookup#HotWaxOmsOrdersByExternalId"
            lookupServiceName="reconciliation.HotWaxOmsExtractionServices.lookup#HotWaxOmsReturnsByExternalId"
            lookupIdsParameterName="externalIds"
            lookupMaxIds="10000"
            enabled="Y"/>

    <!-- Shopify per-EVENT (refund or return) records for returns reconciliation (DAR-BE-018;
         2026-08-17 returns-refund-grain-alignment plan, Task 2, REVISION 2026-08-18). Cursor-
         paginated, not bulk — see the service description and ShopifyReturnRefsSupport.
         No filterParameterName: like the canonical Shopify row, this connector carries no
         tenant exclusion rules, so offering the control would be a silent no-op.
         No keepFieldsParameterName: extract#ShopifyOrderReturnRefs declares no keep-fields
         in-parameter — unlike the OMS-family endpoints, the event shape is fixed, not server-side
         projected from a wider document, so there is nothing to select a subset FROM. keepFieldsBase
         below is documentation-only here (mirrors the endpoint's whole fixed output, matching the
         pattern OMS_RETURNS/OMS_RECON_ORDERS use it for), not a runtime projection input. -->
    <darpan.reconciliation.SourceSystemConnector
            systemEnumId="SHOPIFY_RETURN_REFS"
            extractServiceName="reconciliation.ShopifyOrderExtractionServices.extract#ShopifyOrderReturnRefs"
            dateFromParameterName="windowStart"
            dateToParameterName="windowEnd"
            expectedSourceConfigType="SHOPIFY_RETURN_REFS_API"
            configParameterName="shopifyAuthConfigId"
            configEntityName="darpan.shopify.ShopifyAuthConfig"
            remoteId="SHOPIFY_REMOTE"
            endpointLabel="Shopify Return References"
            systemAliases="SHOPIFY_RETURN_REFS,SHOPIFY_RETURNS,DAR_SYS_SHOPIFY_RETURN_REFS"
            preserveWindowInstants="N"
            keepFieldsBase="refundOrReturnId,refundOrReturnType,orderId,createdAt,orderCancelledAt"
            lookupServiceName="reconciliation.ShopifyOrderExtractionServices.lookup#ShopifyRefundOrReturnIds"
            lookupIdsParameterName="refundOrReturnIds"
            lookupMaxIds="10000"
            enabled="Y"/>

    <!-- Database sources. Both sides of a run may be AUT_SRC_DB, which is how two OFBiz instances
         are compared: same schema, a different SELECT per side. No sendUrlTemplate/remoteId - those
         are HTTP-shaped and do not route. No keepFieldsParameterName - projection is the SELECT list,
         where a SQL author expects it. windowFieldName stays blank: the SQL author binds
         :windowStart/:windowEnd to whatever column they choose, which is strictly more expressive
         than naming one column here.
         expectedSourceConfigType MUST remain DATABASE_QUERY - the System/Endpoint reshape's
         config-type map already assigns that value, and any other is dropped at cutover.
         healthCheckServiceName MUST be a probe# name: PROBE_SERVICE_NAME reserves that verb for the
         diagnostics slot so a registry row cannot aim it at an extract or framework service. -->
    <darpan.reconciliation.SourceSystemConnector
            systemEnumId="DATABASE"
            extractServiceName="reconciliation.DatabaseExtractionServices.extract#DatabaseRecords"
            dateFromParameterName="windowStart"
            dateToParameterName="windowEnd"
            expectedSourceConfigType="DATABASE_QUERY"
            configParameterName="databaseSourceQueryId"
            configEntityName="darpan.database.DatabaseSourceQuery"
            healthCheckServiceName="facade.DatabaseFacadeServices.probe#DatabaseConnection"
            systemAliases="DATABASE,DB,DAR_SYS_DATABASE"
            preserveWindowInstants="N"
            enabled="Y"/>
</entity-facade-xml>
