    <darpan.reconciliation.SourceSystemConnectorField systemEnumId="OMS_RETURNS_GQL" fieldPath="$.records[*].orderExternalId"
            label="Order external ID" fieldType="string" isPrimaryIdCandidate="Y" sequenceNum="4"
