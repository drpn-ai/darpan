    <darpan.migration.DarpanMigration migrationId="RETIRED_FIELDS" componentName="darpan"
            serviceName="facade.SourceEndpointFacadeServices.migrate#RetiredConnectorFields"
            sequenceNum="60" supportsDryRun="N" enabled="Y"
            description="Delete SourceSystemConnectorField pill rows withdrawn from seed data. Seed
                loads are createOrUpdate and never delete, so withdrawal needs an explicit deletion.
                Idempotent — a second run deletes nothing."/>

</entity-facade-xml>
