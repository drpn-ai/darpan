<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="poll" noun="SftpAndReconcile" type="script" transaction="ignore"
            location="component://darpan/src/main/groovy/darpan/reconciliation/automation/pollSftpAndRunReconciliation.groovy"
            allow-remote="false" authenticate="anonymous-all">
        <description>Check configured SFTP locations for available files and run reconciliation through the RuleSet compare-scope pipeline or the temporary mapping bridge.</description>
        <in-parameters>
            <parameter name="ruleSetId">
                <description>Preferred RuleSet input for the SFTP automation cutover. When present, automation routing uses the RuleSet compare-scope pipeline.</description>
            </parameter>
            <parameter name="compareScopeId">
                <description>Optional compare-scope override. Required only when the RuleSet exposes more than one compare scope.</description>
            </parameter>
            <parameter name="reconciliationMappingId">
                <description>Legacy mapping bridge input retained temporarily for existing scheduled jobs that have not been migrated yet.</description>
            </parameter>
            <parameter name="reconciliationRunId">
                <description>Optional run identifier for logging/context only.</description>
            </parameter>

            <parameter name="file1SystemEnumId">
                <description>Optional file 1 system identifier. In RuleSet mode this is used only for file-side validation; in mapping mode it remains required.</description>
            </parameter>
            <parameter name="file2SystemEnumId">
                <description>Optional file 2 system identifier. In RuleSet mode this is used only for file-side validation; in mapping mode it remains required.</description>
            </parameter>
            <parameter name="file1SftpServerId" required="true">
                <description>SftpServer ID for file 1.</description>
            </parameter>
            <parameter name="file2SftpServerId" required="true">
                <description>SftpServer ID for file 2.</description>
            </parameter>
            <parameter name="file1FileTypeEnumId">
                <description>Optional override for file 1 type (DftCsv, DftJson).</description>
            </parameter>
            <parameter name="file2FileTypeEnumId">
                <description>Optional override for file 2 type (DftCsv, DftJson).</description>
            </parameter>
            <parameter name="file1SchemaFileName">
                <description>Optional override for file 1 JSON schema (required when JSON).</description>
            </parameter>
            <parameter name="file2SchemaFileName">
                <description>Optional override for file 2 JSON schema (required when JSON).</description>
            </parameter>
            <parameter name="file1RemotePath">
                <description>Remote path for file 1 (required if only referencing a server).</description>
            </parameter>
            <parameter name="file2RemotePath">
                <description>Remote path for file 2 (required if only referencing a server).</description>
            </parameter>
            <parameter name="sftpRunScopeEnumId" default-value="DARPAN_SFTP_TENANT">
                <description>Automation SFTP access scope. Use DARPAN_SFTP_TENANT for tenant jobs or DARPAN_SFTP_ADMIN for platform/admin jobs.</description>
            </parameter>
            <parameter name="runTenantUserGroupId">
                <description>Tenant user-group id for scheduled tenant jobs. Defaults to the active tenant for authenticated runs.</description>
            </parameter>
            <parameter name="allowAdminSftp" type="Boolean" default-value="false">
                <description>Explicit opt-in required before an admin/platform SFTP server may be used by an admin-scoped job.</description>
            </parameter>
            <parameter name="archiveSubdir" default-value="archive">
                <description>Folder name (under the remote/local directory) where consumed files will be moved.</description>
            </parameter>

            <parameter name="hasHeader" type="Boolean" default-value="true"/>
            <parameter name="stageLocation" default-value="runtime://tmp/reconciliation/automation/input">
                <description>Where staged copies of SFTP files will be written before reconciliation.</description>
            </parameter>
            <parameter name="pollIntervalMinutes" type="Integer">
                <description>Retry interval in minutes when an expected SFTP file is not available yet.</description>
            </parameter>
            <parameter name="pollTimeoutMinutes" type="Integer">
                <description>Maximum retry window in minutes before reporting that expected SFTP files were not found.</description>
            </parameter>
            <parameter name="outputLocation">
                <description>Override for reconciliation outputs. Defaults to the data-manager reconciliation run folder.</description>
            </parameter>
            <parameter name="sparkMaster"/>
            <parameter name="sparkAppName" default-value="SftpReconciliation"/>
        </in-parameters>
        <out-parameters>
            <parameter name="dataAvailable" type="Boolean"/>
            <parameter name="statusMessage"/>

            <parameter name="file1Source"/>
            <parameter name="file2Source"/>
            <parameter name="file1SelectedName"/>
            <parameter name="file2SelectedName"/>
            <parameter name="file1StagedLocation"/>
            <parameter name="file2StagedLocation"/>

            <parameter name="file1Type"/>
            <parameter name="file2Type"/>
            <parameter name="reconciliationType"/>

            <parameter name="diffLocation"/>
            <parameter name="diffFileName"/>
            <parameter name="differenceCount" type="Integer"/>
            <parameter name="onlyInFile1Count" type="Integer"/>
            <parameter name="onlyInFile2Count" type="Integer"/>
            <parameter name="validationErrors" type="List"/>
            <parameter name="processingWarnings" type="List"/>
            <!-- Self-review #4: surface rule build/eval failure so the SFTP automation records FAILED. -->
            <parameter name="ruleExecutionFailed" type="Boolean"/>
        </out-parameters>
    </service>

    <service verb="run" noun="SftpFileAutomation" transaction="ignore" allow-remote="false" authenticate="anonymous-all">
        <description>Run one saved SFTP-file automation, recording execution status and delegating file access to the centralized SFTP poll-and-reconcile service.</description>
        <in-parameters>
            <parameter name="automationId" required="true">
                <description>ReconciliationAutomation row to execute. The automation must use AUT_IN_SFTP_FILES and two AUT_SRC_SFTP source rows.</description>
            </parameter>
            <parameter name="scheduledDate" type="Timestamp">
                <description>Scheduled fire time to record on the execution row. Defaults to the current timestamp.</description>
            </parameter>
            <parameter name="sftpRunScopeEnumId" default-value="DARPAN_SFTP_TENANT">
                <description>SFTP access scope passed through to the centralized SFTP guard.</description>
            </parameter>
            <parameter name="runTenantUserGroupId">
                <description>Tenant user-group id for tenant-scoped scheduled runs. Defaults to the automation owner tenant.</description>
            </parameter>
            <parameter name="allowAdminSftp" type="Boolean" default-value="false">
                <description>Explicit opt-in required before an admin-scoped automation may use admin SFTP.</description>
            </parameter>
            <parameter name="archiveSubdir" default-value="archive"/>
            <parameter name="hasHeader" type="Boolean" default-value="true"/>
            <parameter name="stageLocation" default-value="runtime://tmp/reconciliation/automation/input"/>
            <parameter name="pollIntervalMinutes" type="Integer" default-value="10"/>
            <parameter name="pollTimeoutMinutes" type="Integer" default-value="60"/>
            <parameter name="outputLocation">
                <description>Override for reconciliation outputs. Defaults to the data-manager reconciliation run folder.</description>
            </parameter>
            <parameter name="sparkMaster"/>
            <parameter name="sparkAppName"/>
        </in-parameters>
        <out-parameters>
            <parameter name="automationExecutionId"/>
            <parameter name="statusEnumId"/>
            <parameter name="reconciliationRunResultId"/>
            <parameter name="resultDataManagerPath"/>

            <parameter name="dataAvailable" type="Boolean"/>
            <parameter name="statusMessage"/>
            <parameter name="pollAttemptCount" type="Integer"/>

            <parameter name="file1Source"/>
            <parameter name="file2Source"/>
            <parameter name="file1SelectedName"/>
            <parameter name="file2SelectedName"/>
            <parameter name="file1StagedLocation"/>
            <parameter name="file2StagedLocation"/>

            <parameter name="file1Type"/>
            <parameter name="file2Type"/>
            <parameter name="reconciliationType"/>

            <parameter name="diffLocation"/>
            <parameter name="diffFileName"/>
            <parameter name="differenceCount" type="Integer"/>
            <parameter name="onlyInFile1Count" type="Integer"/>
            <parameter name="onlyInFile2Count" type="Integer"/>
            <parameter name="validationErrors" type="List"/>
            <parameter name="processingWarnings" type="List"/>
            <!-- Self-review #4: surface rule build/eval failure so the SFTP automation records FAILED. -->
            <parameter name="ruleExecutionFailed" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="automationResult" from="darpan.reconciliation.automation.SftpAutomationSupport.runSftpFileAutomation(ec, context)"/>
            <set field="automationExecutionId" from="automationResult.automationExecutionId"/>
            <set field="statusEnumId" from="automationResult.statusEnumId"/>
            <set field="reconciliationRunResultId" from="automationResult.reconciliationRunResultId"/>
            <set field="resultDataManagerPath" from="automationResult.resultDataManagerPath"/>
            <set field="dataAvailable" from="automationResult.dataAvailable"/>
            <set field="statusMessage" from="automationResult.statusMessage"/>
            <set field="pollAttemptCount" from="automationResult.pollAttemptCount"/>
            <set field="file1Source" from="automationResult.file1Source"/>
            <set field="file2Source" from="automationResult.file2Source"/>
            <set field="file1SelectedName" from="automationResult.file1SelectedName"/>
            <set field="file2SelectedName" from="automationResult.file2SelectedName"/>
            <set field="file1StagedLocation" from="automationResult.file1StagedLocation"/>
            <set field="file2StagedLocation" from="automationResult.file2StagedLocation"/>
            <set field="file1Type" from="automationResult.file1Type"/>
            <set field="file2Type" from="automationResult.file2Type"/>
            <set field="reconciliationType" from="automationResult.reconciliationType"/>
            <set field="diffLocation" from="automationResult.diffLocation"/>
            <set field="diffFileName" from="automationResult.diffFileName"/>
            <set field="differenceCount" from="automationResult.differenceCount"/>
            <set field="onlyInFile1Count" from="automationResult.onlyInFile1Count"/>
            <set field="onlyInFile2Count" from="automationResult.onlyInFile2Count"/>
            <set field="validationErrors" from="automationResult.validationErrors"/>
            <set field="processingWarnings" from="automationResult.processingWarnings"/>
            <set field="ruleExecutionFailed" from="automationResult.ruleExecutionFailed"/>
        </actions>
    </service>

    <service verb="execute" noun="Automation" transaction="ignore" allow-remote="false" authenticate="anonymous-all">
        <description>Execute one automation by resolving its scheduled date window, creating/reusing idempotent child execution rows, extracting source files, and running the RuleSet compare-scope pipeline.</description>
        <in-parameters>
            <parameter name="automationId" required="true"/>
            <parameter name="scheduledFireTime" type="Timestamp">
                <description>Scheduled fire time used for idempotency. Defaults to the current timestamp for manual runs.</description>
            </parameter>
            <parameter name="windowStartDate" type="Timestamp">
                <description>Required only for AUT_WIN_CUSTOM backfill runs.</description>
            </parameter>
            <parameter name="windowEndDate" type="Timestamp">
                <description>Required only for AUT_WIN_CUSTOM backfill runs.</description>
            </parameter>
            <parameter name="nowTimestamp" type="Timestamp"/>
            <parameter name="hasHeader" type="Boolean" default-value="true"/>
            <parameter name="outputLocation"/>
            <parameter name="sparkMaster"/>
            <parameter name="sparkAppName"/>
        </in-parameters>
        <out-parameters>
            <parameter name="automationId"/>
            <parameter name="scheduledFireTime" type="Timestamp"/>
            <parameter name="executedCount" type="Integer"/>
            <parameter name="noDataCount" type="Integer"/>
            <parameter name="failedCount" type="Integer"/>
            <parameter name="skippedDuplicateCount" type="Integer"/>
            <parameter name="executionResults" type="List"/>
        </out-parameters>
        <actions>
            <set field="automationResult" from="darpan.reconciliation.automation.AutomationExecutionSupport.executeAutomation(ec, context)"/>
            <set field="automationId" from="automationResult.automationId"/>
            <set field="scheduledFireTime" from="automationResult.scheduledFireTime"/>
            <set field="executedCount" from="automationResult.executedCount"/>
            <set field="noDataCount" from="automationResult.noDataCount"/>
            <set field="failedCount" from="automationResult.failedCount"/>
            <set field="skippedDuplicateCount" from="automationResult.skippedDuplicateCount"/>
            <set field="executionResults" from="automationResult.executionResults"/>
        </actions>
    </service>

    <service verb="scan" noun="DueAutomations" transaction="ignore" allow-remote="false" authenticate="anonymous-all">
        <description>Find active automations with nextScheduledFireTime at or before now, call execute#Automation, and advance nextScheduledFireTime from the automation schedule expression.</description>
        <in-parameters>
            <parameter name="nowTimestamp" type="Timestamp"/>
            <parameter name="limit" type="Integer" default-value="100"/>
            <parameter name="outputLocation"/>
            <parameter name="sparkMaster"/>
            <parameter name="sparkAppName"/>
        </in-parameters>
        <out-parameters>
            <parameter name="scanTimestamp" type="Timestamp"/>
            <parameter name="dueCount" type="Integer"/>
            <parameter name="scanResults" type="List"/>
        </out-parameters>
        <actions>
            <set field="automationResult" from="darpan.reconciliation.automation.AutomationExecutionSupport.scanDueAutomations(ec, context)"/>
            <set field="scanTimestamp" from="automationResult.scanTimestamp"/>
            <set field="dueCount" from="automationResult.dueCount"/>
            <set field="scanResults" from="automationResult.scanResults"/>
        </actions>
    </service>

    <!-- Audit H2.5 / H3.3 — when a reconciliation run or an automation execution crashes mid-flight
         (OOM, JVM kill, container restart between writes), its row is left in AUT_STAT_RUNNING
         forever: ReconciliationOutputSupport.ACTIVE_STATUSES includes RUNNING so the UI blocks
         re-trigger, and findOrCreateExecution only treats PENDING as reusable so the scanner skips
         the same window forever. This reaper transitions any RUNNING / PENDING row whose
         lastUpdatedStamp is older than the configured threshold to FAILED with an explanatory
         status message, freeing the run and unblocking the next scheduled scan. -->
    <service verb="sweep" noun="StuckReconciliationRuns" transaction="ignore" allow-remote="false" authenticate="anonymous-all">
        <description>Reaper that flips stale AUT_STAT_RUNNING / AUT_STAT_PENDING ReconciliationRunResult and ReconciliationAutomationExecution rows to AUT_STAT_FAILED.</description>
        <in-parameters>
            <parameter name="staleMinutes" type="Integer" default-value="120">
                <description>A row in RUNNING/PENDING whose lastUpdatedStamp is older than this many minutes is reaped.</description>
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="cutoffTimestamp" type="Timestamp"/>
            <parameter name="reapedRunResultCount" type="Integer"/>
            <parameter name="reapedExecutionCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="result" from="darpan.reconciliation.automation.StuckRunReaper.sweep(ec, staleMinutes)"/>
            <set field="cutoffTimestamp" from="result.cutoffTimestamp"/>
            <set field="reapedRunResultCount" from="result.reapedRunResultCount"/>
            <set field="reapedExecutionCount" from="result.reapedExecutionCount"/>
        </actions>
    </service>

</services>
