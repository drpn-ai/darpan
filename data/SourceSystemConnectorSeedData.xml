<?xml version="1.0" encoding="UTF-8"?>
<!-- SourceSystemConnector registry seed (DAR-292 / DAR-293, Phase 1).
     HotWax OMS is read over GraphQL only (DAR-BE-052, 2026-11-02): the REST rows (OMS, OMS_RECON_ORDERS,
     OMS_ORDER_ITEMS, OMS_ORDER_LINE_UNITS, OMS_TRANSFER_ORDERS, OMS_RETURNS) were deleted, and migration
     OMS_REST_RETIRED moves stored runs and automations to their GraphQL endpoints. OMS stays an enum: it is the
     HotWax parent the source picker groups endpoints under.
     configIdResolverServiceName / validationServiceName are intentionally left blank: today these are
     Groovy static methods, not Moqui services; converting + allow-listing them is a later phase.
     NetSuite / SAPI are intentionally deferred to a later phase. -->
<entity-facade-xml type="darpan-seed">

    <!-- OMS_GQL (DAR-BE-064): the order-grain presence extract over GraphQL. -->
    <!-- DAR-UI-081: an order keeps its basics for audit findings (currency, bill-to customer, ship groups' method). -->
    <darpan.reconciliation.SourceSystemConnector
            systemEnumId="OMS_GQL"
            extractServiceName="reconciliation.HotWaxOmsExtractionServices.extract#HotWaxOmsGqlOrders"
            dateFromParameterName="windowStart"
            dateToParameterName="windowEnd"
            expectedSourceConfigType="HOTWAX_OMS_GQL"
            configParameterName="omsRestSourceConfigId"
            configEntityName="darpan.hotwax.HotWaxOmsRestSourceConfig"
            remoteId="HOTWAX_ORDERS_API"
            endpointLabel="Orders"
            sendUrlTemplate="{baseUrl}/rest/s1/graphql"
            remoteSendServiceName="reconciliation.HotWaxOmsExtractionServices.extract#HotWaxOmsGqlOrders"
            systemAliases="OMS_GQL,HOTWAX_GQL,DAR_SYS_OMS_GQL"
            preserveWindowInstants="N"
            keepFieldsParameterName="keepRecordFields"
            keepFieldsBase="orderId,orderName,externalId,grandTotal,orderDate,statusId,currencyUomId,billToCustomer,shipGroups"
            filterParameterName="sourceFilters"
            pairLookupServiceName="reconciliation.HotWaxOmsExtractionServices.lookup#HotWaxOmsOrdersByExternalId"
            healthCheckServiceName="facade.HotWaxOmsFacadeServices.probe#HotWaxOmsConnection"
            enabled="Y"/>

    <!-- OMS_PRODUCTS_GQL (DAR-BE-157): every sellable HotWax product keyed by NETSUITE_PRODUCT_ID, for the two-way
         NetSuite <-> HotWax product reconciliation. windowed N: presence is a whole-catalogue question, so the extract
         ignores the window and an audit must never read it as "recent only" (AuditRecentReadSupport). Its own service and
         expectedSourceConfigType, or it would shadow OMS_GQL in the resolvers. Same config row and credential as OMS_GQL. -->
    <darpan.reconciliation.SourceSystemConnector
            systemEnumId="OMS_PRODUCTS_GQL"
            extractServiceName="reconciliation.HotWaxOmsExtractionServices.extract#HotWaxOmsGqlProducts"
            dateFromParameterName="windowStart"
            dateToParameterName="windowEnd"
            expectedSourceConfigType="HOTWAX_OMS_GQL_PRODUCTS"
            configParameterName="omsRestSourceConfigId"
            configEntityName="darpan.hotwax.HotWaxOmsRestSourceConfig"
            remoteId="HOTWAX_ORDERS_API"
            endpointLabel="Products"
            sendUrlTemplate="{baseUrl}/rest/s1/graphql"
            remoteSendServiceName="reconciliation.HotWaxOmsExtractionServices.extract#HotWaxOmsGqlProducts"
            systemAliases="OMS_PRODUCTS_GQL,HOTWAX_PRODUCTS"
            preserveWindowInstants="N"
            windowed="N"
            filterParameterName="sourceFilters"
            evidenceFieldsJson='{"system":"HotWax","facts":["internalName","productId"],"otherSideKeyField":"netsuiteProductId"}'
            healthCheckServiceName="facade.HotWaxOmsFacadeServices.probe#HotWaxOmsConnection"
            enabled="Y"/>

    <darpan.reconciliation.SourceSystemConnector
            systemEnumId="SHOPIFY"
            extractServiceName="reconciliation.ShopifyOrderExtractionServices.extract#ShopifyOrders"
            dateFromParameterName="windowStart"
            dateToParameterName="windowEnd"
            expectedSourceConfigType="SHOPIFY_AUTH"
            configParameterName="shopifyAuthConfigId"
            configEntityName="darpan.shopify.ShopifyAuthConfig"
            remoteId="SHOPIFY_REMOTE"
            endpointLabel="Orders"
            sendUrlTemplate="https://{shop}.myshopify.com/admin/api/{apiVersion}/graphql.json"
            remoteSendServiceName="facade.ShopifyFacadeServices.execute#ShopifyGraphql"
            systemAliases="SHOPIFY,DAR_SYS_SHOPIFY"
            preserveWindowInstants="Y"
            lookupServiceName="reconciliation.ShopifyOrderExtractionServices.lookup#ShopifyOrderIds"
            exchangeStateLookupServiceName="reconciliation.ShopifyOrderExtractionServices.lookup#ShopifyOrderExchangeState"
            exchangeSweepServiceName="reconciliation.ShopifyOrderExtractionServices.lookup#ShopifyExchangeSweep"
            healthCheckServiceName="facade.ShopifyFacadeServices.probe#ShopifyAuthConnection"
            filterParameterName="sourceFilters"
            evidenceFieldsJson='{"system":"Shopify","state":"displayFulfillmentStatus","stateLabels":{"FULFILLED":"Fulfilled","UNFULFILLED":"Unfulfilled","PARTIALLY_FULFILLED":"Partially fulfilled","RESTOCKED":"Restocked","ON_HOLD":"On hold","IN_PROGRESS":"In progress","SCHEDULED":"Scheduled","PENDING_FULFILLMENT":"Pending fulfillment","OPEN":"Open"},"facts":["name","displayFinancialStatus","sourceName"]}'
            enabled="Y"/>

    <!-- NETSUITE has no automation extractor; this row exists so the saved-run path resolves its
         expectedSourceConfigType (NETSUITE_AUTH) + aliases from the registry (config over code).
         No extractServiceName / remote fields on purpose. configParameterName, configEntityName and
         healthCheckServiceName are there for connection diagnostics alone (DAR-BE-114): test#SourceConnection
         finds the auth profile through them, and with no extractServiceName no run path reads them. -->
    <darpan.reconciliation.SourceSystemConnector
            systemEnumId="NETSUITE"
            expectedSourceConfigType="NETSUITE_AUTH"
            configParameterName="nsAuthConfigId"
            configEntityName="darpan.reconciliation.NsAuthConfig"
            healthCheckServiceName="facade.NetSuiteSettingsFacadeServices.probe#NsAuthConnection"
            systemAliases="NETSUITE,DAR_SYS_NETSUITE"
            preserveWindowInstants="N"
            enabled="Y"/>

    <!-- DAR-BE-050. Shopify order lines at UNIT grain. NO lookupServiceName: a diff here means "this unit is
         absent", and a point-existence verify pass looks up the ORDER, would find it present, and would clear a
         real finding as a false positive. Its own expectedSourceConfigType because both connector resolvers take
         the FIRST enabled match, so reusing SHOPIFY_AUTH would resolve ambiguously. -->
    <darpan.reconciliation.SourceSystemConnector
            systemEnumId="SHOPIFY_ORDER_LINE_UNITS"
            extractServiceName="reconciliation.ShopifyOrderExtractionServices.extract#ShopifyOrderLineUnits"
            dateFromParameterName="windowStart"
            dateToParameterName="windowEnd"
            expectedSourceConfigType="SHOPIFY_ORDER_LINE_UNITS_API"
            configParameterName="shopifyAuthConfigId"
            configEntityName="darpan.shopify.ShopifyAuthConfig"
            remoteId="SHOPIFY_REMOTE"
            endpointLabel="Order lines"
            sendUrlTemplate="https://{shop}.myshopify.com/admin/api/{apiVersion}/graphql.json"
            remoteSendServiceName="facade.ShopifyFacadeServices.execute#ShopifyGraphql"
            systemAliases="SHOPIFY_ORDER_LINE_UNITS,DAR_SYS_SHOPIFY_LINE_UNITS"
            preserveWindowInstants="Y"
            filterParameterName="sourceFilters"
            healthCheckServiceName="facade.ShopifyFacadeServices.probe#ShopifyAuthConnection"
            evidenceFieldsJson='{"system":"Shopify","state":"unitState","stateLabels":{"OPEN":"Open","FULFILLED":"Fulfilled","REMOVED":"Removed"},"facts":["shopifyOrderName","sku"]}'
            enabled="Y"/>

    <!-- DAR-BE-116: OMS_ORDER_ITEMS over GraphQL. Same unit record (OmsOrderLineUnitSupport), same options (exchange
         exclusion off, unkeyed items kept); orders come with their NetSuite identification and ship groups and the
         items are read by orderId in batches. salesChannelEnumId is NOT carried: gorjana's GraphQL Order type has no
         such field (SDL 2026-10-23), so a run cannot filter or conclude on it. -->
    <darpan.reconciliation.SourceSystemConnector
            systemEnumId="OMS_ORDER_ITEMS_GQL"
            extractServiceName="reconciliation.HotWaxOmsExtractionServices.extract#HotWaxOmsGqlOrderItems"
            dateFromParameterName="windowStart"
            dateToParameterName="windowEnd"
            expectedSourceConfigType="HOTWAX_OMS_GQL_ORDER_ITEMS"
            configParameterName="omsRestSourceConfigId"
            configEntityName="darpan.hotwax.HotWaxOmsRestSourceConfig"
            remoteId="HOTWAX_ORDERS_API"
            endpointLabel="Order lines"
            sendUrlTemplate="{baseUrl}/rest/s1/graphql"
            remoteSendServiceName="reconciliation.HotWaxOmsExtractionServices.extract#HotWaxOmsGqlOrderItems"
            systemAliases="OMS_ORDER_ITEMS_GQL,HOTWAX_GQL_ORDER_ITEMS,DAR_SYS_OMS_ORDER_ITEMS_GQL"
            preserveWindowInstants="N"
            filterParameterName="sourceFilters"
            windowFieldName="orderDate"
            healthCheckServiceName="facade.HotWaxOmsFacadeServices.probe#HotWaxOmsConnection"
            evidenceFieldsJson='{"system":"HotWax","state":"statusId","stateLabels":{"ITEM_COMPLETED":"Completed","ITEM_APPROVED":"Approved","ITEM_CREATED":"Created","ITEM_CANCELLED":"Cancelled"},"facts":["facilityId","orderItemSeqId","omsOrderId"]}'
            enabled="Y"/>

    <!-- OMS_RETURNS_GQL (DAR-BE-040 fix 3): OMS returns over GraphQL, pending and settled alike. -->
    <darpan.reconciliation.SourceSystemConnector
            systemEnumId="OMS_RETURNS_GQL"
            extractServiceName="reconciliation.HotWaxOmsExtractionServices.extract#HotWaxOmsGqlReturns"
            dateFromParameterName="windowStart"
            dateToParameterName="windowEnd"
            expectedSourceConfigType="HOTWAX_OMS_GQL_RETURNS"
            configParameterName="omsRestSourceConfigId"
            configEntityName="darpan.hotwax.HotWaxOmsRestSourceConfig"
            remoteId="HOTWAX_ORDERS_API"
            endpointLabel="Returns"
            sendUrlTemplate="{baseUrl}/rest/s1/graphql"
            remoteSendServiceName="reconciliation.HotWaxOmsExtractionServices.extract#HotWaxOmsGqlReturns"
            systemAliases="OMS_RETURNS_GQL,HOTWAX_GQL_RETURNS,DAR_SYS_OMS_RETURNS_GQL"
            preserveWindowInstants="N"
            keepFieldsParameterName="keepRecordFields"
            keepFieldsBase="returnId,shopifyReturnId,externalId,orderExternalId,statusId,entryDate,returnTotal,currencyUomId,returnChannelEnumId"
            filterParameterName="sourceFilters"
            healthCheckServiceName="facade.HotWaxOmsFacadeServices.probe#HotWaxOmsConnection"
            orderStateLookupServiceName="reconciliation.HotWaxOmsExtractionServices.lookup#HotWaxOmsOrdersByExternalId"
            returnLinesLookupServiceName="reconciliation.HotWaxOmsExtractionServices.lookup#HotWaxOmsReturnLinesByOrderExternalId"
            lookupServiceName="reconciliation.HotWaxOmsExtractionServices.lookup#HotWaxOmsReturnsByExternalId"
            lookupIdsParameterName="externalIds"
            lookupMaxIds="10000"
            extractOptionsJson='[{"name":"includeReturnsWithoutShopifyRef","label":"Include returns with no Shopify reference","type":"boolean"},{"name":"onlyCancelledReturns","label":"Only cancelled returns","type":"boolean"},{"name":"withReturnCredit","label":"Credit HotWax gave"}]'
            enabled="Y"/>

    <!-- Shopify per-EVENT (refund or return) records for returns reconciliation (DAR-BE-018;
         2026-08-17 returns-refund-grain-alignment plan, Task 2, REVISION 2026-08-18). Cursor-
         paginated, not bulk — see the service description and ShopifyReturnRefsSupport.
         filterParameterName ADDED 2026-08-27: this connector now carries tenant exclusion rules, so
         the rules board offers the control and the getter applies them client-side (Shopify's search
         syntax has no knowledge of tenant rules). The field it exists for is returnWorkflowStatus —
         excluding REQUESTED/OPEN drops in-progress returns that have no OMS counterpart yet. That
         field was called returnStatus for a few hours on 2026-08-27; it was renamed because Shopify's
         own Order.returnStatus holds a DIFFERENT enum (OrderReturnStatus, whose values include
         IN_PROGRESS), and operators excluded on values this field can never hold. The canonical
         SHOPIFY orders row still declares none and still means what it said.
         No keepFieldsParameterName: extract#ShopifyOrderReturnRefs declares no keep-fields
         in-parameter — unlike the OMS-family endpoints, the event shape is fixed, not server-side
         projected from a wider document, so there is nothing to select a subset FROM. keepFieldsBase
         below is documentation-only here (mirrors the endpoint's whole fixed output, matching the
         pattern the OMS endpoints use it for), not a runtime projection input. -->
    <darpan.reconciliation.SourceSystemConnector
            systemEnumId="SHOPIFY_RETURN_REFS"
            extractServiceName="reconciliation.ShopifyOrderExtractionServices.extract#ShopifyOrderReturnRefs"
            dateFromParameterName="windowStart"
            dateToParameterName="windowEnd"
            expectedSourceConfigType="SHOPIFY_RETURN_REFS_API"
            configParameterName="shopifyAuthConfigId"
            configEntityName="darpan.shopify.ShopifyAuthConfig"
            remoteId="SHOPIFY_REMOTE"
            endpointLabel="Returns"
            systemAliases="SHOPIFY_RETURN_REFS,SHOPIFY_RETURNS,DAR_SYS_SHOPIFY_RETURN_REFS"
            preserveWindowInstants="N"
            filterParameterName="sourceFilters"
            keepFieldsBase="refundOrReturnId,refundOrReturnType,orderId,createdAt,orderCancelledAt,refundLineEverFulfilled,orderReturnStatus"
            lookupServiceName="reconciliation.ShopifyOrderExtractionServices.lookup#ShopifyRefundOrReturnIds"
            lookupIdsParameterName="refundOrReturnIds"
            lookupMaxIds="50000"
            enabled="Y"
            extractOptionsJson='[{"name":"completedReturns","label":"Completed returns, one row per order: refunded, exchanged or orderRefunded","type":"text"}]'/>

    <!-- NetSuite via SuiteQL over REST Web Services. ONE row for every NetSuite pair, not one per
         endpoint (DAR-BE-032, generalized by DAR-BE-044). NEW CAPABILITY: Darpan did not reconcile
         against NetSuite before this row, so nothing is migrated and no existing rule set changes
         behaviour.

         WHY ONE ROW. SourceSystemConnector's PK is systemEnumId alone, so a row is an ENDPOINT and
         "system" has quietly become the endpoint dimension - OMS_GQL, OMS_ORDER_ITEMS_GQL and
         OMS_RETURNS_GQL are three ids for one HotWax OMS. Four more within-NetSuite
         pairs on that pattern would mean four more enums, connector rows and extract services, each
         deepening the overload DAR-BE-024 exists to retire. DATABASE is the counter-pattern already
         in this file: one row, both sides using it, differentiated per side by the query config. This
         follows it - the record type, table, window column and projection live in
         NsSuiteQlSourceQuery, so a new NetSuite pair is configuration rather than code.

         Its own systemEnumId AND its own expectedSourceConfigType are still both required. The hollow
         NETSUITE row above stays exactly as it was - it is what the saved-run path resolves for a
         NETSUITE_AUTH source, and both resolvers take the FIRST enabled match on those attributes, so
         reusing either would silently capture dispatch aimed at that row
         (SourceSystemConnectorSupportSmokeTests ratchets this in both directions).

         TRANSPORT - SuiteQL, not a RESTlet, measured against a live account 2026-09-02: 1000 rows per
         page (the documented ceiling, honoured), ~880 rows/sec, so a 161k-order month enumerates in
         about three minutes. A RESTlet would need a SuiteScript record, a deployment and a role grant
         inside the CLIENT's production NetSuite, and buys nothing for a presence check. The credential
         is unchanged: NsAuthConfig.scope already defaults to "restlets rest_webservices".

         configEntityName is NsSuiteQlSourceQuery, which carries its own nsAuthConfigId: the account
         host is derived from that auth profile's tokenUrl, so the account id is never configured twice
         and the request URL stays inside the OutboundHttpPolicy allow-list by construction.

         NO keepFieldsParameterName/keepFieldsBase, for the same reason DATABASE has none: the
         projection is the query's field mapping, where the person defining the dataset expects it. A
         single keepFieldsBase on this row could not be right for more than one pair anyway.

         filterParameterName is required, not optional: for the OMS pair, orders keyed in directly in
         NetSuite carry no custbody_hc_order_id (~0.3% of a sampled month) and are excluded by rule
         rather than reported as differences.

         No lookupServiceName: SuiteQL enumerates the window completely in one pass, so there is no
         bulk-export index skew for a verification pass to correct. -->
    <darpan.reconciliation.SourceSystemConnector
            systemEnumId="NETSUITE_SUITEQL"
            extractServiceName="reconciliation.NetSuiteOrderExtractionServices.extract#NetSuiteOrders"
            dateFromParameterName="windowStart"
            dateToParameterName="windowEnd"
            expectedSourceConfigType="NETSUITE_SUITEQL"
            configParameterName="nsSuiteQlSourceQueryId"
            configEntityName="darpan.reconciliation.NsSuiteQlSourceQuery"
            endpointLabel="SuiteQL"
            sendUrlTemplate="https://{account}.suitetalk.api.netsuite.com/services/rest/query/v1/suiteql"
            remoteSendServiceName="reconciliation.NetSuiteOrderExtractionServices.extract#NetSuiteOrders"
            systemAliases="NETSUITE_SUITEQL,NETSUITE_ORDERS,NETSUITE_SALES_ORDERS,DAR_SYS_NETSUITE_SUITEQL"
            preserveWindowInstants="N"
            windowDateOnly="Y"
            filterParameterName="sourceFilters"
            evidenceFieldsJson='{"system":"NetSuite","state":"status","stateLabels":{"A":"Pending Approval","B":"Pending Fulfillment","C":"Cancelled","D":"Partially Fulfilled","E":"Pending Billing/Partially Fulfilled","F":"Pending Billing","G":"Billed","H":"Closed"},"facts":["orderLineId","lineState","lineLocation","quantityShipped","quantityBilled","quantityBackordered","tranId","sku"]}'
            enabled="Y"/>

    <!-- Database sources. Both sides of a run may be AUT_SRC_DB, which is how two OFBiz instances
         are compared: same schema, a different SELECT per side. No sendUrlTemplate/remoteId - those
         are HTTP-shaped and do not route. No keepFieldsParameterName - projection is the SELECT list,
         where a SQL author expects it. windowFieldName stays blank: the SQL author binds
         :windowStart/:windowEnd to whatever column they choose, which is strictly more expressive
         than naming one column here.
         expectedSourceConfigType MUST remain DATABASE_QUERY - the System/Endpoint reshape's
         config-type map already assigns that value, and any other is dropped at cutover.
         healthCheckServiceName MUST be a probe# name: PROBE_SERVICE_NAME reserves that verb for the
         diagnostics slot so a registry row cannot aim it at an extract or framework service. -->
    <darpan.reconciliation.SourceSystemConnector
            systemEnumId="DATABASE"
            extractServiceName="reconciliation.DatabaseExtractionServices.extract#DatabaseRecords"
            dateFromParameterName="windowStart"
            dateToParameterName="windowEnd"
            expectedSourceConfigType="DATABASE_QUERY"
            configParameterName="databaseSourceQueryId"
            configEntityName="darpan.database.DatabaseSourceQuery"
            healthCheckServiceName="facade.DatabaseFacadeServices.probe#DatabaseConnection"
            systemAliases="DATABASE,DB,DAR_SYS_DATABASE"
            preserveWindowInstants="N"
            enabled="Y"/>
</entity-facade-xml>
