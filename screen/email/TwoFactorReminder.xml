<?xml version="1.0" encoding="UTF-8"?>
<!-- DAR-BE-297 email body: the daily reminder to set up two-factor. No bold. No code or password. The app address is written as text; the only links are the user guide's (EmailFrame.guides). Copy follows the darpan-email skill. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false">
    <macro-template type="text" location="component://darpan/template/email/EmailText.ftl"/>
    <actions>
        <set field="frameOpen" from="darpan.email.EmailFrame.open('DARPAN · SECURITY')"/>
        <set field="frameClose" from="darpan.email.EmailFrame.close()"/>
        <set field="copyVars" from="[firstName: firstName, requiredDate: requiredDate, appUrl: appUrl]"/>
        <set field="copyGreetingBefore" from="darpan.email.EmailCopy.text(ec, &quot;DARPAN_2FA_REMINDER&quot;, &quot;greeting.before&quot;, copyVars)"/>
        <set field="copyGreetingAfter" from="darpan.email.EmailCopy.text(ec, &quot;DARPAN_2FA_REMINDER&quot;, &quot;greeting.after&quot;, copyVars)"/>
        <set field="copyBody" from="darpan.email.EmailCopy.text(ec, &quot;DARPAN_2FA_REMINDER&quot;, &quot;body&quot;, copyVars)"/>
        <set field="copyNextBefore" from="darpan.email.EmailCopy.text(ec, &quot;DARPAN_2FA_REMINDER&quot;, &quot;next.before&quot;, copyVars)"/>
        <set field="copyNextAfter" from="darpan.email.EmailCopy.text(ec, &quot;DARPAN_2FA_REMINDER&quot;, &quot;next.after&quot;, copyVars)"/>
        <set field="copyNote" from="darpan.email.EmailCopy.text(ec, &quot;DARPAN_2FA_REMINDER&quot;, &quot;note&quot;, copyVars)"/>
        <set field="guideLinks" from="darpan.email.EmailCopy.guides(ec, &quot;DARPAN_2FA_REMINDER&quot;)"/>
        <set field="guidesHtml" from="darpan.email.EmailCopy.guidesHtml(guideLinks)"/>
        <set field="guidesText" from="darpan.email.EmailCopy.guidesText(guideLinks)"/>
        <set field="isPast" from="past == true || past == 'true'"/>
        <!-- DAR-BE-315: the plain-text part is these same copy blocks, one per paragraph, never cut or dropped; template/email/EmailText.ftl keeps the labels above out of it (stock text macros cut each at 132 columns and drop fail-widgets branches). -->
        <set field="emailText" from="darpan.email.EmailFrame.textOf([(!isPast ? copyGreetingBefore : copyGreetingAfter), copyBody, (!isPast ? copyNextBefore : copyNextAfter), copyNote, '— Darpan'])"/>
    </actions>
    <widgets>
        <render-mode><text type="html" no-boundary-comment="true"><![CDATA[${frameOpen}]]></text></render-mode>
        <section name="BeforeDate" condition="!isPast"><widgets>
            <container style="dp-p"><label text="${copyGreetingBefore}"/></container>
        </widgets><fail-widgets>
            <container style="dp-p"><label text="${copyGreetingAfter}"/></container>
        </fail-widgets></section>
        <container style="dp-p"><label text="${copyBody}"/></container>
        <section name="BeforeDateNext" condition="!isPast"><widgets>
            <container style="dp-p"><label text="${copyNextBefore}"/></container>
        </widgets><fail-widgets>
            <container style="dp-p"><label text="${copyNextAfter}"/></container>
        </fail-widgets></section>
        <container style="dp-note"><label text="${copyNote}"/></container>
        <container style="dp-sign"><label text="— Darpan"/></container>
        <render-mode>
            <text type="html" no-boundary-comment="true"><![CDATA[${guidesHtml}${frameClose}]]></text>
            <text type="text" no-boundary-comment="true"><![CDATA[${emailText}${guidesText}]]></text>
        </render-mode>
    </widgets>
</screen>
