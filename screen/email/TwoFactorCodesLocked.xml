<?xml version="1.0" encoding="UTF-8"?>
<!-- DAR-BE-264 email body. No bold and no links (a link in a security email is the phishing shape). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false">
    <widgets>
        <render-mode><text type="html"><![CDATA[<html><body>]]></text></render-mode>
        <container><label text="Hi ${firstName}, someone signed in to Darpan with your password but not your code, again and again, until ${at}."/></container>
        <container><label text="Codes are locked for your account until your password is reset."/></container>
        <container><label text="Reset your password now, and tell your Darpan administrator."/></container>
        <container><label text="— Darpan"/></container>
        <render-mode><text type="html"><![CDATA[</body></html>]]></text></render-mode>
    </widgets>
</screen>
