<?xml version="1.0" encoding="UTF-8"?>
<!-- DAR-BE-088. The month-close vocabulary. Every value the month-close JSON emits is one of these
     enumCodes, never the enumId (contract: docs/superpowers/specs/2026-10-21-month-close-json-contract.md,
     "Enums", in the wrapper repo). The codes are part of v1: a code may be added, never renamed or removed.
     Loaded on existing databases through upgrade-data.xml, which restates these rows verbatim. -->
<entity-facade-xml type="darpan-seed">
    <moqui.basic.EnumerationType enumTypeId="MonthCloseCategory" description="Month close statement category"/>
    <moqui.basic.Enumeration enumId="MCC_ORDERS" enumTypeId="MonthCloseCategory" enumCode="orders"
            description="Orders" sequenceNum="1"/>
    <moqui.basic.Enumeration enumId="MCC_REFUNDS_CREDITS" enumTypeId="MonthCloseCategory" enumCode="refundsAndCredits"
            description="Refunds and credits" sequenceNum="2"/>
    <moqui.basic.Enumeration enumId="MCC_RETURNS" enumTypeId="MonthCloseCategory" enumCode="returns"
            description="Returns" sequenceNum="3"/>
    <moqui.basic.Enumeration enumId="MCC_EXCHANGES_WARRANTY" enumTypeId="MonthCloseCategory" enumCode="exchangesAndWarranty"
            description="Exchanges and warranty" sequenceNum="4"/>

    <moqui.basic.EnumerationType enumTypeId="MonthCloseStatementWeight" description="Month close statement weight"/>
    <moqui.basic.Enumeration enumId="MCSW_FIRM" enumTypeId="MonthCloseStatementWeight" enumCode="firm"
            description="Firm: stated by the tenant" sequenceNum="1"/>
    <moqui.basic.Enumeration enumId="MCSW_DERIVED" enumTypeId="MonthCloseStatementWeight" enumCode="derived"
            description="Derived: awaiting the tenant's confirmation" sequenceNum="2"/>

    <moqui.basic.EnumerationType enumTypeId="MonthCloseFindingState" description="Month close finding state"/>
    <moqui.basic.Enumeration enumId="MCFS_OPEN" enumTypeId="MonthCloseFindingState" enumCode="open"
            description="Open" sequenceNum="1"/>
    <moqui.basic.Enumeration enumId="MCFS_PENDING" enumTypeId="MonthCloseFindingState" enumCode="pending"
            description="Pending: inside the check's grace age" sequenceNum="2"/>
    <moqui.basic.Enumeration enumId="MCFS_FIXED" enumTypeId="MonthCloseFindingState" enumCode="fixed"
            description="Fixed" sequenceNum="3"/>

    <moqui.basic.EnumerationType enumTypeId="MonthCloseCheckStatus" description="Month close check status"/>
    <moqui.basic.Enumeration enumId="MCCS_RAN" enumTypeId="MonthCloseCheckStatus" enumCode="ran"
            description="Ran over complete reads" sequenceNum="1"/>
    <moqui.basic.Enumeration enumId="MCCS_PARTIAL" enumTypeId="MonthCloseCheckStatus" enumCode="partial"
            description="Partial: a read was partial or failed, nothing closed" sequenceNum="2"/>
    <moqui.basic.Enumeration enumId="MCCS_NOT_RUN" enumTypeId="MonthCloseCheckStatus" enumCode="notRun"
            description="Not run" sequenceNum="3"/>

    <moqui.basic.EnumerationType enumTypeId="MonthCloseSourceRead" description="Month close source read status"/>
    <moqui.basic.Enumeration enumId="MCSR_COMPLETE" enumTypeId="MonthCloseSourceRead" enumCode="complete"
            description="Complete" sequenceNum="1"/>
    <moqui.basic.Enumeration enumId="MCSR_PARTIAL" enumTypeId="MonthCloseSourceRead" enumCode="partial"
            description="Partial" sequenceNum="2"/>
    <moqui.basic.Enumeration enumId="MCSR_FAILED" enumTypeId="MonthCloseSourceRead" enumCode="failed"
            description="Failed" sequenceNum="3"/>

    <moqui.basic.EnumerationType enumTypeId="MonthCloseFindingEvent" description="Month close finding history event"/>
    <moqui.basic.Enumeration enumId="MCFE_FOUND" enumTypeId="MonthCloseFindingEvent" enumCode="found"
            description="Found" sequenceNum="1"/>
    <moqui.basic.Enumeration enumId="MCFE_STILL_OPEN" enumTypeId="MonthCloseFindingEvent" enumCode="stillOpen"
            description="Still open" sequenceNum="2"/>
    <moqui.basic.Enumeration enumId="MCFE_FIXED" enumTypeId="MonthCloseFindingEvent" enumCode="fixed"
            description="Fixed" sequenceNum="3"/>
    <moqui.basic.Enumeration enumId="MCFE_REOPENED" enumTypeId="MonthCloseFindingEvent" enumCode="reopened"
            description="Reopened" sequenceNum="4"/>

    <!-- No agent type: the external API has no mutations, so an agent can never cause an event. -->
    <moqui.basic.EnumerationType enumTypeId="MonthCloseActorType" description="Month close event actor type"/>
    <moqui.basic.Enumeration enumId="MCAT_CHECK" enumTypeId="MonthCloseActorType" enumCode="check"
            description="Scheduled check" sequenceNum="1"/>
    <moqui.basic.Enumeration enumId="MCAT_USER" enumTypeId="MonthCloseActorType" enumCode="user"
            description="Darpan user" sequenceNum="2"/>
</entity-facade-xml>
