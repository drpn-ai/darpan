<?xml version="1.0" encoding="UTF-8"?>
<!-- DAR-BE-028 email body; copy voiced in DAR-BE-139 (Aditi: "it doesnt need to be so dry"). No bold and no links (a link in a security email is the phishing shape). The not-you line stays plain: it is the security instruction. A code needs no link.
     DAR-BE-298: wears EmailFrame (the app's light theme, like the audit email); copy follows the darpan-email skill. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false">
    <actions>
        <set field="frameOpen" from="darpan.email.EmailFrame.open('DARPAN · SIGN-IN')"/>
        <set field="frameClose" from="darpan.email.EmailFrame.close()"/>
    </actions>
    <widgets>
        <render-mode><text type="html" no-boundary-comment="true"><![CDATA[${frameOpen}]]></text></render-mode>
        <container style="dp-p"><label text="Hi ${firstName}, forgot your Darpan password? Fair. Month-end does that. Here's your way back in:"/></container>
        <container style="dp-code"><label text="${code}"/></container>
        <container style="dp-p"><label text="It works for ${expiresMinutes} minutes, then it turns back into a pumpkin."/></container>
        <container style="dp-note"><label text="Didn't ask for this? Ignore it. Your password stays exactly as it is."/></container>
        <container style="dp-sign"><label text="— Darpan"/></container>
        <render-mode><text type="html" no-boundary-comment="true"><![CDATA[${frameClose}]]></text></render-mode>
    </widgets>
</screen>
