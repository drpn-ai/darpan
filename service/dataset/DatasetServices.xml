<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- DAR-BE-318 plan 3a. A tenant's kept copy of a source read (entity/DatasetEntities.xml). Every read finds by an explicit
         companyUserGroupId condition as well as the DARPAN_ACTIVE_COMPANY_SCOPE filter, never by a bare primary key:
         another tenant's datasetId reads as "does not exist". No service disables authz. -->

    <service verb="store" noun="Dataset" allow-remote="false">
        <description>Finds or creates the active tenant's dataset for (system, connection, options). The same key always returns
            the same datasetId; a repeat call updates the settings it is given (statusId, margins, horizon, read hour). An
            active dataset is refused for a system whose connector's extract service declares no windowFieldName (it could
            not read by the dataset's fields). readRuleEnumId is DRR_CHANGED_SINCE (default) or DRR_ROLLING: a rolling dataset
            re-reads its whole window every day (horizonDays defaults to 60), counts no misses, and needs no stampField (it
            stamps by windowField). idField may name several fields, comma-separated; the copy keys each record by a derived
            _copyId then. Changing idField, stampField, windowField or horizonDays makes the next refresh
            a full read; the copy is not served until that read has rebuilt it (serving checks the copy's own manifest).</description>
        <in-parameters>
            <parameter name="systemEnumId" required="true"/>
            <parameter name="sourceConfigId" required="true"/>
            <parameter name="options" type="Map"/>
            <parameter name="idField" required="true"/>
            <parameter name="stampField"><description>Required for DRR_CHANGED_SINCE; DRR_ROLLING defaults it to windowField.</description></parameter>
            <parameter name="readRuleEnumId"><description>DRR_CHANGED_SINCE or DRR_ROLLING. Omitted: an existing dataset keeps its rule, a new one is changed-since.</description></parameter>
            <parameter name="windowField" required="true"/>
            <parameter name="statusId"/>
            <parameter name="marginDays" type="Integer"/>
            <parameter name="fullReadDays" type="Integer"/>
            <parameter name="horizonDays" type="Integer"/>
            <parameter name="readHourLocal" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="datasetId"/>
        </out-parameters>
        <actions>
            <set field="tenantId" from="ec.user.context.activeTenantUserGroupId"/>
            <if condition="!tenantId || tenantId == '__NO_ACTIVE_TENANT__'">
                <return error="true" message="No active tenant"/></if>
            <if condition="readRuleEnumId &amp;&amp; !(readRuleEnumId in ['DRR_CHANGED_SINCE', 'DRR_ROLLING'])">
                <return error="true" message="Dataset read rule ${readRuleEnumId} is not one of DRR_CHANGED_SINCE, DRR_ROLLING"/></if>
            <!-- idField is stored canonical: trimmed, no empty parts ("a, b," -> "a,b") -->
            <set field="idField" from="darpan.dataset.DatasetRefreshSupport.idFields(idField as String).join(',')"/>
            <if condition="!idField">
                <return error="true" message="idField must name at least one field"/></if>
            <if condition="statusId">
                <entity-find entity-name="moqui.basic.Enumeration" list="statusList">
                    <econdition field-name="enumId" from="statusId"/>
                    <econdition field-name="enumTypeId" value="DatasetStatus"/>
                </entity-find>
                <if condition="!statusList">
                    <return error="true" message="Dataset status ${statusId} is not one of DST_ACTIVE, DST_PAUSED"/></if>
            </if>
            <script>
                optionsJson = darpan.dataset.DatasetSupport.canonicalJson(options)
                optionsHash = darpan.dataset.DatasetSupport.optionsHash(options ?: [:])
            </script>
            <entity-find entity-name="darpan.dataset.Dataset" list="existingList">
                <econdition field-name="companyUserGroupId" from="tenantId"/>
                <econdition field-name="systemEnumId" from="systemEnumId"/>
                <econdition field-name="sourceConfigId" from="sourceConfigId"/>
                <econdition field-name="optionsHash" from="optionsHash"/>
            </entity-find>
            <!-- I1: a paused dataset may still be stored (pausing one during a deploy skew must work); refresh#Dataset checks again -->
            <set field="effectiveStatusId" from="statusId ?: (existingList ? existingList[0].statusId : 'DST_ACTIVE')"/>
            <if condition="effectiveStatusId != 'DST_PAUSED'">
                <set field="connectorProblem" from="darpan.dataset.DatasetRefreshSupport.datasetConnectorProblem(ec, systemEnumId)"/>
                <if condition="connectorProblem">
                    <return error="true" message="A dataset of ${systemEnumId} cannot be kept: ${connectorProblem}"/></if>
            </if>
            <set field="effectiveRule" from="readRuleEnumId ?: (existingList ? existingList[0].readRuleEnumId : null) ?: 'DRR_CHANGED_SINCE'"/>
            <set field="rolling" from="effectiveRule == 'DRR_ROLLING'"/>
            <if condition="!stampField">
                <if condition="rolling">
                    <then><set field="stampField" from="windowField"/></then>
                    <else-if condition="existingList &amp;&amp; existingList[0].readRuleEnumId != 'DRR_ROLLING'">
                        <set field="stampField" from="existingList[0].stampField"/></else-if>
                    <else><return error="true" message="stampField is required for a DRR_CHANGED_SINCE dataset"/></else>
                </if>
            </if>
            <!-- M3: a changed-since read asks the stamp which records changed; a creation date never changes, so it cannot say -->
            <if condition="!rolling &amp;&amp; stampField == windowField">
                <return error="true" message="stampField cannot be the windowField for a DRR_CHANGED_SINCE dataset: a creation date cannot say what changed"/></if>
            <if condition="existingList">
                <then>
                    <set field="existing" from="existingList[0]"/>
                    <!-- switching to rolling without a horizon takes the rolling width; any other omitted horizon is left alone -->
                    <if condition="horizonDays == null &amp;&amp; rolling &amp;&amp; existing.readRuleEnumId != 'DRR_ROLLING'">
                        <set field="horizonDays" from="60" type="Integer"/></if>
                    <!-- I2: a copy built under other settings is never served (KeptCopySupport checks its manifest); the next
                         refresh reads in full to rebuild it -->
                    <set field="settingsChanged" from="existing.idField != idField || existing.stampField != stampField ||
                            existing.windowField != windowField ||
                            (horizonDays != null &amp;&amp; (existing.horizonDays as Long) != (horizonDays as Long)) ||
                            existing.readRuleEnumId != effectiveRule"/>
                    <if condition="settingsChanged">
                        <set field="existing.lastFullReadAt" from="null"/>
                        <log level="info" message="Dataset ${existing.datasetId}: idField, stampField, windowField or horizonDays changed; the next refresh reads in full, and the copy is not served until it does"/>
                    </if>
                    <set field="existing.readRuleEnumId" from="effectiveRule"/>
                    <set field="existing.idField" from="idField"/>
                    <set field="existing.stampField" from="stampField"/>
                    <set field="existing.windowField" from="windowField"/>
                    <if condition="statusId"><set field="existing.statusId" from="statusId"/></if>
                    <if condition="marginDays != null"><set field="existing.marginDays" from="marginDays"/></if>
                    <if condition="fullReadDays != null"><set field="existing.fullReadDays" from="fullReadDays"/></if>
                    <if condition="horizonDays != null"><set field="existing.horizonDays" from="horizonDays"/></if>
                    <if condition="readHourLocal != null"><set field="existing.readHourLocal" from="readHourLocal"/></if>
                    <script>existing.update()</script>
                    <set field="datasetId" from="existing.datasetId"/>
                </then>
                <else>
                    <service-call name="create#darpan.dataset.Dataset" out-map="created" in-map="[companyUserGroupId:tenantId,
                            systemEnumId:systemEnumId, sourceConfigId:sourceConfigId, optionsJson:optionsJson, optionsHash:optionsHash,
                            statusId:statusId ?: 'DST_ACTIVE', readRuleEnumId:effectiveRule, idField:idField, stampField:stampField,
                            windowField:windowField, marginDays:marginDays ?: 2, fullReadDays:fullReadDays ?: 7,
                            horizonDays:horizonDays ?: (rolling ? 60 : 62), readHourLocal:readHourLocal != null ? readHourLocal : 4]"/>
                    <set field="datasetId" from="created.datasetId"/>
                </else>
            </if>
        </actions>
    </service>

    <service verb="get" noun="Dataset" allow-remote="false">
        <description>One of the active tenant's datasets and its last ten reads, newest first. Another tenant's datasetId does not exist.</description>
        <in-parameters>
            <parameter name="datasetId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="dataset" type="Map"/>
            <parameter name="reads" type="List"/>
        </out-parameters>
        <actions>
            <set field="tenantId" from="ec.user.context.activeTenantUserGroupId"/>
            <entity-find entity-name="darpan.dataset.Dataset" list="datasetList">
                <econdition field-name="datasetId" from="datasetId"/>
                <econdition field-name="companyUserGroupId" from="tenantId"/>
            </entity-find>
            <if condition="!tenantId || !datasetList">
                <return error="true" message="Dataset ${datasetId} does not exist"/></if>
            <set field="dataset" from="datasetList[0].getMap()"/>
            <entity-find entity-name="darpan.dataset.DatasetRead" list="readList" limit="10">
                <econdition field-name="datasetId" from="datasetId"/>
                <econdition field-name="companyUserGroupId" from="tenantId"/>
                <order-by field-name="-readSeqId"/>
            </entity-find>
            <set field="reads" from="readList.collect { it.getMap() }"/>
        </actions>
    </service>

    <service verb="find" noun="ServingDataset" allow-remote="false">
        <description>The active tenant's ACTIVE dataset for (system, connection, options), or null: a paused dataset, or one of
            another tenant, does not serve. The active tenant is the user's, or on a scheduled run (no user) the tenant
            TenantAccessSupport.withSystemTenant published.</description>
        <in-parameters>
            <parameter name="systemEnumId" required="true"/>
            <parameter name="sourceConfigId" required="true"/>
            <parameter name="options" type="Map"/>
        </in-parameters>
        <out-parameters>
            <parameter name="dataset" type="Map"/>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <set field="dataset" from="null"/>
            <if condition="tenantId &amp;&amp; tenantId != '__NO_ACTIVE_TENANT__'">
                <script>optionsHash = darpan.dataset.DatasetSupport.optionsHash(options ?: [:])</script>
                <entity-find entity-name="darpan.dataset.Dataset" list="servingList">
                    <econdition field-name="companyUserGroupId" from="tenantId"/>
                    <econdition field-name="systemEnumId" from="systemEnumId"/>
                    <econdition field-name="sourceConfigId" from="sourceConfigId"/>
                    <econdition field-name="optionsHash" from="optionsHash"/>
                    <econdition field-name="statusId" value="DST_ACTIVE"/>
                </entity-find>
                <if condition="servingList"><set field="dataset" from="servingList[0].getMap()"/></if>
            </if>
        </actions>
    </service>

    <!-- DAR-BE-318 plan 3a, Task 6: refreshing the kept copy. refresh#Dataset never holds a transaction while it reads (a
         full Shopify read takes minutes); the lock and the closing writes each run in their own short transaction. -->

    <service verb="refresh" noun="Dataset" transaction="ignore" allow-remote="false">
        <description>One read of the active tenant's dataset into its kept copy. Takes the lock and mints the read (a RUNNING
            DatasetRead) in one transaction, refused while another refresh holds the lock. Reads FULL (asked, no current
            version, or the last full read is fullReadDays old: createdAt over the horizon) or INCREMENTAL (updatedAt from
            readThru minus marginDays), merges or replaces the copy, and closes the read. A failed read is closed FAILED with
            a back-off on nextReadDate, clears the lock, leaves the copy as it was, and fails. A refresh whose lock was taken
            over (it ran past six hours) swaps, prunes and updates nothing, and is closed FAILED. Call it outside a transaction.</description>
        <in-parameters>
            <parameter name="datasetId" required="true"/>
            <parameter name="forceFull" type="Boolean" default-value="false"/>
            <parameter name="extractor" type="Object">
                <description>A closure (serviceName, params) -> result map that stands in for the connector's extract service.
                    Tests pass a stub; empty calls the real extract service. Not remote: allow-remote is false.</description>
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="readKindEnumId"/>
            <parameter name="readSeqId"/>
            <parameter name="missCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <if condition="!tenantId || tenantId == '__NO_ACTIVE_TENANT__'">
                <return error="true" message="No active tenant"/></if>
            <set field="startedAt" from="ec.user.nowTimestamp"/>
            <service-call name="dataset.DatasetServices.lock#DatasetRefresh" out-map="lockOut"
                    in-map="[datasetId:datasetId, tenantId:tenantId, now:startedAt, forceFull:forceFull == true]"/>
            <check-errors/>
            <!-- From here on nothing may throw before finish#DatasetRefresh: refresh() and failureUpdates() never throw. -->
            <set field="readSeqId" from="lockOut.readSeqId"/>
            <set field="result" from="darpan.dataset.DatasetRefreshSupport.refresh(ec, lockOut.dataset, readSeqId, forceFull == true, startedAt, extractor)"/>
            <set field="readKindEnumId" from="result.readKindEnumId"/>
            <set field="read" from="[readKindEnumId:readKindEnumId, fromStamp:result.fromStamp]"/>
            <if condition="result.error">
                <then>
                    <entity-find entity-name="darpan.dataset.DatasetRead" list="priorReadList" limit="20">
                        <econdition field-name="datasetId" from="datasetId"/>
                        <econdition field-name="companyUserGroupId" from="tenantId"/>
                        <econdition field-name="readSeqId" operator="not-equals" from="readSeqId"/>
                        <order-by field-name="-readSeqId"/>
                    </entity-find>
                    <set field="updates" from="darpan.dataset.DatasetRefreshSupport.failureUpdates(ec, lockOut.dataset,
                            priorReadList*.statusId, result.error as String, ec.user.nowTimestamp)"/>
                    <!-- I1: an extractor that stopped taking the window field warns at once, not only after maxRetries -->
                    <if condition="result.warningText &amp;&amp; !updates.warningText">
                        <set field="updates.warningText" from="result.warningText"/></if>
                    <script>read.putAll([statusId:'DRS_FAILED', errorText:result.error])</script>
                    <service-call name="dataset.DatasetServices.finish#DatasetRefresh" out-map="finishOut"
                            in-map="[datasetId:datasetId, tenantId:tenantId, readSeqId:readSeqId, token:startedAt, read:read, updates:updates]"/>
                    <check-errors/>
                    <return error="true" message="Dataset ${datasetId} read ${readSeqId} failed: ${result.error}"/>
                </then>
            </if>
            <!-- a rolling read counts no misses: result.missCount is null and stays null (no warning) -->
            <set field="missCount" from="result.missCount != null ? (result.missCount as Integer) : null"/>
            <script>read.putAll([statusId:'DRS_DONE', readAt:result.readAt, recordsRead:result.recordsRead,
                    changedCount:result.changedCount, addedCount:result.addedCount, removedCount:result.removedCount,
                    missCount:missCount])</script>
            <set field="warningText" from="null"/>
            <if condition="missCount != null &amp;&amp; missCount &gt; 0">
                <set field="warningText" value="Read ${readSeqId} found ${missCount} records the earlier reads missed"/></if>
            <set field="updates" from="[currentVersion:result.version, readThru:startedAt, lastReadAt:result.readAt,
                    recordCount:result.recordCount, lastMissCount:missCount, nextReadDate:result.nextReadDate, warningText:warningText]"/>
            <!-- DAR-BE-374: the read's records feed the ID index now, while this refresh still holds the lock (so no next read
                 prunes the file mid-index); a failure is recorded on the index cursor and never fails the read -->
            <set field="indexOut" from="darpan.idindex.IdIndexDatasetHook.afterRead(ec, lockOut.dataset, readSeqId, result.readFile as String, result.version as String, readKindEnumId as String)"/>
            <!-- plan 3b-1: what a full read kept of each record (the copy's manifest holds the same); empty for whole records -->
            <if condition="readKindEnumId == 'DRK_FULL'"><set field="updates.keptFieldsJson" from="result.keptFieldsJson"/></if>
            <if condition="readKindEnumId == 'DRK_FULL'"><set field="updates.lastFullReadAt" from="result.readAt"/></if>
            <service-call name="dataset.DatasetServices.finish#DatasetRefresh" out-map="finishOut"
                    in-map="[datasetId:datasetId, tenantId:tenantId, readSeqId:readSeqId, token:startedAt, read:read, updates:updates]"/>
            <check-errors/>
            <if condition="!finishOut.owned">
                <return error="true" message="Dataset ${datasetId} read ${readSeqId} failed: lock taken over: another refresh holds this dataset now"/></if>
        </actions>
    </service>

    <service verb="project" noun="KeptRecords" type="interface">
        <description>Plan 3b-1 (ruling P3b1-9): what a connector's servingProjectionServiceName implements, in its system's own
            component (core names no system). Called three ways:
            (1) with unionFields only, when a dataset's read is planned (DatasetSupport.unionFields): answer keepableFields, the
            ones of them the system's read can select and keep, so one source's field it cannot read never fails the shared read;
            (2) with copy, side and the window but no recordsFile, before a slice opens the copy: answer servingProblem unless
            the copy stands in for the side's live read;
            (3) with recordsFile as well: write the side's records to outputFile trimmed exactly as the live extract would, and
            write beside the slice any side file the live extract writes.
            The contract: a service MUST answer servingProblem whenever it cannot reproduce the live read's records and side
            files byte for byte; core trusts what it writes, checking only the record count. Core itself filters the copy
            records before (3) and writes the excluded-records side file (when the row's excludedRecordsSidecar is Y) from the
            copy records as they are, unprojected: a connector that declares Y and names a projection service must keep in its
            copy what its live side file carries. A servingProblem makes the side read live.</description>
        <in-parameters>
            <parameter name="systemEnumId" required="true"/>
            <parameter name="unionFields" type="List"><description>(1) The fields a dataset's read would keep.</description></parameter>
            <parameter name="copy" type="Map"><description>(2, 3) keptFields (the field list the copy's read was sent;
                null: whole records), readFields (what it was asked to read besides), heldFields (the top-level fields its records
                carry), sideFiles (name to absolute path of the files its read wrote beside its records, from the version the slice
                opened; null when not recorded).</description></parameter>
            <parameter name="side" type="Map"><description>(2, 3) keepFields (the list the side sends its extract; null:
                whole records), filterFields, readFields, windowField.</description></parameter>
            <parameter name="windowStart" type="Timestamp"/>
            <parameter name="windowEnd" type="Timestamp"/>
            <parameter name="recordsFile"><description>(3) Absolute path of the slice's records, one JSON record a line, in the
                window and past the side's filters, as the copy holds them.</description></parameter>
            <parameter name="outputFile"><description>(3) Absolute path to write the trimmed records to, one a line, in order.</description></parameter>
            <parameter name="outputLocation"><description>(3) The data-manager location the slice's file lands in; side files go
                there and nowhere else.</description></parameter>
            <parameter name="fileName"><description>(3) The slice's file name there.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="keepableFields" type="List"><description>(1) The unionFields the system's read can keep.</description></parameter>
            <parameter name="servingProblem"><description>(2, 3) Why the copy cannot stand in for the live read; empty when it can.</description></parameter>
            <parameter name="missingFields" type="List"><description>The fields the copy lacks, when that is why.</description></parameter>
            <parameter name="recordCount" type="Long"><description>(3) Records written to outputFile.</description></parameter>
            <parameter name="writtenLocations" type="List"><description>(3) Side files written beside the slice (removed if it is
                not served; a path outside the slice's folder is never touched).</description></parameter>
            <parameter name="resultFields" type="Map"><description>(3) What the live extract answers besides its file (a side
                file's location), added to the served result; a key the slice answers itself is dropped.</description></parameter>
        </out-parameters>
    </service>

    <service verb="queue" noun="DatasetRefresh" transaction="force-new" allow-remote="false">
        <description>Plan 3b-1 (ruling 3b1-7): the active tenant's dataset is due now, so the next scan#DueDatasets rebuilds
            it. A served side asked for a field its copy lacks, and the dataset's next read would keep it (KeptCopySupport).
            A dataset already due keeps its time; another tenant's datasetId does not exist.</description>
        <in-parameters>
            <parameter name="datasetId" required="true"/>
            <parameter name="reason"/>
        </in-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <entity-find entity-name="darpan.dataset.Dataset" list="queueList" for-update="true">
                <econdition field-name="datasetId" from="datasetId"/>
                <econdition field-name="companyUserGroupId" from="tenantId"/>
            </entity-find>
            <if condition="!tenantId || !queueList">
                <return error="true" message="Dataset ${datasetId} does not exist"/></if>
            <set field="row" from="queueList[0]"/>
            <set field="now" from="ec.user.nowTimestamp"/>
            <if condition="row.nextReadDate != null &amp;&amp; row.nextReadDate.time &gt; now.time">
                <set field="row.nextReadDate" from="now"/>
                <entity-update value-field="row"/>
            </if>
            <log level="info" message="Dataset ${datasetId} is due now: ${reason}"/>
        </actions>
    </service>

    <service verb="lock" noun="DatasetRefresh" transaction="force-new" allow-remote="false">
        <description>Internal to refresh#Dataset. In one transaction: reads the Dataset row for update (a second caller waits
            for the first to commit, then sees its lock), refuses while refreshingSince is under six hours old, otherwise
            sets refreshingSince to this refresh's start (its lock token), mints the next readSeqId and writes the read as
            DRS_RUNNING. Taking over a stale lock closes the old holder's RUNNING reads as FAILED.</description>
        <in-parameters>
            <parameter name="datasetId" required="true"/>
            <parameter name="tenantId" required="true"/>
            <parameter name="now" type="Timestamp" required="true"/>
            <parameter name="forceFull" type="Boolean" default-value="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="dataset" type="Map"/>
            <parameter name="readSeqId"/>
        </out-parameters>
        <actions>
            <entity-find entity-name="darpan.dataset.Dataset" list="lockList" for-update="true">
                <econdition field-name="datasetId" from="datasetId"/>
                <econdition field-name="companyUserGroupId" from="tenantId"/>
            </entity-find>
            <if condition="!lockList">
                <return error="true" message="Dataset ${datasetId} does not exist"/></if>
            <set field="row" from="lockList[0]"/>
            <if condition="row.refreshingSince != null &amp;&amp; row.refreshingSince.time &gt; now.time - 6 * 3600000L">
                <return error="true" message="Dataset ${datasetId} is already refreshing since ${row.refreshingSince.toInstant()}"/></if>
            <set field="row.refreshingSince" from="now"/>
            <entity-update value-field="row"/>

            <entity-find entity-name="darpan.dataset.DatasetRead" list="runningList">
                <econdition field-name="datasetId" from="datasetId"/>
                <econdition field-name="companyUserGroupId" from="tenantId"/>
                <econdition field-name="statusId" value="DRS_RUNNING"/>
            </entity-find>
            <iterate list="runningList" entry="abandoned">
                <set field="abandoned.statusId" value="DRS_FAILED"/>
                <set field="abandoned.errorText" value="Abandoned: its lock went stale and a later refresh took it over"/>
                <entity-update value-field="abandoned"/>
            </iterate>
            <!-- ruling P3a-8: six digits, so newest-first by readSeqId holds past 99 reads -->
            <entity-find entity-name="darpan.dataset.DatasetRead" list="lastReadList" limit="1">
                <econdition field-name="datasetId" from="datasetId"/>
                <econdition field-name="companyUserGroupId" from="tenantId"/>
                <order-by field-name="-readSeqId"/>
            </entity-find>
            <set field="lastSeq" from="lastReadList ? lastReadList[0].readSeqId : null"/>
            <set field="readSeqId" from="String.format('%06d', (lastSeq &amp;&amp; lastSeq ==~ /\d+/ ? (lastSeq as Integer) : 0) + 1)"/>
            <set field="dataset" from="row.getMap()"/>
            <service-call name="create#darpan.dataset.DatasetRead" in-map="[datasetId:datasetId, readSeqId:readSeqId,
                    companyUserGroupId:tenantId, statusId:'DRS_RUNNING', readThru:now,
                    readKindEnumId:darpan.dataset.DatasetRefreshSupport.predictedReadKind(ec, dataset, forceFull == true, now)]"/>
        </actions>
    </service>

    <service verb="finish" noun="DatasetRefresh" transaction="force-new" allow-remote="false">
        <description>Internal to refresh#Dataset. In one transaction, with the Dataset row read for update: when the row's
            refreshingSince still equals this refresh's token, applies the read's updates and clears the lock; when it does
            not (the lock was taken over), touches the Dataset not at all. Either way closes the read's DatasetRead row, as
            DRS_FAILED "lock taken over" when the lock was lost.</description>
        <in-parameters>
            <parameter name="datasetId" required="true"/>
            <parameter name="tenantId" required="true"/>
            <parameter name="readSeqId" required="true"/>
            <parameter name="token" type="Timestamp" required="true"/>
            <parameter name="read" type="Map" required="true"/>
            <parameter name="updates" type="Map"/>
        </in-parameters>
        <out-parameters>
            <parameter name="owned" type="Boolean"/>
        </out-parameters>
        <actions>
            <entity-find entity-name="darpan.dataset.Dataset" list="finishList" for-update="true">
                <econdition field-name="datasetId" from="datasetId"/>
                <econdition field-name="companyUserGroupId" from="tenantId"/>
            </entity-find>
            <if condition="!finishList">
                <return error="true" message="Dataset ${datasetId} does not exist"/></if>
            <set field="row" from="finishList[0]"/>
            <set field="owned" from="row.refreshingSince != null &amp;&amp; row.refreshingSince.time == token.time"/>
            <if condition="owned">
                <then>
                    <if condition="updates"><entity-set value-field="row" map="updates" include="nonpk" set-if-empty="true"/></if>
                    <set field="row.refreshingSince" from="null"/>
                    <entity-update value-field="row"/>
                </then>
                <else>
                    <set field="read.statusId" value="DRS_FAILED"/>
                    <set field="read.errorText" from="darpan.dataset.DatasetRefreshSupport.LOCK_TAKEN_OVER + (read.errorText ? '; ' + read.errorText : '')"/>
                </else>
            </if>
            <entity-find entity-name="darpan.dataset.DatasetRead" list="readList" for-update="true">
                <econdition field-name="datasetId" from="datasetId"/>
                <econdition field-name="readSeqId" from="readSeqId"/>
                <econdition field-name="companyUserGroupId" from="tenantId"/>
            </entity-find>
            <if condition="!readList">
                <return error="true" message="Dataset ${datasetId} read ${readSeqId} does not exist"/></if>
            <set field="readRow" from="readList[0]"/>
            <entity-set value-field="readRow" map="read" include="nonpk" set-if-empty="true"/>
            <entity-update value-field="readRow"/>
        </actions>
    </service>

    <service verb="scan" noun="DueDatasets" transaction="ignore" allow-remote="false" authenticate="anonymous-all">
        <description>The scan_DueDatasets_30m job (seeded paused). Starts a refresh for every ACTIVE dataset whose
            nextReadDate has come (or that was never read) and that no live refresh holds, each as its dataset's tenant, one
            after another. A failed or refused refresh is counted and logged; the scan goes on.</description>
        <in-parameters>
            <parameter name="extractor" type="Object">
                <description>Passed to each refresh#Dataset; tests pass a stub. Empty calls the real extract services.</description>
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="started" type="Integer"/>
            <parameter name="failedCount" type="Integer"/>
            <parameter name="results" type="List"/>
        </out-parameters>
        <actions>
            <set field="now" from="ec.user.nowTimestamp"/>
            <set field="lockCutoff" from="new java.sql.Timestamp(now.time - 6 * 3600000L)"/>
            <!-- A cross-tenant sweep: the job runs anonymous, so no tenant filter applies, and each refresh below is run as
                 the row's own tenant. -->
            <entity-find entity-name="darpan.dataset.Dataset" list="dueList">
                <econdition field-name="statusId" value="DST_ACTIVE"/>
                <econditions combine="or">
                    <econdition field-name="nextReadDate" operator="is-null"/>
                    <econdition field-name="nextReadDate" operator="less-equals" from="now"/>
                </econditions>
                <econditions combine="or">
                    <econdition field-name="refreshingSince" operator="is-null"/>
                    <econdition field-name="refreshingSince" operator="less" from="lockCutoff"/>
                </econditions>
                <order-by field-name="nextReadDate"/>
            </entity-find>
            <set field="started" from="0" type="Integer"/>
            <set field="failedCount" from="0" type="Integer"/>
            <set field="results" from="[]"/>
            <iterate list="dueList" entry="due">
                <set field="outcome" from="darpan.dataset.DatasetRefreshSupport.refreshAsTenant(ec, due.datasetId, due.companyUserGroupId, extractor)"/>
                <set field="started" from="started + 1"/>
                <if condition="outcome.error">
                    <set field="failedCount" from="failedCount + 1"/>
                    <log level="warn" message="Dataset ${due.datasetId} (${due.companyUserGroupId}) refresh failed: ${outcome.error}"/>
                </if>
                <script>results.add([datasetId:due.datasetId, companyUserGroupId:due.companyUserGroupId] + outcome)</script>
            </iterate>
        </actions>
    </service>

    <!-- DAR-OPS-029 S42c (OC92). A privacy erase needs every copy of a store's data gone, and kept copies and the ID index
         outlive the finding records (no retention covers either). -->
    <service verb="drop" noun="ConnectionKeptData" allow-remote="false">
        <description>One tenant's kept data read through these connections: the ID index rows they wrote, the index's
            cursors, the kept copies' reads and rows, then the copies' folders. For an erase the caller owes (Shopify's
            shop/redact, after its signature check). One transaction, so the nightly index never sees a copy without its rows
            gone; a folder that will not delete fails it and the rows stay. Refused while a copy is refreshing (a lock under
            six hours old), so the caller fails and retries rather than a refresh writing files back after the erase.</description>
        <in-parameters>
            <parameter name="companyUserGroupId" required="true"/>
            <parameter name="sourceConfigIds" type="List"><description>The connections (config ids) whose data goes. Empty does
                nothing.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="datasetsDropped" type="Integer"/>
            <parameter name="indexRowsDropped" type="Long"/>
        </out-parameters>
        <actions>
            <set field="datasetsDropped" from="0"/>
            <set field="indexRowsDropped" from="0L"/>
            <if condition="!sourceConfigIds"><return/></if>

            <entity-find entity-name="darpan.dataset.Dataset" list="dropList" for-update="true">
                <econdition field-name="companyUserGroupId"/>
                <econdition field-name="sourceConfigId" operator="in" from="sourceConfigIds"/>
            </entity-find>
            <set field="busySince" from="ec.user.nowTimestamp.time - 6 * 3600000L"/>
            <set field="busy" from="dropList.find { it.refreshingSince != null &amp;&amp; it.refreshingSince.time &gt; busySince }"/>
            <if condition="busy">
                <return error="true" message="Dataset ${busy.datasetId} is refreshing; its kept data can be dropped once the refresh ends."/></if>

            <!-- OC104 (S14): mark each connection dropped, locked, before anything is deleted: a run's extract indexed in the
                 background (IdIndexRunHook) reads this marker under the same lock and writes nothing it read before droppedAt. -->
            <iterate list="sourceConfigIds" entry="dropConnectionId">
                <entity-find-one entity-name="darpan.idindex.RecordIdIndexDrop" value-field="dropMarker" for-update="true">
                    <field-map field-name="companyUserGroupId"/>
                    <field-map field-name="connectionId" from="dropConnectionId"/>
                </entity-find-one>
                <if condition="dropMarker == null">
                    <entity-make-value entity-name="darpan.idindex.RecordIdIndexDrop" value-field="dropMarker"
                            map="[companyUserGroupId: companyUserGroupId, connectionId: dropConnectionId, droppedAt: ec.user.nowTimestamp]"/>
                    <entity-create value-field="dropMarker"/>
                    <else><set field="dropMarker.droppedAt" from="ec.user.nowTimestamp"/><entity-update value-field="dropMarker"/></else>
                </if>
            </iterate>

            <entity-find-count entity-name="darpan.idindex.RecordIdIndex" count-field="indexRowsDropped">
                <econdition field-name="companyUserGroupId"/>
                <econdition field-name="connectionId" operator="in" from="sourceConfigIds"/>
            </entity-find-count>
            <entity-delete-by-condition entity-name="darpan.idindex.RecordIdIndex">
                <econdition field-name="companyUserGroupId"/>
                <econdition field-name="connectionId" operator="in" from="sourceConfigIds"/>
            </entity-delete-by-condition>
            <entity-delete-by-condition entity-name="darpan.idindex.RecordIdIndexCursor">
                <econdition field-name="companyUserGroupId"/>
                <econdition field-name="connectionId" operator="in" from="sourceConfigIds"/>
            </entity-delete-by-condition>

            <set field="datasetIds" from="dropList*.datasetId"/>
            <if condition="datasetIds">
                <entity-delete-by-condition entity-name="darpan.dataset.DatasetRead">
                    <econdition field-name="companyUserGroupId"/>
                    <econdition field-name="datasetId" operator="in" from="datasetIds"/>
                </entity-delete-by-condition>
                <entity-delete-by-condition entity-name="darpan.dataset.Dataset">
                    <econdition field-name="companyUserGroupId"/>
                    <econdition field-name="datasetId" operator="in" from="datasetIds"/>
                </entity-delete-by-condition>
                <!-- Files last: a folder that will not delete throws, and the transaction keeps every row above. -->
                <script>datasetIds.each { String id ->
                    File dir = darpan.dataset.DatasetRefreshSupport.datasetDir(ec, companyUserGroupId, id)
                    if (dir.exists() &amp;&amp; !dir.deleteDir()) throw new IllegalStateException("Dataset ${id}: its kept copy folder could not be deleted")
                }</script>
            </if>
            <set field="datasetsDropped" from="datasetIds.size()"/>
        </actions>
    </service>
</services>
