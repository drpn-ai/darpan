<entity-facade-xml type="darpan-seed">
    <!-- DAR-BE-015 — what a client destination is told when a run errors: one neutral line, never the error. The detail
         goes to Darpan's own error space and daily email. Built in Groovy (AutomationExecutionSupport.notifyRunError) and
         read through EmailCopyReader; editable in production (copyText), no deploy. It is posted as chat text, never sent
         as an email: the EmailTemplate row is what lets the admin email editor list, show, preview (screen/email/ErrorNotice.xml)
         and edit it like the other copy. The SYSTEM EmailServer row is seeded by id alone so the template loads anywhere.
         Loaded on an existing database through data/upgrade-data.xml. -->
    <moqui.basic.email.EmailServer emailServerId="SYSTEM"/>
    <moqui.basic.email.EmailTemplate emailTemplateId="DARPAN_ERROR_NOTICE" description="Darpan run did not run (chat line, not an email)"
            emailServerId="SYSTEM" webappName="webroot" sendPartial="Y" subject="Darpan run notice"
            fromAddress="${System.getenv('DARPAN_MAIL_FROM') ?: 'support@drpn.ai'}" fromName="Darpan"
            bodyScreenLocation="component://darpan/screen/email/ErrorNotice.xml"/>
    <darpan.email.EmailCopyBlock emailTemplateId="DARPAN_ERROR_NOTICE" blockId="client.notrun"
            defaultText="${name} did not run this morning. Darpan has been alerted and is working on a fix."/>
</entity-facade-xml>
