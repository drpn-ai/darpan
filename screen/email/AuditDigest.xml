<?xml version="1.0" encoding="UTF-8"?>
<!-- DAR-BE-102 email body: the digest's text as it goes to chat, one block, escaped. Plain on purpose: no bold.
     DAR-BE-298: wears EmailFrame (the app's light theme, like the audit email); copy follows the darpan-email skill. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false">
    <actions>
        <!-- A send passes the finished text (chat gets the same one). The admin preview passes the report instead, so the
             draft's words show: the text is built here, through the same blocks. -->
        <set field="digestText" from="ec.context.get('digestText') ?: darpan.audit.AuditDigestSupport.render(digestReport, digestKind ?: 'AUDDK_DAILY', digestFullList == true, ec.context.get('digestWeekAgo'), ec.context.get('digestReportUrl'), new darpan.email.EmailCopyReader(ec, 'DARPAN_AUDIT_DIGEST'), new darpan.email.EmailCopyReader(ec, 'DARPAN_AUDIT_RUN'))"/>
        <set field="digestHtml" from="darpan.email.EmailFrame.esc(digestText)"/>
        <!-- DAR-OPS-029 S99-076: frameOpen, frameClose, guideLinks, guidesHtml, guidesText (EmailFrame.preamble). -->
        <script>context.putAll(darpan.email.EmailFrame.preamble(ec, 'DARPAN · AUDIT DIGEST', 'DARPAN_AUDIT_DIGEST'))</script>
    </actions>
    <widgets>
        <render-mode><text type="html" no-boundary-comment="true"><![CDATA[${frameOpen}]]></text></render-mode>
        <!-- Not a label: a label in text mode pads and cuts each value to a column width (a long digest lost its tail in the
             plain-text part) and expands its text as a template. The text is inserted as it is. -->
        <render-mode>
            <text type="html" no-boundary-comment="true"><![CDATA[<pre class="text-inline dp-pre">${digestHtml}</pre>${guidesHtml}${frameClose}]]></text>
            <text type="text" no-boundary-comment="true"><![CDATA[${digestText}
${guidesText}]]></text>
        </render-mode>
    </widgets>
</screen>
