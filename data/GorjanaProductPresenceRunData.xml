<?xml version="1.0" encoding="UTF-8"?>
<!--
  DAR-BE-157 - gorjana's NetSuite <-> HotWax product runs, plain two-way saved runs, not part of the audit (Aditi
  2026-10-29). Measured against gorjana production on 2026-10-28/29 (tools/live-probes/run-active-products-probe.sh,
  run-transfer-products-probe.sh, run-ns-item-sellable-probe.sh).

  Why: 294 transfer orders were refused by HotWax on 16 and 22 Oct because their products were not in HotWax yet (the
  NetSuite -> HotWax product sync was behind). A whole-catalogue, two-way presence check names such a product before
  anything is refused for it.

  Two runs over the same two reads; each reports only its own causes (Aditi 2026-10-29: "it should only be reporting:
  Not synced to HW and one netsuite id n several hotwax products ... the not in HW check should run every day ... a weekly
  product sync that checks for irregularities"; "for the daily report, focus on the products that are sellable";
  "non-sellable products should be in the weekly report only"):
    GORJANA_PRODUCT_NOT_IN_HOTWAX_RS (daily)  a sellable NetSuite item HotWax does not have.
    GORJANA_PRODUCT_PRESENCE_RS (weekly)      a non-sellable NetSuite item HotWax does not have, and one NetSuite id on
                                              several HotWax products.
  Sellable = NetSuite Subgroup (custitemsubgroup) Fashion, Fine, Core, Accessories or Home Décor: jewellery, gift sets,
  accessories, candles. Packaging, GWP, Fixture and no Subgroup (packaging, marketing images, displays, every
  non-inventory item) are not sellable. Over the active items: Fashion 6,656, Fine 1,574, Core 49, Accessories 20, Home
  Décor 6; Packaging 122, GWP 32, Fixture 2, none 851.
  Everything else either run sees is HIDDEN (outcome HIDE), "In HotWax, not sellable" included (Aditi 2026-10-29: "hide it"):
  its summary (conclusions.hidden) says how many and why.

  FILE_1 = NetSuite ACTIVE_ITEMS (tools/netsuite-chain-config/gorjana-product-queries.xml): every non-inactive InvtPart,
  Kit and NonInvtPart, live = new (created in the last 90 days: a new item must reach HotWax before its first PO or
  transfer order) or used for HotWax in the last year: weekly (NS_ACTIVE_ITEMS) a line on a HotWax sales order, a transfer
  order or a purchase order; daily (NS_ACTIVE_ITEMS_DAILY) transfer and purchase orders only, since a year of HotWax
  sales-order lines took 447 s of a 13-minute run and an item on a HotWax order was in HotWax (Aditi 2026-10-29: the
  daily run must not take long). Quiet items (live N) are EXCLUDED, so they never become "not in HotWax".
  FILE_2 = HotWax OMS_PRODUCTS_GQL: every sellable product (not virtual, FINISHED_GOOD or MARKETING_PKG_PICK, not
  discontinued), nsKey = its NETSUITE_PRODUCT_ID (the NetSuite item internal id), HOTWAX-ONLY:productId when it has none,
  DUPLICATE:id:productId for every product after the first sharing one (netsuiteIdState NONE / SHARED).
  Neither side is windowed: presence is a whole-catalogue question.

  NOT seed data - tenant configuration. Load per install, AFTER tools/netsuite-chain-config/gorjana-product-queries.xml.
  The HotWax side names the tenant's HotWax config (gorjana_prod locally; gorjana_oms on prod - remap with /transfer).
-->
<entity-facade-xml type="darpan-tenant-config">

    <moqui.basic.Enumeration enumId="CONC_PRODUCT_NOT_IN_HOTWAX" enumTypeId="DarpanConclusion" enumCode="CONC_PRODUCT_NOT_IN_HOTWAX" description="Not synced to HotWax"/>
    <moqui.basic.Enumeration enumId="CONC_PRODUCT_NS_ID_SHARED" enumTypeId="DarpanConclusion" enumCode="CONC_PRODUCT_NS_ID_SHARED" description="One NetSuite id on several HotWax products"/>
    <moqui.basic.Enumeration enumId="CONC_PRODUCT_NOT_SELLABLE_IN_HOTWAX" enumTypeId="DarpanConclusion" enumCode="CONC_PRODUCT_NOT_SELLABLE_IN_HOTWAX" description="In HotWax, not sellable"/>
    <moqui.basic.Enumeration enumId="CONC_PRODUCT_DISCONTINUED_IN_NS" enumTypeId="DarpanConclusion" enumCode="CONC_PRODUCT_DISCONTINUED_IN_NS" description="Discontinued in NetSuite"/>
    <moqui.basic.Enumeration enumId="CONC_PRODUCT_NS_ONLY_NON_INVENTORY" enumTypeId="DarpanConclusion" enumCode="CONC_PRODUCT_NS_ONLY_NON_INVENTORY" description="Non-inventory item, NetSuite only"/>
    <moqui.basic.Enumeration enumId="CONC_PRODUCT_SELLABLE_IN_NS" enumTypeId="DarpanConclusion" enumCode="CONC_PRODUCT_SELLABLE_IN_NS" description="Sellable, in the daily run"/>
    <moqui.basic.Enumeration enumId="CONC_PRODUCT_NOT_SELLABLE_IN_NS" enumTypeId="DarpanConclusion" enumCode="CONC_PRODUCT_NOT_SELLABLE_IN_NS" description="Not sellable, in the weekly run"/>
    <moqui.basic.Enumeration enumId="CONC_PRODUCT_NOT_REPORTED" enumTypeId="DarpanConclusion" enumCode="CONC_PRODUCT_NOT_REPORTED" description="HotWax product, not reported"/>

    <!-- ================= Daily: a sellable NetSuite item HotWax does not have ================= -->
    <darpan.rule.RuleSet ruleSetId="GORJANA_PRODUCT_NOT_IN_HOTWAX_RS" ruleSetName="Products - sellable, not in HotWax"
            description="Every sellable NetSuite item that is new or used for HotWax this year is a sellable HotWax product. Whole catalogue, no window. Run daily."
            version="1.0" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareScope compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" ruleSetId="GORJANA_PRODUCT_NOT_IN_HOTWAX_RS"
            objectType="PRODUCT" scopeMode="COMPARE" description="Every sellable NetSuite item that is new or used for HotWax this year is a sellable HotWax product. Whole catalogue, no window. Run daily."
            companyUserGroupId="GORJANA"/>
    <!-- NS_ACTIVE_ITEMS_DAILY: use = transfer and purchase orders only (19 s, not 447 s; see gorjana-product-queries.xml). -->
    <darpan.rule.RuleSetCompareSource compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" fileSide="FILE_1"
            systemEnumId="NETSUITE_SUITEQL" sourceTypeEnumId="AUT_SRC_API" fileTypeEnumId="DftJson"
            recordRootExpression="records" primaryIdExpression="id"
            sourceConfigId="NS_ACTIVE_ITEMS_DAILY" sourceConfigType="NETSUITE_SUITEQL" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSourceKeyField compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" fileSide="FILE_1" sequenceNum="1" fieldExpression="id" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSourceFilter compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" fileSide="FILE_1" sequenceNum="1" fieldExpression="live" operator="EXCLUDE_IN" filterValues="N" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSource compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" fileSide="FILE_2"
            systemEnumId="OMS_PRODUCTS_GQL" sourceTypeEnumId="AUT_SRC_API" fileTypeEnumId="DftJson"
            recordRootExpression="records" primaryIdExpression="nsKey"
            sourceConfigId="gorjana_prod" sourceConfigType="HOTWAX_OMS_GQL_PRODUCTS" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSourceKeyField compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" fileSide="FILE_2" sequenceNum="1" fieldExpression="nsKey" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSourceFilter compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" fileSide="FILE_2" sequenceNum="1" fieldExpression="sellable" operator="EXCLUDE_IN" filterValues="N" companyUserGroupId="GORJANA"/>

    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" sequenceNum="13" conclusionEnumId="CONC_PRODUCT_DISCONTINUED_IN_NS" outcome="HIDE" appliesToBucket="MISSING_FROM_FILE_2"
            fixActionTemplate="Nothing to fix: NetSuite marks {sku} Discontinued (Active Status), so HotWax does not need it." companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" sequenceNum="13" conditionSeq="1" subject="FILE_1" presence="ANY" keyScope="FULL" fieldExpression="activeStatus" operator="IN" conditionValues="Discontinued" checkLabel="NetSuite Active Status" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" sequenceNum="13" conditionSeq="2" subject="FILE_1" presence="ANY" keyScope="FULL" fieldExpression="sku" operator="NOT_IN" conditionValues="-" checkLabel="NetSuite SKU" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" sequenceNum="14" conclusionEnumId="CONC_PRODUCT_NOT_SELLABLE_IN_NS" outcome="HIDE" appliesToBucket="MISSING_FROM_FILE_2"
            fixActionTemplate="Nothing to fix here: {sku} is not sellable in NetSuite (Subgroup {subgroup}); the weekly product run reports it." companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" sequenceNum="14" conditionSeq="1" subject="FILE_1" presence="ANY" keyScope="FULL" fieldExpression="subgroup" operator="NOT_IN" conditionValues="Fashion,Fine,Core,Accessories,Home Décor" checkLabel="NetSuite Subgroup" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" sequenceNum="14" conditionSeq="2" subject="FILE_1" presence="ANY" keyScope="FULL" fieldExpression="sku" operator="NOT_IN" conditionValues="-" checkLabel="NetSuite SKU" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" sequenceNum="17" conclusionEnumId="CONC_PRODUCT_NOT_SELLABLE_IN_HOTWAX" outcome="HIDE" appliesToBucket="MISSING_FROM_FILE_2"
            fixActionTemplate="NetSuite item {recordKey} ({sku}) is new or was used for HotWax this year, but HotWax product {productId} is {notSellableReason}: make it sellable in HotWax, or inactive in NetSuite." companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" sequenceNum="17" conditionSeq="1" subject="FILE_2" presence="EXCLUDED" keyScope="FULL" fieldExpression="notSellableReason" operator="NOT_IN" conditionValues="-" checkLabel="HotWax has the product, not sellable" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" sequenceNum="17" conditionSeq="2" subject="FILE_2" presence="EXCLUDED" keyScope="FULL" fieldExpression="productId" operator="NOT_IN" conditionValues="-" checkLabel="HotWax product" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" sequenceNum="17" conditionSeq="3" subject="FILE_1" presence="ANY" keyScope="FULL" fieldExpression="sku" operator="NOT_IN" conditionValues="-" checkLabel="NetSuite SKU" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" sequenceNum="20" conclusionEnumId="CONC_PRODUCT_NOT_IN_HOTWAX" appliesToBucket="MISSING_FROM_FILE_2"
            fixActionTemplate="Sync NetSuite item {recordKey} ({sku}) to HotWax, then re-import anything HotWax refused for it (transfer orders, purchase orders)." companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" sequenceNum="20" conditionSeq="1" subject="FILE_2" presence="ABSENT" keyScope="FULL" checkLabel="HotWax has no product with this NetSuite id" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" sequenceNum="20" conditionSeq="2" subject="FILE_1" presence="ANY" keyScope="FULL" fieldExpression="sku" operator="NOT_IN" conditionValues="-" checkLabel="NetSuite SKU" companyUserGroupId="GORJANA"/>
    <!-- The HotWax-only side (a quiet NetSuite item, no or a shared NetSuite id, a gone item) is not this run's question. -->
    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" sequenceNum="90" conclusionEnumId="CONC_PRODUCT_NOT_REPORTED" outcome="HIDE" appliesToBucket="MISSING_FROM_FILE_1"
            fixActionTemplate="Nothing to fix here: this run reports only sellable NetSuite items HotWax lacks." companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_NOT_IN_HOTWAX_SCOPE" sequenceNum="90" conditionSeq="1" subject="FILE_2" presence="ANY" keyScope="FULL" checkLabel="A HotWax product" companyUserGroupId="GORJANA"/>

    <!-- ================= Weekly: a non-sellable NetSuite item HotWax does not have; one NetSuite id on several products ================= -->
    <darpan.rule.RuleSet ruleSetId="GORJANA_PRODUCT_PRESENCE_RS" ruleSetName="Products - NetSuite vs HotWax, weekly"
            description="Every non-sellable NetSuite item (packaging, marketing, displays) that is new or used for HotWax this year is a HotWax product, and no NetSuite id is on more than one HotWax product. Whole catalogue, no window. Run weekly."
            version="1.0" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareScope compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" ruleSetId="GORJANA_PRODUCT_PRESENCE_RS"
            objectType="PRODUCT" scopeMode="COMPARE" description="Every non-sellable NetSuite item (packaging, marketing, displays) that is new or used for HotWax this year is a HotWax product, and no NetSuite id is on more than one HotWax product. Whole catalogue, no window. Run weekly."
            companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSource compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" fileSide="FILE_1"
            systemEnumId="NETSUITE_SUITEQL" sourceTypeEnumId="AUT_SRC_API" fileTypeEnumId="DftJson"
            recordRootExpression="records" primaryIdExpression="id"
            sourceConfigId="NS_ACTIVE_ITEMS" sourceConfigType="NETSUITE_SUITEQL" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSourceKeyField compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" fileSide="FILE_1" sequenceNum="1" fieldExpression="id" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSourceFilter compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" fileSide="FILE_1" sequenceNum="1" fieldExpression="live" operator="EXCLUDE_IN" filterValues="N" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSource compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" fileSide="FILE_2"
            systemEnumId="OMS_PRODUCTS_GQL" sourceTypeEnumId="AUT_SRC_API" fileTypeEnumId="DftJson"
            recordRootExpression="records" primaryIdExpression="nsKey"
            sourceConfigId="gorjana_prod" sourceConfigType="HOTWAX_OMS_GQL_PRODUCTS" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetCompareSourceKeyField compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" fileSide="FILE_2" sequenceNum="1" fieldExpression="nsKey" companyUserGroupId="GORJANA"/>
    <!-- A discontinued, virtual or non-selling product is in the extract only when it carries a NetSuite id no sellable product
         holds; excluded here, so a live NetSuite item HotWax has only that way concludes "In HotWax, not sellable". -->
    <darpan.rule.RuleSetCompareSourceFilter compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" fileSide="FILE_2" sequenceNum="1" fieldExpression="sellable" operator="EXCLUDE_IN" filterValues="N" companyUserGroupId="GORJANA"/>

    <!-- HotWax has it, NetSuite's read does not: only a shared NetSuite id is reported. A fix names only what its own
         conditions read (AuditReportAssembler.causeFix fills a placeholder from the condition that reads the field), so the
         NOT_IN "-" conditions exist to carry the values into the fix: they always hold (no field is "-") and read the value. -->
    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="12" conclusionEnumId="CONC_PRODUCT_NS_ID_SHARED" appliesToBucket="MISSING_FROM_FILE_1"
            fixActionTemplate="NetSuite id {netsuiteProductId} is on HotWax products {productId} ({internalName}) and {sharedWith}: keep it on the product that is that NetSuite item and remove it from the others." companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="12" conditionSeq="1" subject="FILE_2" presence="ANY" keyScope="FULL" fieldExpression="netsuiteIdState" operator="IN" conditionValues="SHARED" checkLabel="Another HotWax product has the same NetSuite id" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="12" conditionSeq="2" subject="FILE_2" presence="ANY" keyScope="FULL" fieldExpression="netsuiteProductId" operator="NOT_IN" conditionValues="-" checkLabel="Its NetSuite id" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="12" conditionSeq="3" subject="FILE_2" presence="ANY" keyScope="FULL" fieldExpression="productId" operator="NOT_IN" conditionValues="-" checkLabel="HotWax product" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="12" conditionSeq="4" subject="FILE_2" presence="ANY" keyScope="FULL" fieldExpression="internalName" operator="NOT_IN" conditionValues="-" checkLabel="HotWax product SKU" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="12" conditionSeq="5" subject="FILE_2" presence="ANY" keyScope="FULL" fieldExpression="sharedWith" operator="NOT_IN" conditionValues="-" checkLabel="Also on HotWax products" companyUserGroupId="GORJANA"/>

    <!-- NetSuite has it live, HotWax does not sell it. Discontinued (Active Status custitem1, Aditi on 193-102-G) and a
         NetSuite-only non-inventory item (POS Tax Variance, donations) are expected; a sellable item is the daily run's. -->
    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="13" conclusionEnumId="CONC_PRODUCT_DISCONTINUED_IN_NS" outcome="HIDE" appliesToBucket="MISSING_FROM_FILE_2"
            fixActionTemplate="Nothing to fix: NetSuite marks {sku} Discontinued (Active Status), so HotWax does not need it." companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="13" conditionSeq="1" subject="FILE_1" presence="ANY" keyScope="FULL" fieldExpression="activeStatus" operator="IN" conditionValues="Discontinued" checkLabel="NetSuite Active Status" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="13" conditionSeq="2" subject="FILE_1" presence="ANY" keyScope="FULL" fieldExpression="sku" operator="NOT_IN" conditionValues="-" checkLabel="NetSuite SKU" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="14" conclusionEnumId="CONC_PRODUCT_SELLABLE_IN_NS" outcome="HIDE" appliesToBucket="MISSING_FROM_FILE_2"
            fixActionTemplate="Nothing to fix here: {sku} is sellable in NetSuite (Subgroup {subgroup}); the daily product run reports it." companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="14" conditionSeq="1" subject="FILE_1" presence="ANY" keyScope="FULL" fieldExpression="subgroup" operator="IN" conditionValues="Fashion,Fine,Core,Accessories,Home Décor" checkLabel="NetSuite Subgroup" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="14" conditionSeq="2" subject="FILE_1" presence="ANY" keyScope="FULL" fieldExpression="sku" operator="NOT_IN" conditionValues="-" checkLabel="NetSuite SKU" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="16" conclusionEnumId="CONC_PRODUCT_NS_ONLY_NON_INVENTORY" outcome="HIDE" appliesToBucket="MISSING_FROM_FILE_2"
            fixActionTemplate="Nothing to fix: {sku} is a NetSuite non-inventory item (an accounting line or a charge) that HotWax does not sell. Sync it to HotWax only if stores sell it." companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="16" conditionSeq="1" subject="FILE_1" presence="ANY" keyScope="FULL" fieldExpression="itemType" operator="IN" conditionValues="NonInvtPart" checkLabel="A NetSuite non-inventory item" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="16" conditionSeq="2" subject="FILE_1" presence="ANY" keyScope="FULL" fieldExpression="sku" operator="NOT_IN" conditionValues="-" checkLabel="NetSuite SKU" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="17" conclusionEnumId="CONC_PRODUCT_NOT_SELLABLE_IN_HOTWAX" outcome="HIDE" appliesToBucket="MISSING_FROM_FILE_2"
            fixActionTemplate="NetSuite item {recordKey} ({sku}) is new or was used for HotWax this year, but HotWax product {productId} is {notSellableReason}: make it sellable in HotWax, or inactive in NetSuite." companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="17" conditionSeq="1" subject="FILE_2" presence="EXCLUDED" keyScope="FULL" fieldExpression="notSellableReason" operator="NOT_IN" conditionValues="-" checkLabel="HotWax has the product, not sellable" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="17" conditionSeq="2" subject="FILE_2" presence="EXCLUDED" keyScope="FULL" fieldExpression="productId" operator="NOT_IN" conditionValues="-" checkLabel="HotWax product" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="17" conditionSeq="3" subject="FILE_1" presence="ANY" keyScope="FULL" fieldExpression="sku" operator="NOT_IN" conditionValues="-" checkLabel="NetSuite SKU" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="20" conclusionEnumId="CONC_PRODUCT_NOT_IN_HOTWAX" appliesToBucket="MISSING_FROM_FILE_2"
            fixActionTemplate="Sync NetSuite item {recordKey} ({sku}) to HotWax, then re-import anything HotWax refused for it (transfer orders, purchase orders)." companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="20" conditionSeq="1" subject="FILE_2" presence="ABSENT" keyScope="FULL" checkLabel="HotWax has no product with this NetSuite id" companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="20" conditionSeq="2" subject="FILE_1" presence="ANY" keyScope="FULL" fieldExpression="sku" operator="NOT_IN" conditionValues="-" checkLabel="NetSuite SKU" companyUserGroupId="GORJANA"/>
    <!-- Every other HotWax-only product (a quiet NetSuite item, no NetSuite id, a gone item) is not reported. -->
    <darpan.rule.RuleSetConclusionRule compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="90" conclusionEnumId="CONC_PRODUCT_NOT_REPORTED" outcome="HIDE" appliesToBucket="MISSING_FROM_FILE_1"
            fixActionTemplate="Nothing to fix here: of HotWax-only products this run reports only a NetSuite id on several of them." companyUserGroupId="GORJANA"/>
    <darpan.rule.RuleSetConclusionCondition compareScopeId="GORJANA_PRODUCT_PRESENCE_SCOPE" sequenceNum="90" conditionSeq="1" subject="FILE_2" presence="ANY" keyScope="FULL" checkLabel="A HotWax product" companyUserGroupId="GORJANA"/>

</entity-facade-xml>
