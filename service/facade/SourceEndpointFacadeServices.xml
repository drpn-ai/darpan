<?xml version="1.0" encoding="UTF-8"?>
<!-- Per-endpoint enablement for API source configs.

     GENERIC BY DESIGN: both services take a configTypeEnumId rather than being per-system, so a new
     shareable config type needs no new service. The type resolves to an entity name through
     SharedConfigAccessSupport.CONFIG_TYPE_REGISTRY — entity names never cross the wire.

     FENCE WARNING: facade\..* is granted to every Darpan role including DARPAN_TENANT_USER
     (SecuritySeedData.xml:97-121), so the artifact fence stops nobody. The gate is the parent-config
     authorization inside darpan.reconciliation.automation.SourceEndpointAccessSupport.listEndpointsForAuthorizedConfig
     (read) and SourceEndpointWriteSupport.storeAccess (write). Enablement is OWNER-controlled: a
     tenant holding only ConfigTenantAccess may read the list (owner OR shared peer) but not change it
     (owner only). -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="list" noun="SourceConfigEndpoints" authz-action="view" allow-remote="true" authenticate="true">
        <description>Endpoints registered for this config type, each with its current enablement.
            The catalog comes from SourceSystemConnector; access rows only supply isEnabled.</description>
        <in-parameters>
            <parameter name="configTypeEnumId" required="true"><description>SCFG_HOTWAX_OMS, SCFG_SHOPIFY_AUTH,
                SCFG_NS_AUTH, or SCFG_NS_RESTLET.</description></parameter>
            <parameter name="configId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="endpoints" type="List">
                <parameter name="systemEnumId"/>
                <parameter name="endpointLabel"/>
                <parameter name="isEnabled" type="Boolean"/>
            </parameter>
        </out-parameters>
        <actions>
            <set field="endpoints" from="darpan.reconciliation.automation.SourceEndpointAccessSupport.listEndpointsForAuthorizedConfig(ec, configTypeEnumId, configId)"/>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="store" noun="SourceConfigEndpointAccess" authz-action="update" allow-remote="true" authenticate="true">
        <description>Replace this config's endpoint enablement. Endpoints omitted from
            enabledSystemEnumIds are explicitly disabled; endpoints included have any prior 'N' row
            flipped back to 'Y'. Absent rows mean enabled, so a fully-enabled config stores nothing
            new.</description>
        <in-parameters>
            <parameter name="configTypeEnumId" required="true"/>
            <parameter name="configId" required="true"/>
            <parameter name="enabledSystemEnumIds" type="List" required="true">
                <parameter name="systemEnumId"/>
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="stored" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="stored" from="darpan.reconciliation.automation.SourceEndpointWriteSupport.storeAccess(ec, configTypeEnumId, configId, enabledSystemEnumIds)"/>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <!-- One-time upgrade migration (P1-T4): translate the legacy canReadOrders flag into explicit
         SourceConfigEndpointAccess rows. authenticate="false" + allow-remote="false" by design: an
         operator runs this once per environment during the upgrade, not a tenant-facing action, and it
         deliberately sweeps every tenant's configs (see SourceEndpointWriteSupport.migrateLegacyCanReadOrders
         Javadoc) — it must never be reachable remotely. -->
    <service verb="migrate" noun="SourceConfigEndpointAccess" authenticate="false" allow-remote="false">
        <description>One-time: translate the legacy canReadOrders flag into explicit endpoint
            decisions. canReadOrders='N' disables every endpoint of that config's type;
            canReadOrders='Y' writes nothing, because an absent row already means enabled.
            Idempotent by PK — safe to re-run. Not remote: an operator runs this once per
            environment during the upgrade.</description>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="disabledConfigCount" type="Integer"/>
            <parameter name="rowsWritten" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="migrationResult" from="darpan.reconciliation.automation.SourceEndpointWriteSupport.migrateLegacyCanReadOrders(ec)"/>
            <set field="disabledConfigCount" from="migrationResult.disabledConfigCount"/>
            <set field="rowsWritten" from="migrationResult.rowsWritten"/>
            <message>Disabled endpoints for ${disabledConfigCount} config(s); wrote ${rowsWritten} row(s).</message>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <!-- One-time upgrade migration (Plan 2 Task 10): delete SourceSystemConnectorField pill rows
         explicitly withdrawn from seed data. Moqui seed loads are createOrUpdate and never delete, so
         removing a row from SourceSystemConnectorFieldSeedData.xml has no effect on a database that
         already loaded the earlier version of that file — the row survives and the rules board keeps
         offering it (see SourceSystemConnectorFieldWriteSupport Javadoc for the SHOPIFY_RETURN_REFS /
         orderName case this fixes). authenticate="false" + allow-remote="false" by design, exactly like
         migrate#SourceConfigEndpointAccess above: an operator runs this once per environment during the
         upgrade, not a tenant-facing action, and it must never be reachable remotely. -->
    <service verb="migrate" noun="RetiredConnectorFields" authenticate="false" allow-remote="false">
        <description>One-time: delete SourceSystemConnectorField rows explicitly retired in
            SourceSystemConnectorFieldWriteSupport.RETIRED_FIELDS. Deletes by exact PK (systemEnumId +
            fieldPath) only — never by systemEnumId alone, which would sweep every pill an endpoint has
            rather than just the withdrawn one. Idempotent — safe to re-run; a second run deletes
            nothing and reports zero. Not remote: an operator runs this once per environment during the
            upgrade.</description>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="rowsDeleted" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="rowsDeleted" from="darpan.reconciliation.automation.SourceSystemConnectorFieldWriteSupport.deleteRetiredFields(ec)"/>
            <message>Deleted ${rowsDeleted} retired field row(s).</message>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

</services>
