<?xml version="1.0" encoding="UTF-8"?>
<!--
  DAR-BE-361. Darpan staff (super admins) read the feedback tenant users sent about findings, across tenants, and answer one by
  email (the answer is never shown in the app). admin.* and therefore inside the DARPAN_ADMIN_API fence (the pattern admin\..*
  already covers this file), which carries no tenant filter, so these reads need no disableAuthz; each service checks super
  admin again first. The reply is an admin mutation and writes darpan.admin.AdminAuditLog in the same transaction.
-->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="get" noun="FeedbackList" allow-remote="true" authenticate="true" authz-action="view">
        <description>Feedback across tenants, unanswered first then newest: [feedbackId, tenant: [id, name], statement, cause, record,
            note, sentBy, sentAt, ageDays, answer, answeredAt]. unansweredOnly (default true) leaves out the answered ones.</description>
        <in-parameters>
            <parameter name="unansweredOnly" type="Boolean" default="true"/>
            <parameter name="limit" type="Integer" default="50"/>
        </in-parameters>
        <out-parameters><parameter name="feedback" type="List"/></out-parameters>
        <actions>
            <set field="feedback" from="[]"/>
            <if condition="!darpan.admin.AdminAccessSupport.requireSuperAdmin(ec)"><return/></if>
            <!-- Unanswered first, newest first within each: two reads of at most rowCap rows, never the whole table. -->
            <set field="rowCap" from="Math.max(1, (limit ?: 50) as int)"/>
            <entity-find entity-name="darpan.audit.AuditFindingFeedback" list="rows" limit="rowCap">
                <econdition field-name="answeredStamp" operator="is-null"/>
                <order-by field-name="-sentStamp"/>
                <order-by field-name="-feedbackId"/>
            </entity-find>
            <if condition="!unansweredOnly &amp;&amp; rows.size() &lt; rowCap">
                <entity-find entity-name="darpan.audit.AuditFindingFeedback" list="answeredRows" limit="rowCap - rows.size()">
                    <econdition field-name="answeredStamp" operator="is-not-null"/>
                    <order-by field-name="-sentStamp"/>
                    <order-by field-name="-feedbackId"/>
                </entity-find>
                <set field="rows" from="rows + answeredRows"/>
            </if>
            <!-- Each tenant, sender and statement is read once. -->
            <set field="nowMillis" from="ec.user.nowTimestamp.time"/>
            <set field="tenantNames" from="[:]"/>
            <set field="userNames" from="[:]"/>
            <set field="statementCodes" from="[:]"/>
            <iterate list="rows" entry="r">
                <if condition="!tenantNames.containsKey(r.companyUserGroupId)">
                    <entity-find-one entity-name="moqui.security.UserGroup" value-field="tenantGroup" cache="false">
                        <field-map field-name="userGroupId" from="r.companyUserGroupId"/></entity-find-one>
                    <set field="ignorePut" from="tenantNames.put(r.companyUserGroupId, tenantGroup?.description ?: r.companyUserGroupId)"/>
                </if>
                <if condition="!userNames.containsKey(r.sentByUserId)">
                    <entity-find-one entity-name="moqui.security.UserAccount" value-field="sender" cache="false">
                        <field-map field-name="userId" from="r.sentByUserId"/></entity-find-one>
                    <set field="ignorePut" from="userNames.put(r.sentByUserId, sender?.userFullName ?: sender?.username ?: r.sentByUserId)"/>
                </if>
                <if condition="!statementCodes.containsKey(r.statementId)">
                    <entity-find-one entity-name="darpan.audit.AuditStatement" value-field="statement" cache="false">
                        <field-map field-name="statementId" from="r.statementId"/></entity-find-one>
                    <set field="ignorePut" from="statementCodes.put(r.statementId, statement?.statementCode ?: r.statementId)"/>
                </if>
                <set field="ignoreAdd" from="feedback.add([feedbackId: r.feedbackId,
                        tenant: [id: r.companyUserGroupId, name: tenantNames.get(r.companyUserGroupId)],
                        statement: statementCodes.get(r.statementId), cause: r.conclusionCode, record: r.recordKey, note: r.note,
                        sentBy: userNames.get(r.sentByUserId), sentAt: r.sentStamp.toInstant().toString(),
                        ageDays: Math.max(0L, (nowMillis - r.sentStamp.time).intdiv(86400000L)),
                        answer: r.answer, answeredAt: r.answeredStamp?.toInstant()?.toString()])"/>
            </iterate>
        </actions>
    </service>

    <service verb="reply" noun="Feedback" allow-remote="true" authenticate="true">
        <description>Answers one piece of feedback by email to its sender (their note quoted, then the answer) and saves the answer. A
            second reply overwrites the answer and sends again. Refuses a blank answer and an unknown id; if the mail is not sent,
            nothing is saved.</description>
        <in-parameters>
            <parameter name="feedbackId" required="true"/>
            <parameter name="answer" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="feedbackId"/>
            <parameter name="answeredAt"/>
        </out-parameters>
        <actions>
            <if condition="!darpan.admin.AdminAccessSupport.requireSuperAdmin(ec)"><return/></if>
            <set field="text" from="answer?.trim()"/>
            <if condition="!text"><return error="true" message="An answer is needed."/></if>
            <entity-find-one entity-name="darpan.audit.AuditFindingFeedback" value-field="feedback">
                <field-map field-name="feedbackId"/></entity-find-one>
            <if condition="feedback == null"><return error="true" message="Feedback ${feedbackId} was not found."/></if>
            <set field="messageId" from="darpan.audit.FeedbackSupport.sendAnswer(ec, feedback, text)"/>
            <if condition="!messageId"><return error="true" message="The answer to ${feedbackId} was not emailed, so it was not saved."/></if>
            <set field="answeredStamp" from="ec.user.nowTimestamp"/>
            <service-call name="update#darpan.audit.AuditFindingFeedback" in-map="[feedbackId: feedbackId, answer: text,
                    answeredByUserId: ec.user.userId, answeredStamp: answeredStamp]"/>
            <service-call name="create#darpan.admin.AdminAuditLog" in-map="[adminUserId: ec.user.userId,
                    serviceName: 'admin.FeedbackAdminServices.reply#Feedback', targetType: 'AuditFindingFeedback',
                    targetId: feedbackId, detailText: 'Answered feedback ' + feedbackId + ' of ' + feedback.companyUserGroupId + ' by email.',
                    auditTimestamp: answeredStamp]"/>
            <set field="answeredAt" from="answeredStamp.toInstant().toString()"/>
        </actions>
    </service>
</services>
