<?xml version="1.0" encoding="UTF-8"?>
<!-- DAR-UI-044. The conclusion vocabulary's type, its one universal member, and every code core rule code concludes
     (DAR-BE-160: core owns the words). Tenant-specific conclusions live in each tenant's config pack. -->
<entity-facade-xml type="seed">
    <moqui.basic.EnumerationType enumTypeId="DarpanConclusion" description="Run result conclusion"/>
    <moqui.basic.Enumeration enumId="UNEXPLAINED" enumTypeId="DarpanConclusion" enumCode="UNEXPLAINED"
            description="Unexplained" sequenceNum="999"/>
    <!-- DAR-BE-151: concluded by brain/oms-netsuite.drl (Cause.expected), so every install needs its label. -->
    <moqui.basic.Enumeration enumId="CONC_PARTIAL_PAYMENT_GIVEN_BACK" enumTypeId="DarpanConclusion"
            enumCode="CONC_PARTIAL_PAYMENT_GIVEN_BACK" description="Partial payment given back"/>
    <!-- DAR-BE-186: concluded by brain/oms-netsuite.drl (Cause.fix) for an order NetSuite does not have. -->
    <moqui.basic.Enumeration enumId="CONC_RETIRED_SKU" enumTypeId="DarpanConclusion"
            enumCode="CONC_RETIRED_SKU" description="Sold on a retired SKU"/>
    <moqui.basic.Enumeration enumId="CONC_PRODUCT_NOT_IN_NETSUITE" enumTypeId="DarpanConclusion"
            enumCode="CONC_PRODUCT_NOT_IN_NETSUITE" description="Product not in NetSuite"/>
    <!-- Codes are short (12 characters at most): a statement link lists its codes in one 255-character column
         (AuditStatementCheck.conclusionCodes; gorjana R1's 16 codes overflowed it, 2026-11-04). -->
    <!-- DAR-BE-151 (Aditi 2026-11-06): an exchange HotWax holds until its original order ships, unfulfilled in NetSuite. -->
    <moqui.basic.Enumeration enumId="ORIG_OPEN" enumTypeId="DarpanConclusion"
            enumCode="ORIG_OPEN" description="Waits on its original order"/>
    <!-- DAR-BE-192: why HotWax holds a replacement (exchange or warranty) back from NetSuite: its return's credit-memo gate. -->
    <moqui.basic.Enumeration enumId="RET_OPEN" enumTypeId="DarpanConclusion"
            enumCode="RET_OPEN" description="Waits on its own return"/>
    <moqui.basic.Enumeration enumId="RMA_CLOSED" enumTypeId="DarpanConclusion"
            enumCode="RMA_CLOSED" description="Return's RMA closed, no credit memo"/>
    <moqui.basic.Enumeration enumId="RMA_NO_MEMO" enumTypeId="DarpanConclusion"
            enumCode="RMA_NO_MEMO" description="Return has an RMA, no credit memo"/>
    <moqui.basic.Enumeration enumId="RET_NO_RMA" enumTypeId="DarpanConclusion"
            enumCode="RET_NO_RMA" description="Return not in NetSuite"/>
    <moqui.basic.Enumeration enumId="LOST_NO_MEMO" enumTypeId="DarpanConclusion"
            enumCode="LOST_NO_MEMO" description="Lost-warranty claim, no credit memo"/>
    <moqui.basic.Enumeration enumId="REPL_UNPAID" enumTypeId="DarpanConclusion"
            enumCode="REPL_UNPAID" description="Replacement not paid for"/>
</entity-facade-xml>
