<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="create" noun="Tenant" allow-remote="true">
        <description>Create a Darpan tenant: UserGroup (UgtDarpanCompany) + TenantSetting in one transaction.</description>
        <in-parameters>
            <parameter name="tenantUserGroupId" required="true"><description>Uppercase tenant id, e.g. KREWE.</description></parameter>
            <parameter name="label" required="true"><description>Display label for tenant pickers.</description></parameter>
            <parameter name="timeZone"><description>Tenant display timezone; defaults to UTC.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"><description>True when the tenant was created.</description></parameter>
            <parameter name="tenantUserGroupId"><description>Id of the created tenant.</description></parameter>
        </out-parameters>
        <actions>
            <set field="result" from="darpan.admin.AdminTenantSupport.createTenant(ec, tenantUserGroupId, label, timeZone)"/>
            <set field="ok" from="result != null"/>
            <set field="tenantUserGroupId" from="result?.tenantUserGroupId"/>
        </actions>
    </service>

    <service verb="update" noun="Tenant" allow-remote="true">
        <description>Rename a tenant and/or change its timezone and go-live.</description>
        <in-parameters>
            <parameter name="tenantUserGroupId" required="true"><description>Tenant to update.</description></parameter>
            <parameter name="label"><description>New display label; unchanged when omitted.</description></parameter>
            <parameter name="timeZone"><description>New timezone; unchanged when omitted.</description></parameter>
            <parameter name="goLiveDate"><description>DAR-BE-145. When the tenant went live; no audit reads data from
                before it. YYYY-MM-DD HH:mm:ss in the tenant's timezone, or ISO with an offset. Unchanged when omitted.</description></parameter>
        </in-parameters>
        <out-parameters><parameter name="ok" type="Boolean"><description>True when updated.</description></parameter></out-parameters>
        <actions>
            <set field="ok" from="false"/>
            <if condition="!darpan.admin.AdminAccessSupport.requireSuperAdmin(ec)"><return/></if>
            <entity-find-one entity-name="moqui.security.UserGroup" value-field="tenantGroup">
                <field-map field-name="userGroupId" from="tenantUserGroupId"/></entity-find-one>
            <if condition="tenantGroup == null || tenantGroup.groupTypeEnumId != darpan.facade.common.TenantAccessSupport.DARPAN_COMPANY_GROUP_TYPE_ENUM_ID">
                <return error="true" message="Tenant ${tenantUserGroupId ?: '(missing)'} was not found."/></if>
            <!-- Validate BEFORE any write, the same way TenantAccessSupport.saveUserSettings does: a
                 rejected timezone must not leave a half-applied rename behind. An unvalidated zone is
                 also invisible downstream - the browser's Intl silently falls back to the viewer's own
                 zone, so timestamps keep rendering and merely stop agreeing with the schedule label. -->
            <if condition="timeZone?.trim()">
                <set field="timeZoneError" from="darpan.facade.common.TenantAccessSupport.validateTimeZone(timeZone)"/>
                <if condition="timeZoneError"><return error="true" message="${timeZoneError}"/></if>
            </if>
            <if condition="goLiveDate?.trim()">
                <entity-find-one entity-name="darpan.auth.TenantSetting" value-field="currentSetting">
                    <field-map field-name="companyUserGroupId" from="tenantUserGroupId"/></entity-find-one>
                <set field="goLiveStamp" from="darpan.admin.AdminTenantSupport.parseGoLive(goLiveDate, timeZone?.trim() ?: currentSetting?.timeZone)"/>
                <if condition="goLiveStamp == null"><return error="true"
                        message="Go-live ${goLiveDate.trim()} is not a date and time, e.g. 2026-10-20 21:05:23."/></if>
            </if>
            <!-- ok turns true once validation passes, as it always has: a write that then fails
                 surfaces through ec.message (and rolls the call back), not through ok. -->
            <set field="ok" from="true"/>
            <if condition="label?.trim()">
                <service-call name="update#moqui.security.UserGroup"
                        in-map="[userGroupId: tenantUserGroupId, description: label.trim()]"/>
            </if>
            <if condition="timeZone?.trim()">
                <service-call name="store#darpan.auth.TenantSetting" in-map="[companyUserGroupId: tenantUserGroupId,
                        timeZone: timeZone.trim(), lastUpdatedDate: ec.user.nowTimestamp]"/>
            </if>
            <if condition="goLiveStamp">
                <service-call name="store#darpan.auth.TenantSetting" in-map="[companyUserGroupId: tenantUserGroupId,
                        goLiveDate: goLiveStamp, lastUpdatedDate: ec.user.nowTimestamp]"/>
            </if>
            <service-call name="create#darpan.admin.AdminAuditLog" in-map="[adminUserId: ec.user.userId,
                    serviceName: 'admin.TenantAdminServices.update#Tenant', targetType: 'Tenant', targetId: tenantUserGroupId,
                    detailText: 'Updated tenant ' + tenantUserGroupId + '.', auditTimestamp: ec.user.nowTimestamp]"/>
        </actions>
    </service>

    <service verb="deactivate" noun="Tenant" allow-remote="true">
        <description>Hide the tenant from the tenant app (availableTenants + active-tenant selection). Flag, not delete.</description>
        <in-parameters><parameter name="tenantUserGroupId" required="true"><description>Tenant to deactivate.</description></parameter></in-parameters>
        <out-parameters><parameter name="ok" type="Boolean"><description>True when deactivated.</description></parameter></out-parameters>
        <actions>
            <set field="ok" from="false"/>
            <if condition="!darpan.admin.AdminAccessSupport.requireSuperAdmin(ec)"><return/></if>
            <entity-find-one entity-name="moqui.security.UserGroup" value-field="tenantGroup">
                <field-map field-name="userGroupId" from="tenantUserGroupId"/></entity-find-one>
            <if condition="tenantGroup == null || tenantGroup.groupTypeEnumId != darpan.facade.common.TenantAccessSupport.DARPAN_COMPANY_GROUP_TYPE_ENUM_ID">
                <return error="true" message="Tenant ${tenantUserGroupId ?: '(missing)'} was not found."/></if>
            <set field="ok" from="true"/>
            <service-call name="store#darpan.auth.TenantSetting" in-map="[companyUserGroupId: tenantUserGroupId,
                    disabled: 'Y', lastUpdatedDate: ec.user.nowTimestamp]"/>
            <service-call name="create#darpan.admin.AdminAuditLog" in-map="[adminUserId: ec.user.userId,
                    serviceName: 'admin.TenantAdminServices.deactivate#Tenant', targetType: 'Tenant', targetId: tenantUserGroupId,
                    detailText: 'Deactivated tenant ' + tenantUserGroupId + '.', auditTimestamp: ec.user.nowTimestamp]"/>
        </actions>
    </service>

    <service verb="reactivate" noun="Tenant" allow-remote="true">
        <description>Re-enable a deactivated tenant.</description>
        <in-parameters><parameter name="tenantUserGroupId" required="true"><description>Tenant to reactivate.</description></parameter></in-parameters>
        <out-parameters><parameter name="ok" type="Boolean"><description>True when reactivated.</description></parameter></out-parameters>
        <actions>
            <set field="ok" from="false"/>
            <if condition="!darpan.admin.AdminAccessSupport.requireSuperAdmin(ec)"><return/></if>
            <entity-find-one entity-name="moqui.security.UserGroup" value-field="tenantGroup">
                <field-map field-name="userGroupId" from="tenantUserGroupId"/></entity-find-one>
            <if condition="tenantGroup == null || tenantGroup.groupTypeEnumId != darpan.facade.common.TenantAccessSupport.DARPAN_COMPANY_GROUP_TYPE_ENUM_ID">
                <return error="true" message="Tenant ${tenantUserGroupId ?: '(missing)'} was not found."/></if>
            <set field="ok" from="true"/>
            <service-call name="store#darpan.auth.TenantSetting" in-map="[companyUserGroupId: tenantUserGroupId,
                    disabled: 'N', lastUpdatedDate: ec.user.nowTimestamp]"/>
            <service-call name="create#darpan.admin.AdminAuditLog" in-map="[adminUserId: ec.user.userId,
                    serviceName: 'admin.TenantAdminServices.reactivate#Tenant', targetType: 'Tenant', targetId: tenantUserGroupId,
                    detailText: 'Reactivated tenant ' + tenantUserGroupId + '.', auditTimestamp: ec.user.nowTimestamp]"/>
        </actions>
    </service>

    <service verb="get" noun="TenantList" allow-remote="true" authz-action="view">
        <description>All tenants (including deactivated) with member counts, for the admin Tenants board.</description>
        <out-parameters>
            <parameter name="tenantList" type="List"><description>All tenants sorted by label.</description>
                <parameter name="tenant" type="Map">
                    <parameter name="tenantUserGroupId"/><parameter name="label"/>
                    <parameter name="disabled" type="Boolean"/><parameter name="memberCount" type="Integer"/>
                </parameter>
            </parameter>
        </out-parameters>
        <actions>
            <set field="tenantList" from="[]"/>
            <if condition="!darpan.admin.AdminAccessSupport.requireSuperAdmin(ec)"><return/></if>
            <!-- Cross-tenant on purpose (admin.* authz carries no tenant entity filter): every
                 UgtDarpanCompany group, with its own TenantSetting flag and active-member count. -->
            <entity-find entity-name="moqui.security.UserGroup" list="tenantGroupList">
                <econdition field-name="groupTypeEnumId" from="darpan.facade.common.TenantAccessSupport.DARPAN_COMPANY_GROUP_TYPE_ENUM_ID"/>
            </entity-find>
            <iterate list="tenantGroupList" entry="tenantGroup">
                <entity-find-one entity-name="darpan.auth.TenantSetting" value-field="tenantSetting">
                    <field-map field-name="companyUserGroupId" from="tenantGroup.userGroupId"/></entity-find-one>
                <entity-find-count entity-name="moqui.security.UserGroupMember" count-field="activeMemberCount">
                    <econdition field-name="userGroupId" from="tenantGroup.userGroupId"/>
                    <econdition field-name="thruDate" from="null"/>
                </entity-find-count>
                <set field="ignoreAdd" from="tenantList.add([tenantUserGroupId: tenantGroup.userGroupId,
                        label: tenantGroup.description ?: tenantGroup.userGroupId,
                        disabled: tenantSetting?.disabled == 'Y', memberCount: activeMemberCount as Integer])"/>
            </iterate>
            <order-map-list list="tenantList"><order-by field-name="label"/></order-map-list>
        </actions>
    </service>

    <service verb="get" noun="TenantDetail" allow-remote="true" authz-action="view">
        <description>One tenant with settings and active members, for the admin tenant detail board.</description>
        <in-parameters><parameter name="tenantUserGroupId" required="true"><description>Tenant to read.</description></parameter></in-parameters>
        <out-parameters>
            <parameter name="tenantDetail" type="Map"><description>Tenant detail or null when not found.</description>
                <parameter name="tenantUserGroupId"/><parameter name="label"/><parameter name="timeZone"/>
                <parameter name="goLiveDate" type="Timestamp"/>
                <parameter name="disabled" type="Boolean"/><parameter name="createdDate" type="Timestamp"/>
                <parameter name="members" type="List"><parameter name="member" type="Map">
                    <parameter name="userId"/><parameter name="username"/>
                    <parameter name="permissionUserGroupId"/><parameter name="fromDate" type="Timestamp"/>
                </parameter></parameter>
            </parameter>
        </out-parameters>
        <actions>
            <if condition="!darpan.admin.AdminAccessSupport.requireSuperAdmin(ec)"><return/></if>
            <entity-find-one entity-name="moqui.security.UserGroup" value-field="tenantGroup">
                <field-map field-name="userGroupId" from="tenantUserGroupId"/></entity-find-one>
            <if condition="tenantGroup == null || tenantGroup.groupTypeEnumId != darpan.facade.common.TenantAccessSupport.DARPAN_COMPANY_GROUP_TYPE_ENUM_ID">
                <return error="true" message="Tenant ${tenantUserGroupId ?: '(missing)'} was not found."/></if>
            <entity-find-one entity-name="darpan.auth.TenantSetting" value-field="tenantSetting">
                <field-map field-name="companyUserGroupId" from="tenantUserGroupId"/></entity-find-one>
            <entity-find entity-name="darpan.auth.TenantUserPermissionGroupMember" list="permissionRowList">
                <econdition field-name="tenantUserGroupId"/></entity-find>
            <set field="memberList" from="[]"/>
            <iterate list="permissionRowList" entry="permissionRow">
                <!-- Ended rows are skipped here rather than in the query, so members keep the order the
                     tenant's rows come back in. -->
                <if condition="permissionRow.thruDate == null">
                    <entity-find-one entity-name="moqui.security.UserAccount" value-field="memberAccount">
                        <field-map field-name="userId" from="permissionRow.userId"/></entity-find-one>
                    <set field="ignoreAdd" from="memberList.add([userId: permissionRow.userId, username: memberAccount?.username,
                            permissionUserGroupId: permissionRow.permissionUserGroupId, fromDate: permissionRow.fromDate])"/>
                </if>
            </iterate>
            <set field="tenantDetail" from="[tenantUserGroupId: tenantUserGroupId,
                    label: tenantGroup.description ?: tenantUserGroupId, timeZone: tenantSetting?.timeZone, goLiveDate: tenantSetting?.goLiveDate,
                    disabled: tenantSetting?.disabled == 'Y', createdDate: tenantSetting?.createdDate, members: memberList]"/>
        </actions>
    </service>
</services>
