<?xml version="1.0" encoding="UTF-8"?>
<!-- DAR-BE-102 email body: the digest's text as it goes to chat, one block, escaped. Plain on purpose: no bold.
     DAR-BE-298: wears EmailFrame (the app's light theme, like the audit email); copy follows the darpan-email skill. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false">
    <actions>
        <set field="frameOpen" from="darpan.email.EmailFrame.open('DARPAN · AUDIT DIGEST')"/>
        <set field="frameClose" from="darpan.email.EmailFrame.close()"/>
        <set field="guidesHtml" from="darpan.email.EmailFrame.guides([['Read the audit page', 'guides/audits#read-the-audit-page'], ['How findings close', 'guides/audits#how-findings-close']])"/>
        <set field="guidesText" from="darpan.email.EmailFrame.guidesText([['Read the audit page', 'guides/audits#read-the-audit-page'], ['How findings close', 'guides/audits#how-findings-close']])"/>
    </actions>
    <widgets>
        <render-mode><text type="html" no-boundary-comment="true"><![CDATA[${frameOpen}]]></text></render-mode>
        <label text="${digestText}" type="pre" style="dp-pre"/>
        <render-mode>
            <text type="html" no-boundary-comment="true"><![CDATA[${guidesHtml}${frameClose}]]></text>
            <text type="text" no-boundary-comment="true"><![CDATA[${guidesText}]]></text>
        </render-mode>
    </widgets>
</screen>
