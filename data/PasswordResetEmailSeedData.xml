<entity-facade-xml type="darpan-seed">
    <!-- DAR-BE-028 — Darpan's own password-reset mail. The framework's PASSWORD_RESET / SINGLE_USE_CODE rows are
         not reused: their fromAddress is empty, which sendEmailTemplate.groovy treats as a hard error.
         fromAddress is expanded at send time (ec.resource.expand), so one row serves every environment and
         each sets DARPAN_MAIL_FROM; unset, the send fails loudly instead of going out from somewhere unexpected.
         SMTP settings are deploy-time configuration. EmailTemplate has a real FK to EmailServer, so this file
         seeds the SYSTEM row by id ALONE, first: the templates can load anywhere, and with no smtpHost
         sendEmailTemplate logs "SMTP Host is empty" and sends nothing. The data loader writes only the
         attributes given, so re-loading this file never blanks an environment's configured SMTP fields. -->
    <moqui.basic.email.EmailServer emailServerId="SYSTEM"/>
    <moqui.basic.email.EmailTemplate emailTemplateId="DARPAN_PASSWORD_RESET_CODE" description="Darpan password reset code"
            emailServerId="SYSTEM" webappName="webroot" sendPartial="Y" subject="Your Darpan reset code"
            fromAddress="${System.getenv('DARPAN_MAIL_FROM') ?: ''}" fromName="Darpan"
            bodyScreenLocation="component://darpan/screen/email/PasswordResetCode.xml"/>
    <moqui.basic.email.EmailTemplate emailTemplateId="DARPAN_PASSWORD_CHANGED" description="Darpan password changed notice"
            emailServerId="SYSTEM" webappName="webroot" sendPartial="Y" subject="Your Darpan password was changed"
            fromAddress="${System.getenv('DARPAN_MAIL_FROM') ?: ''}" fromName="Darpan"
            bodyScreenLocation="component://darpan/screen/email/PasswordChanged.xml"/>
    <moqui.basic.email.EmailTemplate emailTemplateId="DARPAN_RECOVERY_EMAIL_SET" description="Darpan recovery email set notice"
            emailServerId="SYSTEM" webappName="webroot" sendPartial="Y" subject="Darpan recovery email set"
            fromAddress="${System.getenv('DARPAN_MAIL_FROM') ?: ''}" fromName="Darpan"
            bodyScreenLocation="component://darpan/screen/email/RecoveryEmailSet.xml"/>
    <moqui.basic.email.EmailTemplate emailTemplateId="DARPAN_RECOVERY_EMAIL_CONFLICT" description="Darpan recovery email not saved"
            emailServerId="SYSTEM" webappName="webroot" sendPartial="Y" subject="Darpan recovery email not saved"
            fromAddress="${System.getenv('DARPAN_MAIL_FROM') ?: ''}" fromName="Darpan"
            bodyScreenLocation="component://darpan/screen/email/RecoveryEmailConflict.xml"/>
</entity-facade-xml>
