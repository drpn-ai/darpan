    <service verb="change" noun="OwnPassword" allow-remote="true" authenticate="true">
        <description>Change the authenticated user's own password using Moqui's standard password policy checks.</description>
        <in-parameters>
            <parameter name="currentPassword" required="true">
                <description>The authenticated user's current password.</description>
            </parameter>
            <parameter name="newPassword" required="true">
                <description>The new password requested by the authenticated user.</description>
            </parameter>
            <parameter name="newPasswordVerify" required="true">
                <description>Confirmation value for the new password.</description>
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean">
                <description>True when the password update completed without facade errors.</description>
            </parameter>
            <parameter name="messages" type="List">
                <description>Informational messages emitted during password update handling.</description>
                <parameter name="message"/>
            </parameter>
            <parameter name="errors" type="List">
                <description>Errors returned while validating or changing the password.</description>
                <parameter name="error"/>
            </parameter>
            <parameter name="authenticated" type="Boolean">
                <description>True when the current request resolves to an authenticated session.</description>
            </parameter>
            <parameter name="passwordUpdated" type="Boolean">
                <description>True when Moqui successfully changed the authenticated user's password.</description>
            </parameter>
            <parameter name="sessionInfo" type="Map">
                <description>Refreshed authenticated session metadata returned to darpan-ui.</description>
                <parameter name="userId" type="String"/>
                <parameter name="username" type="String"/>
                <parameter name="displayName" type="String"/>
                <parameter name="locale" type="String"/>
                <parameter name="timeZone" type="String"/>
                <parameter name="userTimeZone" type="String"/>
                <parameter name="tenantTimeZone" type="String"/>
                <parameter name="lastLoginDate" type="Timestamp"/>
                <parameter name="lastRun" type="Map">
                    <parameter name="reconciliationRunResultId" type="String"/>
                    <parameter name="savedRunId" type="String"/>
                    <parameter name="savedRunType" type="String"/>
                    <parameter name="reconciliationRunId" type="String"/>
                    <parameter name="createdDate" type="Timestamp"/>
                </parameter>
                <parameter name="scopeType" type="String"/>
                <parameter name="customerScopeId" type="String"/>
                <parameter name="activeTenantUserGroupId" type="String"/>
                <parameter name="activeTenantLabel" type="String"/>
                <parameter name="availableTenants" type="List">
                    <parameter name="userGroupId" type="String"/>
                    <parameter name="label" type="String"/>
                </parameter>
                <parameter name="activeTenantPermissionGroupIds" type="List"><parameter name="permissionGroupId"/></parameter>
                <parameter name="canViewActiveTenantData" type="Boolean"/>
                <parameter name="canRunActiveTenantReconciliation" type="Boolean"/>
                <parameter name="canEditActiveTenantData" type="Boolean"/>
                <parameter name="canManageDarpanCore" type="Boolean"/>
                <parameter name="isSuperAdmin" type="Boolean"/>
            </parameter>
        </out-parameters>
        <actions>
            <set field="authenticated" from="((ec.user.userId)?.toString()?.trim()) != null"/>
            <set field="passwordUpdated" from="false"/>
            <if condition="authenticated">
                <service-call name="org.moqui.impl.UserServices.update#Password" out-map="passwordUpdateOut">
                    <field-map field-name="userId" from="ec.user.userId"/>
                    <field-map field-name="oldPassword" from="currentPassword"/>
                    <field-map field-name="newPassword"/>
                    <field-map field-name="newPasswordVerify"/>
                </service-call>
                <set field="passwordUpdated" from="passwordUpdateOut.updateSuccessful == true &amp;&amp; !ec.message.hasError()"/>
                <!-- Audit M1.3 — on successful password change, revoke every UserLoginKey for the user
                     so any other active session (suspected-compromised device, lingering tokens) is
                     immediately invalidated. The current session re-establishes a fresh login key
                     via Moqui's login-key plumbing on the next call. -->
                <if condition="passwordUpdated == true">
                    <set field="ignoreRevokeCount" from="darpan.facade.auth.AuthFacadeSupport.deleteAllLoginKeysForUser(ec, ec.user.userId)"/>
                </if>
                <set field="sessionInfo" from="darpan.facade.common.TenantAccessSupport.buildSessionInfo(ec)"/>
            </if>
            <if condition="!authenticated">
                <message error="true">Authentication required to change password.</message>
            </if>
            <set field="ok" from="passwordUpdated == true &amp;&amp; !ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <!-- The self-service escape hatch for an account that login refuses until its password changes. Every
         account the admin app creates or resets is flagged requirePasswordChange="Y", and login#Session
         rejects those before a session exists, so change#OwnPassword above — which needs a session — is
         unreachable for exactly the users who most need it. Anonymous by necessity; see the support method
         for the oracle, lockout, and brute-force guards that necessity forces. -->
    <service verb="change" noun="ExpiredPassword" allow-remote="true" authenticate="anonymous-all">
        <description>Change the password of an account that cannot sign in until it is changed, without a session.
            Requires the account's current password, so it grants nothing to a caller who does not already hold
            valid credentials. Issues no token: darpan-ui calls login#Session afterwards with the new password.</description>
        <in-parameters>
            <parameter name="username" required="true">
                <description>Account whose password is being changed. Matched exactly first, then case-insensitively,
                    the same way login resolves an account.</description>
            </parameter>
            <parameter name="currentPassword" required="true">
                <description>The account's existing password, including the temporary one an admin issued.</description>
            </parameter>
            <parameter name="newPassword" required="true">
                <description>The replacement password, subject to the standard Moqui password policy.</description>
            </parameter>
            <parameter name="newPasswordVerify" required="true">
                <description>Confirmation value for the new password.</description>
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean">
                <description>True when the password update completed without facade errors.</description>
            </parameter>
            <parameter name="messages" type="List">
                <description>Informational messages emitted during password update handling.</description>
                <parameter name="message"/>
            </parameter>
            <parameter name="errors" type="List">
                <description>Errors returned while validating or changing the password. Identity and credential
                    failures are collapsed into one indistinguishable message; password-policy failures are
                    reported in full so the user can correct them.</description>
                <parameter name="error"/>
            </parameter>
            <parameter name="passwordUpdated" type="Boolean">
                <description>True when the password was changed and the account can now sign in.</description>
            </parameter>
        </out-parameters>
        <actions>
            <set field="changeResult" from="darpan.facade.auth.AuthFacadeSupport.changeExpiredPassword(ec, username, currentPassword, newPassword, newPasswordVerify)"/>
            <set field="ok" from="changeResult.ok"/>
            <set field="messages" from="changeResult.messages"/>
            <set field="errors" from="changeResult.errors"/>
            <set field="passwordUpdated" from="changeResult.passwordUpdated"/>
        </actions>
    </service>

    <service verb="logout" noun="Session" allow-remote="true" authenticate="anonymous-all">
        <description>Revoke the login-key token from the current request (header or cookie) and end the caller's own session only.
            Other active sessions on the same UserAccount — including other people on a shared login — are not affected;
            use logout#AllSessions to revoke every session.</description>
        <out-parameters>
            <parameter name="ok" type="Boolean">
                <description>True when logout cleanup completed without facade errors.</description>
            </parameter>
            <parameter name="messages" type="List">
                <description>Informational messages emitted during logout handling.</description>
                <parameter name="message"/>
            </parameter>
            <parameter name="errors" type="List">
                <description>Errors returned while clearing session state.</description>
                <parameter name="error"/>
            </parameter>
            <parameter name="authenticated" type="Boolean">
                <description>Always false after logout cleanup finishes.</description>
            </parameter>
            <parameter name="authTokenRevoked" type="Boolean">
                <description>True when logout removed the matching `UserLoginKey` record for the supplied auth token.</description>
            </parameter>
        </out-parameters>
        <actions>
            <set field="authResult" from="darpan.facade.auth.AuthFacadeSupport.logoutSession(ec)"/>
            <set field="ok" from="authResult.ok"/>
            <set field="messages" from="authResult.messages"/>
            <set field="errors" from="authResult.errors"/>
            <set field="authenticated" from="authResult.authenticated"/>
            <set field="authTokenRevoked" from="authResult.authTokenRevoked"/>
        </actions>
    </service>

    <!-- Audit M1.2 — Sign-out-everywhere. The original logout#Session only revoked the submitted
         login key; other active sessions on other devices kept working for the full 6-day expiry
         window. This service deletes every UserLoginKey row for the current authenticated user. -->
    <service verb="logout" noun="AllSessions" allow-remote="true" authenticate="true">
        <description>Revoke every active UserLoginKey for the authenticated user (sign out on every device).</description>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="authenticated" type="Boolean"/>
            <parameter name="authTokenRevoked" type="Boolean"/>
            <parameter name="allSessionsRevoked" type="Integer">
                <description>Count of UserLoginKey rows removed for the user.</description>
            </parameter>
        </out-parameters>
        <actions>
            <set field="authResult" from="darpan.facade.auth.AuthFacadeSupport.logoutAllSessions(ec)"/>
            <set field="ok" from="authResult.ok"/>
            <set field="messages" from="authResult.messages"/>
            <set field="errors" from="authResult.errors"/>
            <set field="authenticated" from="authResult.authenticated"/>
            <set field="authTokenRevoked" from="authResult.authTokenRevoked"/>
            <set field="allSessionsRevoked" from="authResult.allSessionsRevoked"/>
        </actions>
    </service>
</services>
