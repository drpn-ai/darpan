<?xml version="1.0" encoding="UTF-8"?>
<!-- DAR-BE-028 recovery email set: the old address and the new one each get their side.
     DAR-BE-298: wears EmailFrame (the app's light theme, like the audit email) and the VOICE_GUIDE.md voice (Aditi
     2026-11-18: "there still is no personality here" / "keep it short still... but making the user smile"); the darpan-email skill holds the rules. No bold. The only
     links are the user guide's (EmailFrame.guides: docs.drpn.ai pages, address shown; never a sign-in or action page). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false">
    <actions>
        <set field="frameOpen" from="darpan.email.EmailFrame.open('DARPAN · ACCOUNT')"/>
        <set field="frameClose" from="darpan.email.EmailFrame.close()"/>
        <set field="smile" from="isOldAddress ? darpan.email.EmailSmile.line(ec, &quot;DARPAN_RECOVERY_EMAIL_SET_OLD&quot;, darpan.email.EmailCopy.text(ec, &quot;DARPAN_RECOVERY_EMAIL_SET&quot;, &quot;smile.old&quot;, [:])) : darpan.email.EmailSmile.line(ec, &quot;DARPAN_RECOVERY_EMAIL_SET_NEW&quot;, darpan.email.EmailCopy.text(ec, &quot;DARPAN_RECOVERY_EMAIL_SET&quot;, &quot;smile.new&quot;, [:]))"/>
        <set field="copyGreeting" from="darpan.email.EmailCopy.text(ec, &quot;DARPAN_RECOVERY_EMAIL_SET&quot;, &quot;greeting&quot;, [firstName: firstName])"/>
        <set field="copyBodyOld" from="darpan.email.EmailCopy.text(ec, &quot;DARPAN_RECOVERY_EMAIL_SET&quot;, &quot;body.old&quot;, [smile: smile])"/>
        <set field="copyBodyNew" from="darpan.email.EmailCopy.text(ec, &quot;DARPAN_RECOVERY_EMAIL_SET&quot;, &quot;body.new&quot;, [smile: smile])"/>
        <set field="copyNote" from="darpan.email.EmailCopy.text(ec, &quot;DARPAN_RECOVERY_EMAIL_SET&quot;, &quot;note&quot;, [:])"/>
        <set field="guideLinks" from="darpan.email.EmailCopy.guides(ec, &quot;DARPAN_RECOVERY_EMAIL_SET&quot;)"/>
        <set field="guidesHtml" from="darpan.email.EmailFrame.guides(guideLinks)"/>
        <set field="guidesText" from="darpan.email.EmailFrame.guidesText(guideLinks)"/>
    </actions>
    <widgets>
        <render-mode><text type="html" no-boundary-comment="true"><![CDATA[${frameOpen}]]></text></render-mode>
        <container style="dp-p"><label text="${copyGreeting}"/></container>
        <section name="RecoveryAddressSide" condition="isOldAddress">
            <widgets><container style="dp-p"><label text="${copyBodyOld}"/></container></widgets>
            <fail-widgets><container style="dp-p"><label text="${copyBodyNew}"/></container></fail-widgets>
        </section>
        <container style="dp-note"><label text="${copyNote}"/></container>
        <container style="dp-sign"><label text="— Darpan"/></container>
        <render-mode>
            <text type="html" no-boundary-comment="true"><![CDATA[${guidesHtml}${frameClose}]]></text>
            <text type="text" no-boundary-comment="true"><![CDATA[${guidesText}]]></text>
        </render-mode>
    </widgets>
</screen>
