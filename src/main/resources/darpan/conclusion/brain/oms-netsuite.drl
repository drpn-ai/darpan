// DAR-BE-151: the oms-netsuite brain pack. Checked in and reviewed like code; tenants never write it.
// Layers: facts (Groovy, darpan.conclusion.brain.fact) -> each fact read once -> pieces -> causes about ONE subject
// -> one best-cause rule -> statements that only say whose cause a finding takes. Web: claude.ai/artifact/P5r3oxsGXV99mjGaBn5X2V
package darpan.conclusion.brain.omsnetsuite

import darpan.conclusion.brain.fact.Finding
import darpan.conclusion.brain.fact.Item
import darpan.conclusion.brain.fact.Order
import darpan.conclusion.brain.fact.Product
import darpan.conclusion.brain.fact.Payment
import darpan.conclusion.brain.fact.Return
import darpan.conclusion.brain.fact.Ask
import darpan.conclusion.brain.fact.Answered
import darpan.conclusion.brain.fact.Cause
import darpan.conclusion.brain.fact.BestCause
import darpan.conclusion.brain.fact.Conclusion
import java.math.BigDecimal
import java.util.List

// @label / @value: how a fact reads in a finding's "how Darpan concluded" ({path} is a field path on the fact).
declare OrderNotInNetsuite
    @label("The order is not in NetSuite") @value("{order.orderId}")
    order : Order @key
end

declare TenderGivenBack
    @label("A tender was given back in full") @value("{tender} {amount}")
    order : Order @key
    tender : String @key
    amount : BigDecimal
end

declare PaymentsGivenBack
    @label("Every tender taken was given back") @value("{taken}")
    order : Order @key
    taken : BigDecimal
end

declare PartialPaymentGivenBack
    @label("Part of the order was paid and given back") @value("{taken} of {order.total}")
    order : Order @key
    taken : BigDecimal
end

declare ProductNotInNetsuite
    @label("The item's product has no NetSuite id in HotWax") @value("{product.sku}")
    product : Product @key
end

declare SoldOnRetiredSku
    @label("Sold on a retired -OLD SKU; its live SKU") @value("{product.sku} -> {liveSku}")
    product : Product @key
    liveSku : String
end

// ---- each fact read once

rule "R1 sees the order not in NetSuite: no sales order line"
    @reads("Finding") @produces("OrderNotInNetsuite")
when
    Finding( kind == "orderLine", bucket == "MISSING_FROM_FILE_2", netsuiteHasOrderLine == false, $o : order, order != null )
then
    insertLogical( new OrderNotInNetsuite( $o ) );
end

rule "R2 sees the order not in NetSuite: no NETSUITE_ORDER_ID"
    @reads("Finding, Return, Order") @produces("OrderNotInNetsuite")
when
    Finding( kind == "return", bucket == "MISSING_FROM_FILE_2", $r : ret, ret != null )
    Return( this == $r, $o : order )
    Order( this == $o, netsuiteOrderId == null )
then
    insertLogical( new OrderNotInNetsuite( $o ) );
end

// Per amount, not per row: two gift cards swiped (100 + 81) are given back only by 181 back to that tender. A row of the
// tender with no amount proves nothing.
rule "A tender taken was given back in full"
    @reads("Order, Payment") @produces("TenderGivenBack")
when
    $o : Order( paymentsComplete == true )
    Payment( order == $o, state == "SETTLED", $t : tender )
    not Payment( order == $o, tender == $t, amount == null )
    $taken : List() from collect( Payment( order == $o, tender == $t, state == "SETTLED" ) )
    $back : List() from collect( Payment( order == $o, tender == $t, state == "REFUNDED" ) )
then
    BigDecimal taken = Payment.sum( $taken );
    if (taken.compareTo( Payment.sum( $back ) ) == 0) { insertLogical( new TenderGivenBack( $o, $t, taken ) ); }
end

// ---- questions: asked only when an answer can still change a cause; the ask planner batches them across findings

rule "Ask for the payments of an order that never reached NetSuite"
    @reads("OrderNotInNetsuite, Answered") @asks("orderPayments") @mayEnable("CONC_PARTIAL_PAYMENT_GIVEN_BACK")
when
    OrderNotInNetsuite( $o : order )
    not Answered( question == "orderPayments", subject == $o )
then
    insertLogical( new Ask( "orderPayments", $o ) );
end

// DAR-BE-186: only for the items of an order NetSuite does not have; one read per 100 products, dropped when the order's
// best cause already outranks what the answer could unlock.
rule "Ask whether an item's product is known to NetSuite, when its order never reached NetSuite"
    @reads("OrderNotInNetsuite, Item, Answered") @asks("productNetsuiteId") @mayEnable("CONC_RETIRED_SKU,CONC_PRODUCT_NOT_IN_NETSUITE")
when
    OrderNotInNetsuite( $o : order )
    Item( order == $o, $p : product )
    not Answered( question == "productNetsuiteId", subject == $p )
then
    insertLogical( new Ask( "productNetsuiteId", $p, $o ) );
end

// ---- pieces

rule "An item's product has no NetSuite id in HotWax"
    @reads("Product, Answered") @produces("ProductNotInNetsuite")
when
    $p : Product( netsuiteProductId == null )
    Answered( question == "productNetsuiteId", subject == $p )
then
    insertLogical( new ProductNotInNetsuite( $p ) );
end

// gorjana 2026-11-03: HotWax kept the old Shopify variant (238-007-G-OLD) beside the re-created product (238-007-G, same
// UPC), and only the live one carries the NetSuite id. Its live SKU is the same SKU without -OLD.
rule "A product with no NetSuite id is a retired -OLD SKU"
    @reads("ProductNotInNetsuite, Product") @produces("SoldOnRetiredSku")
when
    ProductNotInNetsuite( $p : product )
    Product( this == $p, sku != null, sku matches "(?i).+-OLD" )
then
    insertLogical( new SoldOnRetiredSku( $p, $p.getSku().replaceAll( "(?i)-OLD$", "" ) ) );
end

rule "Every tender taken was given back, and nothing else was"
    @reads("Order, Payment, TenderGivenBack") @produces("PaymentsGivenBack")
when
    $o : Order( paymentsComplete == true )
    exists Payment( order == $o, state == "SETTLED" )
    forall( $p : Payment( order == $o, state == "SETTLED" || state == "REFUNDED" )
            TenderGivenBack( order == $o, tender == $p.tender ) )
    not Payment( order == $o, state != "SETTLED", state != "REFUNDED", state != "CANCELLED" )
    not Payment( order == $o, state == "SETTLED", amount == null )
    $amounts : List() from collect( Payment( order == $o, state == "SETTLED" ) )
then
    insertLogical( new PaymentsGivenBack( $o, Payment.sum( $amounts ) ) );
end

rule "Less than the order total was taken"
    @reads("PaymentsGivenBack, Order") @produces("PartialPaymentGivenBack")
when
    PaymentsGivenBack( $o : order, $taken : taken )
    Order( this == $o, total != null, total > $taken )
then
    insertLogical( new PartialPaymentGivenBack( $o, $taken ) );
end

// ---- causes: each about one subject, written once

rule "Order cause · partial payment given back"
    @reads("OrderNotInNetsuite, PartialPaymentGivenBack") @concludes("CONC_PARTIAL_PAYMENT_GIVEN_BACK") @rank(80)
when
    $n : OrderNotInNetsuite( $o : order )
    $p : PartialPaymentGivenBack( order == $o )
then
    insertLogical( Cause.expected( $o, "CONC_PARTIAL_PAYMENT_GIVEN_BACK", 80, $n, $p ) );
end

rule "Order cause · sold on a retired SKU"
    @reads("OrderNotInNetsuite, Item, SoldOnRetiredSku") @concludes("CONC_RETIRED_SKU") @rank(66)
when
    $n : OrderNotInNetsuite( $o : order )
    Item( order == $o, $p : product )
    $r : SoldOnRetiredSku( product == $p )
then
    insertLogical( Cause.fix( $o, "CONC_RETIRED_SKU", 66, $n, $r ) );
end

rule "Order cause · product not in NetSuite"
    @reads("OrderNotInNetsuite, Item, ProductNotInNetsuite") @concludes("CONC_PRODUCT_NOT_IN_NETSUITE") @rank(65)
when
    $n : OrderNotInNetsuite( $o : order )
    Item( order == $o, $p : product )
    $q : ProductNotInNetsuite( product == $p )
then
    insertLogical( Cause.fix( $o, "CONC_PRODUCT_NOT_IN_NETSUITE", 65, $n, $q ) );
end

// ---- one rule picks every subject's best cause

rule "The best cause about a subject"
    @reads("Cause") @produces("BestCause")
when
    $c : Cause( $s : subject, $r : rank )
    not Cause( subject == $s, rank > $r )
then
    insertLogical( new BestCause( $s, $c ) );
end

// ---- statements: whose cause a finding takes (line and return causes join here as they are ported)

rule "R1 · the order's cause, when NetSuite has no line for it"
    @reads("Finding, OrderNotInNetsuite, BestCause") @states("R1")
when
    $f : Finding( kind == "orderLine", bucket == "MISSING_FROM_FILE_2", $o : order, order != null )
    OrderNotInNetsuite( order == $o )
    BestCause( subject == $o, $c : cause )
then
    insert( Conclusion.of( $f, $c ) );
end

rule "R2 · its order's cause"
    @reads("Finding, Return, BestCause") @states("R2")
when
    $f : Finding( kind == "return", bucket == "MISSING_FROM_FILE_2", $r : ret, ret != null )
    Return( this == $r, $o : order )
    BestCause( subject == $o, $c : cause )
then
    insert( Conclusion.of( $f, $c ) );
end
