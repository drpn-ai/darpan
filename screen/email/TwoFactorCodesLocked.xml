<?xml version="1.0" encoding="UTF-8"?>
<!-- DAR-BE-264 codes locked. A real alarm (VOICE_GUIDE grave register): the personality is directness and being on their side, the only lightness is the reassurance.
     DAR-BE-298: wears EmailFrame (the app's light theme, like the audit email) and the VOICE_GUIDE.md voice (Aditi
     2026-11-18: "there still is no personality here" / "keep it short still... but making the user smile"); the darpan-email skill holds the rules. No bold. The only
     links are the user guide's (EmailFrame.guides: docs.drpn.ai pages, address shown; never a sign-in or action page). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false">
    <actions>
        <set field="frameOpen" from="darpan.email.EmailFrame.open('DARPAN · SECURITY')"/>
        <set field="frameClose" from="darpan.email.EmailFrame.close()"/>
        <set field="guidesHtml" from="darpan.email.EmailFrame.guides([['Forgot password', 'troubleshooting/login-and-session#forgot-password'], ['Two-factor sign-in', 'guides/two-factor']])"/>
        <set field="guidesText" from="darpan.email.EmailFrame.guidesText([['Forgot password', 'troubleshooting/login-and-session#forgot-password'], ['Two-factor sign-in', 'guides/two-factor']])"/>
    </actions>
    <widgets>
        <render-mode><text type="html" no-boundary-comment="true"><![CDATA[${frameOpen}]]></text></render-mode>
        <container style="dp-p"><label text="Hi ${firstName},"/></container>
        <container style="dp-p"><label text="Someone has your Darpan password. They kept trying it without your code until ${at}."/></container>
        <container style="dp-p"><label text="Your code held. They didn't get in. Codes are locked on your account until the password changes."/></container>
        <container style="dp-note"><label text="Reset your password now, and tell your Darpan administrator."/></container>
        <container style="dp-sign"><label text="— Darpan"/></container>
        <render-mode>
            <text type="html" no-boundary-comment="true"><![CDATA[${guidesHtml}${frameClose}]]></text>
            <text type="text" no-boundary-comment="true"><![CDATA[${guidesText}]]></text>
        </render-mode>
    </widgets>
</screen>
