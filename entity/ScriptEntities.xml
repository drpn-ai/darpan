<?xml version="1.0" encoding="UTF-8"?>
<!--
  DAR-BE-164. Tenant scripts: JEXL a tenant writes and runs in Darpan as data, with no code commit. Tenant-scoped like
  every tenant entity (DARPAN_SCOPE_TENANT_SCRIPT). Evaluated only by darpan.script.ScriptSupervisor.
-->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="TenantScript" package="darpan.script" cache="never">
        <description>One script a tenant wrote: its JEXL body, the profile it runs under and what it reads.</description>
        <field name="tenantScriptId" type="id" is-pk="true"/>
        <field name="companyUserGroupId" type="id" not-null="true"><description>The tenant.</description></field>
        <field name="scriptName" type="text-medium" not-null="true"><description>Unique within the tenant.</description></field>
        <field name="description" type="text-medium"/>
        <field name="scriptProfile" type="text-short" not-null="true">
            <description>EXPRESSION (one expression, no loops) or SCRIPT (statements, loops, lambdas).</description></field>
        <field name="inputSource" type="text-short" not-null="true">
            <description>What input holds: SAMPLE (sampleInputJson) or RUN_RESULT (a finished run's differences).</description></field>
        <field name="scriptBody" type="text-long" not-null="true"><description>The JEXL source.</description></field>
        <field name="sampleInputJson" type="text-long"><description>The input a SAMPLE script runs against.</description></field>
        <field name="isActive" type="text-indicator"/>
        <field name="createdByUserId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <field name="lastUpdatedByUserId" type="id"/>
        <field name="lastUpdatedDate" type="date-time"/>

        <relationship type="one" title="Tenant" related="moqui.security.UserGroup" short-alias="tenant">
            <key-map field-name="companyUserGroupId" related-field-name="userGroupId"/>
        </relationship>

        <index name="TENANT_SCRIPT_NAME" unique="true">
            <index-field name="companyUserGroupId"/>
            <index-field name="scriptName"/>
        </index>
    </entity>

    <!-- DAR-BE-167. A script put to work: run on a schedule, its text posted to a chat space. -->
    <entity entity-name="TenantScriptDeployment" package="darpan.script" cache="never">
        <description>One deployment of a tenant script: when it runs (cron in the tenant's zone), what it reads (the
            newest result of a saved run, or the script's own sample), and where its text goes (a chat space). The
            script never sends anything itself: it returns text and Darpan delivers it.</description>
        <field name="tenantScriptDeploymentId" type="id" is-pk="true"/>
        <field name="companyUserGroupId" type="id" not-null="true"><description>The tenant.</description></field>
        <field name="tenantScriptId" type="id" not-null="true"/>
        <field name="scheduleExpr" type="text-short" not-null="true">
            <description>Quartz cron, e.g. 0 0 9 * * ? (09:00 daily), read in the tenant's time zone.</description></field>
        <field name="inputSavedRunId" type="id">
            <description>RUN_RESULT scripts: the saved run whose newest finished result the script reads.</description></field>
        <field name="chatSpaceId" type="id" not-null="true"><description>Where the script's text is posted.</description></field>
        <field name="isActive" type="text-indicator"/>
        <field name="nextRunDate" type="date-time"/>
        <field name="lastRunDate" type="date-time"/>
        <field name="lastRunStatus" type="text-short">
            <description>SENT, NOTHING_TO_SEND, SCRIPT_ERROR, NO_INPUT, NOT_DELIVERED, SCRIPT_MISSING.</description></field>
        <field name="lastRunMessage" type="text-medium"/>
        <field name="lastRunUnits" type="number-integer"/>
        <field name="createdByUserId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <field name="lastUpdatedByUserId" type="id"/>
        <field name="lastUpdatedDate" type="date-time"/>

        <relationship type="one" title="Tenant" related="moqui.security.UserGroup" short-alias="tenant">
            <key-map field-name="companyUserGroupId" related-field-name="userGroupId"/>
        </relationship>
        <relationship type="one" related="darpan.script.TenantScript" short-alias="script">
            <key-map field-name="tenantScriptId"/>
        </relationship>

        <index name="TSCRIPT_DEPLOY_DUE">
            <index-field name="isActive"/>
            <index-field name="nextRunDate"/>
        </index>
    </entity>
</entities>
