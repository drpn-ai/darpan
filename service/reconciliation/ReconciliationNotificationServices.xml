<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="build" noun="RunCompletedPayload" authenticate="false">
        <description>Build the Google Chat text payload for a completed reconciliation run.</description>
        <in-parameters>
            <parameter name="companyUserGroupId"/>
            <parameter name="companyLabel"/>
            <parameter name="runName"/>
            <parameter name="savedRunId"/>
            <parameter name="reconciliationRunId"/>
            <parameter name="reconciliationRunResultId"/>
            <parameter name="reconciliationMappingId"/>
            <parameter name="ruleSetId"/>
            <parameter name="resultDataManagerPath"/>
            <parameter name="file1SystemLabel"/>
            <parameter name="file1Label"/>
            <parameter name="file1SystemEnumId"/>
            <parameter name="file2SystemLabel"/>
            <parameter name="file2Label"/>
            <parameter name="file2SystemEnumId"/>
            <parameter name="differenceCount"/>
            <parameter name="onlyInFile1Count"/>
            <parameter name="onlyInFile2Count"/>
            <!-- differenceCount is onlyInFile1Count + onlyInFile2Count and nothing more
                 (ReconciliationServices.groovy:111 — both sides are left_anti presence checks).
                 Records present on BOTH sides with differing values are counted only here. Without
                 this parameter a run with zero missing records and N value mismatches reported
                 "Differences: 0" and read as a clean sync. -->
            <parameter name="ruleDifferenceCount"/>
            <!-- Audit 2026-06-11 #5: surface rule failures / processing warnings so a silently broken
                 ruleset does not produce a normal "completed" alert. -->
            <parameter name="statusEnumId"/>
            <parameter name="processingWarnings" type="List"/>
            <parameter name="terminationReason"/>
            <!-- UAT 2026-07-31: a run that died before producing any result has no counts to report.
                 The standard body ("run completed" + "Differences: 0") reads as a clean sync for those,
                 which is worse than silence — this switches to a did-not-complete body instead. -->
            <parameter name="noOutputProduced" type="Boolean" default-value="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="payload" type="Map"/>
        </out-parameters>
        <actions>
            <set field="notificationContext" from="[companyUserGroupId: companyUserGroupId, companyLabel: companyLabel, runName: runName, savedRunId: savedRunId, reconciliationRunId: reconciliationRunId, reconciliationRunResultId: reconciliationRunResultId, reconciliationMappingId: reconciliationMappingId, ruleSetId: ruleSetId, resultDataManagerPath: resultDataManagerPath, file1SystemLabel: file1SystemLabel, file1Label: file1Label, file1SystemEnumId: file1SystemEnumId, file2SystemLabel: file2SystemLabel, file2Label: file2Label, file2SystemEnumId: file2SystemEnumId]"/>
            <set field="tenantLabelValue" from="((companyLabel)?.toString()?.trim()) ?: darpan.facade.common.TenantAccessSupport.resolveTenantLabelForUserGroupId(ec, companyUserGroupId)"/>
            <set field="runNameValue" from="((runName)?.toString()?.trim()) ?: ((savedRunId)?.toString()?.trim()) ?: ((reconciliationRunId)?.toString()?.trim()) ?: 'reconciliation run'"/>
            <set field="resultIdValue" from="((reconciliationRunResultId)?.toString()?.trim())"/>
            <set field="resultUrl" from="darpan.reconciliation.notification.TenantNotificationSupport.buildRunResultUrl(ec, notificationContext)"/>
            <set field="file1SystemLabelValue" from="darpan.reconciliation.notification.TenantNotificationSupport.resolveFileSystemLabel(ec, notificationContext, 'file1', null)"/>
            <set field="file2SystemLabelValue" from="darpan.reconciliation.notification.TenantNotificationSupport.resolveFileSystemLabel(ec, notificationContext, 'file2', null)"/>
            <!-- Both verification passes emit one audit sentence on EVERY run, including all-clear ones,
                 into this same list. Counting those as warnings headlined every exchange-enabled run
                 "WITH ISSUES" (reported from prod 2026-08-05, Gorjana API Order Sync: 0 differences,
                 0 missing, 0 pending — still flagged). Split them so the header reacts only to real
                 warnings. -->
            <set field="partitionedWarnings" from="darpan.reconciliation.notification.TenantNotificationSupport.partitionAuditNotes(processingWarnings)"/>
            <set field="warningList" from="partitionedWarnings.warnings"/>
            <!-- partitionedWarnings.auditNotes is deliberately NOT read. The split still has to
                 happen — it is what keeps an always-emitted audit sentence out of warningList, and
                 so out of the "finished, but not cleanly" header — but the notes themselves are no
                 longer rendered here (2026-08-28). They restated what the *Details* block already
                 reports as structured counts, and on a returns run that came to six sentences of
                 prose after the numbers. The stored artifact keeps every sentence verbatim for the
                 run-result page's audit trail. -->
            <set field="runFailed" from="((statusEnumId)?.toString()?.trim()) == 'AUT_STAT_FAILED'"/>
            <set field="noOutput" from="runFailed &amp;&amp; noOutputProduced == true"/>
            <!-- A no-output failure keeps its original header verbatim: zeros there are not "no
                 differences", they are "never computed", and the verdict renderer has no counts to
                 read. Every other run is rendered by RunNotificationVoice, which leads with the
                 verdict instead of a fixed prefix. -->
            <if condition="noOutput">
                <set field="lines" from="['Darpan run FAILED: ' + runNameValue]"/>
            <else>
                <set field="voiceCounts" from="[onlyInFile1Count: onlyInFile1Count, onlyInFile2Count: onlyInFile2Count,
                        ruleDifferenceCount: ruleDifferenceCount, runFailed: runFailed, hasWarnings: (warningList ? true : false)]"/>
                <set field="voiceModel" from="darpan.reconciliation.notification.RunNotificationVoice.classify(voiceCounts) + [
                        runName: runNameValue, file1SystemLabel: file1SystemLabelValue, file2SystemLabel: file2SystemLabelValue,
                        priorCleanRuns: darpan.reconciliation.notification.RunNotificationStreak.countConsecutiveCleanRuns(ec, savedRunId, companyUserGroupId, resultIdValue),
                        completedMoment: darpan.reconciliation.notification.TenantNotificationSupport.resolveCompletedMoment(ec, companyUserGroupId, resultIdValue)]"/>
                <set field="lines" from="darpan.reconciliation.notification.RunNotificationVoice.renderLines(voiceModel)"/>
            </else>
            </if>
            <if condition="noOutput">
                <set field="ignoreLine" from="lines.add('⚠ Status: FAILED — the run did not finish and produced no results. Nothing was reconciled.')"/>
            </if>
            <if condition="runFailed &amp;&amp; !noOutput">
                <set field="ignoreLine" from="lines.add('⚠ Status: FAILED — the ruleset did not fully evaluate; results may be incomplete.')"/>
            </if>
            <set field="terminationReasonValue" from="((terminationReason)?.toString()?.trim())"/>
            <if condition="terminationReasonValue">
                <set field="ignoreLine" from="lines.add('⚠ ' + terminationReasonValue)"/>
            </if>
            <if condition="tenantLabelValue">
                <set field="ignoreLine" from="lines.add('Tenant: ' + tenantLabelValue)"/>
            </if>
            <if condition="resultIdValue">
                <set field="ignoreLine" from="lines.add('Result ID: ' + resultIdValue)"/>
            </if>
            <if condition="resultUrl">
                <set field="ignoreLine" from="lines.add('Run result: &lt;' + resultUrl + '|Open run result&gt;')"/>
            </if>
            <if condition="warningList">
                <set field="ignoreLine" from="lines.add('Warnings (' + warningList.size() + '): ' + warningList.take(3).join('; ') + (warningList.size() > 3 ? ' …' : ''))"/>
            </if>
            <set field="payload" from="[text: lines.join('\n')]"/>
        </actions>
    </service>

    <service verb="migrate" noun="TenantNotificationSettings" authenticate="false">
        <description>One-time v1.2.0 upgrade: copy each tenant's TenantNotificationSetting webhook into a
            TenantChatSpace named 'Default space' and link that tenant's automations (without a space) to it.
            Idempotent — tenants that already have any chat space are skipped. Internal only, not remote.</description>
        <out-parameters>
            <parameter name="migratedTenantCount" type="Integer"/>
            <parameter name="linkedAutomationCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="migratedTenantCount" from="0"/>
            <set field="linkedAutomationCount" from="0"/>
            <set field="settingRows" from="ec.entity.find('darpan.reconciliation.TenantNotificationSetting').disableAuthz().useCache(false).list() ?: []"/>
            <iterate list="settingRows" entry="settingRow">
                <set field="tenantIdValue" from="((settingRow.companyUserGroupId)?.toString()?.trim())"/>
                <set field="webhookValue" from="((settingRow.googleChatWebhookUrl)?.toString()?.trim())"/>
                <set field="existingSpaceCount" from="tenantIdValue ? ec.entity.find('darpan.reconciliation.TenantChatSpace').condition('companyUserGroupId', tenantIdValue).disableAuthz().useCache(false).count() : 1"/>
                <if condition="tenantIdValue &amp;&amp; webhookValue &amp;&amp; existingSpaceCount == 0">
                    <service-call name="create#darpan.reconciliation.TenantChatSpace" out-map="createdSpace"
                            in-map="[companyUserGroupId: tenantIdValue, spaceName: 'Default space', googleChatWebhookUrl: webhookValue, isActive: ((settingRow.isActive)?.toString()?.trim()) ?: 'Y', createdByUserId: settingRow.createdByUserId, createdDate: ec.user.nowTimestamp, lastUpdatedDate: ec.user.nowTimestamp]"/>
                    <set field="migratedTenantCount" from="migratedTenantCount + 1"/>
                    <set field="automationRows" from="ec.entity.find('darpan.reconciliation.ReconciliationAutomation').condition('companyUserGroupId', tenantIdValue).disableAuthz().useCache(false).list() ?: []"/>
                    <iterate list="automationRows" entry="automationRow">
                        <if condition="!((automationRow.chatSpaceId)?.toString()?.trim())">
                            <set field="ignoreSet" from="automationRow.set('chatSpaceId', createdSpace.chatSpaceId)"/>
                            <set field="ignoreUpdate" from="automationRow.update()"/>
                            <set field="linkedAutomationCount" from="linkedAutomationCount + 1"/>
                        </if>
                    </iterate>
                </if>
            </iterate>
        </actions>
    </service>

    <service verb="migrate" noun="ChatSpaceWebhookUrls" authenticate="false">
        <description>One-time upgrade for Slack support: copy each chat space's legacy
            googleChatWebhookUrl into the provider-agnostic webhookUrl column and stamp its provider as
            CHAT_PROV_GOOGLE. Idempotent — a row that already has webhookUrl is left untouched.

            NOT required for delivery. TenantNotificationSupport.resolveWebhookUrl falls back to the
            legacy column, so notifications keep working unrun; this exists so the legacy column can be
            dropped in the following release, and so the settings list stops depending on the fallback.
            Internal only, not remote: it reads and writes across every tenant with no per-request
            authorization check.</description>
        <out-parameters>
            <parameter name="migratedSpaceCount" type="Integer"/>
            <parameter name="skippedSpaceCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="migratedSpaceCount" from="0"/>
            <set field="skippedSpaceCount" from="0"/>
            <set field="spaceRows" from="ec.entity.find('darpan.reconciliation.TenantChatSpace').disableAuthz().useCache(false).list() ?: []"/>
            <iterate list="spaceRows" entry="spaceRow">
                <set field="existingWebhookUrl" from="((spaceRow.webhookUrl)?.toString()?.trim())"/>
                <set field="legacyWebhookUrl" from="((spaceRow.googleChatWebhookUrl)?.toString()?.trim())"/>
                <if condition="!existingWebhookUrl &amp;&amp; legacyWebhookUrl">
                    <set field="ignoreWebhook" from="spaceRow.set('webhookUrl', legacyWebhookUrl)"/>
                    <!-- Every row predating this release is a Google Chat space by construction: the
                         product could not create any other kind. Stamping it explicitly means the
                         provider column stops relying on the null-reads-as-Google rule. -->
                    <if condition="!((spaceRow.chatProviderEnumId)?.toString()?.trim())">
                        <set field="ignoreProvider" from="spaceRow.set('chatProviderEnumId', 'CHAT_PROV_GOOGLE')"/>
                    </if>
                    <set field="ignoreUpdate" from="spaceRow.update()"/>
                    <set field="migratedSpaceCount" from="migratedSpaceCount + 1"/>
                <else>
                    <set field="skippedSpaceCount" from="skippedSpaceCount + 1"/>
                </else>
                </if>
            </iterate>
        </actions>
    </service>

    <service verb="clear" noun="UndecryptableChatSpaceWebhooks" authenticate="false">
        <description>One-time upgrade for the 2026-08-14 removal of encrypt="true" from
            TenantChatSpace.googleChatWebhookUrl. Moqui only decrypts a field still declared encrypted, so
            any row written before that change now reads back as ciphertext. Left alone it would be handed
            straight to URI.create() on every send. This nulls every unreadable value, so the space renders
            as not-configured and an admin re-pastes the URL once.
            Idempotent, and a no-op on an installation that never stored a webhook. Internal only.

            BOTH webhook columns are checked. migrate#ChatSpaceWebhookUrls copies the legacy column into
            webhookUrl WITHOUT validating it, and resolveWebhookUrl reads webhookUrl FIRST, so on a
            deployment that ran the migration before this cleanup the ciphertext moved into the new column
            where the legacy-only pass could never reach it (reported live 2026-08-29). Nothing orders two
            one-time services, so this has to be safe run either way round.

            The columns validate DIFFERENTLY and must not be merged: googleChatWebhookUrl is a Google Chat
            URL by definition, while webhookUrl is provider-agnostic. Validating webhookUrl against the
            Google Chat host pin would null every working Slack webhook and turn this cleanup into an
            outage, so it goes through validateWebhookUrl with the row's own provider.</description>
        <out-parameters>
            <parameter name="clearedSpaceCount" type="Integer"/>
            <parameter name="keptSpaceCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="clearedSpaceCount" from="0"/>
            <set field="keptSpaceCount" from="0"/>
            <set field="spaceRows" from="ec.entity.find('darpan.reconciliation.TenantChatSpace').disableAuthz().useCache(false).list() ?: []"/>
            <iterate list="spaceRows" entry="spaceRow">
                <set field="legacyValue" from="((spaceRow.googleChatWebhookUrl)?.toString()?.trim())"/>
                <set field="newColumnValue" from="((spaceRow.webhookUrl)?.toString()?.trim())"/>
                <set field="rowCleared" from="false"/>
                <if condition="legacyValue &amp;&amp; darpan.reconciliation.notification.TenantNotificationSupport.validateGoogleChatWebhookUrl(legacyValue)">
                    <set field="ignoreLegacy" from="spaceRow.set('googleChatWebhookUrl', null)"/>
                    <set field="rowCleared" from="true"/>
                </if>
                <if condition="newColumnValue &amp;&amp; darpan.reconciliation.notification.TenantNotificationSupport.validateWebhookUrl(spaceRow.chatProviderEnumId, newColumnValue)">
                    <set field="ignoreNewColumn" from="spaceRow.set('webhookUrl', null)"/>
                    <set field="rowCleared" from="true"/>
                </if>
                <if condition="rowCleared">
                    <!-- ONE update per row, so a space with ciphertext in both columns is a single write
                         and is counted once rather than twice. -->
                    <set field="ignoreUpdate" from="spaceRow.update()"/>
                    <set field="clearedSpaceCount" from="clearedSpaceCount + 1"/>
                <else>
                    <!-- Counted as kept only if it actually had something to keep: a space that never
                         stored a webhook is neither cleared nor kept, which is what makes a second pass
                         over already-cleared rows report zero. -->
                    <if condition="legacyValue || newColumnValue">
                        <set field="keptSpaceCount" from="keptSpaceCount + 1"/>
                    </if>
                </else>
                </if>
            </iterate>
        </actions>
    </service>

    <!-- Task 13 fix round 1, Critical 2: originally named facade.ReconciliationFacadeServices.migrate#
         AutomationExcludeFilters with allow-remote="true"/authenticate="true". data/SecuritySeedData.xml
         warns that facade.* is an auto-grant trap — the facade.* ArtifactGroupMember grants AUTHZA_ALL
         to every tenant tier, so any authenticated user (including a view-only member of one tenant)
         could invoke a cross-tenant migration and read the global automationsScanned count. Moved out of
         facade.* and matched to this file's own migrate#TenantNotificationSettings posture: authenticate
         ="false", no allow-remote (defaults false, so it is not reachable via /rpc/json at all). -->
    <service verb="migrate" noun="AutomationExcludeFilters" authenticate="false" transaction="ignore">
        <description>One-time backfill: copy each ruleset-backed automation's exclusion filters from its
            rule set into the automation's own snapshot, across every tenant. Idempotent — a side that
            already has filter rows is left untouched. Run once after deploying exclusion filters;
            automations created afterwards are seeded at save time and do not need it. Internal only, not
            remote: this reads and writes across every tenant with no per-request authorization check, so
            it must be invoked from a trusted internal/admin path, never exposed to the SPA or
            /rpc/json.</description>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="automationsScanned" type="Integer"/>
            <parameter name="automationsSkipped" type="Integer"/>
            <parameter name="sidesSeeded" type="Integer"/>
            <parameter name="rowsCreated" type="Integer"/>
        </out-parameters>
        <actions>
            <!-- Task 13 fix round 2, minor: snapshot BEFORE calling the sweep so ok/errors below
                 reflect only what THIS call produced, not a stale error already sitting on ec.message
                 from something unrelated earlier on the same execution context (ec.message is never
                 cleared between service calls; a bare !ec.message.hasError() stays poisoned by that
                 forever, as the round-1 fix report's own cross-test cascade demonstrated). -->
            <set field="preCallErrorCount" from="darpan.facade.common.FacadeSupport.getErrors(ec).size()"/>
            <set field="backfillResult" from="darpan.facade.reconciliation.AutomationFacadeSupport.backfillAutomationExcludeFilters(ec)"/>
            <set field="automationsScanned" from="backfillResult.automationsScanned"/>
            <set field="automationsSkipped" from="backfillResult.automationsSkipped"/>
            <set field="sidesSeeded" from="backfillResult.sidesSeeded"/>
            <set field="rowsCreated" from="backfillResult.rowsCreated"/>
            <!-- Task 13 fix round 2, New Important 1: <message> must run BEFORE the messages set below
                 — FacadeSupport.getMessages(ec) returns a snapshot, so a <message> added after that set
                 already ran never appears in the messages out-parameter, matching every sibling service
                 in ReconciliationFacadeServices.xml. -->
            <message>Backfilled ${rowsCreated} exclusion filter rows across ${sidesSeeded} source sides (${automationsScanned} automations scanned, ${automationsSkipped} skipped).</message>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec).drop(preCallErrorCount)"/>
            <set field="ok" from="errors.isEmpty()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
        </actions>
    </service>

</services>
