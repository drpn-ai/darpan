<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- DAR-UI-048. One flowchart question through the SAME script the Run button uses, so a question
         is a normal run in every respect. A second definition rather than new facade inputs: the
         walker's key-file inputs name server paths and must never be reachable from a browser, so this
         entry point is internal. anonymous-all (the execute#Automation pattern) so the walker can call it
         under any signed-in member; the script itself still enforces tenant write access. It implements
         run#SavedRunDiff (S99-056: its parameters and results, so the two cannot drift) and adds the
         walker's inputs below; never the other way round, which would publish them on the remote service. -->
    <service verb="run" noun="FlowchartQuestion" type="script" transaction="ignore" allow-remote="false" authenticate="anonymous-all"
            location="component://darpan/src/main/groovy/darpan/facade/reconciliation/runSavedRunDiff.groovy">
        <description>Internal: runs one flowchart question through the Run button's own script, with the walker's key-file
            inputs (absolute server paths) and row links. Never remote.</description>
        <implements service="facade.ReconciliationFacadeServices.run#SavedRunDiff"/>
        <in-parameters>
            <!-- DAR-UI-048, walker-only. Absolute local paths and the flowchart's row links. -->
            <parameter name="file1IncludeIdsLocation"/>
            <parameter name="file1KeysOutLocation"/>
            <parameter name="reconciliationExecutionId"/>
            <parameter name="reconciliationRunId"/>
            <parameter name="parentRunResultId"/>
            <!-- Final review C1: the scheduler's walk has no user; see runSavedRunDiff.groovy for when it is honoured. -->
            <parameter name="systemTenantRun" type="Boolean"/>
        </in-parameters>
    </service>

    <!-- DAR-UI-048. The whole walk, for the facade's async dispatch and for automations. Internal. -->
    <service verb="run" noun="Reconciliation" transaction="ignore" allow-remote="false" authenticate="anonymous-all">
        <in-parameters>
            <parameter name="reconciliationId" required="true"/>
            <parameter name="reconciliationExecutionId"/>
            <parameter name="windowStartDate" type="Timestamp"/>
            <parameter name="windowEndDate" type="Timestamp"/>
            <parameter name="windowStartLocalDate"/>
            <parameter name="windowEndLocalDate"/>
            <parameter name="callerTenantUserGroupId"><description>Final review B1: the tenant the starting request
                resolved (header or preference). Checked again here against the caller's tenants; blank = today's
                preference-then-first resolution.</description></parameter>
        </in-parameters>
        <out-parameters><parameter name="summary" type="Map"/></out-parameters>
        <actions>
            <set field="summary" from="darpan.facade.common.TenantAccessSupport.withCallerTenant(ec, callerTenantUserGroupId) { -> darpan.common.TransactionDetachSupport.runDetachedFromCallerTransaction(ec) { -> darpan.reconciliation.flowchart.RunFlowchartSupport.runReconciliation(ec, [reconciliationId: reconciliationId, reconciliationExecutionId: reconciliationExecutionId, windowStartDate: windowStartDate, windowEndDate: windowEndDate, windowStartLocalDate: windowStartLocalDate, windowEndLocalDate: windowEndLocalDate]) } }"/>
        </actions>
    </service>
</services>
