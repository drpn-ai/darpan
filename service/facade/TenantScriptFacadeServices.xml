<?xml version="1.0" encoding="UTF-8"?>
<!--
  DAR-BE-334. The active tenant's queries (a read over its kept data and Darpan results, plus a JEXL script) and their
  schedules (email and chat), on moqui-jexl. Every read and write names the active tenant, so another tenant's query
  reads as not found (darpan.query.TenantQuerySupport). Writing and running need tenant edit access; scheduling needs
  tenant admin, since a schedule sends the tenant's data out.
-->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="list" noun="TenantQueries" allow-remote="true" authenticate="true" authz-action="view">
        <description>The active tenant's queries by name, with the fn: library and the QUERY limits for the editor, and the
            signed-in user's pinned queries for this tenant (pin order; a deleted query drops out).</description>
        <in-parameters>

        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="queries" type="List"/>
            <parameter name="library" type="List"/>
            <parameter name="limits" type="Map"/>
            <parameter name="pinnedQueryIds" type="List"><parameter name="pinnedQueryId"/></parameter>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <if condition="!tenantId"><message error="true">Choose a tenant first.</message></if>
            <if condition="!ec.message.hasError()"><script><![CDATA[
                queries = darpan.query.TenantQuerySupport.listQueries(ec, tenantId)
                library = org.moqui.jexl.ScriptSupervisor.libraryCatalog()
                limits = org.moqui.jexl.ScriptProfiles.get('QUERY').toMap()
            ]]></script></if>
            <if condition="!ec.message.hasError()">
                <set field="queryIds" from="queries*.tenantQueryId as Set"/>
                <set field="pinnedQueryIds" from="darpan.facade.reconciliation.ReconciliationDashboardPreferenceSupport.parsePinnedReconciliationMappingIds(ec.user.getPreference('darpan.queries.pinnedIds.' + tenantId)).findAll { queryIds.contains(it) }"/>
            </if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="save" noun="TenantQueryPins" allow-remote="true" authenticate="true" authz-action="view">
        <description>DAR-UI-138. Pin the signed-in user's queries for the active tenant (a personal preference, so view access
            is enough). Keeps the order given, once each, and only the active tenant's queries: an unknown id or another
            tenant's is dropped, never an error. Stored per user and per tenant, so pins in one tenant leave the others alone.</description>
        <in-parameters>
            <parameter name="pinnedQueryIds" type="List"><parameter name="pinnedQueryId"/></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="pinnedQueryIds" type="List"><parameter name="pinnedQueryId"/></parameter>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <if condition="!tenantId"><message error="true">Choose a tenant first.</message></if>
            <if condition="!ec.message.hasError()">
                <set field="queryIds" from="darpan.query.TenantQuerySupport.listQueries(ec, tenantId)*.tenantQueryId as Set"/>
                <set field="pinnedQueryIds" from="darpan.facade.reconciliation.ReconciliationDashboardPreferenceSupport.normalizePinnedReconciliationMappingIds(pinnedQueryIds).findAll { queryIds.contains(it) }"/>
                <script>ec.user.setPreference('darpan.queries.pinnedIds.' + tenantId, groovy.json.JsonOutput.toJson(pinnedQueryIds))</script>
                <else><set field="pinnedQueryIds" from="null"/></else>
            </if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="save" noun="TenantQuery" allow-remote="true" authenticate="true" transaction="ignore">
        <description>Create or update one of the active tenant's queries: a read over its kept data and Darpan results, and a JEXL script (profile QUERY). The script must parse and run on its sample; the read's sources must exist. Needs edit access to the tenant.</description>
        <in-parameters>
            <parameter name="tenantQueryId"/>
            <parameter name="queryName" required="true"/>
            <parameter name="description"/>
            <parameter name="readSpecJson" allow-html="any"/>
            <parameter name="scriptBody" required="true" allow-html="any"/>
            <parameter name="sampleInputJson" allow-html="any"/>
            <parameter name="isActive" type="Boolean" default-value="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="query" type="Map"/>
            <parameter name="notes" type="List"/>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <set field="canWrite" from="darpan.facade.common.TenantAccessSupport.requireActiveTenantWriteAccess(ec, 'Your active tenant only has view access, so it cannot change or run queries.', 'Choose a tenant first.')"/>
            <if condition="!ec.message.hasError()"><script><![CDATA[
                Map saved = darpan.query.TenantQuerySupport.saveQuery(ec, tenantId, [tenantQueryId: tenantQueryId, queryName: queryName,
                        description: description, readSpecJson: readSpecJson, scriptBody: scriptBody, sampleInputJson: sampleInputJson, isActive: isActive])
                query = saved?.query; notes = saved?.notes
            ]]></script></if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="delete" noun="TenantQuery" allow-remote="true" authenticate="true">
        <description>Delete one of the active tenant's queries and its schedules. Needs edit access.</description>
        <in-parameters>
            <parameter name="tenantQueryId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>

        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <set field="canWrite" from="darpan.facade.common.TenantAccessSupport.requireActiveTenantWriteAccess(ec, 'Your active tenant only has view access, so it cannot change or run queries.', 'Choose a tenant first.')"/>
            <if condition="!ec.message.hasError()"><script><![CDATA[
                darpan.query.TenantQuerySupport.deleteQuery(ec, tenantId, tenantQueryId)
            ]]></script></if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="run" noun="TenantQuery" allow-remote="true" authenticate="true" transaction="ignore">
        <description>Run a saved query, or the read and script given, on the active tenant's data now. Nothing is sent. Needs edit access.</description>
        <in-parameters>
            <parameter name="tenantQueryId"/>
            <parameter name="readSpecJson" allow-html="any"/>
            <parameter name="scriptBody" allow-html="any"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="result" type="Map"><description>{ok, summary, files: [{name, columns, rowCount, previewRows}], data, nothing, invalid, readCounts, units, elapsedMs, logs, error, readText}</description></parameter>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <set field="canWrite" from="darpan.facade.common.TenantAccessSupport.requireActiveTenantWriteAccess(ec, 'Your active tenant only has view access, so it cannot change or run queries.', 'Choose a tenant first.')"/>
            <if condition="!ec.message.hasError()"><script><![CDATA[
                result = darpan.query.TenantQuerySupport.runQuery(ec, tenantId, [tenantQueryId: tenantQueryId, readSpecJson: readSpecJson, scriptBody: scriptBody])
            ]]></script></if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="list" noun="TenantQuerySchedules" allow-remote="true" authenticate="true" authz-action="view">
        <description>The active tenant's query schedules (optionally for one query): owner, recipients, last run.</description>
        <in-parameters>
            <parameter name="tenantQueryId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="schedules" type="List"/>
            <parameter name="timeZone"/>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <if condition="!tenantId"><message error="true">Choose a tenant first.</message></if>
            <if condition="!ec.message.hasError()"><script><![CDATA[
                schedules = darpan.query.TenantQuerySupport.listSchedules(ec, tenantId, tenantQueryId)
                timeZone = darpan.reconciliation.notification.TenantNotificationSupport.resolveTenantZone(ec, tenantId).id
            ]]></script></if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="save" noun="TenantQuerySchedule" allow-remote="true" authenticate="true">
        <description>Create or update a schedule of one of the active tenant's queries: when (daily at HH:mm, or a cron), in the tenant's zone, and where its answer goes (email addresses, a chat space). Whoever saves it owns it. Needs tenant-admin access.</description>
        <in-parameters>
            <parameter name="scheduleId"/>
            <parameter name="tenantQueryId" required="true"/>
            <parameter name="dailyAt"/>
            <parameter name="cronExpression"/>
            <parameter name="isActive" type="Boolean" default-value="false"/>
            <parameter name="emailTo"/>
            <parameter name="emailCc"/>
            <parameter name="chatSpaceId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="schedule" type="Map"/>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <if condition="!tenantId"><message error="true">Choose a tenant first.</message></if>
            <if condition="tenantId &amp;&amp; !darpan.facade.common.TenantAccessSupport.isTenantAdmin(ec, tenantId)">
                <message error="true">Scheduling a query sends the tenant's data out, so it needs tenant-admin access.</message></if>
            <if condition="!ec.message.hasError()"><script><![CDATA[
                schedule = darpan.query.TenantQuerySupport.saveSchedule(ec, tenantId, [scheduleId: scheduleId, tenantQueryId: tenantQueryId,
                        dailyAt: dailyAt, cronExpression: cronExpression, isActive: isActive, emailTo: emailTo, emailCc: emailCc, chatSpaceId: chatSpaceId])?.schedule
            ]]></script></if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="delete" noun="TenantQuerySchedule" allow-remote="true" authenticate="true">
        <description>Delete one of the active tenant's query schedules. Needs tenant-admin access.</description>
        <in-parameters>
            <parameter name="scheduleId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>

        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <if condition="!tenantId"><message error="true">Choose a tenant first.</message></if>
            <if condition="tenantId &amp;&amp; !darpan.facade.common.TenantAccessSupport.isTenantAdmin(ec, tenantId)">
                <message error="true">Scheduling a query sends the tenant's data out, so it needs tenant-admin access.</message></if>
            <if condition="!ec.message.hasError()"><script><![CDATA[
                darpan.query.TenantQuerySupport.deleteSchedule(ec, tenantId, scheduleId)
            ]]></script></if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="run" noun="TenantQuerySchedule" allow-remote="true" authenticate="true" transaction="ignore">
        <description>Run a schedule now: a preview by default (nothing sent); send=true delivers it and records the run. Only its owner can run it by hand.</description>
        <in-parameters>
            <parameter name="scheduleId" required="true"/>
            <parameter name="send" type="Boolean" default-value="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="outcome" type="Map"/>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <if condition="!tenantId"><message error="true">Choose a tenant first.</message></if>
            <if condition="tenantId &amp;&amp; !darpan.facade.common.TenantAccessSupport.isTenantAdmin(ec, tenantId)">
                <message error="true">Scheduling a query sends the tenant's data out, so it needs tenant-admin access.</message></if>
            <if condition="!ec.message.hasError()"><script><![CDATA[
                outcome = darpan.query.TenantQuerySupport.runSchedule(ec, tenantId, scheduleId, send as boolean)
            ]]></script></if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>
    <service verb="get" noun="TenantQueryCatalog" allow-remote="true" authenticate="true" authz-action="view">
        <description>What the active tenant's queries may read: its kept datasets (with their kept fields; none listed = whole
            records), its saved runs and its audits (with the finding fields). The agent writes queries from this.</description>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="datasets" type="List"/>
            <parameter name="savedRuns" type="List"/>
            <parameter name="audits" type="List"/>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <if condition="!tenantId"><message error="true">Choose a tenant first.</message></if>
            <if condition="!ec.message.hasError()"><script><![CDATA[
                Map catalog = darpan.query.QueryCatalog.catalog(ec, tenantId)
                datasets = catalog.datasets; savedRuns = catalog.savedRuns; audits = catalog.audits
            ]]></script></if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="create" noun="TenantQueryProposal" allow-remote="true" authenticate="true" transaction="ignore">
        <description>A query proposed for the active tenant (by the agent or a person): its read is checked against
            get#TenantQueryCatalog and, when every source and field is in it, the query runs on the tenant's data so its
            result can be shown first. Nothing is saved; accepting it is save#TenantQuery. status: PROPOSED or REFUSED (code
            NOT_KEPT, UNKNOWN_SOURCE or INVALID_READ, with the field). Needs edit access.</description>
        <in-parameters>
            <parameter name="queryName" required="true"/>
            <parameter name="description"/>
            <parameter name="readSpecJson" allow-html="any"/>
            <parameter name="scriptBody" required="true" allow-html="any"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="status"/>
            <parameter name="code"/>
            <parameter name="field"/>
            <parameter name="message"/>
            <parameter name="proposal" type="Map"><description>{queryName, description, readSpecJson, scriptBody, readText}</description></parameter>
            <parameter name="preview" type="Map"><description>As run#TenantQuery's result.</description></parameter>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <set field="canWrite" from="darpan.facade.common.TenantAccessSupport.requireActiveTenantWriteAccess(ec, 'Your active tenant only has view access, so it cannot change or run queries.', 'Choose a tenant first.')"/>
            <if condition="!ec.message.hasError()"><script><![CDATA[
                Map out = darpan.query.QueryCatalog.propose(ec, tenantId, [queryName: queryName, description: description,
                        readSpecJson: readSpecJson, scriptBody: scriptBody])
                status = out?.status; code = out?.code; field = out?.field; message = out?.message
                proposal = out?.proposal; preview = out?.preview
            ]]></script></if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>
</services>
