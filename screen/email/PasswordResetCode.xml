<?xml version="1.0" encoding="UTF-8"?>
<!-- DAR-BE-028 email body; copy voiced in DAR-BE-139 (Aditi: "it doesnt need to be so dry"). No bold, and no
     links, because a link in a reset email is the phishing shape users should learn to distrust, and a code needs
     none. The "not you" line stays plain: that is the security instruction. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false">
    <widgets>
        <render-mode><text type="html"><![CDATA[<html><body>]]></text></render-mode>
        <container><label text="Hi ${firstName}, forgot your Darpan password? Fair. Month-end does that. Here's your way back in:"/></container>
        <container><label text="${code}"/></container>
        <container><label text="It works for ${expiresMinutes} minutes, then it turns back into a pumpkin."/></container>
        <container><label text="Didn't ask for this? Ignore it. Your password stays exactly as it is."/></container>
        <container><label text="— Darpan"/></container>
        <render-mode><text type="html"><![CDATA[</body></html>]]></text></render-mode>
    </widgets>
</screen>
