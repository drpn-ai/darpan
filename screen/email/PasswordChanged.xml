<?xml version="1.0" encoding="UTF-8"?>
<!-- DAR-BE-028: sent when a reset completes (PasswordResetSupport signs the account out everywhere first).
     DAR-BE-298: wears EmailFrame (the app's light theme, like the audit email) and the VOICE_GUIDE.md voice (Aditi
     2026-11-18: "there still is no personality here"); the darpan-email skill holds the rules. No bold. The only
     links are the user guide's (EmailFrame.guides: docs.drpn.ai pages, address shown; never a sign-in or action page). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false">
    <actions>
        <set field="frameOpen" from="darpan.email.EmailFrame.open('DARPAN · SECURITY')"/>
        <set field="frameClose" from="darpan.email.EmailFrame.close()"/>
        <set field="guidesHtml" from="darpan.email.EmailFrame.guides([['Lockouts and session length', 'troubleshooting/login-and-session#lockouts-and-session-length'], ['Two-factor sign-in', 'guides/two-factor']])"/>
        <set field="guidesText" from="darpan.email.EmailFrame.guidesText([['Lockouts and session length', 'troubleshooting/login-and-session#lockouts-and-session-length'], ['Two-factor sign-in', 'guides/two-factor']])"/>
    </actions>
    <widgets>
        <render-mode><text type="html" no-boundary-comment="true"><![CDATA[${frameOpen}]]></text></render-mode>
        <container style="dp-p"><label text="Hi ${firstName},"/></container>
        <container style="dp-p"><label text="New password, who dis?"/></container>
        <container style="dp-p"><label text="Your Darpan password changed on ${changedAt}, and every device you were signed in on got signed out on the way. Spring cleaning, but for sessions."/></container>
        <container style="dp-p"><label text="If that was you: lovely. Go forth. There is nothing else to do."/></container>
        <container style="dp-note"><label text="Not you? Tell your Darpan administrator now. Today, not after month-end."/></container>
        <container style="dp-sign"><label text="— Darpan"/></container>
        <render-mode>
            <text type="html" no-boundary-comment="true"><![CDATA[${guidesHtml}${frameClose}]]></text>
            <text type="text" no-boundary-comment="true"><![CDATA[${guidesText}]]></text>
        </render-mode>
    </widgets>
</screen>
