<?xml version="1.0" encoding="UTF-8"?>
<!-- Per-endpoint enablement for API source configs.

     GENERIC BY DESIGN: both services take a configTypeEnumId rather than being per-system, so a new
     shareable config type needs no new service. The type resolves to an entity name through
     SharedConfigAccessSupport.CONFIG_TYPE_REGISTRY — entity names never cross the wire.

     FENCE WARNING: facade\..* is granted to every Darpan role including DARPAN_TENANT_USER
     (SecuritySeedData.xml:97-121), so the artifact fence stops nobody. The gate is the parent-config
     authorization inside storeSourceConfigEndpointAccess.groovy. Enablement is OWNER-controlled: a
     tenant holding only ConfigTenantAccess may read the list but not change it. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="list" noun="SourceConfigEndpoints" authz-action="view" allow-remote="true" authenticate="true">
        <description>Endpoints registered for this config type, each with its current enablement.
            The catalog comes from SourceSystemConnector; access rows only supply isEnabled.</description>
        <in-parameters>
            <parameter name="configTypeEnumId" required="true"><description>SCFG_HOTWAX_OMS, SCFG_SHOPIFY_AUTH,
                SCFG_NS_AUTH, or SCFG_NS_RESTLET.</description></parameter>
            <parameter name="configId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="endpoints" type="List">
                <parameter name="systemEnumId"/>
                <parameter name="endpointLabel"/>
                <parameter name="isEnabled" type="Boolean"/>
            </parameter>
        </out-parameters>
        <actions>
            <set field="endpoints" from="darpan.reconciliation.automation.SourceEndpointAccessSupport.listEndpointsForConfig(ec, configTypeEnumId, configId)"/>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="store" noun="SourceConfigEndpointAccess" authz-action="update" allow-remote="true" authenticate="true">
        <description>Replace this config's endpoint enablement. Endpoints omitted from
            enabledSystemEnumIds are explicitly disabled; endpoints included have any prior 'N' row
            flipped back to 'Y'. Absent rows mean enabled, so a fully-enabled config stores nothing
            new.</description>
        <in-parameters>
            <parameter name="configTypeEnumId" required="true"/>
            <parameter name="configId" required="true"/>
            <parameter name="enabledSystemEnumIds" type="List" required="true">
                <parameter name="systemEnumId"/>
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="stored" type="Boolean"/>
        </out-parameters>
        <actions>
            <script location="component://darpan/src/main/groovy/darpan/facade/settings/storeSourceConfigEndpointAccess.groovy"/>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

</services>
