<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- DAR-BE-090 / DAR-BE-103. The two audit-run JSON documents (contract: docs/superpowers/specs/2026-10-21-audit-run-json-contract.md
         in the wrapper repo). Read-only views over the catalog, the ledger and check health; the work is in
         darpan.audit.AuditReportAssembler, because it is nested JSON with zone-aware formatting.

         Internal only (allow-remote="false"), with the tenant passed explicitly, like the ledger's writers. Every read
         carries an explicit companyUserGroupId condition, so the documents are tenant-pinned on scheduler threads
         (authz off, no active tenant) as well as under a user. The external entry point (GraphQL, DAR-BE-098)
         resolves the tenant from its API key and calls these. -->

    <service verb="assemble" noun="AuditReport" authenticate="false" allow-remote="false">
        <description>The darpan.audit.report/v1 document for one audit on one morning: report, health, summary,
            and the four categories with every statement of the audit, its checks and its findings (oldest first, at most
            50 per statement). State is as of the end of reportDate, so a past morning reads from the findings'
            history.</description>
        <in-parameters>
            <parameter name="companyUserGroupId" required="true"/>
            <parameter name="auditId" required="true">
                <description>The audit to report, e.g. GORJANA_MONTH_CLOSE; another tenant's audit reads as not found.</description></parameter>
            <parameter name="reportDate" type="Date" required="true">
                <description>The morning to describe, as a tenant calendar day.</description></parameter>
            <parameter name="generatedStamp" type="Timestamp" default="ec.user.nowTimestamp">
                <description>report.generatedAt; pinned by tests, now otherwise.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="document" type="Map"/>
        </out-parameters>
        <actions>
            <set field="document" from="darpan.audit.AuditReportAssembler.assembleReport(ec, companyUserGroupId, auditId, reportDate, generatedStamp)"/>
            <if condition="document == null">
                <return error="true" message="Audit ${auditId} was not found for tenant ${companyUserGroupId}"/></if>
        </actions>
    </service>

    <service verb="get" noun="AuditWindow" authenticate="false" allow-remote="false">
        <description>DAR-BE-091. The window an audit's checks read on one morning: from the first day of the audit's
            period to the report day, inclusive ("on the 14th it reconciles 1-14, on the 15th 1-15"). The scheduled
            run (DAR-BE-092) asks this before extracting, so every open finding of the period is examined again.</description>
        <in-parameters>
            <parameter name="companyUserGroupId" required="true"/>
            <parameter name="auditId" required="true"/>
            <parameter name="reportDate" type="Date" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="windowFromDate" type="Date"/>
            <parameter name="windowThruDate" type="Date"/>
            <parameter name="period"/>
        </out-parameters>
        <actions>
            <entity-find entity-name="darpan.audit.Audit" list="audits">
                <econdition field-name="auditId"/>
                <econdition field-name="companyUserGroupId"/>
            </entity-find>
            <if condition="!audits">
                <return error="true" message="Audit ${auditId} was not found for tenant ${companyUserGroupId}"/></if>
            <entity-find-one entity-name="moqui.basic.Enumeration" value-field="periodEnum" cache="true">
                <field-map field-name="enumId" from="audits[0].periodEnumId"/></entity-find-one>
            <set field="windowThruDate" from="reportDate"/>
            <set field="windowFromDate" from="java.sql.Date.valueOf(darpan.audit.AuditReportAssembler.periodStart(reportDate.toLocalDate(), periodEnum?.enumCode))"/>
            <set field="period" from="darpan.audit.AuditReportAssembler.periodOf(reportDate.toLocalDate(), periodEnum?.enumCode)"/>
        </actions>
    </service>

    <service verb="assemble" noun="AuditFinding" authenticate="false" allow-remote="false">
        <description>The darpan.audit.finding/v1 document for one finding: status, records, evidence, diagnosis,
            how to fix and verify it, and its history. A finding of another tenant reads as not found.</description>
        <in-parameters>
            <parameter name="companyUserGroupId" required="true"/>
            <parameter name="findingId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="document" type="Map"/>
        </out-parameters>
        <actions>
            <set field="document" from="darpan.audit.AuditReportAssembler.assembleFinding(ec, companyUserGroupId, findingId)"/>
            <if condition="document == null">
                <return error="true" message="Finding ${findingId} was not found"/></if>
        </actions>
    </service>
</services>
