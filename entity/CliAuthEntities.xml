<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- DAR-CLI-003. Browser-approved CLI sign-in. Both entities belong to a person, not a tenant: no
         DARPAN_ACTIVE_COMPANY_SCOPE filter. Every read of a CliSession conditions on userId = ec.user.userId;
         a CliDeviceCode is found by the hash of the CLI's device code or by the user code the person types. -->

    <entity entity-name="CliDeviceCode" package="darpan.auth" use="transactional" cache="never">
        <description>One CLI sign-in request (device code flow). The CLI holds the device code and polls with it;
            the person approves the short user code in their browser. Expires 10 minutes after it starts and
            is claimed once: the first poll after approval gets the login key, every later poll gets EXPIRED.</description>
        <field name="deviceCodeHash" type="id-long" is-pk="true">
            <description>SHA-256 (hex) of the device code; the device code itself is never stored.</description></field>
        <field name="userCode" type="id" not-null="true">
            <description>The code the person types or follows in the browser, XXXX-XXXX.</description></field>
        <field name="hostLabel" type="text-short">
            <description>The computer the CLI says it runs on, shown to the person before they approve.</description></field>
        <field name="statusId" type="id">
            <description>PENDING, APPROVED, DENIED or CLAIMED (approved and the key handed out).</description></field>
        <field name="approvedByUserId" type="id"/>
        <field name="issuedLoginKeyHash" type="id-long">
            <description>Hash of the login key issued at claim (moqui.security.UserLoginKey.loginKey).</description></field>
        <field name="requestIp" type="text-short">
            <description>Client IP of the start request, for the per-address limit.</description></field>
        <field name="createdDate" type="date-time"/>
        <field name="expiresDate" type="date-time"/>

        <relationship type="one-nofk" title="ApprovedBy" related="moqui.security.UserAccount" short-alias="approvedBy">
            <key-map field-name="approvedByUserId" related="userId"/>
        </relationship>
        <index name="CLIDEV_USER_CODE" unique="true"><index-field name="userCode"/></index>
        <index name="CLIDEV_IP_CREATED"><index-field name="requestIp"/><index-field name="createdDate"/></index>
    </entity>

    <entity entity-name="CliSession" package="darpan.auth" use="transactional" cache="never">
        <description>Marks a moqui.security.UserLoginKey as issued to the Darpan CLI, so a request signed in with it
            can be held to what the CLI may call. No FK to UserLoginKey: the framework deletes a user's expired keys
            when it issues a new one, and this row outlives the key.</description>
        <field name="loginKeyHash" type="id-long" is-pk="true">
            <description>moqui.security.UserLoginKey.loginKey: the key's hash, never the key.</description></field>
        <field name="userId" type="id" not-null="true"/>
        <field name="hostLabel" type="text-short"/>
        <field name="createdDate" type="date-time"/>
        <field name="revokedDate" type="date-time"/>

        <relationship type="one-nofk" related="moqui.security.UserAccount" short-alias="user"/>
        <relationship type="one-nofk" related="moqui.security.UserLoginKey" short-alias="loginKey">
            <key-map field-name="loginKeyHash" related="loginKey"/>
        </relationship>
        <index name="CLISES_USER"><index-field name="userId"/></index>
    </entity>

    <!-- DAR-BE-195. Per-user CLI access: a Darpan admin turns the CLI on for one user in one tenant. Unlike the two
         entities above these belong to a tenant: DARPAN_ACTIVE_COMPANY_SCOPE filter rows in SecuritySeedData. -->

    <entity entity-name="CliAccessGrant" package="darpan.auth" cache="never">
        <description>A Darpan admin's grant of CLI access to one user in one tenant, with an optional end. At most one grant
            per user and tenant is not REVOKED. Only admin.CliAccessAdminServices write it.</description>
        <field name="grantId" type="id" is-pk="true"/>
        <field name="userId" type="id" not-null="true"/>
        <field name="companyUserGroupId" type="id" not-null="true"><description>The tenant.</description></field>
        <field name="fromDate" type="date-time" not-null="true"/>
        <field name="thruDate" type="date-time"><description>Empty: no end date.</description></field>
        <field name="statusId" type="text-short"><description>ACTIVE, PAUSED or REVOKED.</description></field>
        <field name="pausedDate" type="date-time"/>
        <field name="createdByUserId" type="id"/>
        <field name="lastChangedByUserId" type="id"/>
        <field name="lastChangedDate" type="date-time"/>
        <index name="CLI_GRANT_TENANT_USER"><index-field name="companyUserGroupId"/><index-field name="userId"/></index>
    </entity>

    <entity entity-name="CliAccessGrantEvent" package="darpan.auth" cache="never">
        <description>Every change to a CLI grant: who, when, and the grant before and after.</description>
        <field name="eventId" type="id" is-pk="true"/>
        <field name="grantId" type="id" not-null="true"/>
        <field name="companyUserGroupId" type="id" not-null="true"><description>The tenant.</description></field>
        <field name="userId" type="id"><description>The grant's user.</description></field>
        <field name="action" type="text-short"><description>GRANT, CHANGE, PAUSE, UNPAUSE or REVOKE.</description></field>
        <field name="byUserId" type="id"/>
        <field name="eventDate" type="date-time"/>
        <field name="beforeJson" type="text-intermediate"/>
        <field name="afterJson" type="text-intermediate"/>
        <index name="CLI_GRANT_EVENT_GRANT"><index-field name="grantId"/></index>
    </entity>

    <entity entity-name="CliAccessRequest" package="darpan.auth" cache="never">
        <description>DAR-BE-209. A user's request, from the app, for the CLI in one tenant. At most one PENDING per user and
            tenant; a Darpan admin approves it (making a CliAccessGrant) or declines it with an optional note the user sees.</description>
        <field name="requestId" type="id" is-pk="true"/>
        <field name="userId" type="id" not-null="true"/>
        <field name="companyUserGroupId" type="id" not-null="true"><description>The tenant.</description></field>
        <field name="reason" type="text-intermediate"><description>What the user wants it for (optional, at most 500 characters).</description></field>
        <field name="statusId" type="text-short"><description>PENDING, APPROVED or DECLINED.</description></field>
        <field name="requestedDate" type="date-time"/>
        <field name="decidedByUserId" type="id"/>
        <field name="decidedDate" type="date-time"/>
        <field name="decisionNote" type="text-intermediate"><description>Shown to the user on a decline (optional, at most 500 characters).</description></field>
        <field name="grantId" type="id"><description>The grant an approval made.</description></field>
        <index name="CLI_REQUEST_TENANT_USER"><index-field name="companyUserGroupId"/><index-field name="userId"/></index>
        <index name="CLI_REQUEST_STATUS"><index-field name="statusId"/></index>
    </entity>

    <view-entity entity-name="CliSessionAndKey" package="darpan.auth">
        <description>A CLI session with its login key's expiry; a session whose key the framework has purged drops out.</description>
        <member-entity entity-alias="CLS" entity-name="darpan.auth.CliSession"/>
        <member-entity entity-alias="ULK" entity-name="moqui.security.UserLoginKey" join-from-alias="CLS">
            <key-map field-name="loginKeyHash" related="loginKey"/>
        </member-entity>
        <alias-all entity-alias="CLS"/>
        <alias name="expiresDate" entity-alias="ULK" field="thruDate"/>
    </view-entity>
</entities>
